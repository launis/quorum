uage": "auto"}}, "459": {"id": "8829e7fc-30a1-44eb-8fb8-a2458514d4cf", "type": "claim", "term": "Weidinger ym. 2021...", "definition": "J\u00e4rjestelm\u00e4n tuottama \u201dkognitiivinen j\u00e4lki\u201d on arkaluonteista dataa.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.666722", "metadata": {"citation_keys": [], "citation_text": "Weidinger ym. 2021", "full_reference": null, "concept_context": "5.3.2 Riski: Strategiset ja Eettiset Uhat", "language": "auto"}}, "460": {"id": "e16df7ef-4207-486d-a893-afde1a4fb82d", "type": "claim", "term": "OWASP Foundation 2025f...", "definition": "Riskin kuvaus: J\u00e4rjestelm\u00e4 on altis yleisille LLM-tietoturvariskeille.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.692361", "metadata": {"citation_keys": [], "citation_text": "OWASP Foundation 2025f", "full_reference": "OWASP Foundation 2025f. OWASP Top 10 for Gen AI. GenAI OWASP Top 10. Saatavilla: https://genai.owasp.org/llm-top-10/.", "concept_context": "5.3.3 Riski: Teknologiset tietoturvauhat (OWASP Top 10 for LLMs)", "language": "auto"}}, "461": {"id": "bea9349a-03eb-4eb7-a7f1-4fbca9abc49f", "type": "claim", "term": "Bai ym. 2022...", "definition": "Tulevaisuudessa siirryt\u00e4\u00e4n perustuslailliseen teko\u00e4lyyn (CAI).", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.717908", "metadata": {"citation_keys": [], "citation_text": "Bai ym. 2022", "full_reference": null, "concept_context": "5.3.3 Riski: Teknologiset tietoturvauhat (OWASP Top 10 for LLMs)", "language": "auto"}}, "462": {"id": "625fb742-6136-497a-b142-7732ba0f50ee", "type": "claim", "term": "Parasuraman & Riley 1997...", "definition": "T\u00e4m\u00e4 edellytt\u00e4\u00e4 koulutusta ja ty\u00f6kaluja automaatioharhan tunnistamiseksi.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.744688", "metadata": {"citation_keys": [], "citation_text": "Parasuraman & Riley 1997", "full_reference": "Parasuraman, Raja & Riley, Victor 1997. Humans and automation: Use, misuse, disuse, abuse. Human Factors, 39(2), s. 230\u2013253. Saatavilla: https://doi.org/10.1518/001872097778543886.", "concept_context": "6.1 Hypoteesin validoinnin ja jatkokehityksen edellytykset", "language": "auto"}}, "463": {"id": "3e173091-c88b-47d6-bb42-7cf829d30b0b", "type": "claim", "term": "Tutkimuseettinen neuvottelukunta TENK 2019...", "definition": "Ennen empiirisen tutkimusagendan toteuttamista on ehdottoman v\u00e4ltt\u00e4m\u00e4t\u00f6nt\u00e4 hankkia eettinen ennakkoarviointi ja hyv\u00e4ksynt\u00e4 asiaankuuluvalta tutkimuseettiselt\u00e4 toimikunnalta noudattaen Suomessa ihmistieteiden tutkimusta koskevia kansallisia ohjeistuksia.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.770220", "metadata": {"citation_keys": [], "citation_text": "Tutkimuseettinen neuvottelukunta TENK 2019", "full_reference": "Tutkimuseettinen neuvottelukunta TENK 2019. Ihmiseen kohdistuvan tutkimuksen eettiset periaatteet. Helsinki: TENK. Saatavilla: https://tenk.fi/sites/default/files/2021-01/Ihmistieteiden_eettisen_ennakkoarvioinnin_ohje_2020.pdf.", "concept_context": "6.2 Tutkimusagenda: Seuraavat vaiheet", "language": "auto"}}, "464": {"id": "35b51da6-8fd8-4e0d-8a74-0b8036d222c6", "type": "claim", "term": "McHugh 2012...", "definition": "Agenda jakautuu kahteen vaiheeseen: Ulkoisen validiteetin testaus (arvioijien v\u00e4linen luotettavuus IRR): On v\u00e4litt\u00f6m\u00e4sti k\u00e4ynnistett\u00e4v\u00e4 vertaileva pilottitutkimus (n=50), joka mittaa Kognitiivisen Kvoorumin arvioitsijareliabiliteetin (IRR) suhteessa ihmisasiantuntijoihin k\u00e4ytt\u00e4m\u00e4ll\u00e4 Cohenin Kappa -kerrointa ja Intra-Class Correlation (ICC) -mittaria.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.796658", "metadata": {"citation_keys": [], "citation_text": "McHugh 2012", "full_reference": "McHugh, Mary L. 2012. Interrater reliability: the kappa statistic. Biochemia Medica, 22(3), s. 276\u2013282. Saatavilla: https://doi.org/10.11613/BM.2012.031.", "concept_context": "6.2 Tutkimusagenda: Seuraavat vaiheet", "language": "auto"}}, "465": {"id": "7f6fbbe6-36d3-4a46-b495-bb502b8589f1", "type": "claim", "term": "Cullen 2020...", "definition": "Holistisen validiteetin testaus (Goodhartin Laki): On mitattava kest\u00e4vyytt\u00e4 \u201dperformatiivista reflektiota\u201d vastaan.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.824884", "metadata": {"citation_keys": [], "citation_text": "Cullen 2020", "full_reference": "Cullen, Michael J. 2020. Faking in high-stakes selection: A call to integrate empirical research and applied practice. International Journal of Selection and Assessment, 28(3), s. 223\u2013226. Saatavilla: https://doi.org/10.1111/ijsa.12289.", "concept_context": "6.2 Tutkimusagenda: Seuraavat vaiheet", "language": "auto"}}, "466": {"id": "c7eedb8b-901f-40fc-884a-7b7c86cf7bce", "type": "claim", "term": "Strathern 1997...", "definition": "On suoritettava koe, jossa testataan \u201dEp\u00e4ilytt\u00e4v\u00e4 T\u00e4ydellisyys\u201d -heuristiikan kyky\u00e4 erottaa aidot suoritukset optimoiduista.", "source_file": "Holistinen Mestaruus.docx", "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29", "ingested_at": "2026-02-17T03:38:32.851399", "metadata": {"citation_keys": [], "citation_text": "Strathern 1997", "full_reference": "Strathern, Marilyn 1997. 'Improving ratings': audit in the British university system. European Review, 5(3), s. 305\u2013321. Saatavilla: https://doi.org/10.1002/(SICI)1234-981X(199707)5:3<305::AID-EURO184>3.0.CO;2-4.", "concept_context": "6.2 Tutkimusagenda: Seuraavat vaiheet", "language": "auto"}}}, "components": {"1": {"id": "PANEL_PROMPT_TEMPLATE", "name": null, "description": null, "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "prompt", "content": "Olet Cognitive Quorum -j\u00e4rjestelm\u00e4n Asiantuntijapaneeli (Panel Agent).\n\nSINUN TEHT\u00c4V\u00c4SI on suorittaa alla m\u00e4\u00e4ritellyt roolit ja analyysit rinnakkain, hy\u00f6dynt\u00e4en sy\u00f6tteen\u00e4 saatuja aiempien vaiheiden tuloksia.\n\n{task_section}\n\n{context_section}\n\n{search_section}\n\n{linguistics_section}\n\nT\u00c4SS\u00c4 ON ANALYSOITAVA AINEISTO (INPUTS):\n{input_json}\n\nSUORITA ANALYYSI JA PALAUTA VAIN JSON-MUOTOINEN VASTAUS (PanelOutputDTO)."}, "2": {"id": "HEADER_MANDATES", "name": null, "description": "Mandaattiosion erotin.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "header", "content": "### 1. PERUUTTAMATTOMAT M\u00c4\u00c4R\u00c4YKSET (IRREVOCABLE MANDATES)"}, "3": {"id": "INSTRUCTION_STRICT_SCALE", "name": null, "description": "Pakottaa noudattamaan matriisin asteikkoa (Fail Fast).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "**T\u00c4RKE\u00c4\u00c4**: Kaikkien pisteiden ON oltava m\u00e4\u00e4ritellyn asteikon (Scale) sis\u00e4ll\u00e4.\n\nSinun on noudatettava asteikon rajoja ehdottomasti. Pisteet alle asteikon minimin tai yli maksimin ovat kiellettyj\u00e4."}, "4": {"id": "HEADER_RULES", "name": null, "description": "S\u00e4\u00e4nt\u00f6osion erotin.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "header", "content": "### 2. OPERATIIVISET S\u00c4\u00c4NN\u00d6T (OPERATIONAL RULES)"}, "5": {"id": "HEADER_PROTOCOLS", "name": null, "description": "Ty\u00f6kaluosion erotin.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "header", "content": "### 3. TY\u00d6KALUT JA MENETELM\u00c4T (TOOLS & METHODS)"}, "6": {"id": "HEADER_INSTRUCTIONS", "name": null, "description": "Teht\u00e4v\u00e4osion erotin.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "header", "content": "### 4. TEHT\u00c4V\u00c4NANTO (MISSION INSTRUCTIONS)\n\nT\u00c4RKE\u00c4\u00c4: Aloita vastaus AINA t\u00e4ytt\u00e4m\u00e4ll\u00e4 'reasoning_trace' -kentt\u00e4 JSON-objektin alussa. Kirjoita siihen askel askeleelta (Chain-of-Thought), miten analysoit sy\u00f6tteen, ENNEN kuin teet lopullisia johtop\u00e4\u00e4t\u00f6ksi\u00e4 (kuten bool-arvot tai pisteet). T\u00e4m\u00e4 on pakollinen auditointij\u00e4lki.\n\n**HUOMIO: ARVIOINNIN KOHDE (SCOPE)**\nKeskity VAIN 'User'-merkittyihin viesteihin. Chat-historiassa 'AI' tai 'Assistant' ovat vain kontekstia. \u00c4l\u00e4 anna k\u00e4ytt\u00e4j\u00e4lle pisteit\u00e4 teko\u00e4lyn vastauksista. Sinun teht\u00e4v\u00e4si on arvioida k\u00e4ytt\u00e4j\u00e4n omaa promptauskyky\u00e4 (Driver vs Passenger), ei teko\u00e4lyn tuottamaa teksti\u00e4."}, "7": {"id": "MANDATE_1", "name": null, "description": "Pakottaa hitaaseen ajatteluun (Kahneman).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "mandate", "content": "Mandaatti 1 (System 2 -Pakko): M\u00c4\u00c4R\u00c4YS: Sinun ON k\u00e4ytett\u00e4v\u00e4 hidasta, deliberatiivista p\u00e4\u00e4ttely\u00e4. \u00c4l\u00e4 reagoi intuitiivisesti. Pys\u00e4hdy analysoimaan jokaista v\u00e4itett\u00e4."}, "8": {"id": "MANDATE_2", "name": null, "description": "Pakottaa tunnistamaan kognitiiviset vinoumat.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "mandate", "content": "Mandaatti 2 (Vinoumien Torjunta): M\u00c4\u00c4R\u00c4YS: Tunnista aktiivisesti 'Confirmation Bias' ja 'Sunk Cost Fallacy'. Jos k\u00e4ytt\u00e4j\u00e4 kehuu huonoa ideaa, vastusta h\u00e4nt\u00e4."}, "9": {"id": "MANDATE_3", "name": null, "description": "Erottaa mestaruuden osaamattomuudesta.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "mandate", "content": "Mandaatti 3 (Insin\u00f6\u00f6rim\u00e4inen N\u00f6yryys): M\u00c4\u00c4R\u00c4YS: Arvosta vain perusteltua s\u00e4\u00e4nt\u00f6jen rikkomista ('Mestaruus'). Selitt\u00e4m\u00e4t\u00f6n poikkeama on virhe."}, "10": {"id": "MANDATE_4", "name": null, "description": "Est\u00e4\u00e4 j\u00e4rjestelm\u00e4n pelaamisen (Goodhart).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "mandate", "content": "Mandaatti 4 (Performatiivisuuden Paljastus): M\u00c4\u00c4R\u00c4YS: Oleta Goodhartin laki todeksi. Jos k\u00e4ytt\u00e4j\u00e4 'n\u00e4yttelee' asiantuntijaa ilman substanssia, paljasta se."}, "11": {"id": "MANDATE_5", "name": null, "description": "K\u00e4\u00e4nt\u00e4\u00e4 todistustaakan: oleta tyhj\u00e4ksi kunnes toisin todistetaan.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "mandate", "content": "Mandaatti 5 (Null Hypothesis): L\u00c4HT\u00d6OLETUS: Sy\u00f6te on tyhj\u00e4 ja v\u00e4itteet ovat v\u00e4\u00e4ri\u00e4. Sinun on *todistettava* jokainen havainto sitaatilla sy\u00f6tteest\u00e4. Jos et l\u00f6yd\u00e4 suoraa todistetta, tulos on 'Ei havaittu'."}, "12": {"id": "RULE_1", "name": null, "description": "Tietoturvaraja.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "rule", "content": "S\u00e4\u00e4nt\u00f6 1 (Luottamuksen Keh\u00e4): M\u00c4\u00c4R\u00c4YS: Luota vain Vartija-agentin (Guard) validoimaan dataan. Hylk\u00e4\u00e4 'tahriintunut' data."}, "13": {"id": "RULE_2", "name": null, "description": "Toimivallan rajaus.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "rule", "content": "S\u00e4\u00e4nt\u00f6 2 (Toimivalta): M\u00c4\u00c4R\u00c4YS: Pysy roolissasi. \u00c4l\u00e4 hallusinoi kykyj\u00e4 (esim. live-internet) joita sinulla ei ole."}, "14": {"id": "RULE_3", "name": null, "description": "Est\u00e4\u00e4 estetiikkavinouman.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "rule", "content": "S\u00e4\u00e4nt\u00f6 3 (Substanssi > Muoto): M\u00c4\u00c4R\u00c4YS: \u00c4l\u00e4 anna pisteit\u00e4 ulkoasusta. Arvioi vain SUBSTANSSIA ja LOGIIKKAA."}, "15": {"id": "RULE_4", "name": null, "description": "Turing-testi prosessille.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "rule", "content": "S\u00e4\u00e4nt\u00f6 4 (Ep\u00e4ilytt\u00e4v\u00e4 T\u00e4ydellisyys): M\u00c4\u00c4R\u00c4YS: Jos prosessissa ei ole kitkaa tai iteraatiota, se on ep\u00e4ilytt\u00e4v\u00e4. T\u00e4ydellisyys ilman ty\u00f6t\u00e4 on huijausta."}, "16": {"id": "RULE_5", "name": null, "description": "Ep\u00e4varmuuden raportointi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "rule", "content": "S\u00e4\u00e4nt\u00f6 5 (Hauraus): M\u00c4\u00c4R\u00c4YS: Kirjaa aina 'Episteeminen Ep\u00e4varmuus'. \u00c4l\u00e4 arvaa k\u00e4ytt\u00e4j\u00e4n aikeita."}, "17": {"id": "RULE_6", "name": null, "description": "Faktojen ensisijaisuus.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "rule", "content": "S\u00e4\u00e4nt\u00f6 6 (Falsifiointi): M\u00c4\u00c4R\u00c4YS: Faktavirhe kumoaa hyv\u00e4n retoriikan. Totuus on t\u00e4rke\u00e4mpi kuin tyyli."}, "18": {"id": "GLOBAL_CONTEXT", "name": "J\u00e4rjestelm\u00e4n Aikaleima ja Sijainti", "description": "M\u00e4\u00e4ritt\u00e4\u00e4 nykyhetken ja pakottaa teko\u00e4lyn pois training-data -rajoitteista.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "context", "content": "### J\u00c4RJESTELM\u00c4KONTEKSTI (SYSTEM CONTEXT)\nNYKYHETKI: {{CURRENT_DATE}}.\nKELLONAIKA: {{DYNAMIC_TIME}}.\n{{DYNAMIC_LOCATION}}\n\nROOLI: Toimit 'Cognitive Quorum' -auditointij\u00e4rjestelm\u00e4n moottorina.\n\nAIKA-ANKKURI: Tiedosta, ett\u00e4 toimit NYT, t\u00e4ss\u00e4 hetkess\u00e4 ({{CURRENT_DATE}}). Koulutusdatasi 'Knowledge Cutoff' on historiaa. Arvioi kaikkia teknologioita ja v\u00e4itteit\u00e4 t\u00e4st\u00e4 ajankohdasta k\u00e4sin.\n\n### AUDITOITAVA MATERIAALI (INPUT DATA)\nAlla on k\u00e4ytt\u00e4j\u00e4n toimittamat tiedostot auditointia varten. Jos kentt\u00e4 on tyhj\u00e4, tiedostoa ei ole toimitettu.\n\n[KESKUSTELUHISTORIA_ALKU]\n{{HISTORY_TEXT}}\n[KESKUSTELUHISTORIA_LOPPU]\n\n[LOPPUTUOTE_ALKU]\n{{PRODUCT_TEXT}}\n[LOPPUTUOTE_LOPPU]\n\n[REFLEKTIODOKUMENTTI_ALKU]\n{{REFLECTION_TEXT}}\n[REFLEKTIODOKUMENTTI_LOPPU]"}, "19": {"id": "OP_RULE_1", "name": null, "description": "Sanktio hallusinaatioista.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "operational_rule", "content": "EROTTELU 1: Faktatarkkuus. Hallusinaatio = Automaattinen pistev\u00e4hennys."}, "20": {"id": "OP_RULE_2", "name": null, "description": "Sanktio kopioinnista.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "operational_rule", "content": "EROTTELU 2: Aitous. Jos teksti on >80% teko\u00e4lyn kirjoittamaa ilman k\u00e4ytt\u00e4j\u00e4n ohjausta, se on plagiointia."}, "21": {"id": "OP_RULE_3", "name": null, "description": "Todistepohjainen arviointi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "operational_rule", "content": "EROTTELU 3: Todisteet. Arvioi vain Lokia (mit\u00e4 tehtiin), \u00e4l\u00e4 Reflektiota (mit\u00e4 v\u00e4itettiin)."}, "22": {"id": "OP_RULE_4", "name": null, "description": "Leikkaa pisteet passiivisilta k\u00e4ytt\u00e4jilt\u00e4 (Ohjelmallinen s\u00e4\u00e4nt\u00f6).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "operational_rule", "content": "S\u00e4\u00e4nt\u00f6 4 (Passiivisuus-leikkuri): M\u00c4\u00c4R\u00c4YS: Jos k\u00e4ytt\u00e4j\u00e4 on 'Matkustaja' (Taso 1) miss\u00e4\u00e4n kategoriassa, se aktivoi automaattisen 'Passiivisuus-leikkurin'. T\u00e4m\u00e4 leikkaa lopulliset pisteet ohjelmallisesti. Sinun teht\u00e4v\u00e4si on vain tunnistaa passiivisuus rehellisesti - \u00e4l\u00e4 yrit\u00e4 itse laskea keskiarvoa alas."}, "23": {"id": "INSTRUCTION_NO_HALLUCINATION", "name": null, "description": "Strict grounding instruction to prevent hallucinations.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "RAJOITUKSET (NO-HALLUCINATION POLICY):\n- \u00c4L\u00c4 KEKSI ESIMERKKEJ\u00c4 (Esim. 'Uusiutuva energia', 'S\u00e4hk\u00f6autot').\n- Generoi analyysi VAIN JA AINOASTAAN annetusta tekstist\u00e4.\n- Jos teksti on 'Asiakasnumero: 12345', analysoi vain se."}, "24": {"id": "INSTRUCTION_CITATION_OBLIGATION", "name": null, "description": "Pakottaa suoran sitaatin k\u00e4yt\u00f6n.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "RAJOITUS (CITATION OBLIGATION):\n- Sinun on *pakko* sis\u00e4llytt\u00e4\u00e4 'citation_snippet' -kentt\u00e4\u00e4n suora lainaus sy\u00f6tteest\u00e4 jokaiselle v\u00e4itteelle.\n- Jos et pysty lainaamaan teksti\u00e4, et saa esitt\u00e4\u00e4 v\u00e4itett\u00e4."}, "25": {"id": "INSTRUCTION_NO_DATA_LEAK", "name": null, "description": "Prevents LLM from mirroring raw input back into output.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "RAJOITUS (HUGE DATA PROTECTION):\n- \u00c4L\u00c4 KOSKAAN KOPIOI ALKUPER\u00c4IST\u00c4 TEKSTI\u00c4 TULOSTEEKSEEN.\n- Aseta kent\u00e4\u00e4n VAIN teksti: 'DATA_CHECKED_AND_SECURED'.\n- Syy: JSON-rakenne hajoaa, jos yrit\u00e4t tulostaa 50 sivun raportin t\u00e4h\u00e4n."}, "26": {"id": "INSTRUCTION_BIBLICAL_GROUNDING", "name": null, "description": "Enforces Knowledge Base and Context (Search) as the sole, indisputable source of truth.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "RAJOITUS (BIBLICAL GROUNDING): TIETOKANTA JA KONTEKSTI OVAT AINOA TOTUUS.\n- Sinun maailmasi rajoittuu T\u00c4YSIN annettuun aineistoon (Knowledge Base, L\u00e4hdeluettelo, Hakutulokset).\n- Jos tietoa ei ole annetussa tekstiss\u00e4, SIT\u00c4 EI OLE OLEMASSA.\n- L\u00e4hdeluettelo on 'Jumalan Sana': \u00c4l\u00e4 koskaan kyseenalaista, muokkaa tai hallusinoi l\u00e4hteit\u00e4.\n- Jos k\u00e4ytt\u00e4j\u00e4 kysyy jotain, mit\u00e4 ei l\u00f6ydy l\u00e4hteist\u00e4 eik\u00e4 hakutuloksista, vastaa: 'Tieto ei sis\u00e4lly annettuun aineistoon'."}, "27": {"id": "INSTRUCTION_LANGUAGE_FI", "name": null, "description": "Enforces Finnish language output strictly.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "KIELI: Kirjoita vastauksesi, analyysisi ja kaikki generoitava teksti AINA suomeksi. T\u00e4m\u00e4 on EHDOTON vaatimus. Vaikka sy\u00f6teaineisto tai JSON-skeeman kenttien kuvaukset olisivat englanniksi, sinun ON tuotettava suomenkielist\u00e4 teksti\u00e4. \u00c4l\u00e4 vaihda kielt\u00e4 englanniksi kesken vastauksen."}, "28": {"id": "TASK_GUARD", "name": null, "description": "Vartija - Input Hygiene Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 1: VARTIJA (Input Hygiene Audit)\nTEHT\u00c4V\u00c4T:\n1. SUORITA TEKNINEN TARKASTUS: Onko sy\u00f6te 'roskaa' (ep\u00e4m\u00e4\u00e4r\u00e4ist\u00e4) vai 'koodia' (strukturoitua)?\n2. T\u00c4YT\u00c4 'SecurityCheck':\n   - 'threat_detected': Aseta FALSE (\u00e4l\u00e4 keskeyt\u00e4 ajoa osaamattomuuden takia).\n   - 'risk_level': Aseta 'KORKEA', jos havaitset 'Lazy Prompting' (alle 5 sanaa, ei kontekstia).\n   - 'simulation_result': Luokittele k\u00e4ytt\u00e4j\u00e4: 'Passiivinen Matkustaja' vs 'Aktiivinen Arkkitehti'.\n3. T\u00c4YT\u00c4 'tainted_data' (T\u00c4RKE\u00c4 - CRITICAL):\n   - \u00c4L\u00c4 kopioi alkuper\u00e4ist\u00e4 teksti\u00e4 t\u00e4h\u00e4n kentt\u00e4\u00e4n.\n   - Aseta arvoksi VAIN merkkijono: \"DATA_CHECKED_AND_SECURED\".\n   - Syytteess\u00e4 annettu teksti on jo j\u00e4rjestelm\u00e4ss\u00e4, sen kopiointi on turhaa ja aiheuttaa virheit\u00e4.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (GuardOutput). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon, 'security_check' -objektin, ja 'tainted_data' -objektin:\n{{SCHEMA_EXAMPLE}}"}, "29": {"id": "TASK_ANALYST", "name": null, "description": "Analyytikko - Context Engineering Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 2: ANALYYTIKKO (Context Engineering Audit)\nTEHT\u00c4V\u00c4T:\n1. ETSI todisteita 'Grounding'-tekniikasta VAIN annetuista sy\u00f6tetiedostoista (history_text, product_text, etc.).\n2. SUORITA TOTUUSVERTAILU (Truth Protocol):\n   - TASO 1 (Laki): Tietopankki on Ehdoton Auktoriteetti. Jos k\u00e4ytt\u00e4j\u00e4 v\u00e4itt\u00e4\u00e4 jotain, mik\u00e4 on ristiriidassa Tietopankin kanssa -> KIRJAA RIKKOMUS (Critical Violation).\n   - TASO 2 (Forensinen): Vastaako Reflektio (v\u00e4itteet) Lokia (teot)?\n   - TASO 3 (Ulkoinen): Jos Tietopankki ei ota kantaa, onko v\u00e4ite uskottava?\n3. T\u00c4YT\u00c4 'AnalystOutput':\n   - 'hypotheses': Listaa v\u00e4itteet ja niiden status (Verified/Violation/Hallucination). JOKAISELLE v\u00e4itteelle T\u00c4YTYY t\u00e4ytt\u00e4\u00e4 'quotes' -lista suorilla lainauksilla.\n   - 'evidence_found': True, jos ja vain jos inputissa on faktoja. Jos tyhj\u00e4 -> False.\n   - 'rag_evidence': Poimi suorat sitaatit Tietopankista, jotka tukevat tai kumoavat v\u00e4itteet.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (AnalystOutput). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'hypotheses' -listan:\n{{SCHEMA_EXAMPLE}}"}, "30": {"id": "TASK_PROFILER", "name": null, "description": "Profiler - Cognitive Bias Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 4: PROFILOIJA (Cognitive Bias Audit)\nTEHT\u00c4V\u00c4T:\n1. ETSI kognitiivisia vinoumia prompteista.\n2. TUNNISTA 'Automation Bias': Hyv\u00e4ksyyk\u00f6 k\u00e4ytt\u00e4j\u00e4 ensimm\u00e4isen vastauksen sokeasti?\n3. VERTAA Reflektiota (V\u00e4itteet) ja Historiaa (Teot). Tunnista Ristiriita (Say-Do Gap): Jos k\u00e4ytt\u00e4j\u00e4 v\u00e4itt\u00e4\u00e4 reflektoivansa, mutta historia on mekaanista tilaamista, kirjaa 'Illusion of Competence'.\n\nMETRIIKKA: {{PROFILER_METRICS}}\nKONTROLLISUHDE: {{INPUT_CONTROL_RATIO}}\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (ProfilerAnalysis). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'author_intent' -kent\u00e4n:\n{{SCHEMA_EXAMPLE}}"}, "31": {"id": "TASK_LOGICIAN", "name": null, "description": "Logician - Prompt Structure Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 5: LOOGIKKO (Prompt Structure Audit)\nTEHT\u00c4V\u00c4T:\n1. J\u00c4SENN\u00c4 k\u00e4ytt\u00e4j\u00e4n prompti T\u00c4YDELLISELL\u00c4 Toulmin-mallilla (6 osaa):\n   - Claim: K\u00e4ytt\u00e4j\u00e4n tavoite/v\u00e4ite.\n   - Data: K\u00e4ytt\u00e4j\u00e4n antama konteksti/todisteet.\n   - Warrant: Logiikka, miksi ohje johtaa tavoitteeseen.\n   - Backing: Taustatuki warrantille (miksi logiikka p\u00e4tee?).\n   - Rebuttal: Vasta-argumentit tai poikkeukset (huomioiko k\u00e4ytt\u00e4j\u00e4 estot?).\n   - Qualifier: Varmuusaste/rajaus (esim. 'useimmiten', 'ehdottomasti').\n2. ARVIOI TODISTUSVOIMA (Probative Value):\n   - KORKEA: V\u00e4ite saa tukea Reflektiosta (A), Lokista (B) JA Tietopankista/Hausta (C).\n   - KESKITASO: V\u00e4ite saa tukea A:sta ja B:st\u00e4, mutta ulkoinen validointi puuttuu.\n   - MATALA: V\u00e4ite perustuu vain k\u00e4ytt\u00e4j\u00e4n omaan sanaan (A) ilman lokitodisteita (B).\n3. ARVIOI: Onko prompti looginen kokonaisuus? Jos osia puuttuu, j\u00e4t\u00e4 vastaava kentt\u00e4 tyhj\u00e4ksi.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (LogicianOutput). \nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA. Sinun on palautettava 'logician_data' -objekti, jonka SIS\u00c4LL\u00c4 ovat analyysikent\u00e4t.\nVarmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'logician_data' -objektin:\n{{SCHEMA_EXAMPLE}}"}, "32": {"id": "TASK_FALSIFIER", "name": null, "description": "Falsifier - Critical Loop Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 6: FALSIFIOIJA (Critical Loop Audit)\nTEHT\u00c4V\u00c4T:\n1. ETSI 'Iteraatiosilmukkaa': Miss\u00e4 kohtaa k\u00e4ytt\u00e4j\u00e4 sanoi 'Ei' tai 'Korjaa'?\n2. T\u00c4YT\u00c4 'stress_test_findings':\n   - 'question': K\u00e4ytt\u00e4j\u00e4n korjausk\u00e4sky.\n   - 'observation': Oliko k\u00e4ytt\u00e4j\u00e4 kriittinen vai 'Jees-mies'?\n3. T\u00c4YT\u00c4 'fidelity_audit': Merkitse 'HEIKKO', jos k\u00e4ytt\u00e4j\u00e4 hyv\u00e4ksyi ensimm\u00e4isen version ilman yht\u00e4k\u00e4\u00e4n muutosta.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (FalsifierOutput).\nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA. Sinun on palautettava 'falsifier_data' -objekti, jonka SIS\u00c4LL\u00c4 ovat analyysikent\u00e4t.\nVarmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'falsifier_data' -objektin:\n{{SCHEMA_EXAMPLE}}"}, "33": {"id": "TASK_OVERSEER", "name": null, "description": "Overseer - Hallucination Management", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 9: VALVOJA (Hallucination Management)\nTEHT\u00c4V\u00c4T:\n1. ANALYSOI hakutulokset:\n{{SEARCH_RESULT}}\n\n2. SUORITA FAKTATARKISTUS (Fact Checker Protocol):\n   - Etsi k\u00e4ytt\u00e4j\u00e4n tai teko\u00e4lyn esitt\u00e4mi\u00e4 FAKTAV\u00c4ITTEIT\u00c4 (esim. vuosiluvut, nimet, tapahtumat).\n   - VERTAA v\u00e4itteit\u00e4 hakutuloksiin.\n   - Jos v\u00e4ite on totta (Search vahvistaa) -> MERKITSE 'VERIFIED'.\n   - Jos v\u00e4ite on ep\u00e4tosi (Search kumoaa) -> MERKITSE 'HALLUCINATION'.\n3. JOS virhe l\u00f6ytyy: Tarkista, huomasiko/korjasiko k\u00e4ytt\u00e4j\u00e4 sen?\n4. TUOMIO: Jos k\u00e4ytt\u00e4j\u00e4 j\u00e4tti virheen lopputuotteeseen -> Kirjaa 'KRIITTINEN LAIMINLY\u00d6NTI'.\n5. T\u00c4YT\u00c4 'fact_checks' havainnoillasi.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (OverseerOutput).\nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA. Sinun on palautettava 'overseer_data' -objekti, jonka SIS\u00c4LL\u00c4 ovat analyysikent\u00e4t.\nVarmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'overseer_data' -objektin:\n{{SCHEMA_EXAMPLE}}"}, "34": {"id": "TASK_CAUSAL", "name": null, "description": "Causal Analyst - Impact Verification", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "**VAIHE 7: KAUSAALINEN ANALYYSI (Causal Audit)**\n\nSinun teht\u00e4v\u00e4si on arvioida v\u00e4itteiden ja todistusaineiston v\u00e4list\u00e4 syy-seuraussuhdetta.\n\n**ANALYYSI:**\n1. **Abduktiivinen P\u00e4\u00e4ttely**: Onko esitetty syy paras mahdollinen selitys havainnolle?\n   - Tunnista \"Post Hoc Ergo Propter Hoc\" -virheet.\n   - Arvioi: `POST_HOC` (Virheellinen), `UNCERTAIN` (Ep\u00e4varma), `GENUINE` (Aito).\n\n2. **Vastafaktuaalinen Testi (Counterfactual Test)**:\n   - Kuvittele tilanne, jossa v\u00e4itetty\u00e4 syyt\u00e4 (X) ei olisi tapahtunut.\n   - Olisiko seuraus (Y) silti tapahtunut?\n   - M\u00e4\u00e4rit\u00e4 uskottavuus (Plausibility): `IMPOSSIBLE` (Mahdoton), `PLAUSIBLE` (Mahdollinen), `HIGH` (Todenn\u00e4k\u00f6inen).\n   - Kirjaa simulaation tulos `simulation_result` kentt\u00e4\u00e4n.\n\n**TUOTOSVAATIMUS**:\nVastauksen on oltava `CausalOutput` -skeeman mukainen JSON.\nVarmista erityisesti, ett\u00e4 `counterfactual_test` -objekti on t\u00e4ytetty kattavasti.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (CausalOutput).\nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA. Sinun on palautettava 'causal_analysis' -objekti, jonka SIS\u00c4LL\u00c4 ovat analyysikent\u00e4t.\nVarmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'causal_analysis' -objektin:\n{{SCHEMA_EXAMPLE}}"}, "35": {"id": "TASK_PERFORMATIVITY", "name": null, "description": "Performativity Detector - Illusion of Control Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 8: TUNNISTAJA (Illusion of Control Audit)\nTEHT\u00c4V\u00c4T:\n1. ETSI 'V\u00e4syneit\u00e4 Komentoja' (1-2 sanaa: 'jatka', 'lis\u00e4\u00e4').\n2. TUNNISTA 'Illusion of Control': K\u00e4ytt\u00e4j\u00e4 luulee ohjaavansa, mutta AI tekee aloitteet.\n3. LIPUTA 'Performatiivinen', jos k\u00e4ytt\u00e4j\u00e4n panos on minimaalinen mutta reflektio mahtipontinen.\n4. SOVELLA Goodhartin lakia: Etsi 'Ep\u00e4ilytt\u00e4v\u00e4\u00e4 T\u00e4ydellisyytt\u00e4' (Suspicious Perfection). Jos prosessi on kitkaton ja virheet\u00f6n, liputa se anomaliana (Strathern 1997).\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (PerformativityOutput).\\nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA.\\nVIRHEELLINEN ESIMERKKI (\u00c4L\u00c4 TEE N\u00c4IN):\\n{\\n  \"reasoning_trace\": \"...\",\\n  \"performativity_heuristics\": ... (T\u00e4m\u00e4 on v\u00e4\u00e4rin, puuttuu k\u00e4\u00e4re)\\n}\\n\\nOIKEA ESIMERKKI (TEE N\u00c4IN):\\n{\\n  \"reasoning_trace\": \"...\",\\n  \"performativity_analysis\": {  <-- T\u00c4M\u00c4 K\u00c4\u00c4RE ON PAKOLLINEN\\n    \"performativity_heuristics\": ...\\n  }\\n}\\n\\nVarmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'performativity_analysis' -objektin:\\n{{SCHEMA_EXAMPLE}}"}, "36": {"id": "TASK_ARCHIVIST", "name": null, "description": "Archivist - Best Practices Audit", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 10: ARKISTONHOITAJA (Best Practices Audit)\nTEHT\u00c4V\u00c4T:\n1. VERTAA k\u00e4ytt\u00e4j\u00e4n tyyli\u00e4 'State of the Art' -k\u00e4yt\u00e4nt\u00f6ihin (esim. OpenAI Cookbook).\n2. ARVIOI 'Linjakkuus': Noudattaako k\u00e4ytt\u00e4j\u00e4 systemaattista prosessia vai 'Brute Force' -yrityst\u00e4?\n3. ANNA 'compliance_analysis': Valitse yksi seuraavista: 'Critically Misaligned', 'Misaligned', 'Neutral', 'Aligned', 'Strongly Aligned'.\n4. ANNA 'compliance_score' (1-5): 1=T\u00e4ysin satunnainen, 3=Jonkinlainen prosessi, 5=T\u00e4ydellinen best practices -noudattaminen.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (ArchivistOutput). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace', 'relevant_cases', ja 'compliance_analysis' -kent\u00e4t:\n{{SCHEMA_EXAMPLE}}"}, "37": {"id": "TASK_JUDGE", "name": null, "description": "Judge - Competence Scoring", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 9: TUOMARI (JUDGE) - GRAND UNIFICATION\n\nSINUN TEHT\u00c4V\u00c4SI:\nToimit J\u00e4rjestelm\u00e4n Tuomarina. Teht\u00e4v\u00e4si EI ole arvioida sy\u00f6tetekstin laatua, vaan k\u00e4ytt\u00e4j\u00e4n **Promptauskompetenssia** (Driver vs. Passenger).\n\nK\u00c4YT\u00c4 SEURAAVAA LOGIIKKAA (DRIVER'S LICENSE):\n\n1. **AJOKORTTIMALLI (MANDATE 4)**:\n   - J\u00e4rjestelm\u00e4 on kuin auto. K\u00e4ytt\u00e4j\u00e4 on joko **Kuljettaja** (Driver) tai **Matkustaja** (Passenger).\n   - Kuljettaja ottaa vastuun, ohjaa, antaa kontekstin ja m\u00e4\u00e4rittelee tavoitteet.\n   - Matkustaja on passiivinen, heitt\u00e4\u00e4 ep\u00e4m\u00e4\u00e4r\u00e4isen sy\u00f6tteen (\"tee t\u00e4st\u00e4 jotain\") ja odottaa auton ajavan itsest\u00e4\u00e4n.\n\n2. **TOTUUSPROTOKOLLAN PISTEYTYS (HIERARCHICAL SCORING)**:\n   - **KRUUNUNJALOKIVEN RIKKOMUS (Critical Violation)**: Jos Analyytikko liputtaa, ett\u00e4 k\u00e4ytt\u00e4j\u00e4 on rikkonut Tietopankin (Knowledge Base) s\u00e4\u00e4nt\u00f6j\u00e4 -> **AUTOMAATTINEN HYLKY (Max 40/100 tai -50 pistett\u00e4)**. T\u00e4m\u00e4 on kuin ajaisi p\u00e4in punaisia.\n   - **FAKTAVIRHE (Hallucination)**: Jos Valvoja liputtaa, ett\u00e4 k\u00e4ytt\u00e4j\u00e4 on v\u00e4\u00e4r\u00e4ss\u00e4 Google-haun perusteella -> **V\u00c4HENN\u00c4 20 PISTETT\u00c4**. T\u00e4m\u00e4 on kuin ajaisi ylinopeutta.\n   - **FORENSINEN RISTIRIITA (Say-Do Gap)**: Jos Reflektio ja Loki ovat ristiriidassa -> **V\u00c4HENN\u00c4 10 PISTETT\u00c4**. T\u00e4m\u00e4 on huolimattomuutta.\n\n3. **PISTEYTYS (NOUDATA MATRIISIA)**:\n   - Sinun ON noudatettava edell\u00e4 m\u00e4\u00e4ritelty\u00e4 **Arviointimatriisia (Evaluation Matrix)** ja sen **Asteikkoa (Scale)**.\n   - Jos matriisin asteikko on 1-100, k\u00e4yt\u00e4 koko asteikkoa.\n   - Jos matriisin asteikko on 1-4, k\u00e4yt\u00e4 sit\u00e4.\n\nT\u00c4YT\u00c4 SCHEMA: `EvaluationResult`\n- `reasoning_trace`: Kirjoita t\u00e4h\u00e4n SYV\u00c4LLINEN perustelu p\u00e4\u00e4t\u00f6kselle (Chain-of-Thought).\n- `score_card`: T\u00e4yt\u00e4 pistekortti (total_score, final_verdict, dimensions).\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (EvaluationResult). Varmista ett\u00e4 'reasoning_trace' on mukana:\n{{SCHEMA_EXAMPLE}}"}, "38": {"id": "TASK_COACH", "name": null, "description": "Coach - Technical Remediation", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 12: VALMENTAJA (COACH)\n\nSINUN TEHT\u00c4V\u00c4SI:\nToimit J\u00e4rjestelm\u00e4n Valmentajana (Coach). Teht\u00e4v\u00e4si on auttaa k\u00e4ytt\u00e4j\u00e4\u00e4 kehittym\u00e4\u00e4n \"Matkustajasta\" (Passenger) \"Kuljettajaksi\" (Driver).\n\nOHJEET:\n1. **ANALYSOI TUOMIO**: Katso Tuomarin (Step 11) antama `score_card`.\n2. **TUNNISTA PROFIILI (SUHTEESSA ASTEIKKOON)**:\n   - **Passenger (Matalat Pisteet)**: K\u00e4ytt\u00e4j\u00e4 on passiivinen. Pisteet ovat asteikon alap\u00e4\u00e4ss\u00e4. Ohjaa h\u00e4nt\u00e4 ottamaan vastuu.\n   - **Driver (Korkeat Pisteet)**: K\u00e4ytt\u00e4j\u00e4 on aktiivinen. Pisteet ovat asteikon yl\u00e4p\u00e4\u00e4ss\u00e4. Anna syv\u00e4llisemp\u00e4\u00e4 optimointipalautetta.\n3. **KONSTRUKTIIVINEN JA RIKASTETTU PALAUTE**:\n   - \u00c4l\u00e4 vain hauku. Kerro *miten* promptia pit\u00e4\u00e4 parantaa.\n   - **Enriched Feedback**: Viittaa akateemisiin l\u00e4hteisiin (esim. Kahneman, Strathern, Popper) perustellaksesi neuvosi. Esim. \"V\u00e4lt\u00e4 my\u00f6t\u00e4ilyvinoumaa (Sycophancy Bias).\"\n\nT\u00c4YT\u00c4 SCHEMA: `CoachingPlan`\n- `focus_areas`: Miksi k\u00e4ytt\u00e4j\u00e4 sai ne pisteet jotka sai?\n- `actionable_steps`: Konkreettinen lista: Tee A, Tee B.\n- `bibliography`: L\u00e4hdeviitteet.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (CoachingPlan). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'actionable_steps' -listan:\n{{SCHEMA_EXAMPLE}}"}, "39": {"id": "TASK_INTERACTION", "name": null, "description": "Interaction Analyst - Driver Metrics", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 3: VUOROVAIKUTUS (Driver Metrics)\nTEHT\u00c4V\u00c4T:\n1. ARVIOI Riippuvuussuhdetta (Dependency). (Huom: J\u00e4rjestelm\u00e4 laskee tarkan Input-Control Ration erikseen). Jos vaikuttaa, ett\u00e4 k\u00e4ytt\u00e4j\u00e4 on t\u00e4ysin riippuvainen, liputa 'High Dependency'.\n2. Laske 'imperative_command_count': Montako kertaa k\u00e4ytt\u00e4j\u00e4 antaa suoran k\u00e4skyn (esim. 'Tee', 'Korjaa', 'Analysoi')?\n3. TUNNISTA Strategia: Zero-shot (Hyl\u00e4tty), Few-shot (Hyv\u00e4ksytty), Chain-of-Thought (Kiitett\u00e4v\u00e4).\n4. LUOKITTELE Arkkityyppi: 'Matkustaja' (Tilaa), 'Kartanlukija' (Korjaa), 'Kuski' (Ohjaa), 'Arkkitehti' (Suunnittelee).\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (InteractionAnalysis). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'role_classification' -kent\u00e4n:\n{{SCHEMA_EXAMPLE}}"}, "40": {"id": "TASK_PANEL", "name": null, "description": "Panel Agent - Unified Critics", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "SIN\u00c4 TOIMIT SEURAAVANA ASIANTUNTIJAPANEELINA (Jokainen rooli analysoi saman aineiston):\n\nROOLI 1: Logician (Structure Audit)\nTEHT\u00c4V\u00c4T:\n1. J\u00c4SENN\u00c4 k\u00e4ytt\u00e4j\u00e4n prompti T\u00c4YDELLISELL\u00c4 Toulmin-mallilla (6 osaa):\n   - Claim: K\u00e4ytt\u00e4j\u00e4n tavoite/v\u00e4ite.\n   - Data: K\u00e4ytt\u00e4j\u00e4n antama konteksti/todisteet.\n   - Warrant: Logiikka, miksi ohje johtaa tavoitteeseen.\n   - Backing: Taustatuki warrantille (miksi logiikka p\u00e4tee?).\n   - Rebuttal: Vasta-argumentit tai poikkeukset (huomioiko k\u00e4ytt\u00e4j\u00e4 estot?).\n   - Qualifier: Varmuusaste/rajaus (esim. 'useimmiten', 'ehdottomasti').\n2. ARVIOI: Onko prompti looginen kokonaisuus? Jos osia puuttuu, j\u00e4t\u00e4 vastaava kentt\u00e4 tyhj\u00e4ksi.\nOUTPUT: logician_data\n\nROOLI 2: Falsifier (Critical Loop Audit)\nTEHT\u00c4V\u00c4T:\n1. ETSI 'Iteraatiosilmukkaa': Miss\u00e4 kohtaa k\u00e4ytt\u00e4j\u00e4 sanoi 'Ei' tai 'Korjaa'?\n2. T\u00c4YT\u00c4 'stress_test_findings':\n   - 'question': K\u00e4ytt\u00e4j\u00e4n korjausk\u00e4sky.\n   - 'observation': Oliko k\u00e4ytt\u00e4j\u00e4 kriittinen vai 'Jees-mies'?\n3. T\u00c4YT\u00c4 'fidelity_audit': Merkitse 'HEIKKO', jos k\u00e4ytt\u00e4j\u00e4 hyv\u00e4ksyi ensimm\u00e4isen version ilman yht\u00e4k\u00e4\u00e4n muutosta.\nOUTPUT: falsifier_data\n\nROOLI 3: Causal Analyst (Impact Verification)\nSinun teht\u00e4v\u00e4si on arvioida v\u00e4itteiden ja todistusaineiston v\u00e4list\u00e4 syy-seuraussuhdetta.\nANALYYSI:\n1. Abduktiivinen P\u00e4\u00e4ttely: Onko esitetty syy paras mahdollinen selitys havainnolle?\n   - Tunnista \"Post Hoc Ergo Propter Hoc\" -virheet.\n   - Arvioi: `POST_HOC` (Virheellinen), `UNCERTAIN` (Ep\u00e4varma), `GENUINE` (Aito).\n2. Vastafaktuaalinen Testi (Counterfactual Test):\n   - Kuvittele tilanne, jossa v\u00e4itetty\u00e4 syyt\u00e4 (X) ei olisi tapahtunut.\n   - Olisiko seuraus (Y) silti tapahtunut?\n   - M\u00e4\u00e4rit\u00e4 uskottavuus (Plausibility): `IMPOSSIBLE` (Mahdoton), `PLAUSIBLE` (Mahdollinen), `HIGH` (Todenn\u00e4k\u00f6inen).\n   - Kirjaa simulaation tulos `simulation_result` kentt\u00e4\u00e4n.\nOUTPUT: causal_analysis\n\nROOLI 4: Performativity Detector (Illusion of Control Audit)\nTEHT\u00c4V\u00c4T:\n1. ETSI 'V\u00e4syneit\u00e4 Komentoja' (1-2 sanaa: 'jatka', 'lis\u00e4\u00e4').\n2. TUNNISTA 'Illusion of Control': K\u00e4ytt\u00e4j\u00e4 luulee ohjaavansa, mutta AI tekee aloitteet.\n3. LIPUTA 'Performatiivinen', jos k\u00e4ytt\u00e4j\u00e4n panos on minimaalinen mutta reflektio mahtipontinen.\n4. SOVELLA Goodhartin lakia: Etsi 'Ep\u00e4ilytt\u00e4v\u00e4\u00e4 T\u00e4ydellisyytt\u00e4' (Suspicious Perfection). Jos prosessi on kitkaton ja virheet\u00f6n, liputa se anomaliana (Strathern 1997).\nOUTPUT: performativity_analysis\n\nROOLI 5: Factual Overseer (Hallucination Management)\nTEHT\u00c4V\u00c4T:\n1. ANALYSOI hakutulokset:\n{{SEARCH_RESULT}}\n\n2. TARKISTA faktojen paikkansapit\u00e4vyys.\n3. JOS virhe l\u00f6ytyy: Tarkista, huomasiko/korjasiko k\u00e4ytt\u00e4j\u00e4 sen?\n4. TUOMIO: Jos k\u00e4ytt\u00e4j\u00e4 j\u00e4tti virheen lopputuotteeseen -> Kirjaa 'KRIITTINEN LAIMINLY\u00d6NTI'.\n5. T\u00c4YT\u00c4 'fact_checks' havainnoillasi.\nOUTPUT: overseer_data\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (PanelOutput).\n\nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA.\nSinun on palautettava objekti, jossa on erilliset avaimet jokaiselle roolille (esim. 'logician_data', 'performativity_analysis').\n\u00c4l\u00e4 yrit\u00e4 yhdist\u00e4\u00e4 kaikkia kentti\u00e4 yhteen litte\u00e4\u00e4n listaan.\n\nVarmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja kaikki vaaditut data-objektit:\n{{SCHEMA_EXAMPLE}}"}, "41": {"id": "TASK_XAI", "name": null, "description": "XAI Reporter - License Certification", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "task", "content": "VAIHE 13: XAI-RAPORTOIJA (XAI REPORTER)\n\nSINUN TEHT\u00c4V\u00c4SI:\nToimit J\u00e4rjestelm\u00e4n XAI-Raportoijana (Explainable AI). Teht\u00e4v\u00e4si on selitt\u00e4\u00e4 k\u00e4ytt\u00e4j\u00e4lle *miksi* h\u00e4n sai tietyn tuomion ja *miten* j\u00e4rjestelm\u00e4 p\u00e4\u00e4tyi lopputulokseen.\n\nOHJEET:\n1. **TIIVIST\u00c4 PROSESSI**: Kerro lyhyesti, mit\u00e4 vaiheita (Guard -> Judge -> Coach) sy\u00f6te k\u00e4vi l\u00e4pi.\n2. **SELIT\u00c4 P\u00c4\u00c4T\u00d6S (DRIVERS LICENSE)**:\n   - Jos hyl\u00e4tty (Matalat Pisteet): Selit\u00e4, ett\u00e4 sy\u00f6te oli liian passiivinen (\"Matkustaja\").\n   - Jos hyv\u00e4ksytty (Korkeat Pisteet): Selit\u00e4, mitk\u00e4 elementit tekiv\u00e4t siit\u00e4 \"Kuljettajan\" sy\u00f6tteen.\n3. **AVAIMET JATKOON**: Viittaa Coachin antamaan \"CoachingPlan\"-suunnitelmaan.\\n4. **VERSION COMPATIBILITY**: Support ALL matrix versions (Standard V1 & Cognitive V2). DO NOT reject input based on version mismatch.\\n\\nT\u00c4YT\u00c4 SCHEMA: `XAIOutput`\n- `executive_summary`: Johdon yhteenveto p\u00e4\u00e4t\u00f6ksest\u00e4.\n- `final_verdict`: Lopullinen tuomio selkokielell\u00e4.\n- `confidence_score`: Kuinka varma j\u00e4rjestelm\u00e4 on arviostaan (0.0 - 1.0).\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (XAIOutput). Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace', 'executive_summary' ja 'final_verdict' -kent\u00e4t:\n{{SCHEMA_EXAMPLE}}"}, "42": {"id": "PROTOCOL_1", "name": null, "description": "Puutteiden auditointi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "protocol", "content": "Protokolla 1 (Negatiivinen Loki): Kirjaa yl\u00f6s PUUTTEET. Mit\u00e4 k\u00e4ytt\u00e4j\u00e4 j\u00e4tti tekem\u00e4tt\u00e4?"}, "43": {"id": "PROTOCOL_2", "name": null, "description": "Validointiprosessi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "protocol", "content": "Protokolla 2 (Validointi): 1. Syntaksi (JSON), 2. Semantiikka (J\u00e4rki), 3. Strategia (Tavoite)."}, "44": {"id": "PROTOCOL_3", "name": null, "description": "Tiedonhankinta.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "protocol", "content": "Protokolla 3 (RFI): Jos tieto puuttuu, \u00e4l\u00e4 arvaa. Vaadi lis\u00e4tietoa."}, "45": {"id": "PROTOCOL_4", "name": null, "description": "Vastuunsiirto.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "protocol", "content": "Protokolla 4 (Vastuu): Jos luotettavuus on ep\u00e4varma, siirr\u00e4 vastuu ihmiselle (HITL)."}, "46": {"id": "METHOD_1", "name": null, "description": "Stressitestaus.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "method", "content": "Menetelm\u00e4 1 (Red Team): Simuloi hy\u00f6kk\u00e4\u00e4j\u00e4\u00e4. Yrit\u00e4 rikkoa argumentti tahallaan."}, "47": {"id": "METHOD_2", "name": null, "description": "Ristiinvalidoiva ketju.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "method", "content": "Menetelm\u00e4 2 (Ketju): Auditoi edellisen agentin tulos ennen omaa ty\u00f6t\u00e4si."}, "48": {"id": "METHOD_3", "name": null, "description": "Sokraattinen auditointi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "method", "content": "Menetelm\u00e4 3 (Kysymykset): Generoi kysymyksi\u00e4, jotka paljastavat k\u00e4ytt\u00e4j\u00e4n tiet\u00e4m\u00e4tt\u00f6myyden."}, "49": {"id": "INSTRUCTION_TOULMIN", "name": null, "description": "Argumentaatiomalli.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "K\u00c4SKE: J\u00e4senn\u00e4 Toulmin-mallilla (V\u00e4ite, Peruste, Oikeutus). Perusta analyysi VAIN annettuun aineistoon (step_analyst). \u00c4L\u00c4 keksi omia esimerkej\u00e4. Jos todisteita ei ole, hylk\u00e4\u00e4 v\u00e4ite."}, "50": {"id": "INSTRUCTION_BLOOM", "name": null, "description": "Kognitiivinen mittari.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "K\u00c4SKE: Arvioi Bloomin tasolla. Vaadi 'Analyysi\u00e4' tai korkeampaa."}, "51": {"id": "INSTRUCTION_ANON", "name": null, "description": "Tietosuoja.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "TARKISTA: Etsi tekstist\u00e4 PII-dataa (Nimet, Email). JOS JA VAIN JOS l\u00f6yd\u00e4t AITOA PII-dataa sy\u00f6tteest\u00e4, poista se. \u00c4L\u00c4 KOSKAAN keksi esimerkkej\u00e4 tyhj\u00e4st\u00e4 (esim. 'Matti Meik\u00e4l\u00e4inen'). Jos dataa ei l\u00f6ydy, kirjaa 'Ei havaittu' ja jatka."}, "52": {"id": "INSTRUCTION_RAG_OPT", "name": null, "description": "RAG-optimointi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "K\u00c4SKE: Optimoi konteksti 'Lost in the Middle' -ilmi\u00f6t\u00e4 vastaan."}, "53": {"id": "PRINCIPLE_1", "name": null, "description": "Popperilainen tieteenfilosofia.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "principle", "content": "Periaate 1: M\u00c4\u00c4R\u00c4YS: Tieteellinen totuus selvitet\u00e4\u00e4n yritt\u00e4m\u00e4ll\u00e4 kumota v\u00e4ite. Jos v\u00e4ite ei kest\u00e4 kritiikki\u00e4, se on v\u00e4\u00e4r\u00e4."}, "54": {"id": "REQUIREMENT_1", "name": null, "description": "Mallien diversiteetti.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "requirement", "content": "Vaatimus 1: M\u00c4\u00c4R\u00c4YS: Kriittiset vaiheet (Falsifiointi) on ajettava eri parametreilla kuin luovat vaiheet."}, "55": {"id": "INSTRUCTION_COACH_CITATION", "name": null, "description": "Tiukat ohjeet l\u00e4hdeluettelon luomiseen (Vain DB).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "instruction", "content": "CRITICAL: Do NOT populate the 'lahdeluettelo' field manually. The system will generate it programmatically based on your inline citations.\n\nYOUR TASK is to use inline citations explicitly in your text (e.g., '(Toulmin 2003)', '(Kahneman 2011)').\nEnsure you refer to the provided EXTERNAL SOURCES.\nLeave 'lahdeluettelo' as an empty list []."}, "56": {"id": "HEURISTIC_1", "name": null, "description": "Syy-seuraus -analyysi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "heuristic", "content": "Heuristiikka 1 (Temporaalinen): M\u00c4\u00c4R\u00c4YS: Tarkista aikajana. Tuliko oivallus ENNEN tuloksen paranemista (Syy) vai vasta sen j\u00e4lkeen (Rationalisointi)?"}, "57": {"id": "HEURISTIC_2", "name": null, "description": "Lis\u00e4arvon mittaus.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "heuristic", "content": "Heuristiikka 2 (Kontrafaktuaalinen): M\u00c4\u00c4R\u00c4YS: Kysy 'Jos k\u00e4ytt\u00e4j\u00e4 ei olisi tehnyt mit\u00e4\u00e4n, olisiko teko\u00e4ly ratkaissut t\u00e4m\u00e4n silti?'. Jos kyll\u00e4 -> Matkustaja."}, "58": {"id": "HEURISTIC_3", "name": null, "description": "Occamin partaveitsi.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "heuristic", "content": "Heuristiikka 3 (Occamin partaveitsi): M\u00c4\u00c4R\u00c4YS: Yksinkertaisin selitys on todenn\u00e4k\u00f6isin."}, "59": {"id": "STANDARD_REPORT_OUTPUT", "name": "Standard Report Output Schema", "description": "Standard fields to hoist for XAI Report.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "output_config", "content": ["executive_summary", "final_verdict", "confidence_score", "score_cards", "comparison_data", "analysis_strengths", "analysis_weaknesses", "analysis_opportunities", "analysis_recommendations"]}, "60": {"id": "PANEL_OUTPUT_CONFIG", "name": "Panel Audit Output Schema", "description": "Standard fields to hoist for Panel Audit.", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "output_config", "content": ["logician_data", "falsifier_data", "causal_analysis", "performativity_analysis", "overseer_data"]}, "61": {"id": "GuardAgent", "name": "GuardAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.guard", "component_class": "GuardAgent", "class_name": "GuardAgent", "registered_at": "2025-12-26T16:04:11.225845", "type": "agent", "content": null}, "62": {"id": "AnalystAgent", "name": "AnalystAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.analyst", "component_class": "AnalystAgent", "class_name": "AnalystAgent", "registered_at": "2025-12-26T16:04:11.234018", "type": "agent", "content": null}, "63": {"id": "InteractionAnalystAgent", "name": "InteractionAnalystAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.interaction", "component_class": "InteractionAnalystAgent", "class_name": "InteractionAnalystAgent", "registered_at": "2025-12-26T16:04:11.238648", "type": "agent", "content": null}, "64": {"id": "ProfilerAgent", "name": "ProfilerAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.profiler", "component_class": "ProfilerAgent", "class_name": "ProfilerAgent", "registered_at": "2025-12-26T16:04:11.243183", "type": "agent", "content": null}, "65": {"id": "LogicianAgent", "name": "LogicianAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.logician", "component_class": "LogicianAgent", "class_name": "LogicianAgent", "registered_at": "2025-12-26T16:04:11.248398", "type": "agent", "content": null}, "66": {"id": "LogicalFalsifierAgent", "name": "LogicalFalsifierAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.critics", "component_class": "LogicalFalsifierAgent", "class_name": "LogicalFalsifierAgent", "registered_at": "2025-12-26T16:04:11.253142", "type": "agent", "content": null}, "67": {"id": "FactualOverseerAgent", "name": "FactualOverseerAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.critics", "component_class": "FactualOverseerAgent", "class_name": "FactualOverseerAgent", "registered_at": "2025-12-26T16:04:11.258145", "type": "agent", "content": null}, "68": {"id": "CausalAnalystAgent", "name": "CausalAnalystAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.critics", "component_class": "CausalAnalystAgent", "class_name": "CausalAnalystAgent", "registered_at": "2025-12-26T16:04:11.261605", "type": "agent", "content": null}, "69": {"id": "PerformativityDetectorAgent", "name": "PerformativityDetectorAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.critics", "component_class": "PerformativityDetectorAgent", "class_name": "PerformativityDetectorAgent", "registered_at": "2025-12-26T16:04:11.268309", "type": "agent", "content": null}, "70": {"id": "ArchivistAgent", "name": "ArchivistAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.archivist", "component_class": "ArchivistAgent", "class_name": "ArchivistAgent", "registered_at": "2025-12-26T16:04:11.272534", "type": "agent", "content": null}, "71": {"id": "JudgeAgent", "name": "JudgeAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.judge", "component_class": "JudgeAgent", "class_name": "JudgeAgent", "registered_at": "2025-12-26T16:04:11.278349", "type": "agent", "content": null}, "72": {"id": "CoachAgent", "name": "CoachAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.coach", "component_class": "CoachAgent", "class_name": "CoachAgent", "registered_at": "2025-12-26T16:04:11.283204", "type": "agent", "content": null}, "73": {"id": "XAIReporterAgent", "name": "XAIReporterAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.xai", "component_class": "XAIReporterAgent", "class_name": "XAIReporterAgent", "registered_at": "2025-12-26T16:04:11.289228", "type": "agent", "content": null}, "74": {"id": "PanelAgent", "name": "PanelAgent", "description": null, "citation": null, "citation_full": null, "module": "backend.agents.panel", "component_class": "PanelAgent", "class_name": "PanelAgent", "registered_at": "2025-12-26T16:04:11.294530", "type": "agent", "content": null}, "75": {"id": "DocumentProcessor", "name": "DocumentProcessor", "description": null, "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": "DocumentProcessor", "registered_at": "now", "type": "processor", "content": null}, "76": {"id": "matrix_standard_v1", "name": "Kognitiivinen Quorum Unified Matrix", "description": "Yhdistetty matriisi: Agency (Prosessi), Synteesi (Lopputulos), Falsification (Laatu).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "evaluation_matrix", "content": {"criteria": [{"anchors": {"1": "Matkustaja (Tilaa): Passiivinen tilaaja. 'Tee essee aiheesta X'. Hyv\u00e4ksyy ensimm\u00e4isen version. Ulkoistaa ajattelun.", "2": "Kartanlukija (Korjaa): Reaktiivinen toiminta. Ep\u00e4m\u00e4\u00e4r\u00e4inen aloitus, korjaa vasta j\u00e4lkik\u00e4teen ('Ei noin, vaan n\u00e4in').", "3": "Kuski (Ohjaa): K\u00e4ytt\u00e4j\u00e4 tiet\u00e4\u00e4 mit\u00e4 haluaa ja asettaa reunaehdot. Korjaa suuntaa aktiivisesti, jos teko\u00e4ly poikkeaa.", "4": "Arkkitehti (Suunnittelee): K\u00e4ytt\u00e4j\u00e4 on purkanut ongelman osiin (Decomposition) ENNEN ensimm\u00e4ist\u00e4 promptia. Prosessi on suunniteltu ketju."}, "id": "agency", "instruction": "Onko k\u00e4ytt\u00e4j\u00e4ll\u00e4 suunnitelma vai reagoiko h\u00e4n vain?", "label": "Strateginen Ohjaus (Agency)"}, {"anchors": {"1": "Ei uutta tietoa. Lopputuote on vain tiivistelm\u00e4 tai kopio l\u00e4hdemateriaalista ilman omaa panosta.", "2": "Heikko synteesi. Yhdistelee asioita mekaanisesti. Ei uusia oivalluksia tai k\u00e4sitteit\u00e4.", "3": "Vahva synteesi. Teko\u00e4ly on tuottanut uudenlaisen kokonaisuuden k\u00e4ytt\u00e4j\u00e4n ohjauksessa. Selke\u00e4 lis\u00e4arvo.", "4": "Transformatiivinen. 'Supermegatrendi'-tason oivallus. Lopputulos on enemm\u00e4n kuin osiensa summa ja aidosti uutta tietoa."}, "id": "synteesi", "instruction": "Luoako k\u00e4ytt\u00e4j\u00e4 uutta tietoa teko\u00e4lyn avulla vai vain kierr\u00e4tt\u00e4\u00e4k\u00f6 vanhaa?", "label": "Uuden Tiedon Luominen (Synteesi)"}, {"anchors": {"1": "Sokea: Sokea luottamus. Kopioi hallusinaatiot suoraan lopputuotteeseen.", "2": "Hyv\u00e4ksyv\u00e4: Kehuu teko\u00e4ly\u00e4 ('Hyv\u00e4!') vaikka vastauksessa olisi puutteita. Korjaukset vain tyylillisi\u00e4.", "3": "Korjaava: Huomaa selke\u00e4t virheet ja pyyt\u00e4\u00e4 korjausta.", "4": "Adversariaalinen: Testaa rajoja ('Etsi virheet'). Spottaa faktavirheet ja pakottaa korjaamaan l\u00e4hteisiin viitaten."}, "id": "falsification", "instruction": "Miten k\u00e4ytt\u00e4j\u00e4 reagoi virheisiin ja haastaako h\u00e4n teko\u00e4ly\u00e4?", "label": "Kriittinen Iteraatio (Falsification)"}], "description": "Yhdistetty matriisi: Agency (Prosessi), Synteesi (Lopputulos), Falsification (Laatu).", "name": "Kognitiivinen Quorum Unified Matrix", "role_description": "Toimit J\u00e4rjestelm\u00e4n Tuomarina. Arvioi sek\u00e4 prosessia ett\u00e4 lopputulosta.", "scale": {"max": 100, "min": 1}}}, "77": {"id": "matrix_cognitive_v2", "name": "Kognitiivinen Quorum Unified Matrix", "description": "Yhdistetty matriisi: Agency (Prosessi), Synteesi (Lopputulos), Falsification (Laatu).", "citation": null, "citation_full": null, "module": null, "component_class": null, "class_name": null, "registered_at": null, "type": "evaluation_matrix", "content": {"criteria": [{"anchors": {"1": "Matkustaja (Tilaa): Passiivinen tilaaja. 'Tee essee aiheesta X'. Hyv\u00e4ksyy ensimm\u00e4isen version. Ulkoistaa ajattelun.", "2": "Kartanlukija (Korjaa): Reaktiivinen toiminta. Ep\u00e4m\u00e4\u00e4r\u00e4inen aloitus, korjaa vasta j\u00e4lkik\u00e4teen ('Ei noin, vaan n\u00e4in').", "3": "Kuski (Ohjaa): K\u00e4ytt\u00e4j\u00e4 tiet\u00e4\u00e4 mit\u00e4 ha