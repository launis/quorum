{
  "id": "comprehensive_audit_v1",
  "description": "Full audit workflow including Safety, Context, Analysis, Critique, Judgment, Coaching, and Reporting.",
  "steps": [
    {
      "id": "check_safety",
      "task_key": "guard",
      "inputs": {
        "history_text": "$inputs.history_text",
        "product_text": "$inputs.product_text",
        "reflection_text": "$inputs.reflection_text"
      }
    },
    {
      "id": "fetch_context",
      "task_key": "retrieve_context",
      "inputs": {
        "organization_id": "$inputs.organization_id"
      }
    },
    {
      "id": "analyze",
      "task_key": "analyst",
      "inputs": {
        "history_text": "$check_safety.sanitized_inputs.history_text",
        "product_text": "$check_safety.sanitized_inputs.product_text",
        "reflection_text": "$check_safety.sanitized_inputs.reflection_text",
        "precedents_summary": "$fetch_context.precedents"
      }
    },
    {
      "id": "panel_review",
      "task_key": "panel",
      "inputs": {
        "metadata": "$analyze.metadata",
        "reasoning_trace": "$analyze.reasoning_trace",
        "metodologinen_loki": "$analyze.metodologinen_loki",
        "edellisen_vaiheen_validointi": "$analyze.edellisen_vaiheen_validointi",
        "semanttinen_tarkistussumma": "$analyze.semanttinen_tarkistussumma",
        "hypoteesit": "$analyze.hypoteesit",
        "rag_todisteet": "$analyze.rag_todisteet"
      }
    },
    {
      "id": "adjudicate",
      "task_key": "judge",
      "inputs": {
        "analysis": "$analyze",
        "critique": "$panel_review"
      }
    },
    {
      "id": "coach_plan",
      "task_key": "coach",
      "inputs": {
        "judgment": "$adjudicate"
      }
    },
    {
      "id": "generate_report",
      "task_key": "reporter",
      "inputs": {
        "analysis": "$analyze",
        "critique": "$panel_review",
        "judgment": "$adjudicate",
        "plan": "$coach_plan"
      }
    }
  ]
}
