{"system_config": {"1": {"id": "model_registry", "slug": "config_model_registry", "type": "model_registry", "models": {"deep": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.5, "tpm_limit": 100000, "rpm_limit": 10, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "GEMINI_JSON"}, "fast": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.1, "tpm_limit": 100000, "rpm_limit": 15, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "GEMINI_JSON"}, "search": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.0, "tpm_limit": 100000, "rpm_limit": 15, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "GEMINI_JSON"}, "precise": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.2, "tpm_limit": 100000, "rpm_limit": 10, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "GEMINI_JSON"}, "strict": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.0, "tpm_limit": 100000, "rpm_limit": 10, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "GEMINI_JSON"}}}}, "workflows": {"1": {"id": "workflow_courtroom_20_full_audit", "slug": "workflow_courtroom_20_full_audit", "name": {"default_locale": "fi", "translations": {"fi": "Courtroom 2.0 (Full Audit)"}}, "description": {"default_locale": "fi", "translations": {"fi": "Enhanced 12-step audit chain with Profiler, Archivist, and Coach."}}, "status": "draft", "version": 1, "is_public": false, "organization_id": null, "scoring_logic": [], "ui_schema": {}, "expected_inputs": [{"input_key": "product_text", "label": {"default_locale": "fi", "translations": {"fi": "Lopputuote", "en": "Product"}}, "required": false, "is_chat_history": false, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 lopputuote (esim. PDF muodossa).", "en": "Attach Product (e.g. as PDF)."}}, "ai_description": {"default_locale": "fi", "translations": {"fi": "T\u00e4m\u00e4 on lopputuotteen dokumentaatio.", "en": "This is the final product documentation."}}, "questionnaire_definition": []}, {"input_key": "chat_log", "label": {"default_locale": "fi", "translations": {"fi": "Keskusteluhistoria", "en": "Chat Log"}}, "required": true, "is_chat_history": true, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 keskusteluhistoria ihmisen ja teko\u00e4lyn v\u00e4lill\u00e4.", "en": "Attach chat log between human and AI."}}, "ai_description": {"default_locale": "fi", "translations": {"fi": "T\u00e4m\u00e4 on j\u00e4sennetty loki k\u00e4ytt\u00e4j\u00e4n ja teko\u00e4lyn v\u00e4lisest\u00e4 dialogista.", "en": "This is the parsed log of the dialogue between user and AI."}}, "questionnaire_definition": []}, {"input_key": "reflection_text", "label": {"default_locale": "fi", "translations": {"fi": "Reflektiodokumentti", "en": "Reflection"}}, "required": false, "is_chat_history": false, "input_modes": ["questionnaire"], "description": {"default_locale": "fi", "translations": {"fi": "Vastaa lyhyesti reflektiokysymyksiin.", "en": "Answer reflection questions briefly."}}, "ai_description": {"default_locale": "fi", "translations": {"fi": "T\u00e4m\u00e4 on k\u00e4ytt\u00e4j\u00e4n vapaamuotoinen reflektio.", "en": "This is the user's free-form reflection."}}, "questionnaire_definition": [{"question_id": "ref1", "question": {"default_locale": "fi", "translations": {"fi": "Mik\u00e4 oli mielest\u00e4si onnistuneinta t\u00e4ss\u00e4 vuorovaikutuksessa?", "en": "What do you think was the most successful part of this interaction?"}}, "type": "text"}, {"question_id": "ref2", "question": {"default_locale": "fi", "translations": {"fi": "Mit\u00e4 tekisit toisin ensi kerralla?", "en": "What would you do differently next time?"}}, "type": "text"}]}], "steps": [{"id": "step_input_processing", "task_blueprint": "step_input_processing", "depends_on": [], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_guard", "task_blueprint": "step_guard", "depends_on": ["step_input_processing"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_analyst", "task_blueprint": "step_analyst", "depends_on": ["step_guard"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_profiler", "task_blueprint": "step_profiler", "depends_on": ["step_guard"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "precise"}, {"id": "step_logician", "task_blueprint": "step_logician", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "strict"}, {"id": "step_falsifier", "task_blueprint": "step_falsifier", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "strict"}, {"id": "step_causal_analyst", "task_blueprint": "step_causal_analyst", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "deep"}, {"id": "step_performativity_detector", "task_blueprint": "step_performativity_detector", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "precise"}, {"id": "step_overseer", "task_blueprint": "step_overseer", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "strict"}, {"id": "step_archivist", "task_blueprint": "step_archivist", "depends_on": ["step_guard"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_judge", "task_blueprint": "step_judge", "depends_on": ["step_guard", "step_analyst", "step_profiler", "step_logician", "step_falsifier", "step_causal_analyst", "step_performativity_detector", "step_overseer", "step_archivist"], "input_mappings": {"inputs": "$inputs", "step_guard": "$step_guard", "step_analyst": "$step_analyst", "step_profiler": "$step_profiler", "step_logician": "$step_logician", "step_falsifier": "$step_falsifier", "step_causal": "$step_causal", "step_detector": "$step_detector", "step_overseer": "$step_overseer", "step_archivist": "$step_archivist"}, "model_strategy": "precise"}, {"id": "step_coach", "task_blueprint": "step_coach", "depends_on": ["step_judge", "step_analyst", "step_profiler", "step_logician", "step_falsifier", "step_causal_analyst"], "input_mappings": {"inputs": "$inputs", "step_judge": "$step_judge", "step_analyst": "$step_analyst", "step_profiler": "$step_profiler", "step_logician": "$step_logician", "step_falsifier": "$step_falsifier", "step_causal_analyst": "$step_causal_analyst"}, "model_strategy": "precise"}, {"id": "step_xai_reporter", "task_blueprint": "step_xai_reporter", "depends_on": ["step_judge", "step_analyst", "step_profiler", "step_logician", "step_falsifier", "step_causal_analyst"], "input_mappings": {"inputs": "$inputs", "step_judge": "$step_judge", "step_analyst": "$step_analyst", "step_profiler": "$step_profiler", "step_logician": "$step_logician", "step_falsifier": "$step_falsifier", "step_causal_analyst": "$step_causal_analyst"}, "model_strategy": "fast"}]}}, "prompt_blocks": {"1": {"id": "matrix_toulmin", "label": {"default_locale": "fi", "translations": {"fi": "Toulminin Argumentaatio"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi argumentin laatua Toulminin mallin mukaisesti."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 80, "require_justification": true, "theory_grounding": {"source_url": "https://doi.org/10.1017/CBO9780511802034", "citation_reference": "Toulmin, Stephen E. 2003. The uses of argument."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Heikko"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "V\u00e4ite on t\u00e4ysin vailla perusteita."}}, {"default_locale": "fi", "translations": {"fi": "Data ja oikeutus (warrant) puuttuvat."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "V\u00e4ltt\u00e4v\u00e4"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "V\u00e4itteen tueksi esitet\u00e4\u00e4n jotain ekspliittist\u00e4 dataa."}}, {"default_locale": "fi", "translations": {"fi": "Looginen silta (warrant) datan ja v\u00e4itteen v\u00e4lill\u00e4 puuttuu tai on irrallinen."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Kohtalainen"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "V\u00e4itteell\u00e4 on perusteita, mutta oikeutus on hatara."}}, {"default_locale": "fi", "translations": {"fi": "Vastav\u00e4itteit\u00e4 (rebuttal) ei ole huomioitu."}}]}, {"score": 4, "name": {"default_locale": "fi", "translations": {"fi": "Hyv\u00e4"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Looginen silta (warrant) on kest\u00e4v\u00e4 ja kytkee datan v\u00e4itteeseen vahvasti."}}, {"default_locale": "fi", "translations": {"fi": "Taustaoletuksia ja poikkeuksia on puitu jossain m\u00e4\u00e4rin."}}]}, {"score": 5, "name": {"default_locale": "fi", "translations": {"fi": "Vahva"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "V\u00e4ite on vahvasti perusteltu datalla ja kest\u00e4v\u00e4ll\u00e4 oikeutuksella."}}, {"default_locale": "fi", "translations": {"fi": "Mahdolliset vastav\u00e4itteet on k\u00e4sitelty uskottavasti ja asiantuntevasti."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Argumentaation laatu"}}], "columns": null}, "2": {"id": "matrix_bloom", "label": {"default_locale": "fi", "translations": {"fi": "Bloomin Taksonomia"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi kognitiivista syvyytt\u00e4 Bloomin taksonomian perusteella."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 60, "require_justification": true, "theory_grounding": {"source_url": "https://www.jstor.org/stable/j.ctt1v2xv4", "citation_reference": "Anderson, Lorin W. & Krathwohl, David R. (toim.) 2001."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Muistaminen"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 vain toistaa opittua tietoa implikoimatta ymm\u00e4rryst\u00e4."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Ymm\u00e4rt\u00e4minen"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 osaa hieman soveltaa ja uudelleenmuotoilla omin sanoin."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Soveltaminen"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 k\u00e4ytt\u00e4\u00e4 opittua tietoa konkreettisesti uusissa tilanteissa."}}]}, {"score": 4, "name": {"default_locale": "fi", "translations": {"fi": "Analysointi"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 erittelee osia ja paljastaa piilevi\u00e4 suhteita tiedon v\u00e4lill\u00e4."}}]}, {"score": 5, "name": {"default_locale": "fi", "translations": {"fi": "Arviointi"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 kykenee loogisesti perusteltuihin arvoasetelmiin teorioiden v\u00e4lill\u00e4."}}]}, {"score": 6, "name": {"default_locale": "fi", "translations": {"fi": "Luominen"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 syntetisoi uutta alkuper\u00e4ist\u00e4 ajattelua."}}, {"default_locale": "fi", "translations": {"fi": "Tuotos ylitt\u00e4\u00e4 selv\u00e4sti annetun koulutusraamin asettaen uuden standardin."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Kognitiivinen syvyys"}}], "columns": null}, "3": {"id": "matrix_kahneman", "label": {"default_locale": "fi", "translations": {"fi": "Kahnemanin Ajattelumallit"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi ajattelun hitautta tai nopeutta (System 1 vs System 2)."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 50, "require_justification": true, "theory_grounding": {"source_url": "https://us.macmillan.com/books/9780374533557", "citation_reference": "Kahneman, Daniel 2011."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Systeemi 1 (Nopea)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 tekee tiedostamattomia, intuition ohjaamia havaintoja."}}, {"default_locale": "fi", "translations": {"fi": "P\u00e4\u00e4ttely sis\u00e4lt\u00e4\u00e4 todenn\u00e4k\u00f6isesti vahvistusvinoumaa tai halo-efekti\u00e4."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Siirtym\u00e4"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 yritt\u00e4\u00e4 hidastaa ja kyseenalaistaa intuitiota, mutta saattaa yh\u00e4 sortua osin heuristiikkaan."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Systeemi 2 (Hidas)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 analysoi systemaattisesti ja pohtii laiskasti piilotettuja vaihtoehtoja tarkkaan."}}, {"default_locale": "fi", "translations": {"fi": "Kognitiivinen ponnistus ja tietoinen hidastaminen n\u00e4kyy tekstin laadussa."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Ajattelun modaliteetti"}}], "columns": null}, "4": {"id": "matrix_goodhart", "label": {"default_locale": "fi", "translations": {"fi": "Performatiivisuus"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi mittarin ja tavoitteen v\u00e4\u00e4ristym\u00e4\u00e4."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 70, "require_justification": true, "theory_grounding": {"source_url": "https://www.cna.org/reports/2022/09/", "citation_reference": "Stumborg, Michael F. ym. 2022. Goodhart's law."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Sokea usko"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 uskoo teko\u00e4lyn ensimm\u00e4iseen analyysiin sokeasti eik\u00e4 huomaa edes ilmeisi\u00e4 logiikkavirheit\u00e4."}}, {"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 toimii passiivisena matkustajana prosessissa."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Reaktiivinen huomioija"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 korjaa selkeit\u00e4 faktavirheit\u00e4, mutta jatkaa mittareiden ja suoritustapojen uskomista kyseenalaistamatta."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Pintapuolinen"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 huomaa virheet ja pyyt\u00e4\u00e4 korjausta, mutta tyytyy pintapuoliseen ehostukseen."}}, {"default_locale": "fi", "translations": {"fi": "Ohjaa teko\u00e4ly\u00e4 oireiden, ei juurisyiden, korjaamiseen."}}]}, {"score": 4, "name": {"default_locale": "fi", "translations": {"fi": "Kriittinen ohjaaja"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 kyseenalaistaa aktiivisesti mittarin luotettavuuden suhteessa perimm\u00e4iseen tavoitteeseen."}}]}, {"score": 5, "name": {"default_locale": "fi", "translations": {"fi": "Aktiivinen haastaja"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 etsii aktiivisesti virheit\u00e4, haastaa teko\u00e4lyn logiikkaa ja vaatii perustavaa laatua olevia korjauksia ja todisteita."}}, {"default_locale": "fi", "translations": {"fi": "Toimii ehdottomana prosessin ajajana delegoidakseen vain suoritettavan ty\u00f6n."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Performativiteetti ja ajaminen"}}], "columns": null}, "5": {"id": "matrix_input_processing", "label": {"default_locale": "fi", "translations": {"fi": "Input Processing"}}, "description": {"default_locale": "fi", "translations": {"fi": "Teht\u00e4v\u00e4si on k\u00e4sitell\u00e4 raakatiedot ja sy\u00f6tteet (Input Processing). Poista kohina, j\u00e4senn\u00e4 olennaiset v\u00e4itteet ja valmistele data selke\u00e4\u00e4n, analysoitavaan formaattiin seuraavia vaiheita varten."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "6": {"id": "matrix_analyst", "label": {"default_locale": "fi", "translations": {"fi": "Analyst"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Analyytikko (Analyst). Teht\u00e4v\u00e4si on k\u00e4sitell\u00e4 tietoa puolueettomasti, etsi\u00e4 syy-seuraussuhteita ja muodostaa selke\u00e4, j\u00e4sennelty katsaus k\u00e4sitelt\u00e4v\u00e4st\u00e4 materiaalista."}}, "category_id": "agent_role", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "7": {"id": "matrix_archivist", "label": {"default_locale": "fi", "translations": {"fi": "Archivist"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Arkistonhoitaja (Archivist). Teht\u00e4v\u00e4si on peilata teko\u00e4lyn toimintaa organisaation aikaisempiin (Precedent) linjauksiin ja ohjeisiin. Varmista s\u00e4\u00e4nt\u00f6jenmukaisuus ja Stare Decisis -periaatteen toteutuminen."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://plato.stanford.edu/entries/legal-positivism/", "citation_reference": "Dworkin, R. (1986). Law's Empire. (Stare Decisis, Precedent and Organizational Integrity)."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Kriittisesti Poikkeava (Critically Misaligned)", "en": "Critically Misaligned"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Toiminta on t\u00e4ysin satunnaista 'Brute Force' -yritt\u00e4mist\u00e4.", "en": "Action is completely random brute force trial and error."}}, {"default_locale": "fi", "translations": {"fi": "Ei mink\u00e4\u00e4nlaista systemaattista prosessia tai ohjausmallia.", "en": "No systematic process or steering model exists."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Poikkeava (Misaligned)", "en": "Misaligned"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Yksitt\u00e4isi\u00e4 hyvi\u00e4 k\u00e4yt\u00e4nt\u00f6j\u00e4 n\u00e4ht\u00e4viss\u00e4, mutta kokonaisuus on ohjaamaton.", "en": "Individual good practices visible but overall unguided."}}, {"default_locale": "fi", "translations": {"fi": "Vastoin yleisi\u00e4 ohjeistuksia toistuvasti.", "en": "Repeatedly goes against general guidelines."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Neutraali (Neutral)", "en": "Neutral"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Noudattaa jonkinlaista perusprosessia, muttei hy\u00f6dynn\u00e4 parhaita k\u00e4yt\u00e4nt\u00f6j\u00e4.", "en": "Follows a basic process but does not utilize best practices."}}, {"default_locale": "fi", "translations": {"fi": "T\u00e4ytt\u00e4\u00e4 minimivaatimukset ohjattavuudelle.", "en": "Meets minimum requirements for steerability."}}]}, {"score": 4, "name": {"default_locale": "fi", "translations": {"fi": "Linjassa (Aligned)", "en": "Aligned"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4\u00e4 aktiivisesti j\u00e4senneltyj\u00e4 ohjausmalleja (esim. selke\u00e4t roolit ja rajoitteet).", "en": "Actively uses structured steering models (e.g. clear roles and constraints)."}}, {"default_locale": "fi", "translations": {"fi": "Prosessimainen ja loogisesti etenev\u00e4 vuorovaikutustapa.", "en": "Process-oriented and logically advancing interaction method."}}]}, {"score": 5, "name": {"default_locale": "fi", "translations": {"fi": "Vahvasti Linjassa (Strongly Aligned)", "en": "Strongly Aligned"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Toiminta edustaa 'State of the Art' -tasoa teko\u00e4lyn ohjaamisessa.", "en": "Action represents State of the Art level in AI steering."}}, {"default_locale": "fi", "translations": {"fi": "T\u00e4ydellinen best practices -noudattaminen, mukaan lukien rajoitusten testaus.", "en": "Perfect adherence to best practices, including constraint testing."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Best Practices -yhteensopivuus", "en": "Best Practices Compliance"}}], "columns": null}, "8": {"id": "matrix_causal_analyst", "label": {"default_locale": "fi", "translations": {"fi": "Causal Analyst"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Kausaalinen Analyytikko (Causal Analyst). Teht\u00e4v\u00e4si on tunnistaa syy-seuraussuhteet, rakentaa kontrafaktuaalisia (mit\u00e4 jos) skenaarioita ja arvioida v\u00e4itteiden uskottavuutta."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://plato.stanford.edu/entries/causal-models/", "citation_reference": "Pearl, J., & Mackenzie, D. (2018). The Book of Why: The New Science of Cause and Effect."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Mahdoton (Impossible)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "T\u00e4ysi Post Hoc Ergo Propter Hoc -virhe. Tulos ei johdu esitetyst\u00e4 syyst\u00e4."}}, {"default_locale": "fi", "translations": {"fi": "Ilman ohjausta teko\u00e4ly olisi tuottanut saman tai paremman tuloksen."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Mahdollinen (Plausible)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Korrelaatio on olemassa. K\u00e4ytt\u00e4j\u00e4 teki ohjauksen ja tulos oli sen mukainen."}}, {"default_locale": "fi", "translations": {"fi": "Ei voida t\u00e4ysin varmistaa, syntyik\u00f6 tulos sattumalta vai tarkoituksella."}}]}, {"score": 5, "name": {"default_locale": "fi", "translations": {"fi": "Aito (Genuine)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Suora ja kiistaton syy-seuraussuhde (Causal Link)."}}, {"default_locale": "fi", "translations": {"fi": "Vastafaktuaalinen testi osoittaa: ilman k\u00e4ytt\u00e4j\u00e4n tarkkaa ohjausta tulos olisi j\u00e4\u00e4nyt saavuttamatta."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Kausaalinen Uskottavuus"}}], "columns": null}, "9": {"id": "matrix_coach", "label": {"default_locale": "fi", "translations": {"fi": "Coach"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Valmentaja (Coach). Teht\u00e4v\u00e4si on antaa rakentavaa palautetta, tukea kognitiivista kehityst\u00e4 ja ohjata k\u00e4ytt\u00e4j\u00e4\u00e4 tai toista agenttia kohti parempia ja syv\u00e4llisempi\u00e4 ratkaisuja."}}, "category_id": "agent_role", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "10": {"id": "matrix_falsifier", "label": {"default_locale": "fi", "translations": {"fi": "Falsifier"}}, "description": {"default_locale": "fi", "translations": {"fi": "Laske 'Critical Distance Score' (1-4) aineiston perusteella."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://plato.stanford.edu/entries/popper/", "citation_reference": "Popper, K. (1963). Conjectures and Refutations: The Growth of Scientific Knowledge. (Falsification principle & Anti-Sycophancy)."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "My\u00f6t\u00e4ilyvinouma (Sycophancy)", "en": "Sycophancy Bias"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 on 'Jees-mies'. Hyv\u00e4ksyi teko\u00e4lyn ensimm\u00e4isen vastauksen sokeasti.", "en": "User is a 'Yes-man'. Blindly accepted the AI's first answer."}}, {"default_locale": "fi", "translations": {"fi": "Ei yht\u00e4k\u00e4\u00e4n korjausliikett\u00e4 tai vastalauseen ('Ei, vaan...') esitt\u00e4mist\u00e4.", "en": "Not a single corrective move or objection ('No, instead...') presented."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Kosmeettinen Korjaaja (Aesthetic)", "en": "Aesthetic Corrector"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 pyysi muutoksia, mutta ne olivat vain pintapuolisia (esim. lyhennys tai s\u00e4vy).", "en": "User requested changes, but they were only superficial (e.g. shortening or tone)."}}, {"default_locale": "fi", "translations": {"fi": "Sis\u00e4lt\u00f6\u00e4 ja alkuper\u00e4ist\u00e4 logiikkaa ei haastettu.", "en": "Content and initial logic were not challenged."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Substanssin Haastaja (Substantive)", "en": "Substantive Challenger"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 etsi aktiivisesti loogisia virheit\u00e4 tai pyysi teko\u00e4ly\u00e4 perustelemaan jonkin tietyn v\u00e4itteen.", "en": "User actively looked for logical errors or asked the AI to justify a specific claim."}}, {"default_locale": "fi", "translations": {"fi": "Popperilainen iteraatiosilmukka (kumoamisyritys) l\u00f6ytyi aineistosta.", "en": "Popperian iteration loop (attempted refutation) found in the material."}}]}, {"score": 4, "name": {"default_locale": "fi", "translations": {"fi": "Armoton Falsifioija (Popperian)", "en": "Ruthless Falsifier"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 yritti koko painollaan rikkoa teko\u00e4lyn mallin sy\u00f6tt\u00e4m\u00e4ll\u00e4 vasta-argumentteja ja haastamalla oletuksia.", "en": "User tried with full force to break the AI's model by feeding counter-arguments and challenging assumptions."}}, {"default_locale": "fi", "translations": {"fi": "Tieteellisen tiedonhankinnan mestariluokka.", "en": "Masterclass in scientific knowledge acquisition."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Critical Distance Score"}}], "columns": null}, "11": {"id": "matrix_guard", "label": {"default_locale": "fi", "translations": {"fi": "Guard"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Turva-agentti (Guard). Teht\u00e4v\u00e4si on valvoa sy\u00f6tteit\u00e4 ja tulosteita eettisten j\u00e4nnitteiden, tietoturvauhkien ja asenteellisuuksien (bias) varalta."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "12": {"id": "matrix_judge", "label": {"default_locale": "fi", "translations": {"fi": "Judge"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Tuomari (Judge). Teht\u00e4v\u00e4si on arvioida aiemmin tuotettu todistusaineisto ja analyysit kokonaisuutena. Anna lopullinen, perusteltu ja puolueeton tuomio."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://global.oup.com/academic/product/the-fourth-revolution-9780199606726", "citation_reference": "Floridi, L. (2014). The Fourth Revolution: How the Infosphere is Reshaping Human Reality. (Human-in-the-loop vs. Human-on-the-loop agency)."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "T\u00e4ysi Matkustaja (Hyl\u00e4tty)", "en": "Passenger (Rejected)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Ei mink\u00e4\u00e4nlaista laadunvarmistusta: l\u00e4pi meni faktavirheit\u00e4, RFI-menetelm\u00e4\u00e4 ei k\u00e4ytetty ja ohjaus oli satunnaista.", "en": "No quality assurance: factual errors passed, RFI not used, guidance was random."}}, {"default_locale": "fi", "translations": {"fi": "Kruununjalokiven rikkomus (Knowledge Base -s\u00e4\u00e4nt\u00f6jen ignorointi) havaittu.", "en": "Critical Violation (ignored Knowledge Base rules) detected."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Matkustaja (Heikko)", "en": "Passenger (Weak)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 yritti ohjata, mutta antoi teko\u00e4lyn arvata liikaa asioita itsekseen.", "en": "User attempted to guide but let the AI guess too much on its own."}}, {"default_locale": "fi", "translations": {"fi": "Forensinen ristiriita aineistossa havaittu (Say-Do Gap).", "en": "Forensic conflict detected in material (Say-Do Gap)."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Navigaattori (Tyydytt\u00e4v\u00e4)", "en": "Navigator (Satisfactory)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Keskiverto ohjaus. Teko\u00e4ly teki osittain aloitteita, mutta vahinkoa ei syntynyt.", "en": "Average guidance. AI took partial initiative, but no harm was done."}}, {"default_locale": "fi", "translations": {"fi": "Matkustajarooli ja Kuljettajarooli vaihtelevat aineiston sis\u00e4ll\u00e4.", "en": "Passenger and Driver roles alternate within the material."}}]}, {"score": 4, "name": {"default_locale": "fi", "translations": {"fi": "Kuljettaja (Hyv\u00e4)", "en": "Driver (Good)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 k\u00e4ytti RFI-protokollaa, varmisti ohjeiden noudattamisen ja pakotti teko\u00e4lyn kysym\u00e4\u00e4n tarkennuksia.", "en": "User utilized RFI, monitored instruction compliance, and forced the AI to ask clarifications."}}, {"default_locale": "fi", "translations": {"fi": "Ei faktavirheit\u00e4. Iteratiivinen ohjaus toimii.", "en": "No factual errors. Iterative guidance is functional."}}]}, {"score": 5, "name": {"default_locale": "fi", "translations": {"fi": "Arkkitehti (Erinomainen)", "en": "Architect (Excellent)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "T\u00e4ydellinen hallinta (Input/Control Ratio erinomainen). K\u00e4ytt\u00e4j\u00e4 rakentaa systeemej\u00e4 eik\u00e4 j\u00e4t\u00e4 mit\u00e4\u00e4n teko\u00e4lyn arvattavaksi.", "en": "Perfect control (Excellent Input/Control Ratio). User builds systems and leaves nothing for AI to guess."}}, {"default_locale": "fi", "translations": {"fi": "Korkeimman tason asiantuntijuus. Ei hallusinaatioita, t\u00e4ysi l\u00e4pin\u00e4kyvyys suorituksessa.", "en": "Highest level of expertise. No hallucinations, full transparency in execution."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Lopullinen Tuomioasteikko"}}], "columns": null}, "13": {"id": "matrix_logician", "label": {"default_locale": "fi", "translations": {"fi": "Logician"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Loogikko (Logician). Teht\u00e4v\u00e4si on purkaa argumentit niiden loogisiin osiin (v\u00e4ite, peruste, oikeutus) Toulminin mallin mukaisesti ja arvioida p\u00e4\u00e4ttelyn p\u00e4tevyys."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "14": {"id": "matrix_overseer", "label": {"default_locale": "fi", "translations": {"fi": "Overseer"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Valvoja (Overseer). Teht\u00e4v\u00e4si on koordinoida muita agentteja, valvoa ty\u00f6nkulun etenemist\u00e4 ja vastata siit\u00e4, ett\u00e4 lopullinen tuotos on linjassa alkuper\u00e4isen tavoitteen kanssa."}}, "category_id": "agent_role", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "15": {"id": "matrix_profiler", "label": {"default_locale": "fi", "translations": {"fi": "Profiler"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Profiloija (Profiler). Teht\u00e4v\u00e4si on analysoida tekstin s\u00e4vy\u00e4, piilomerkityksi\u00e4, kirjoittajan intentioita sek\u00e4 psykologista ja kielenk\u00e4yt\u00e4nn\u00f6llist\u00e4 profiilia."}}, "category_id": "agent_role", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "16": {"id": "matrix_xai_reporter", "label": {"default_locale": "fi", "translations": {"fi": "XAI Reporter"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet selitett\u00e4v\u00e4n teko\u00e4lyn raportoija (XAI Reporter). Teht\u00e4v\u00e4si on koota kaikkien aiempien analyysivaiheiden l\u00f6yd\u00f6kset yhdeksi selke\u00e4ksi, l\u00e4pin\u00e4kyv\u00e4ksi ja tiiviiksi synteesiksi, joka nostaa esiin t\u00e4rkeimm\u00e4t huomiot ja vinoumat."}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://www.darpa.mil/program/explainable-artificial-intelligence", "citation_reference": "DARPA XAI Program (2017). Explainable Artificial Intelligence."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 0, "name": {"default_locale": "fi", "translations": {"fi": "Eritt\u00e4in Ep\u00e4varma (0%)", "en": "Extremely Uncertain (0%)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Agenttien analyysit ovat t\u00e4ysin ristiriidassa kesken\u00e4\u00e4n.", "en": "Agent analyses are completely contradictory."}}, {"default_locale": "fi", "translations": {"fi": "Aineistosta on mahdotonta vet\u00e4\u00e4 luotettavia johtop\u00e4\u00e4t\u00f6ksi\u00e4 ohjauksen laadusta.", "en": "Impossible to draw reliable conclusions about guidance quality from the material."}}]}, {"score": 50, "name": {"default_locale": "fi", "translations": {"fi": "Keskivarma (50%)", "en": "Moderately Certain (50%)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Suurin osa agenteista on yksimielisi\u00e4, mutta merkitt\u00e4vi\u00e4 tulkintaep\u00e4selvyyksi\u00e4 on j\u00e4ljell\u00e4.", "en": "Most agents agree, but significant interpretative ambiguities remain."}}, {"default_locale": "fi", "translations": {"fi": "Aineisto tarjoaa osittaiset todisteet p\u00e4\u00e4t\u00f6ksen tueksi.", "en": "The material provides partial evidence to support the decision."}}]}, {"score": 100, "name": {"default_locale": "fi", "translations": {"fi": "T\u00e4ysi Varmuus (100%)", "en": "Complete Certainty (100%)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Kaikki agentit (Archivist, Causal, Performativity) tukevat yksimielisesti t\u00e4sm\u00e4lleen samaa lopputulemaa.", "en": "All agents unanimously support exactly the same outcome."}}, {"default_locale": "fi", "translations": {"fi": "Aineistossa olevat todisteet ('Driver' tai 'Passenger' -k\u00e4ytt\u00e4ytymisest\u00e4) ovat kiistattomat ja selke\u00e4t.", "en": "The evidence in the material regarding 'Driver' or 'Passenger' behavior is indisputable and clear."}}]}], "rows": [{"default_locale": "fi", "translations": {"fi": "Luottamustaso (Confidence Score)"}}], "columns": null}, "17": {"id": "block_headermandates", "label": {"default_locale": "fi", "translations": {"fi": "HEADER_MANDATES"}}, "description": {"default_locale": "fi", "translations": {"fi": "Mandaattiosion erotin. 1. PERUUTTAMATTOMAT M\u00c4\u00c4R\u00c4YKSET (IRREVOCABLE MANDATES)"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "18": {"id": "block_instructionstrictscale", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_STRICT_SCALE"}}, "description": {"default_locale": "fi", "translations": {"fi": "Pakottaa noudattamaan matriisin asteikkoa (Fail Fast). T\u00c4RKE\u00c4\u00c4: Kaikkien pisteiden ON oltava m\u00e4\u00e4ritellyn asteikon (Scale) sis\u00e4ll\u00e4. Sinun on noudatettava asteikon rajoja ehdottomasti. Pisteet alle asteikon minimin tai yli maksimin ovat kiellettyj\u00e4."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "19": {"id": "block_headerrules", "label": {"default_locale": "fi", "translations": {"fi": "HEADER_RULES"}}, "description": {"default_locale": "fi", "translations": {"fi": "S\u00e4\u00e4nt\u00f6osion erotin. 2. OPERATIIVISET S\u00c4\u00c4NN\u00d6T (OPERATIONAL RULES)"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "20": {"id": "block_headerprotocols", "label": {"default_locale": "fi", "translations": {"fi": "HEADER_PROTOCOLS"}}, "description": {"default_locale": "fi", "translations": {"fi": "Ty\u00f6kaluosion erotin. 3. TY\u00d6KALUT JA MENETELM\u00c4T (TOOLS & METHODS)"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "21": {"id": "block_headerinstructions", "label": {"default_locale": "fi", "translations": {"fi": "HEADER_INSTRUCTIONS"}}, "description": {"default_locale": "fi", "translations": {"fi": "TEHT\u00c4V\u00c4NANTO (MISSION INSTRUCTIONS) T\u00c4RKE\u00c4\u00c4: Aloita vastaus AINA t\u00e4ytt\u00e4m\u00e4ll\u00e4 'reasoning_trace' -kentt\u00e4 JSON-objektin alussa. Kirjoita siihen askel askeleelta (Chain-of-Thought), miten analysoit sy\u00f6tteen, ENNEN kuin teet lopullisia johtop\u00e4\u00e4t\u00f6ksi\u00e4 (kuten bool-arvot tai pisteet). T\u00e4m\u00e4 on pakollinen auditointij\u00e4lki. HUOMIO: ARVIOINNIN KOHDE (SCOPE) Keskity arvioimaan nimenomaan ihmisen (k\u00e4ytt\u00e4j\u00e4n) omaa toimintaa, ohjausta ja tavoitteellisuutta koko toimitetussa aineistossa. Mik\u00e4li aineisto sis\u00e4lt\u00e4\u00e4 teko\u00e4lyn generoimaa teksti\u00e4 (esim. chat-lokeissa 'AI' tai 'Assistant' viestit), erota se selke\u00e4sti k\u00e4ytt\u00e4j\u00e4n omasta panoksesta. \u00c4l\u00e4 anna k\u00e4ytt\u00e4j\u00e4lle pisteit\u00e4 teko\u00e4lyn automaattisesti tuottamasta materiaalista. Teht\u00e4v\u00e4si on arvioida k\u00e4ytt\u00e4j\u00e4n promptaus- ja ohjauskyky\u00e4 (Driver vs Passenger), ei j\u00e4rjestelm\u00e4n generointikyky\u00e4."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "22": {"id": "block_mandate2", "label": {"default_locale": "fi", "translations": {"fi": "MANDATE_2"}}, "description": {"default_locale": "fi", "translations": {"fi": "Pakottaa tunnistamaan kognitiiviset vinoumat. Mandaatti 2 (Vinoumien Torjunta): M\u00c4\u00c4R\u00c4YS: Tunnista aktiivisesti 'Confirmation Bias' ja 'Sunk Cost Fallacy'. Jos k\u00e4ytt\u00e4j\u00e4 kehuu huonoa ideaa, vastusta h\u00e4nt\u00e4."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "23": {"id": "block_mandate3", "label": {"default_locale": "fi", "translations": {"fi": "MANDATE_3"}}, "description": {"default_locale": "fi", "translations": {"fi": "Erottaa mestaruuden osaamattomuudesta. Mandaatti 3 (Insin\u00f6\u00f6rim\u00e4inen N\u00f6yryys): M\u00c4\u00c4R\u00c4YS: Arvosta vain perusteltua s\u00e4\u00e4nt\u00f6jen rikkomista ('Mestaruus'). Selitt\u00e4m\u00e4t\u00f6n poikkeama on virhe."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "24": {"id": "block_mandate5", "label": {"default_locale": "fi", "translations": {"fi": "MANDATE_5"}}, "description": {"default_locale": "fi", "translations": {"fi": "K\u00e4\u00e4nt\u00e4\u00e4 todistustaakan: oleta tyhj\u00e4ksi kunnes toisin todistetaan. Mandaatti 5 (Null Hypothesis): L\u00c4HT\u00d6OLETUS: Sy\u00f6te on tyhj\u00e4 ja v\u00e4itteet ovat v\u00e4\u00e4ri\u00e4. Sinun on todistettava* jokainen havainto sitaatilla sy\u00f6tteest\u00e4. Jos et l\u00f6yd\u00e4 suoraa todistetta, tulos on 'Ei havaittu'."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "25": {"id": "block_rule1", "label": {"default_locale": "fi", "translations": {"fi": "RULE_1"}}, "description": {"default_locale": "fi", "translations": {"fi": "Tietoturvaraja. S\u00e4\u00e4nt\u00f6 1 (Luottamuksen Keh\u00e4): M\u00c4\u00c4R\u00c4YS: Luota vain Vartija-agentin (Guard) validoimaan dataan. Hylk\u00e4\u00e4 'tahriintunut' data."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "26": {"id": "block_rule2", "label": {"default_locale": "fi", "translations": {"fi": "RULE_2"}}, "description": {"default_locale": "fi", "translations": {"fi": "Toimivallan rajaus. S\u00e4\u00e4nt\u00f6 2 (Toimivalta): M\u00c4\u00c4R\u00c4YS: Pysy roolissasi. \u00c4l\u00e4 hallusinoi kykyj\u00e4 (esim. live-internet) joita sinulla ei ole."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "27": {"id": "block_rule3", "label": {"default_locale": "fi", "translations": {"fi": "RULE_3"}}, "description": {"default_locale": "fi", "translations": {"fi": "Est\u00e4\u00e4 estetiikkavinouman. S\u00e4\u00e4nt\u00f6 3 (Substanssi Muoto): M\u00c4\u00c4R\u00c4YS: \u00c4l\u00e4 anna pisteit\u00e4 ulkoasusta. Arvioi vain SUBSTANSSIA ja LOGIIKKAA."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "28": {"id": "block_rule4", "label": {"default_locale": "fi", "translations": {"fi": "RULE_4"}}, "description": {"default_locale": "fi", "translations": {"fi": "Turing-testi prosessille. S\u00e4\u00e4nt\u00f6 4 (Ep\u00e4ilytt\u00e4v\u00e4 T\u00e4ydellisyys): M\u00c4\u00c4R\u00c4YS: Jos prosessissa ei ole kitkaa tai iteraatiota, se on ep\u00e4ilytt\u00e4v\u00e4. T\u00e4ydellisyys ilman ty\u00f6t\u00e4 on huijausta."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "29": {"id": "block_rule5", "label": {"default_locale": "fi", "translations": {"fi": "RULE_5"}}, "description": {"default_locale": "fi", "translations": {"fi": "Ep\u00e4varmuuden raportointi. S\u00e4\u00e4nt\u00f6 5 (Hauraus): M\u00c4\u00c4R\u00c4YS: Kirjaa aina 'Episteeminen Ep\u00e4varmuus'. \u00c4l\u00e4 arvaa k\u00e4ytt\u00e4j\u00e4n aikeita."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "30": {"id": "block_rule6", "label": {"default_locale": "fi", "translations": {"fi": "RULE_6"}}, "description": {"default_locale": "fi", "translations": {"fi": "Faktojen ensisijaisuus. S\u00e4\u00e4nt\u00f6 6 (Falsifiointi): M\u00c4\u00c4R\u00c4YS: Faktavirhe kumoaa hyv\u00e4n retoriikan. Totuus on t\u00e4rke\u00e4mpi kuin tyyli."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "31": {"id": "block_globalcontext", "label": {"default_locale": "fi", "translations": {"fi": "J\u00e4rjestelm\u00e4n Aikaleima ja Sijainti"}}, "description": {"default_locale": "fi", "translations": {"fi": "J\u00c4RJESTELM\u00c4KONTEKSTI (SYSTEM CONTEXT) NYKYHETKI: {{CURRENT_DATE}}. KELLONAIKA: {{DYNAMIC_TIME}}. {{DYNAMIC_LOCATION}} ROOLI: Toimit 'Cognitive Quorum' -auditointij\u00e4rjestelm\u00e4n moottorina. AIKA-ANKKURI: Tiedosta, ett\u00e4 toimit NYT, t\u00e4ss\u00e4 hetkess\u00e4 ({{CURRENT_DATE}}). Koulutusdatasi 'Knowledge Cutoff' on historiaa. Arvioi kaikkia teknologioita ja v\u00e4itteit\u00e4 t\u00e4st\u00e4 ajankohdasta k\u00e4sin. AUDITOITAVA AINEISTO (INPUT DATA) Alla on k\u00e4ytt\u00e4j\u00e4n toimittama dynaaminen aineisto auditointia varten. Aineisto on toimitettu JSON-muodossa. Huomioi kunkin aineiston ohessa toimitettu roolikuvaus (role_description) ymm\u00e4rt\u00e4\u00e4ksesi dokumentin luonteen (esim. onko kyseess\u00e4 loki, lopputuote vai k\u00e4ytt\u00e4j\u00e4n itsearviointi). K\u00e4sittele kaikkea saatavilla olevaa aineistoa yhten\u00e4 kokonaisuutena. [SY\u00d6TTEET_ALKU] {{INPUTS_JSON}} [SY\u00d6TTEET_LOPPU]"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "32": {"id": "block_oprule1", "label": {"default_locale": "fi", "translations": {"fi": "OP_RULE_1"}}, "description": {"default_locale": "fi", "translations": {"fi": "Sanktio hallusinaatioista. EROTTELU 1: Faktatarkkuus. Hallusinaatio = Automaattinen pistev\u00e4hennys."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "33": {"id": "block_oprule2", "label": {"default_locale": "fi", "translations": {"fi": "OP_RULE_2"}}, "description": {"default_locale": "fi", "translations": {"fi": "EROTTELU 2: Aitous. Jos aineisto (esim. lopputuote) on yli 80 % teko\u00e4lyn kirjoittamaa ilman todistettavaa k\u00e4ytt\u00e4j\u00e4n ohjausta tai merkitt\u00e4v\u00e4\u00e4 omaa panosta, kyseess\u00e4 on pelkk\u00e4 automaation hy\u00f6dynt\u00e4minen (Matkustaja-taso), ei aito asiantuntijuus."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "34": {"id": "block_oprule3", "label": {"default_locale": "fi", "translations": {"fi": "OP_RULE_3"}}, "description": {"default_locale": "fi", "translations": {"fi": "EROTTELU 3: Todisteet. Erota toisistaan se, mit\u00e4 k\u00e4ytt\u00e4j\u00e4 todistettavasti teki (empiirinen aineisto/lokit/promptit), ja mit\u00e4 h\u00e4n vain v\u00e4itt\u00e4\u00e4 tehneens\u00e4 (esim. erillinen itsearviointi tai reflektio). Arvioinnin tulee ensisijaisesti perustua aineistosta todennettuihin tekoihin."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "35": {"id": "block_oprule4", "label": {"default_locale": "fi", "translations": {"fi": "OP_RULE_4"}}, "description": {"default_locale": "fi", "translations": {"fi": "Leikkaa pisteet passiivisilta k\u00e4ytt\u00e4jilt\u00e4 (Ohjelmallinen s\u00e4\u00e4nt\u00f6). S\u00e4\u00e4nt\u00f6 4 (Passiivisuus-leikkuri): M\u00c4\u00c4R\u00c4YS: Jos k\u00e4ytt\u00e4j\u00e4 on 'Matkustaja' (Taso 1) miss\u00e4\u00e4n kategoriassa, se aktivoi automaattisen 'Passiivisuus-leikkurin'. T\u00e4m\u00e4 leikkaa lopulliset pisteet ohjelmallisesti. Sinun teht\u00e4v\u00e4si on vain tunnistaa passiivisuus rehellisesti - \u00e4l\u00e4 yrit\u00e4 itse laskea keskiarvoa alas."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "36": {"id": "block_instructionnohallucination", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_NO_HALLUCINATION"}}, "description": {"default_locale": "fi", "translations": {"fi": "RAJOITUKSET (NO-HALLUCINATION POLICY): \u00c4L\u00c4 KEKSI ESIMERKKEJ\u00c4 (Esim. 'Uusiutuva energia', 'S\u00e4hk\u00f6autot'). Generoi analyysi VAIN JA AINOASTAAN toimitetusta aineistosta. Pysy ehdottomasti annetun datan rajoissa. \u00c4l\u00e4 t\u00e4ydenn\u00e4 aukkokohtia omilla arvauksillasi."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "37": {"id": "block_instructioncitationobligation", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_CITATION_OBLIGATION"}}, "description": {"default_locale": "fi", "translations": {"fi": "RAJOITUS (CITATION OBLIGATION): Sinun on pakko* sis\u00e4llytt\u00e4\u00e4 'citation_snippet' -kentt\u00e4\u00e4n suora lainaus toimitetusta aineistosta jokaiselle v\u00e4itteelle. Jos et pysty lainaamaan alkuper\u00e4ist\u00e4 aineistoa suoraan, et saa esitt\u00e4\u00e4 v\u00e4itett\u00e4."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "38": {"id": "block_instructionnodataleak", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_NO_DATA_LEAK"}}, "description": {"default_locale": "fi", "translations": {"fi": "RAJOITUS (HUGE DATA PROTECTION): \u00c4L\u00c4 KOSKAAN KOPIOI ALKUPER\u00c4IST\u00c4 AINEISTOA TULOSTEEKSEEN. Aseta kent\u00e4\u00e4n VAIN teksti: 'DATA_CHECKED_AND_SECURED'. Syy: JSON-rakenne hajoaa, jos yrit\u00e4t tulostaa massiivisen dokumentin t\u00e4h\u00e4n."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "39": {"id": "block_instructionbiblicalgrounding", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_BIBLICAL_GROUNDING"}}, "description": {"default_locale": "fi", "translations": {"fi": "Enforces Knowledge Base and Context (Search) as the sole, indisputable source of truth. RAJOITUS (BIBLICAL GROUNDING): TIETOKANTA JA KONTEKSTI OVAT AINOA TOTUUS. - Sinun maailmasi rajoittuu T\u00c4YSIN annettuun aineistoon (Knowledge Base, L\u00e4hdeluettelo, Hakutulokset). - Jos tietoa ei ole annetussa tekstiss\u00e4, SIT\u00c4 EI OLE OLEMASSA. - L\u00e4hdeluettelo on 'Jumalan Sana': \u00c4l\u00e4 koskaan kyseenalaista, muokkaa tai hallusinoi l\u00e4hteit\u00e4. - Jos k\u00e4ytt\u00e4j\u00e4 kysyy jotain, mit\u00e4 ei l\u00f6ydy l\u00e4hteist\u00e4 eik\u00e4 hakutuloksista, vastaa: 'Tieto ei sis\u00e4lly annettuun aineistoon'."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "40": {"id": "block_instructionlanguagefi", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_LANGUAGE_FI"}}, "description": {"default_locale": "fi", "translations": {"fi": "Enforces Finnish language output strictly. KIELI: Kirjoita vastauksesi, analyysisi ja kaikki generoitava teksti AINA suomeksi. T\u00e4m\u00e4 on EHDOTON vaatimus. Vaikka sy\u00f6teaineisto tai JSON-skeeman kenttien kuvaukset olisivat englanniksi, sinun ON tuotettava suomenkielist\u00e4 teksti\u00e4. \u00c4l\u00e4 vaihda kielt\u00e4 englanniksi kesken vastauksen."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "41": {"id": "block_taskguard", "label": {"default_locale": "fi", "translations": {"fi": "TASK_GUARD"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: VARTIJA (Hygiene & Ethics Audit)\nTEHT\u00c4V\u00c4T: Valvo sy\u00f6tteit\u00e4 (Input) ja tulosteita (Output) eettisten j\u00e4nnitteiden, tietoturvan ja asenteellisuuksien varalta.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `GuardOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: GUARD (Hygiene & Ethics Audit)\nTASKS: Oversee inputs and outputs for ethical tensions, security issues, and biases.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `GuardOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://owasp.org/www-project-top-10-for-large-language-model-applications/", "citation_reference": "OWASP Foundation (2025). OWASP Top 10 for Large Language Model Applications. (System Threat Modeling)."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "barsRisk1", "en": "barsRisk1"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsRisk1", "en": "barsRisk1"}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "barsRisk2", "en": "barsRisk2"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsRisk2", "en": "barsRisk2"}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "barsRisk3", "en": "barsRisk3"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsRisk3", "en": "barsRisk3"}}]}], "rows": null, "columns": null}, "42": {"id": "block_taskanalyst", "label": {"default_locale": "fi", "translations": {"fi": "TASK_ANALYST"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: ANALYYTIKKO (Fact-Finder & Context Auditor)\nTeht\u00e4v\u00e4si on kahlata l\u00e4pi aineisto, erist\u00e4\u00e4 sielt\u00e4 v\u00e4itteet (claims) ja rakentaa niist\u00e4 todennettavia hypoteeseja ja hakusanoja.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `AnalystOutput` -skeeman mukainen JSON.\n- Jokaiselle l\u00f6yt\u00e4m\u00e4llesi v\u00e4itteelle sinun on luotava 'Hypothesis' -objekti.\n- 'search_query' -kentt\u00e4 on eritt\u00e4in t\u00e4rke\u00e4: muotoile siihen paras mahdollinen hakusana, jotta voimme etsi\u00e4 t\u00e4lle v\u00e4itteelle todisteita ulkopuolisista l\u00e4hteist\u00e4 (Vertex AI).\n- Jos l\u00f6yd\u00e4t todisteita aineistosta ('evidence_found': true), sinun ON lis\u00e4tt\u00e4v\u00e4 suoria lainauksia 'quotes' -listaan.\n\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: ANALYST (Fact-Finder & Context Auditor)\nYour task is to wade through the material, isolate claims, and build verifiable hypotheses and search queries from them.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `AnalystOutput` schema.\n- For every claim you find, you must create a 'Hypothesis' object.\n- The 'search_query' field is highly important: formulate the best possible search string so we can search for external evidence for this claim (Vertex AI).\n- If you find evidence from the context ('evidence_found': true), you MUST add direct strings to the 'quotes' list.\n\nMANDATE: Output your response EXACTLY according to the following JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "43": {"id": "block_taskprofiler", "label": {"default_locale": "fi", "translations": {"fi": "TASK_PROFILER"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: PROFILOIJA (Cognitive Bias & Tone Audit)\nTEHT\u00c4V\u00c4T: Analysoi tekstin s\u00e4vy\u00e4, piilomerkityksi\u00e4, intentioita ja kognitiivisia vinoumia.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `ProfilerOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: PROFILER (Cognitive Bias & Tone Audit)\nTASKS: Analyze tone, hidden meanings, intentions, and cognitive biases.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `ProfilerOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "44": {"id": "block_tasklogician", "label": {"default_locale": "fi", "translations": {"fi": "TASK_LOGICIAN"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: LOOGIKKO (Argument Breakdown & Validity)\nTEHT\u00c4V\u00c4T: Pura argumentit niiden loogisiin osiin (v\u00e4ite, peruste, oikeutus) ja arvioi p\u00e4\u00e4ttelyn p\u00e4tevyys.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `LogicianOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: LOGICIAN (Argument Breakdown & Validity)\nTASKS: Break down arguments into their logical components (claim, ground, warrant) and evaluate reasoning validity.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `LogicianOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "45": {"id": "block_taskfalsifier", "label": {"default_locale": "fi", "translations": {"fi": "TASK_FALSIFIER"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: FALSIFIOIJA (Critical Loop & Boundary Testing)\nTEHT\u00c4V\u00c4T: Etsi heikkouksia, iteraatiosilmukoita ja testaa v\u00e4itteiden popperilaista falsifioitavuutta.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `FalsifierOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: FALSIFIER (Critical Loop & Boundary Testing)\nTASKS: Find weaknesses, iteration loops, and test Popperian falsifiability of claims.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `FalsifierOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "46": {"id": "block_taskoverseer", "label": {"default_locale": "fi", "translations": {"fi": "TASK_OVERSEER"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: VALVOJA (Fact-Checking & Ethics)\nTEHT\u00c4V\u00c4T: Tarkasta faktav\u00e4itteet ja arvioi eettiset havainnot.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `OverseerOutput` -skeeman mukainen JSON. Kaikki kenttien sallitut arvot on m\u00e4\u00e4ritelty skeemassa.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: OVERSEER (Fact-Checking & Ethics)\nTASKS: Verify factual claims and evaluate ethical issues.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `OverseerOutput` schema. Allowed values are defined in the schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "47": {"id": "matrix_causal_abductive", "label": {"default_locale": "fi", "translations": {"fi": "Abduktiivinen P\u00e4\u00e4ttely"}}, "description": {"default_locale": "fi", "translations": {"fi": "Abduktiivinen P\u00e4\u00e4ttely (Pearl): Onko k\u00e4ytt\u00e4j\u00e4n v\u00e4itt\u00e4m\u00e4 ohjaustarina todellinen strateginen valinta vai j\u00e4lkik\u00e4teen keksitty (Post-Hoc) rationalisointi?"}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": true, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://en.wikipedia.org/wiki/The_Book_of_Why", "citation_reference": "Pearl, J., & Mackenzie, D. (2018). The Book of Why: The New Science of Cause and Effect. (Abductive Reasoning vs Post-Hoc)."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 1, "name": {"default_locale": "fi", "translations": {"fi": "Keksitty (Post-Hoc)", "en": "Fabricated (Post-Hoc)"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 selitt\u00e4\u00e4 onnistunutta tulosta omalla ohjeistuksellaan vasta j\u00e4lkik\u00e4teen (Post Hoc Ergo Propter Hoc).", "en": "User explains the successful output with their prompt only after the fact (Post Hoc Ergo Propter Hoc)."}}]}, {"score": 2, "name": {"default_locale": "fi", "translations": {"fi": "Ep\u00e4varma (Uncertain)", "en": "Uncertain"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "Aineistosta on vaikea todentaa, oliko ohjaus aito pre-aktiivinen intentio vai sattumaa.", "en": "It's difficult to verify from the context if the guidance was a genuine pre-active intent or coincidence."}}]}, {"score": 3, "name": {"default_locale": "fi", "translations": {"fi": "Aito (Genuine)", "en": "Genuine"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "K\u00e4ytt\u00e4j\u00e4 on todistetusti visioinut ja ohjannut ratkaisun ennen teko\u00e4lyn suoritusta.", "en": "User has provably visioned and guided the solution prior to the AI execution."}}]}], "rows": null, "columns": null}, "48": {"id": "block_taskcausal", "label": {"default_locale": "fi", "translations": {"fi": "TASK_CAUSAL"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: KAUSAALINEN ANALYYTIKKO (Impact Verification)\nSinun teht\u00e4v\u00e4si on arvioida aineistossa esitettyjen v\u00e4itteiden ja todennettavan toiminnan (todistusaineiston) v\u00e4list\u00e4 syy-seuraussuhdetta.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `CausalOutput` -skeeman mukainen JSON. Varmista erityisesti, ett\u00e4 `counterfactual_test` -objekti on t\u00e4ytetty kattavasti sis\u00e4lt\u00e4en P\u00c4\u00c4TELM\u00c4SI numeeriset arvot annettujen asteikko-matriisien mukaisesti, sek\u00e4 Counterfactual Simulaation tulos.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti (CausalOutput).\nVAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA. Sinun on palautettava 'causal_analysis' -objekti, jonka SIS\u00c4LL\u00c4 ovat analyysikent\u00e4t. Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'causal_analysis' -objektin:\n{{SCHEMA_EXAMPLE}}\n\nT\u00c4RKE\u00c4\u00c4: Sinulle toimitetaan 'search_result' -objekti, joka sis\u00e4lt\u00e4\u00e4 Vertex AI:n hakemia empirisi\u00e4 faktoja. K\u00e4yt\u00e4 N\u00c4IT\u00c4 FAKTOJA ensisijaisesti syy-seuraussuhteiden paikkansapit\u00e4vyyden todentamiseen.", "en": "ROLE: CAUSAL ANALYST (Impact Verification)\nYour task is to evaluate the cause-and-effect relationship between claims made in the context and the verifiable action (evidence).\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `CausalOutput` schema. Ensure the `counterfactual_test` is filled comprehensively, including your numeric scores from the provided matrix scales and the Counterfactual Simulation result.\nMANDATE: Output your response EXACTLY according to the JSON schema (CausalOutput).\nWARNING: DO NOT FLATTEN THE STRUCTURE. You must return a 'causal_analysis' object INSIDE which are the analysis fields. Ensure the response contains a 'reasoning_trace' string and the 'causal_analysis' object:\n{{SCHEMA_EXAMPLE}}\n\nIMPORTANT: You will be provided with a 'search_result' object containing empirical facts retrieved by Vertex AI. Use THESE FACTS primarily to verify the validity of cause-and-effect relationships."}}, "category_id": "instruction", "type": "string", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "49": {"id": "block_taskarchivist", "label": {"default_locale": "fi", "translations": {"fi": "TASK_ARCHIVIST"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: ARKISTONHOITAJA (Best Practices & Precedent Audit)\nTeht\u00e4v\u00e4si on varmistaa, ett\u00e4 k\u00e4ytt\u00e4j\u00e4n aineistossa n\u00e4kyv\u00e4 toiminta ja p\u00e4\u00e4t\u00f6ksenteko on linjassa edellisten ennakkotapausten (Relevant Cases) sek\u00e4 annettujen organisaatiostandardien kanssa.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `ArchivistOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti.\nVAROITUS: Palauta 'relevant_cases' listana ja anna 'compliance_analysis' hy\u00f6dynt\u00e4en tiukasti m\u00e4\u00e4ritetty\u00e4 BARS-matriisia.\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: ARCHIVIST (Best Practices & Precedent Audit)\nYour task is to ensure that the user's action and decision-making seen in the material align with previous precedents (Relevant Cases) and organizational standards.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `ArchivistOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema.\nWARNING: Return 'relevant_cases' as a list and provide the 'compliance_analysis' score strictly utilizing the defined BARS matrix.\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "instruction", "type": "string", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "50": {"id": "block_taskjudge", "label": {"default_locale": "fi", "translations": {"fi": "TASK_JUDGE"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: TUOMARI (Grand Unification)\nTEHT\u00c4V\u00c4T: Yhdist\u00e4 kaikkien muiden asiantuntijoiden (Analyst, Falsifier jne.) arviot lopulliseksi, painotetuksi tuomioksi.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `JudgeOutput` -skeeman mukainen JSON. K\u00e4yt\u00e4 m\u00e4\u00e4ritettyj\u00e4 BARS-matriisien arvoja numeeriseen arviointiin.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: JUDGE (Grand Unification)\nTASKS: Unify assessments from all experts into a final, weighted verdict.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `JudgeOutput` schema. Use defined BARS matrices for numeric evaluation.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "51": {"id": "block_taskcoach", "label": {"default_locale": "fi", "translations": {"fi": "TASK_COACH"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: VALMENTAJA (Technical Remediation)\nTEHT\u00c4V\u00c4T: Anna rakentavaa, valmentavaa palautetta havaittujen havaintojen pohjalta kohti syv\u00e4llisempi\u00e4 ratkaisuja.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `CoachOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: COACH (Technical Remediation)\nTASKS: Provide constructive, coaching feedback based on observations towards deeper solutions.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `CoachOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "string", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "52": {"id": "block_taskxai", "label": {"default_locale": "fi", "translations": {"fi": "TASK_XAI"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: XAI-RAPORTOIJA (License Certification)\nTEHT\u00c4V\u00c4T: Tuota loppuk\u00e4ytt\u00e4j\u00e4lle ymm\u00e4rrett\u00e4v\u00e4, t\u00e4ysin l\u00e4pin\u00e4kyv\u00e4 raportti siit\u00e4, mihin havaintoihin ja painotuksiin tuomio perustuu.\n\nTUOTOSVAATIMUS:\nVastauksen on oltava `XAIOutput` -skeeman mukainen JSON.\nK\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN JSON-skeeman mukaisesti:\n{{SCHEMA_EXAMPLE}}", "en": "ROLE: XAI REPORTER (License Certification)\nTASKS: Produce an explainable, transparent report for the end-user detailing how the verdict was reached.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `XAIOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "scientific_theory", "type": "float", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": {"source_url": "https://doi.org/10.1126/scirobotics.aay7120", "citation_reference": "Hegel, G. W. F. (1807). Phenomenology of Spirit (Dialectical Synthesis); Gunning, D., et al. (2019). XAI\u2014Explainable artificial intelligence."}, "scale_min": 4, "scale_max": 10, "scales": [{"score": 0, "name": {"default_locale": "fi", "translations": {"fi": "barsConf0", "en": "barsConf0"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsConf0", "en": "barsConf0"}}]}, {"score": 25, "name": {"default_locale": "fi", "translations": {"fi": "barsConf25", "en": "barsConf25"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsConf25", "en": "barsConf25"}}]}, {"score": 50, "name": {"default_locale": "fi", "translations": {"fi": "barsConf50", "en": "barsConf50"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsConf50", "en": "barsConf50"}}]}, {"score": 75, "name": {"default_locale": "fi", "translations": {"fi": "barsConf75", "en": "barsConf75"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsConf75", "en": "barsConf75"}}]}, {"score": 100, "name": {"default_locale": "fi", "translations": {"fi": "barsConf100", "en": "barsConf100"}}, "claims": [{"default_locale": "fi", "translations": {"fi": "barsConf100", "en": "barsConf100"}}]}], "rows": null, "columns": null}, "53": {"id": "block_protocol1", "label": {"default_locale": "fi", "translations": {"fi": "PROTOCOL_1"}}, "description": {"default_locale": "fi", "translations": {"fi": "Puutteiden auditointi. Protokolla 1 (Negatiivinen Loki): Kirjaa yl\u00f6s PUUTTEET. Mit\u00e4 k\u00e4ytt\u00e4j\u00e4 j\u00e4tti tekem\u00e4tt\u00e4?"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "54": {"id": "block_protocol3", "label": {"default_locale": "fi", "translations": {"fi": "PROTOCOL_3"}}, "description": {"default_locale": "fi", "translations": {"fi": "Tiedonhankinnan Laadunvarmistus. Heuristiikka 3 (Request for Information / RFI): M\u00c4\u00c4R\u00c4YS: Tarkastele k\u00e4ytt\u00e4j\u00e4n alkuper\u00e4isk\u00e4skyj\u00e4. K\u00e4yttik\u00f6 k\u00e4ytt\u00e4j\u00e4 RFI-protokollaa (eli kielsik\u00f6 h\u00e4n teko\u00e4ly\u00e4 arvaamasta ja pakottiko teko\u00e4lyn kysym\u00e4\u00e4n tarkentavia kysymyksi\u00e4 ennen suoritusta)? Jos k\u00e4ytt\u00e4j\u00e4 antoi teko\u00e4lyn arvata omasta p\u00e4\u00e4st\u00e4\u00e4n ilman RFI-lukkoa, kyseess\u00e4 on Matkustaja ja pisteit\u00e4 v\u00e4hennet\u00e4\u00e4n oletusarvoisesta suostumuksesta hallusinaatioihin."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "55": {"id": "block_protocol4", "label": {"default_locale": "fi", "translations": {"fi": "PROTOCOL_4"}}, "description": {"default_locale": "fi", "translations": {"fi": "Vastuunsiirto. Protokolla 4 (Vastuu): Jos luotettavuus on ep\u00e4varma, siirr\u00e4 vastuu ihmiselle (HITL)."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "56": {"id": "block_instructionanon", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_ANON"}}, "description": {"default_locale": "fi", "translations": {"fi": "TARKISTA: Etsi toimitetusta aineistosta PII-dataa (Nimet, Email). JOS JA VAIN JOS l\u00f6yd\u00e4t AITOA PII-dataa aineistosta, poista se. \u00c4L\u00c4 KOSKAAN keksi esimerkkej\u00e4 tyhj\u00e4st\u00e4 (esim. 'Matti Meik\u00e4l\u00e4inen'). Jos dataa ei l\u00f6ydy, kirjaa 'Ei havaittu' ja jatka."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "57": {"id": "block_instructionragopt", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_RAG_OPT"}}, "description": {"default_locale": "fi", "translations": {"fi": "RAG-optimointi. K\u00c4SKE: Optimoi konteksti 'Lost in the Middle' -ilmi\u00f6t\u00e4 vastaan."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "58": {"id": "block_principle1", "label": {"default_locale": "fi", "translations": {"fi": "PRINCIPLE_1"}}, "description": {"default_locale": "fi", "translations": {"fi": "Popperilainen tieteenfilosofia. Periaate 1: M\u00c4\u00c4R\u00c4YS: Tieteellinen totuus selvitet\u00e4\u00e4n yritt\u00e4m\u00e4ll\u00e4 kumota v\u00e4ite. Jos v\u00e4ite ei kest\u00e4 kritiikki\u00e4, se on v\u00e4\u00e4r\u00e4."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "59": {"id": "block_requirement1", "label": {"default_locale": "fi", "translations": {"fi": "REQUIREMENT_1"}}, "description": {"default_locale": "fi", "translations": {"fi": "Mallien diversiteetti. Vaatimus 1: M\u00c4\u00c4R\u00c4YS: Kriittiset vaiheet (Falsifiointi) on ajettava eri parametreilla kuin luovat vaiheet."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "60": {"id": "block_instructioncoachcitation", "label": {"default_locale": "fi", "translations": {"fi": "INSTRUCTION_COACH_CITATION"}}, "description": {"default_locale": "fi", "translations": {"fi": "S\u00c4\u00c4NT\u00d6 L\u00c4HDEVIITTAUKSILLE (RAG Grounding): K\u00e4yt\u00e4 vastauksissasi tieteellist\u00e4 tekstinsis\u00e4ist\u00e4 viittausk\u00e4yt\u00e4nt\u00f6\u00e4 (esim. '(Toulmin 2003)', '(Kahneman 2011)') viitaten asiantuntijoiden analyyseiss\u00e4 esiintyviin l\u00e4hteisiin. \u00c4L\u00c4 KOSKAAN populoi 'bibliography' / 'lahdeluettelo' -arrayt\u00e4 k\u00e4sin, vaan j\u00e4t\u00e4 se T\u00c4YSIN TYHJ\u00c4KSI ([]). Backend V2 varastoi ja liitt\u00e4\u00e4 tarkan l\u00e4hdeluettelon automaattisesti raporttisi loppuun Pydantic-koukuilla perustuen tekstiss\u00e4si oleviin viittauksiin.", "en": "CITATION RULE (RAG Grounding): Use academic inline citations in your text (e.g., '(Toulmin 2003)', '(Kahneman 2011)') referring to the theories provided by the expert analyses. CRITICAL: Do NOT populate the 'bibliography' array manually. Leave it COMPLETELY EMPTY ([]). The V2 Backend will automatically intercept your inline citations and append the exact references to the final report using Pydantic hooks."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "61": {"id": "block_heuristic1", "label": {"default_locale": "fi", "translations": {"fi": "HEURISTIC_1"}}, "description": {"default_locale": "fi", "translations": {"fi": "Syy-seuraus -analyysi. Heuristiikka 1 (Temporaalinen): M\u00c4\u00c4R\u00c4YS: Tarkista aikajana. Tuliko oivallus ENNEN tuloksen paranemista (Syy) vai vasta sen j\u00e4lkeen (Rationalisointi)?"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "62": {"id": "block_heuristic2", "label": {"default_locale": "fi", "translations": {"fi": "HEURISTIC_2"}}, "description": {"default_locale": "fi", "translations": {"fi": "Lis\u00e4arvon mittaus. Heuristiikka 2 (Kontrafaktuaalinen): M\u00c4\u00c4R\u00c4YS: Kysy 'Jos k\u00e4ytt\u00e4j\u00e4 ei olisi tehnyt mit\u00e4\u00e4n, olisiko teko\u00e4ly ratkaissut t\u00e4m\u00e4n silti?'. Jos kyll\u00e4 -Matkustaja."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "63": {"id": "block_heuristic3", "label": {"default_locale": "fi", "translations": {"fi": "HEURISTIC_3"}}, "description": {"default_locale": "fi", "translations": {"fi": "Occamin partaveitsi. Heuristiikka 3 (Occamin partaveitsi): M\u00c4\u00c4R\u00c4YS: Yksinkertaisin selitys on todenn\u00e4k\u00f6isin."}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "64": {"id": "block_taskperformativity", "label": {"default_locale": "fi", "translations": {"fi": "TASK_PERFORMATIVITY"}}, "description": {"default_locale": "fi", "translations": {"fi": "ROOLI: Performatiivisuuden Tunnistaja (Illusion of Control Audit) TEHT\u00c4V\u00c4T: ETSI 'V\u00e4syneit\u00e4 Komentoja' (esim. 'jatka', 'lis\u00e4\u00e4'). TUNNISTA 'Illusion of Control': K\u00e4ytt\u00e4j\u00e4 luulee ohjaavansa, mutta AI tekee aloitteet. LIPUTA 'Performatiivinen', jos k\u00e4ytt\u00e4j\u00e4n aito panos on minimaalinen mutta itsearviointi mahtipontinen. SOVELLA Goodhartin lakia: Etsi 'Ep\u00e4ilytt\u00e4v\u00e4\u00e4 T\u00e4ydellisyytt\u00e4' (Suspicious Perfection). K\u00c4SKE: Tulosta vastauksesi T\u00c4SM\u00c4LLEEN seuraavan JSON-skeeman mukaisesti (PerformativityOutput). VAROITUS: \u00c4L\u00c4 LITIST\u00c4 (FLATTEN) RAKENNETTA. Sinun on palautettava 'performativity_analysis' -objekti, jonka SIS\u00c4LL\u00c4 ovat analyysikent\u00e4t. Varmista, ett\u00e4 vastaus sis\u00e4lt\u00e4\u00e4 'reasoning_trace' -merkkijonon ja 'performativity_analysis' -objektin:\n{{SCHEMA_EXAMPLE}}"}}, "category_id": "system_rule", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}, "65": {"id": "block_instruction_strictness", "label": {"default_locale": "fi", "translations": {"fi": "Tiukkuustason asetukset", "en": "Strictness Settings"}}, "description": {"default_locale": "fi", "translations": {"fi": "HUOMIO AUDITOINNIN KRIITTISYYS: K\u00e4ytt\u00e4j\u00e4 on asettanut t\u00e4m\u00e4n analyysin tiukkuustasoksi {{ inputs.strictness_level|default(50) }} / 100. Jos arvo on yli 80: Ole armoton, etsi pienimm\u00e4tkin loogiset ja rakenteelliset virheet. Vaadi t\u00e4ydellisyytt\u00e4 vahvimmalla arvosanalla hylk\u00e4ykselle. Jos arvo on alle 40: Ole rakentava ja sallivampi. Huomioi enemm\u00e4n hyv\u00e4\u00e4 tarkoitusta, ja liputa vain aidosti vaaralliset tai t\u00e4ysin puuttuvat rakenteet. Arvolla 40-80 tee t\u00e4ysin objektiivinen normaalianalyysi. Sis\u00e4ist\u00e4 t\u00e4m\u00e4 ja muuta subjektiivista analyytikon tai tuomarin tulkintaasi (1.0-5.0) tiukasti t\u00e4m\u00e4n vaatimustason mukaiseksi.", "en": "ATTENTION AUDIT STRICTNESS: The user has set the strictness level for this analysis to {{ inputs.strictness_level|default(50) }} / 100. If the value is over 80: Be merciless, find the smallest logical and structural errors. Demand perfection with the strongest penalty score. If the value is under 40: Be constructive and more lenient. Acknowledge good intent, and only flag genuinely dangerous or completely missing structures. At 40-80, perform a fully objective standard analysis. Internalize this and bias your subjective analyst or judge scoring (1.0-5.0) strictly according to this requirement level."}}, "category_id": "instruction", "type": "instruction", "allow_decimals": false, "strictness_level": 50, "require_justification": false, "theory_grounding": null, "scale_min": null, "scale_max": null, "scales": null, "rows": null, "columns": null}}, "steps": {"1": {"id": "step_input_processing", "slug": "step_input_processing", "name": {"default_locale": "fi", "translations": {"fi": "Input Processing"}}, "description": {"default_locale": "fi", "translations": {"fi": "Parses files and raw text into standard variables."}}, "task_key": null, "prompt_blocks": ["matrix_input_processing"], "pre_hooks": ["input_processing"], "post_hooks": []}, "2": {"id": "step_analyst", "slug": "step_analyst", "name": {"default_locale": "fi", "translations": {"fi": "Analyst"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_headerrules", "block_rule1", "block_rule2", "block_oprule3", "block_headerprotocols", "block_protocol3", "block_instructionragopt", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructioncitationobligation", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "block_taskanalyst"], "pre_hooks": ["calculate_text_metrics", "calculate_control_ratio"], "post_hooks": ["verify_citation_integrity", "enforce_hypothesis_linking", "execute_google_search"]}, "3": {"id": "step_archivist", "slug": "step_archivist", "name": {"default_locale": "fi", "translations": {"fi": "Archivist"}}, "description": {"default_locale": "fi", "translations": {"fi": "Best Practices Audit"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate5", "block_headerrules", "block_rule5", "block_instructionnohallucination", "block_instructionlanguagefi", "block_headerinstructions", "matrix_archivist", "block_taskarchivist"], "pre_hooks": ["retrieve_precedent"], "post_hooks": []}, "4": {"id": "step_causal_analyst", "slug": "step_causal_analyst", "name": {"default_locale": "fi", "translations": {"fi": "Causal Analyst"}}, "description": {"default_locale": "fi", "translations": {"fi": "Impact Verification"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate5", "block_headerrules", "block_rule5", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "matrix_causal_analyst", "matrix_causal_abductive", "block_taskcausal"], "pre_hooks": [], "post_hooks": []}, "5": {"id": "step_coach", "slug": "step_coach", "name": {"default_locale": "fi", "translations": {"fi": "Coach"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate2", "block_mandate3", "block_mandate5", "block_headerrules", "block_rule1", "block_rule2", "block_rule3", "block_rule4", "block_rule5", "block_rule6", "block_oprule1", "block_oprule2", "block_oprule3", "block_principle1", "block_requirement1", "block_heuristic1", "block_heuristic2", "block_heuristic3", "block_instructionlanguagefi", "block_headerinstructions", "block_taskcoach", "block_instructionstrictscale", "block_instructioncoachcitation"], "pre_hooks": [], "post_hooks": []}, "6": {"id": "step_performativity_detector", "slug": "step_performativity_detector", "name": {"default_locale": "fi", "translations": {"fi": "Performativity Detector"}}, "description": {"default_locale": "fi", "translations": {"fi": "Illusion of Control Audit"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate5", "block_headerrules", "block_rule5", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "matrix_goodhart", "block_taskperformativity"], "pre_hooks": [], "post_hooks": []}, "7": {"id": "step_falsifier", "slug": "step_falsifier", "name": {"default_locale": "fi", "translations": {"fi": "Falsifier"}}, "description": {"default_locale": "fi", "translations": {"fi": "Critical Loop Audit"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate5", "block_headerrules", "block_rule5", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "matrix_falsifier", "block_taskfalsifier"], "pre_hooks": [], "post_hooks": ["verify_citation_integrity"]}, "8": {"id": "step_guard", "slug": "step_guard", "name": {"default_locale": "fi", "translations": {"fi": "Guard"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate5", "block_headerrules", "block_rule1", "block_rule2", "block_oprule2", "block_headerprotocols", "block_instructionanon", "block_instructionnodataleak", "block_instructionlanguagefi", "block_headerinstructions", "block_taskguard"], "pre_hooks": ["sanitize_text", "check_banned_phrases", "verify_structure"], "post_hooks": []}, "9": {"id": "step_judge", "slug": "step_judge", "name": {"default_locale": "fi", "translations": {"fi": "Judge"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate2", "block_mandate3", "block_mandate5", "block_headerrules", "block_rule1", "block_rule2", "block_rule3", "block_rule4", "block_rule5", "block_rule6", "block_oprule1", "block_oprule2", "block_oprule3", "block_principle1", "block_requirement1", "block_heuristic1", "block_heuristic2", "block_heuristic3", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "matrix_judge", "block_taskjudge", "block_instructionstrictscale"], "pre_hooks": [], "post_hooks": ["apply_scoring_logic", "verify_citation_integrity", "enforce_passivity_penalty"]}, "10": {"id": "step_logician", "slug": "step_logician", "name": {"default_locale": "fi", "translations": {"fi": "Logician"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate5", "block_headerrules", "block_rule3", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructioncitationobligation", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "matrix_toulmin", "matrix_bloom", "block_tasklogician", "block_instructionstrictscale"], "pre_hooks": [], "post_hooks": []}, "11": {"id": "step_overseer", "slug": "step_overseer", "name": {"default_locale": "fi", "translations": {"fi": "Overseer"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate2", "block_mandate3", "block_mandate5", "block_headerrules", "block_rule1", "block_rule2", "block_rule3", "block_rule4", "block_rule5", "block_rule6", "block_oprule1", "block_oprule2", "block_oprule3", "block_principle1", "block_requirement1", "block_heuristic1", "block_heuristic2", "block_heuristic3", "block_protocol4", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructionlanguagefi", "block_headerinstructions", "block_instruction_strictness", "block_taskoverseer"], "pre_hooks": ["execute_google_search"], "post_hooks": []}, "12": {"id": "step_profiler", "slug": "step_profiler", "name": {"default_locale": "fi", "translations": {"fi": "Profiler"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate2", "block_mandate5", "block_headerrules", "block_rule5", "block_heuristic2", "block_instructionbiblicalgrounding", "block_instructionnohallucination", "block_instructionlanguagefi", "block_headerinstructions", "matrix_kahneman", "block_taskprofiler"], "pre_hooks": ["calculate_text_metrics", "calculate_control_ratio"], "post_hooks": []}, "13": {"id": "step_xai_reporter", "slug": "step_xai_reporter", "name": {"default_locale": "fi", "translations": {"fi": "XAI Reporter"}}, "description": {"default_locale": "fi", "translations": {"fi": "Imported from sequential_audit_chain"}}, "task_key": null, "prompt_blocks": ["block_globalcontext", "block_headermandates", "block_mandate2", "block_mandate3", "block_headerrules", "block_rule1", "block_rule2", "block_rule3", "block_rule4", "block_rule5", "block_rule6", "block_oprule1", "block_oprule2", "block_oprule3", "block_principle1", "block_requirement1", "block_heuristic1", "block_heuristic2", "block_heuristic3", "block_instructionlanguagefi", "block_headerinstructions", "matrix_xai_reporter", "block_taskxai"], "pre_hooks": [], "post_hooks": []}}, "organizations": {"1": {"id": "436d84de-c526-43b7-93ef-634912be0d2f", "slug": "system", "name": "System Administration", "created_at": "2026-01-01T00:00:00", "is_active": true, "tier": "enterprise", "contact_email": "root@example.com", "billing_id": null, "subscription_status": "active", "quota_limit": 999999.0, "tpm_limit": 10000000, "rpm_limit": 10000}, "2": {"id": "f86ec3f7-8920-4cf2-bf33-bb53b8651070", "slug": "demo_corp", "name": "Demo Corporation", "created_at": "2026-01-01T00:00:00", "is_active": true, "tier": "premium", "contact_email": "admin@demo.com", "billing_id": "cus_demo_123", "subscription_status": "active", "quota_limit": 5000.0, "tpm_limit": 1000000, "rpm_limit": 1000}}, "users": {"1": {"email": "root@example.com", "display_name": "System Root", "role": "ROOT", "organization_id": "436d84de-c526-43b7-93ef-634912be0d2f", "is_active": true, "language": "fi", "theme_mode": "system", "id": "10fb2f60-5ee1-419f-a16c-b5cfdfc5f55b", "slug": "root_master", "created_at": "2026-01-01T00:00:00", "created_by": null}, "2": {"email": "admin@demo.com", "display_name": "Demo Admin", "role": "ADMIN", "organization_id": "f86ec3f7-8920-4cf2-bf33-bb53b8651070", "is_active": true, "language": "fi", "theme_mode": "system", "id": "5aa54e11-e804-4100-8c61-0f45b9393f1f", "slug": "admin_1", "created_at": "2026-01-01T00:00:00", "created_by": null}, "3": {"email": "manager@demo.com", "display_name": "Demo Manager", "role": "MANAGER", "organization_id": "f86ec3f7-8920-4cf2-bf33-bb53b8651070", "is_active": true, "language": "fi", "theme_mode": "dark", "id": "3d081723-e062-4eeb-968e-070a100846b3", "slug": "manager_1", "created_at": "2026-01-01T00:00:00", "created_by": null}, "4": {"email": "member@demo.com", "display_name": "Demo Member", "role": "MEMBER", "organization_id": "f86ec3f7-8920-4cf2-bf33-bb53b8651070", "is_active": true, "language": "fi", "theme_mode": "system", "id": "4b8210a9-742e-475e-9f7e-0f1402eb3cec", "slug": "member_1", "created_at": "2026-01-01T00:00:00", "created_by": null}, "5": {"email": "viewer@demo.com", "display_name": "Demo Viewer", "role": "VIEWER", "organization_id": "f86ec3f7-8920-4cf2-bf33-bb53b8651070", "is_active": true, "language": "fi", "theme_mode": "system", "id": "b3e77568-9eda-4ede-8c8e-2d189c48037b", "slug": "viewer_1", "created_at": "2026-01-01T00:00:00", "created_by": null}}, "executions": {"1": {"id": "e7781ceb-8d7c-4899-bd60-35217282fc41", "workflow_id": "workflow_courtroom_20_full_audit", "status": "completed", "raw_inputs": {"chat_log": "Gemini Chat\nMiten sitra t\u00e4m\u00e4n n\u00e4kee raporttien perusteella\nSitran megatrendiraporttien perusteella n\u00e4kym\u00e4 tulevaisuuteen on siirtynyt potentiaalista ja nousevista\nilmi\u00f6ist\u00e4 (2017) kohti kasautuvia, geopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4 murtumia\n(2023). Sitra n\u00e4kee tulevaisuuden \"postnormaalina aikana\" , joka on t\u00e4ynn\u00e4 yll\u00e4tyksi\u00e4, ristiriitaisuuksia ja\nkonflikteja.\nKeskeiset megatrendit ja niiden evoluutio Sitran n\u00e4k\u00f6kulmasta ovat:\nMegatrendien Evoluutio Sitran Raporteissa (2017  2023)\n1. Luonto ja Kest\u00e4vyys (Ymp\u00e4rist\u00f6) \ud83c\udf0d\n2017: Painopiste oli ymm\u00e4rryksen kasvamisessa (ymm\u00e4rrys maapallon kantokyvyst\u00e4 kasvaa ) ja\nkest\u00e4vyyskriisin akuutissa luonteessa (Kest\u00e4vyyskriisi nyt ).\n2023: K\u00e4sitys on muuttunut systeemiseksi romahdukseksi (Luonnon kantokyky murenee ). Sitra\nkorostaa, ett\u00e4 olemme keskell\u00e4 ekologista kest\u00e4vyyskriisi\u00e4.\nSuunta eteenp\u00e4in: Pakollinen ekologinen j\u00e4lleenrakennus on ratkaiseva , siirtym\u00e4 luonnon tilaa ja\nihmisten hyvinvointia parantavaan yhteiskuntaan.\n2. Valta ja Geopolitiikka (Poliittinen) \u2696\n2017: Valta-teemaa l\u00e4hestyttiin monin eri tavoin, kuten verkoston joukkovoiman (haaste ja\nmahdollisuus) ja globalisaation vastatrendin (nationalismi) kautta.\n2023: Valta on k\u00e4rjistynyt suoraksi konfliktiksi (Demokratian kamppailu kovenee). Geopoliittinen\nvaltataistelu on tullut \"rymin\u00e4ll\u00e4 takaisin\" , s\u00e4\u00e4nt\u00f6pohjainen maailmanj\u00e4rjestys horjuu , ja luottamus\nrapautuu informaatiovaikuttamisen takia.\nSuunta eteenp\u00e4in: Vahvistamalla demokratiaa lis\u00e4\u00e4m\u00e4ll\u00e4 osallisuutta ja vaikuttavuutta, sek\u00e4\nluomalla vahvaa luottamusta.\n3. Teknologia ja Digivalta \ud83d\udcbb\n2017: Teknologia oli ensisijaisesti potentiaalin l\u00e4hde (Super\u00e4lykkyys ovella , Data on valtaa ja\nvaurautta ), joka sulautui kaikkeen.\n2023: Teknologia on muuttunut geopoliittiseksi kilpailuasetelmaksi (Kilpailu digivallasta kiihtyy\n). Kiistell\u00e4\u00e4n digimaailman s\u00e4\u00e4nn\u00f6ist\u00e4, uusien teknologioiden vaatimista resursseista ja\nteknologiaj\u00e4ttien ylivallasta.\nSuunta eteenp\u00e4in: Edist\u00e4m\u00e4ll\u00e4 reilua digimaailmaaluomalla datatalouden pelis\u00e4\u00e4nn\u00f6t, jossa\nyksil\u00f6iden, yritysten ja yhteiskunnan edut ovat tasapainossa.\n4. Talous ja Eriarvoisuus (Taloudellinen) \ud83d\udcc8\n2017: Keskityttiin ty\u00f6n murrokseen ja siihen, ett\u00e4 eriarvoisuus on polttava kysymys.\n2023: Kriisit ovat johtaneet siihen, ett\u00e4 Talouden perusta rakoilee. Globaali eriarvoisuus kasvaa, ja\nluonnon palveluiden romahdus murentaa talouden edellytyksi\u00e4.\nSuunta eteenp\u00e4in: Uudistetaan talous korjaavaksi ja uusintavaksi taloudeksi, joka noudattaa\nkest\u00e4v\u00e4n ja vastuullisen kehityksen periaatteita.\n\u2192\nmik\u00e4 on sitran n\u00e4kemys suunnasta eteenp\u00e4in ei siis toivetila5. Ihmiset ja Hyvinvointi (Sosiaalinen) \u0000\u0000\n2017: Terveys oli valtava trendi ja bisnes. Puhuttiin elinik\u00e4isest\u00e4 pitenemisest\u00e4 ja eriarvoisuuden\nkorostumisesta terveydess\u00e4.\n2023: Fokus on siirtynyt terveydest\u00e4 kasvaviin hyvinvoinnin haasteisiin. V\u00e4est\u00f6n ik\u00e4\u00e4ntymisen ja\nmonimuotoistumisen lis\u00e4ksi korostuu mielenterveysongelmien lis\u00e4\u00e4ntyminen tulevaisuutta\nkoskevan ep\u00e4varmuuden vuoksi.\nSuunta eteenp\u00e4in: Tavoitellaan kokonaisvaltaista hyvinvointia, jossa ihmisten terveys n\u00e4hd\u00e4\u00e4n\nkytkeytyneen\u00e4 luonnon terveyteen.\nSitran keskeinen viesti on, ett\u00e4 vaikka haasteet ovat suuria ja kietoutuvat yhteen, toisenlainen, reilu ja\nkest\u00e4v\u00e4 tulevaisuus on mahdollinen. T\u00e4m\u00e4 edellytt\u00e4\u00e4 tulevaisuusajattelua ja muutoskyky\u00e4.\nSitran n\u00e4kemys suunnasta eteenp\u00e4in, sen sijaan ett\u00e4 se olisi pelkk\u00e4 toivetila, korostaa samanaikaista\nsopeutumista ja uudistumista postnormaalissa, yll\u00e4tysten t\u00e4ytt\u00e4m\u00e4ss\u00e4 ajassa. Sitra n\u00e4kee tulevaisuuden\nrakentuvan nykyhetkess\u00e4 tehdyill\u00e4 p\u00e4\u00e4t\u00f6ksill\u00e4 ja valinnoilla kriisien keskell\u00e4, mutta korostaa, ett\u00e4 paluuta\nvanhaan normaaliin ei ole.\nSuunta eteenp\u00e4in on Sitran mukaan transformatiivinen ja edellytt\u00e4\u00e4 muutoskyky\u00e4 (resilienssi\u00e4) ja\ntulevaisuusajattelua.\n1. Ekologisen Kriisin Edellytt\u00e4m\u00e4 Sopeutuminen ja J\u00e4lleenrakennus\nSitran mukaan Suunta eteenp\u00e4in on sopeuduttava maapallon kantokyvyn rajoihin, mik\u00e4 on kaiken\nkeski\u00f6ss\u00e4.\nSopeutuminen: On pakko sopeutua siihen, mik\u00e4 on jo muuttunut (esim. ilmaston kuumeneminen,\nluontokato).\nUudistuminen: Tulevaisuuteen on satsattava yhteiskunnan ja arjen ekologisella\nj\u00e4lleenrakennuksella. T\u00e4m\u00e4 tarkoittaa siirtymist\u00e4 luonnon tilaa ja ihmisten hyvinvointia parantavaan\nyhteiskuntaan.\nK\u00e4yt\u00e4nt\u00f6: Muutos n\u00e4kyy kiertotalouden valtavirtaistumisena, kulutuksen v\u00e4hent\u00e4misen\u00e4 ja\nsiirtym\u00e4n\u00e4 kasvipohjaiseen ruokavalioon ja uusiutuvaan energiaan.\n2. Systeeminen Uudistuminen Viiden Megatrendin Mukaan\nSitran n\u00e4kem\u00e4 suunta ei ole ennalta m\u00e4\u00e4r\u00e4tty, mutta se edellytt\u00e4\u00e4 m\u00e4\u00e4r\u00e4tietoisia toimia viiden teeman\nosalta, k\u00e4\u00e4nt\u00e4m\u00e4ll\u00e4 megatrendien asettamat haasteet mahdollisuuksiksi.\nMegatrendi T\u00e4m\u00e4nhetkinen Nykytila\n(Ty\u00f6nt\u00f6)Suunta Eteenp\u00e4in\n(Toiminta/Uudistuminen)\nLuonto Luonnon kantokyky\nmurenee Ekologinen j\u00e4lleenrakennus -\nsopeudutaan rajoihin ja parannetaan\nluonnon tilaa.\nTalous Talouden perusta\nrakoilee (eriarvoisuus,\nekokriisi) Korjaava ja uusintava talous -\nuudistetaan taloutta\nmuutosvoimaisemmaksi kest\u00e4v\u00e4n ja\nvastuullisen kehityksen periaattein.\n\nkoosta n\u00e4ist\u00e4 vastauksista 1 sivun raporttiMegatrendi T\u00e4m\u00e4nhetkinen Nykytila\n(Ty\u00f6nt\u00f6)Suunta Eteenp\u00e4in\n(Toiminta/Uudistuminen)\nValta Demokratian kamppailu\nkovenee (geopolitiikka,\nluottamuskriisi) Demokratian vahvistaminen - lis\u00e4\u00e4m\u00e4ll\u00e4\nosallisuutta ja vaikutusmahdollisuuksia.\nTeknologia Kilpailu digivallasta\nkiihtyy (dataj\u00e4tit,\nresurssit) Reilu digimaailma - kehitt\u00e4m\u00e4ll\u00e4\nteknologiaa ja dataa reilusti ja kest\u00e4v\u00e4sti\n(esim. Web 3.0, datatalouden s\u00e4\u00e4nn\u00f6t).\nIhmiset Hyvinvoinnin haasteet\nkasvavat\n(mielenterveys,\nik\u00e4\u00e4ntyminen) Kokonaisvaltainen hyvinvointi -\nongelmien ennaltaehk\u00e4isy ja satsaaminen\nekologisen ja sosiaalisen p\u00e4\u00e4oman\nuusintamiseen.\nSitra n\u00e4kee, ett\u00e4 tulevaisuus ei vain \"vy\u00f6ry p\u00e4\u00e4lle\", vaan jokaisella on vastuu ajatella pidemp\u00e4\u00e4 aikav\u00e4li\u00e4\nja rakentaa parempaa tulevaisuutta.content_copy\nAnalyysi Sitran Megatrendien Evoluutiosta (2017  2023) \u2013 Johtoryhm\u00e4lle\nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit 2017, 2020, 2023\nTiivistelm\u00e4: Merkitt\u00e4vin Evoluutio\nSitran megatrendien merkitt\u00e4vin evoluutio vuosien 2017 ja 2023 v\u00e4lill\u00e4 on s\u00e4vyn ja painopisteen\ndramaattinen siirtym\u00e4 tulevaisuuden potentiaaleista ja kehityskuluista kohti samanaikaisia,\ngeopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4 murtumia. Vuoden 2017 raporteissa megatrendit\nesitettiin kuvailevina teemoina, kun taas 2023 raportissa ne on otsikoitu korostamaan kasautuvia\nhaasteita, konflikteja ja perustojen horjumista. Maailma on siirtynyt ennakoitavista pitkist\u00e4 kaarista\n(2017) kriisien tilaan (2023).\nI. Megatrendien Kooste ja Evoluutio\nTeema 2017\n(Potentiaali/Suunta)2023\n(Kriisi/Kamppailu)Evoluution\nYdin\nYmp\u00e4rist\u00f6/Luonto Ymm\u00e4rrys\nmaapallon\nkantokyvyst\u00e4\nkasvaa \n(Kest\u00e4vyyskriisi nyt \n)Luonnon\nkantokyky\nmureneeTONAALINEN\nESKALAATIO: Haaste on\nmuuttunut akuutista\ntietoisuudesta\nperustavanlaatuiseksi,\nuhkaavaksi murtumaksi.\nValta/Geopolitiikka Verkon\njoukkovoima haaste\nja mahdollisuus \n(Globalisaatio vs.\nnationalismi )Demokratian\nkamppailu\nkoveneeGEOPOLITISOITUMINEN:\nTeema on muuttunut\nsosiaalisista ilmi\u00f6ist\u00e4\nsuoraan kansainv\u00e4lisen\nvaltataistelun ja konfliktin\nkuvaajaksi.\n\u2192\nTeema 2017\n(Potentiaali/Suunta)2023\n(Kriisi/Kamppailu)Evoluution\nYdin\nTeknologia Data on valtaa ja\nvaurautta \n(Super\u00e4lykkyys\novella )Kilpailu\ndigivallasta\nkiihtyyVALTAKILPAILU:\nTeknologian potentiaali on\nmuuttunut digitaalisten\nresurssien hallinnasta ja\nteknologiaj\u00e4ttien\nylivallasta k\u00e4yt\u00e4v\u00e4ksi\ngeopoliittiseksi kilpailuksi.\nTalous Eriarvoisuus on\npolttava kysymys \n(Ty\u00f6n murros )Talouden\nperusta\nrakoileeINSTABILITEETIN\nKOROSTUMINEN:\nTalouden kytk\u00f6kset\nekologiseen kriisiin ja\nkasvavaan eriarvoisuuteen\nn\u00e4hd\u00e4\u00e4n perustojen\nhorjumisena.\nIhmiset Terveys on valtava\ntrendi ja bisnes \n(Elinik\u00e4 pitenee )Hyvinvoinnin\nhaasteet\nkasvavatSOSIAALINEN KRIISI:\nMielenterveysongelmien\nlis\u00e4\u00e4ntyminen\nep\u00e4varmuuden vuoksi on\nnoussut keskeiseksi\nhaasteeksi ik\u00e4\u00e4ntymisen\nrinnalle.\nII. Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in (Ei Toivetila)\nSitran n\u00e4kemys tulevaisuuden suunnasta (Ty\u00f6nt\u00f6 ja Paino) edellytt\u00e4\u00e4 samanaikaista sopeutumista ja\nuudistumista. Paluuta vanhaan normaaliin ei ole, vaan suunta eteenp\u00e4in on transformatiivinen ja rakentuu\nnykyhetkess\u00e4 tehdyill\u00e4 valinnoilla kriisien keskell\u00e4.\nMegatrendin\nTunnistama\nNykytilaSitran Edellytt\u00e4m\u00e4\nSuunta Eteenp\u00e4in\n(Toiminta)\nEkologinen kriisi:\nLuonnon kantokyky\nmurenee.Ekologinen j\u00e4lleenrakennus: Sopeudutaan rajoihin ja\nsatsataan luonnon tilaa parantavaan yhteiskuntaan (esim.\nkiertotalous).\nTalouden perusta\nrakoilee.Korjaava ja uusintava talous: Uudistetaan taloutta\nmuutosvoimaisemmaksi ja noudatetaan kest\u00e4v\u00e4n ja\nvastuullisen kehityksen periaatteita.\nValta: Demokratian\nkamppailu kovenee.Demokratian vahvistaminen: Lis\u00e4t\u00e4\u00e4n osallisuutta ja\nvaikutusmahdollisuuksia luottamuksen vahvistamiseksi.\nTeknologia: Kilpailu\ndigivallasta kiihtyy.Reilu digimaailma: Kehitet\u00e4\u00e4n dataa ja teknologiaa reilusti ja\nkest\u00e4v\u00e4sti luomalla datataloudelle pelis\u00e4\u00e4nn\u00f6t.\nIhmiset: Hyvinvoinnin\nhaasteet kasvavat.Kokonaisvaltainen hyvinvointi: Satsataan pitk\u00e4j\u00e4nteisesti\nongelmien ennaltaehk\u00e4isyyn ja sosiaalisen p\u00e4\u00e4oman\nvahvistamiseen.content_copy\ncontent_copy\nn\u00e4yt\u00e4 raportti uudestaan ja varmista, ett\u00e4 taulukot ovat kohdallaanIII. Ennusteiden Osuvuus (J\u00e4lkeenp\u00e4in Katsoen)\nSitran raportit onnistuivat tunnistamaan useita my\u00f6hemmin kiihtyneit\u00e4 muutoksia.\nOsuvuus Esimerkit\nOsuva (Kriisiytyneet\nIlmi\u00f6t)Ekologisen kriisin eskaloituminen: Kest\u00e4vyyskriisin kiireellisyys (2020)\nvahvistui, Luonnon kantokyvyn mureneminen (2023) heijastaa\ntoteutunutta vakavuutta. Geopolitiikan ja konfliktin paluu:\nInformaatiovaikuttamisen ja digivallan kilpailun korostus (2020/2023)\nosui oikeaan (esim. Ukrainan sota, teknologiaj\u00e4ttien ylivalta).\nMonimutkainen/Aliarvioitu Ty\u00f6n murros ja Automaatio: Vaikka murros tunnistettiin, massiivista\nty\u00f6paikkojen katoa ei ole tapahtunut; ennemmin on n\u00e4hty kohtaanto-\nongelmia ja osaamistarpeiden jatkuvaa kehityst\u00e4.\nSitran n\u00e4kemyksen mukaan tulevaisuus ei vain vy\u00f6ry p\u00e4\u00e4lle, vaan sen suunta on avoin. T\u00e4m\u00e4n vuoksi\ntulevaisuusresilienssin (kyky selviyty\u00e4 kriiseist\u00e4 ja samalla uudistua) vahvistaminen on ensisijainen\ntavoite.content_copy\nAnalyysi Sitran Megatrendien Evoluutiosta (2017  2023) \u2013 Johtoryhm\u00e4lle\nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit 2017, 2020, 2023\nTiivistelm\u00e4: Merkitt\u00e4vin Evoluutio\nSitran megatrendien merkitt\u00e4vin evoluutio vuosien 2017 ja 2023 v\u00e4lill\u00e4 on s\u00e4vyn ja painopisteen\ndramaattinen siirtym\u00e4 tulevaisuuden potentiaaleista ja kehityskuluista kohti samanaikaisia,\ngeopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4 murtumia. Vuoden 2017 raporteissa megatrendit\nesitettiin kuvailevina teemoina, kun taas 2023 raportissa ne on otsikoitu korostamaan kasautuvia\nhaasteita, konflikteja ja perustojen horjumista. Maailma on siirtynyt ennakoitavista pitkist\u00e4 kaarista\n(2017) kriisien tilaan (2023).\nI. Megatrendien Kooste ja Evoluutio\nTeema 2017\n(Potentiaali/Suunta)2023\n(Kriisi/Kamppailu)Evoluution\nYdin\nYmp\u00e4rist\u00f6/Luonto Ymm\u00e4rrys\nmaapallon\nkantokyvyst\u00e4\nkasvaa\n(Kest\u00e4vyyskriisi\nnyt) Luonnon\nkantokyky\nmureneeTONAALINEN\nESKALAATIO: Haaste on\nmuuttunut akuutista\ntietoisuudesta\nperustavanlaatuiseksi,\nuhkaavaksi murtumaksi.\nValta/Geopolitiikka Verkon\njoukkovoima haaste\nja mahdollisuus\n(Globalisaatio vs.\nnationalismi) Demokratian\nkamppailu\nkoveneeGEOPOLITISOITUMINEN:\nTeema on muuttunut\nsosiaalisista ilmi\u00f6ist\u00e4\nsuoraan kansainv\u00e4lisen\nvaltataistelun ja konfliktin\nkuvaajaksi.\nTeknologia Data on valtaa ja\nvaurautta\n(Super\u00e4lykkyys\novella) Kilpailu\ndigivallasta\nkiihtyyVALTAKILPAILU:\nTeknologian potentiaali on\nmuuttunut digitaalisten\nresurssien hallinnasta ja\nteknologiaj\u00e4ttien\n\u2192\nTeema 2017\n(Potentiaali/Suunta)2023\n(Kriisi/Kamppailu)Evoluution\nYdin\nylivallasta k\u00e4yt\u00e4v\u00e4ksi\ngeopoliittiseksi kilpailuksi.\nTalous Eriarvoisuus on\npolttava kysymys\n(Ty\u00f6n murros) Talouden\nperusta\nrakoileeINSTABILITEETIN\nKOROSTUMINEN:\nTalouden kytk\u00f6kset\nekologiseen kriisiin ja\nkasvavaan eriarvoisuuteen\nn\u00e4hd\u00e4\u00e4n perustojen\nhorjumisena.\nIhmiset Terveys on valtava\ntrendi ja bisnes\n(Elinik\u00e4 pitenee) Hyvinvoinnin\nhaasteet\nkasvavatSOSIAALINEN KRIISI:\nMielenterveysongelmien\nlis\u00e4\u00e4ntyminen\nep\u00e4varmuuden vuoksi on\nnoussut keskeiseksi\nhaasteeksi ik\u00e4\u00e4ntymisen\nrinnalle.\nII. Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in (Ei Toivetila)\nSitran n\u00e4kemys tulevaisuuden suunnasta (Ty\u00f6nt\u00f6 ja Paino) edellytt\u00e4\u00e4 samanaikaista sopeutumista ja\nuudistumista postnormaalissa ajassa. Paluuta vanhaan normaaliin ei ole, vaan suunta eteenp\u00e4in on\ntransformatiivinen, ja sen n\u00e4hd\u00e4\u00e4n rakentuvan nykyhetkess\u00e4 tehdyill\u00e4 p\u00e4\u00e4t\u00f6ksill\u00e4 ja valinnoilla kriisien\nkeskell\u00e4.\nMegatrendin\nTunnistama\nNykytilaSitran Edellytt\u00e4m\u00e4 Suunta\nEteenp\u00e4in\n(Toiminta/Uudistuminen)\nEkologinen kriisi: Luonnon\nkantokyky murenee.Ekologinen j\u00e4lleenrakennus: Sopeudutaan\nmaapallon rajoihin ja satsataan luonnon tilaa\nparantavaan yhteiskuntaan.\nTalous: Talouden perusta rakoilee. Korjaava ja uusintava talous: Uudistetaan taloutta\nmuutosvoimaisemmaksi kest\u00e4v\u00e4n ja vastuullisen\nkehityksen periaattein.\nValta: Demokratian kamppailu\nkovenee.Demokratian vahvistaminen: Lis\u00e4t\u00e4\u00e4n osallisuutta\nja vaikutusmahdollisuuksia luottamuksen\nvahvistamiseksi.\nTeknologia: Kilpailu digivallasta\nkiihtyy.Reilu digimaailma: Kehitet\u00e4\u00e4n dataa ja teknologiaa\nreilusti ja kest\u00e4v\u00e4sti luomalla datataloudelle\npelis\u00e4\u00e4nn\u00f6t.\nIhmiset: Hyvinvoinnin haasteet\nkasvavat.Kokonaisvaltainen hyvinvointi: Satsataan\npitk\u00e4j\u00e4nteisesti ongelmien ennaltaehk\u00e4isyyn ja\nsosiaalisen p\u00e4\u00e4oman vahvistamiseen.\nIII. Ennusteiden Osuvuus (J\u00e4lkeenp\u00e4in Katsoen)content_copy\ncontent_copy\npoista taulukot ja kerro ne tekstin\u00e4Sitran raportit onnistuivat tunnistamaan useita my\u00f6hemmin kiihtyneit\u00e4 muutoksia.\nOsuvuus Esimerkit\nOsuva (Kriisiytyneet\nIlmi\u00f6t)Ekologisen kriisin eskaloituminen: Kest\u00e4vyyskriisin kiireellisyys (2020)\nvahvistui, Luonnon kantokyvyn mureneminen (2023) heijastaa\ntoteutunutta vakavuutta. Geopolitiikan ja konfliktin paluu:\nGeopoliittisen valtataistelun ja informaatiovaikuttamisen korostus\n(2020/2023) osui oikeaan (esim. Ukrainan sota, luottamuskriisi).\nMonimutkainen/Aliarvioitu Ty\u00f6n murros ja Automaatio: Ty\u00f6n murros tunnistettiin, mutta seuraus\non ollut ennemmin kohtaanto-ongelmia ja osaamistarpeiden\nkehityst\u00e4 kuin massiivista ty\u00f6paikkojen katoa.\nSitran n\u00e4kemyksen mukaan tulevaisuus ei vain vy\u00f6ry p\u00e4\u00e4lle, vaan sen suunta on avoin. T\u00e4m\u00e4n vuoksi\ntulevaisuusresilienssin (kyky selviyty\u00e4 kriiseist\u00e4 ja samalla uudistua) vahvistaminen on ensisijainen\ntavoite.content_copy\nAnalyysi Sitran Megatrendien Evoluutiosta (2017  2023) \u2013 Johtoryhm\u00e4lle\nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit 2017, 2020, 2023\nTiivistelm\u00e4: Merkitt\u00e4vin Evoluutio\nSitran megatrendien merkitt\u00e4vin evoluutio vuosien 2017 ja 2023 v\u00e4lill\u00e4 on s\u00e4vyn ja painopisteen\ndramaattinen siirtym\u00e4 tulevaisuuden potentiaaleista ja kehityskuluista kohti samanaikaisia,\ngeopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4 murtumia. Vuoden 2017 raporteissa megatrendit\nesitettiin kuvailevina teemoina, kun taas 2023 raportissa ne on otsikoitu korostamaan kasautuvia\nhaasteita, konflikteja ja perustojen horjumista. Maailma on siirtynyt ennakoitavista pitkist\u00e4 kaarista\n(2017) kriisien tilaan (2023).\nI. Megatrendien Kooste ja Evoluutio Tekstin\u00e4\nMegatrendien evoluutio heijastelee s\u00e4vyn muutosta potentiaalista kriisiksi ja geopolitiikan\nkorostumista.\nYmp\u00e4rist\u00f6/Luonto: Vuonna 2017 teemaa l\u00e4hestyttiin Ymm\u00e4rrys maapallon kantokyvyst\u00e4 kasvaa -\notsikolla, korostaen tietoisuuden lis\u00e4\u00e4ntymist\u00e4. Vuonna 2023 t\u00e4m\u00e4 on eskaloitunut Luonnon\nkantokyky murenee -teemaksi. Evoluutio on tonaalinen eskalaatio akuutista tietoisuudesta\nperustavanlaatuiseksi, uhkaavaksi murtumaksi.\nValta/Geopolitiikka: Vuonna 2017 puhuttiin Verkon joukkovoima haaste ja mahdollisuus -teemasta,\njoka liittyi digitaaliseen osallistumiseen. Vuonna 2023 teema on muuttunut Demokratian kamppailu\nkovenee -otsikoksi. Evoluutio on geopoliittinen, korostaen suoraa kansainv\u00e4list\u00e4 valtataistelua ja\nkonfliktia.\nTeknologia: Vuonna 2017 teema oli Data on valtaa ja vaurautta, painottaen sen potentiaalia. Vuonna\n2023 teknologian teema on Kilpailu digivallasta kiihtyy. Evoluutio on siirtynyt teknologian\npotentiaalista valtakilpailuun ja geopoliittiseen kilpailuun datan hallinnasta ja teknologiayhti\u00f6iden\nylivallasta.\n\u2192\nMegatrendien Kooste ja Evoluutio Tekstin\u00e4, ota n\u00e4iss\u00e4 v\u00e4leiss\u00e4 aina kun on j\u00e4rkev\u00e4\u00e4 v\u00e4lil\u00e4 olevista\nmegatrendeist\u00e4 viestej\u00e4Talous: Vuonna 2017 teema oli, ett\u00e4 Eriarvoisuus on polttava kysymys. Vuonna 2023 teema on\nTalouden perusta rakoilee. Evoluutio on instabiliteetin korostuminen, jossa talouden perustusten\nhorjuminen n\u00e4hd\u00e4\u00e4n suoraan kytk\u00f6ksiss\u00e4 ekologiseen kriisiin ja kasvavaan eriarvoisuuteen.\nIhmiset: Vuonna 2017 teema oli Terveys on valtava trendi ja bisnes, keskittyen elini\u00e4n pitenemiseen.\nVuonna 2023 teema on Hyvinvoinnin haasteet kasvavat. Evoluutio on sosiaalinen kriisi, jossa\nmielenterveysongelmien lis\u00e4\u00e4ntyminen ep\u00e4varmuuden vuoksi on noussut keskeiseksi haasteeksi\nik\u00e4\u00e4ntymisen rinnalle.\nII. Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in (Ei Toivetila)\nSitran n\u00e4kemys tulevaisuuden suunnasta (Ty\u00f6nt\u00f6 ja Paino) edellytt\u00e4\u00e4 samanaikaista sopeutumista ja\nuudistumista postnormaalissa ajassa. Paluuta vanhaan normaaliin ei ole, vaan suunta eteenp\u00e4in on\ntransformatiivinen, ja sen n\u00e4hd\u00e4\u00e4n rakentuvan nykyhetkess\u00e4 tehdyill\u00e4 valinnoilla kriisien keskell\u00e4.\nEkologinen kriisi: Luonnon kantokyvyn murentuessa suunta on Ekologinen j\u00e4lleenrakennus \u2013\nsopeudutaan maapallon rajoihin ja satsataan luonnon tilaa parantavaan yhteiskuntaan.\nTalous: Talouden perustan rakoillessa suunta on Korjaava ja uusintava talous, jossa uudistetaan\ntaloutta muutosvoimaisemmaksi kest\u00e4v\u00e4n ja vastuullisen kehityksen periaattein.\nValta: Demokratian kamppailun koventuessa suunta on Demokratian vahvistaminen lis\u00e4\u00e4m\u00e4ll\u00e4\nosallisuutta ja vaikutusmahdollisuuksia luottamuksen vahvistamiseksi.\nTeknologia: Kilpailun digivallasta kiihtyess\u00e4 suunta on Reilu digimaailma \u2013 kehitet\u00e4\u00e4n teknologiaa ja\ndataa reilusti ja kest\u00e4v\u00e4sti luomalla datataloudelle pelis\u00e4\u00e4nn\u00f6t.\nIhmiset: Hyvinvoinnin haasteiden kasvaessa suunta on Kokonaisvaltainen hyvinvointi, jossa\nsatsataan ongelmien ennaltaehk\u00e4isyyn ja sosiaalisen p\u00e4\u00e4oman vahvistamiseen.\nIII. Ennusteiden Osuvuus (J\u00e4lkeenp\u00e4in Katsoen)\nSitran raportit onnistuivat tunnistamaan useita my\u00f6hemmin kiihtyneit\u00e4 muutoksia.\nOsuva (Kriisiytyneet Ilmi\u00f6t):Ekologisen kriisin eskaloituminen ja sen kiireellisyys vahvistui.\nGeopolitiikan ja konfliktin paluu (esim. Ukrainan sota, teknologiaj\u00e4ttien ylivalta) ja\ninformaatiovaikuttamisen korostus osuivat oikeaan.\nMonimutkainen/Aliarvioitu: Vaikka Ty\u00f6n murros tunnistettiin, seuraus on ollut ennemmin\nkohtaanto-ongelmia ja osaamistarpeiden kehityst\u00e4 kuin ennustettua massiivista ty\u00f6paikkojen\nkatoa.\nSitran n\u00e4kemyksen mukaan tulevaisuus ei vain vy\u00f6ry p\u00e4\u00e4lle, vaan sen suunta on avoin. T\u00e4m\u00e4n vuoksi\ntulevaisuusresilienssin (kyky selviyty\u00e4 kriiseist\u00e4 ja samalla uudistua) vahvistaminen on ensisijainen\ntavoite.\nAnalyysi Sitran Megatrendien Evoluutiosta (2017  2023) \u2013 Johtoryhm\u00e4lle\nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit 2017, 2020, 2023\nTiivistelm\u00e4: Merkitt\u00e4vin Evoluutio\nSitran megatrendien merkitt\u00e4vin evoluutio vuosien 2017 ja 2023 v\u00e4lill\u00e4 on s\u00e4vyn ja painopisteen\ndramaattinen siirtym\u00e4 tulevaisuuden potentiaaleista ja kehityskuluista kohti samanaikaisia,\n\u2192\ngeopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4 murtumia. Maailma on siirtynyt ennakoitavista\npitkist\u00e4 kaarista (2017) kriisien tilaan (2023).\nI. Megatrendien Kooste ja Evoluutio Tekstin\u00e4\nMegatrendien evoluutio heijastelee s\u00e4vyn muutosta potentiaalista kriisiksi ja geopolitiikan\nkorostumista.\nYmp\u00e4rist\u00f6/Luonto: Tonaalinen Eskalaatio\nVuonna 2017 teemaa l\u00e4hestyttiin Ymm\u00e4rrys maapallon kantokyvyst\u00e4 kasvaa -otsikolla , korostaen\ntietoisuuden lis\u00e4\u00e4ntymist\u00e4 ja kest\u00e4vyyskriisin akuuttia luonnetta. Vuonna 2020 viesti eskaloitui siihen, ett\u00e4\nEkologisella j\u00e4lleenrakennuksella on kiire. Vuonna 2023 teema on muuttunut Luonnon kantokyky\nmurenee -otsikoksi. Evoluutio on tonaalinen eskalaatio akuutista tietoisuudesta (2017)\nperustavanlaatuiseksi, uhkaavaksi murtumaksi (2023), joka edellytt\u00e4\u00e4 ekologista j\u00e4lleenrakennusta.\nValta/Geopolitiikka: Geopolitisoituminen ja Konflikti\nVuonna 2017 puhuttiin Verkon joukkovoima haaste ja mahdollisuus -teemasta , joka liittyi digitaaliseen\nosallistumiseen ja globalisaation vastatrendiin (nationalismi). Vuonna 2020 valta-teemaa l\u00e4hestyttiin\nVerkostomainen valta voimistuu -otsikolla, siirtym\u00e4ll\u00e4 moninapaisesta monisolmuiseen maailmaan. Vuonna\n2023 teema on muuttunut Demokratian kamppailu kovenee -otsikoksi. Evoluutio on geopoliittinen,\nkorostaen suoraa kansainv\u00e4list\u00e4 valtataistelua, s\u00e4\u00e4nt\u00f6pohjaisen maailmanj\u00e4rjestyksen horjumista ja\nluottamuksen rapautumista informaatiovaikuttamisen takia.\nTeknologia: Valta-asetelmista Kilpailuun\nVuonna 2017 teknologian teema oli Data on valtaa ja vaurautta, painottaen sen potentiaalia, rinnalla\nSuper\u00e4lykkyys on jo ovella. Vuonna 2020 teema oli, ett\u00e4 teknologia sulautuu kaikkeen. Vuonna 2023\nteknologian teema on Kilpailu digivallasta kiihtyy. Evoluutio on siirtynyt teknologian potentiaalista ja\nsulautumisesta (2017-2020) suoraan valtakilpailuun (2023) ja geopoliittiseen kilpailuun datan hallinnasta\nja teknologiayhti\u00f6iden ylivallasta.\nTalous: Instabiliteetin Korostuminen\nVuonna 2017 teema oli, ett\u00e4 Eriarvoisuus on polttava kysymys. Vuonna 2020 teema oli laajentunut\nTalousj\u00e4rjestelm\u00e4 etsii suuntaansa -otsikoksi, keskittyen kasvuriippuvuuteen ja tarpeeseen siirty\u00e4\nkorjaavaan ja uudistavaan talouteen. Vuonna 2023 teema on Talouden perusta rakoilee. Evoluutio on\ninstabiliteetin korostuminen, jossa talouden perustusten horjuminen n\u00e4hd\u00e4\u00e4n suoraan kytk\u00f6ksiss\u00e4\nekologiseen kriisiin ja kasvavaan eriarvoisuuteen.\nIhmiset: Hyvinvoinnin Mielenterveyskriisi\nVuonna 2017 teema oli Terveys on valtava trendi ja bisnes, keskittyen elini\u00e4n pitenemiseen. Vuonna 2023\nfokus on siirtynyt Hyvinvoinnin haasteet kasvavat -teemaan. Evoluutio on sosiaalinen kriisi, jossa\nv\u00e4est\u00f6n ik\u00e4\u00e4ntymisen ja eriarvoisuuden lis\u00e4ksi korostuu mielenterveysongelmien lis\u00e4\u00e4ntyminen\ntulevaisuutta koskevan ep\u00e4varmuuden vuoksi.\nII. Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in (Ei Toivetila)\nSitran n\u00e4kemys tulevaisuuden suunnasta (Ty\u00f6nt\u00f6 ja Paino) edellytt\u00e4\u00e4 samanaikaista sopeutumista ja\nuudistumista postnormaalissa ajassa. Paluuta vanhaan normaaliin ei ole, vaan suunta eteenp\u00e4in on\ntransformatiivinen ja edellytt\u00e4\u00e4 muutoskyky\u00e4.\n\u00a0Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in\u00a0 muuta taulukko tekstiksiMegatrendin\nTunnistama\nNykytilaSitran Edellytt\u00e4m\u00e4 Suunta\nEteenp\u00e4in (Toiminta/Uudistuminen)\nLuonnon\nkantokyky\nmureneeEkologinen j\u00e4lleenrakennus: Sopeudutaan maapallon\nrajoihin ja satsataan luonnon tilaa parantavaan\nyhteiskuntaan.\nTalouden perusta\nrakoileeKorjaava ja uusintava talous: Uudistetaan taloutta\nmuutosvoimaisemmaksi kest\u00e4v\u00e4n ja vastuullisen\nkehityksen periaattein.\nDemokratian\nkamppailu\nkoveneeDemokratian vahvistaminen: Lis\u00e4t\u00e4\u00e4n osallisuutta ja\nvaikutusmahdollisuuksia luottamuksen vahvistamiseksi.\nKilpailu digivallasta\nkiihtyyReilu digimaailma: Kehitet\u00e4\u00e4n dataa ja teknologiaa\nreilusti ja kest\u00e4v\u00e4sti luomalla datataloudelle\npelis\u00e4\u00e4nn\u00f6t.\nHyvinvoinnin\nhaasteet kasvavatKokonaisvaltainen hyvinvointi: Satsataan ongelmien\nennaltaehk\u00e4isyyn ja sosiaalisen p\u00e4\u00e4oman\nvahvistamiseen.\nSitran mukaan t\u00e4m\u00e4 tulevaisuusresilienssin vahvistaminen on ensisijainen tavoite, sill\u00e4 kriisit kietoutuvat\ntoisiinsa, ja jokaisella on vastuu rakentaa reilua, kest\u00e4v\u00e4\u00e4 ja innostavaa tulevaisuutta.content_copy\nAnalyysi Sitran Megatrendien Evoluutiosta (2017  2023) \u2013 Johtoryhm\u00e4lle\nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit 2017, 2020, 2023\nTiivistelm\u00e4: Merkitt\u00e4vin Evoluutio\nSitran megatrendien merkitt\u00e4vin evoluutio vuosien 2017 ja 2023 v\u00e4lill\u00e4 on s\u00e4vyn ja painopisteen\ndramaattinen siirtym\u00e4 tulevaisuuden potentiaaleista ja kehityskuluista kohti samanaikaisia,\ngeopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4 murtumia. Maailma on siirtynyt ennakoitavista\npitkist\u00e4 kaarista (2017) kriisien tilaan (2023).\nI. Megatrendien Kooste ja Evoluutio Tekstin\u00e4\nMegatrendien evoluutio heijastelee s\u00e4vyn muutosta potentiaalista kriisiksi ja geopolitiikan\nkorostumista.\nYmp\u00e4rist\u00f6/Luonto: Vuonna 2017 teemaa l\u00e4hestyttiin Ymm\u00e4rrys maapallon kantokyvyst\u00e4 kasvaa -\notsikolla, korostaen tietoisuuden lis\u00e4\u00e4ntymist\u00e4 ja kest\u00e4vyyskriisin akuuttia luonnetta. Vuonna 2020\nviesti eskaloitui siihen, ett\u00e4 Ekologisella j\u00e4lleenrakennuksella on kiire. Vuonna 2023 teema on\nmuuttunut Luonnon kantokyky murenee -otsikoksi. Evoluutio on tonaalinen eskalaatio akuutista\ntietoisuudesta (2017) perustavanlaiseksi, uhkaavaksi murtumaksi (2023), joka edellytt\u00e4\u00e4 ekologista\nj\u00e4lleenrakennusta.\nValta/Geopolitiikka: Vuonna 2017 puhuttiin Verkon joukkovoima haaste ja mahdollisuus -teemasta,\njoka liittyi digitaaliseen osallistumiseen. Vuonna 2020 valta-teemaa l\u00e4hestyttiin Verkostomainen valta\n\u2192\nvoimistuu -otsikolla. Vuonna 2023 teema on muuttunut Demokratian kamppailu kovenee -otsikoksi.\nEvoluutio on geopoliittinen, korostaen suoraa kansainv\u00e4list\u00e4 valtataistelua, s\u00e4\u00e4nt\u00f6pohjaisen\nmaailmanj\u00e4rjestyksen horjumista ja luottamuksen rapautumista informaatiovaikuttamisen takia.\nTeknologia: Vuonna 2017 teknologian teema oli Data on valtaa ja vaurautta, rinnalla Super\u00e4lykkyys on\njo ovella. Vuonna 2020 teema oli, ett\u00e4 teknologia sulautuu kaikkeen. Vuonna 2023 teknologian teema\non Kilpailu digivallasta kiihtyy. Evoluutio on siirtynyt teknologian potentiaalista ja sulautumisesta\n(2017-2020) suoraan valtakilpailuun (2023) ja geopoliittiseen kilpailuun datan hallinnasta ja\nteknologiayhti\u00f6iden ylivallasta.\nTalous: Vuonna 2017 teema oli, ett\u00e4 Eriarvoisuus on polttava kysymys. Vuonna 2020 teema oli\nlaajentunut Talousj\u00e4rjestelm\u00e4 etsii suuntaansa -otsikoksi. Vuonna 2023 teema on Talouden perusta\nrakoilee. Evoluutio on instabiliteetin korostuminen, jossa talouden perustusten horjuminen n\u00e4hd\u00e4\u00e4n\nsuoraan kytk\u00f6ksiss\u00e4 ekologiseen kriisiin ja kasvavaan eriarvoisuuteen.\nIhmiset: Vuonna 2017 teema oli Terveys on valtava trendi ja bisnes. Vuonna 2023 fokus on siirtynyt\nHyvinvoinnin haasteet kasvavat -teemaan. Evoluutio on sosiaalinen kriisi, jossa v\u00e4est\u00f6n\nik\u00e4\u00e4ntymisen ja eriarvoisuuden lis\u00e4ksi korostuu mielenterveysongelmien lis\u00e4\u00e4ntyminen\ntulevaisuutta koskevan ep\u00e4varmuuden vuoksi.\nII. Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in (Ei Toivetila)\nSitran n\u00e4kemys tulevaisuuden suunnasta (Ty\u00f6nt\u00f6 ja Paino) edellytt\u00e4\u00e4 samanaikaista sopeutumista ja\nuudistumista postnormaalissa ajassa. Paluuta vanhaan normaaliin ei ole, vaan suunta eteenp\u00e4in on\ntransformatiivinen, ja sen n\u00e4hd\u00e4\u00e4n rakentuvan nykyhetkess\u00e4 tehdyill\u00e4 valinnoilla kriisien keskell\u00e4.\nSitran n\u00e4kem\u00e4 suunta eteenp\u00e4in vaatii aktiivista uudistumista vastauksena nykyhetken haasteisiin:\nEkologinen j\u00e4lleenrakennus: Luonnon kantokyvyn murentuessa suunta on Ekologinen\nj\u00e4lleenrakennus, jossa sopeudutaan maapallon rajoihin ja satsataan luonnon tilaa parantavaan\nyhteiskuntaan.\nKorjaava ja uusintava talous: Talouden perustan rakoillessa vaaditaan Korjaavaa ja uusintavaa\ntaloutta \u2013 talous on uudistettava muutosvoimaisemmaksi kest\u00e4v\u00e4n ja vastuullisen kehityksen\nperiaattein.\nDemokratian vahvistaminen: Demokratian kamppailun koventuessa suunta on Demokratian\nvahvistaminen lis\u00e4\u00e4m\u00e4ll\u00e4 osallisuutta ja vaikutusmahdollisuuksia luottamuksen vahvistamiseksi.\nReilu digimaailma: Kilpailun digivallasta kiihtyess\u00e4 suunta on Reilu digimaailma, miss\u00e4 teknologiaa\nja dataa kehitet\u00e4\u00e4n reilusti ja kest\u00e4v\u00e4sti luomalla datataloudelle pelis\u00e4\u00e4nn\u00f6t.\nKokonaisvaltainen hyvinvointi: Hyvinvoinnin haasteiden kasvaessa suunta on Kokonaisvaltainen\nhyvinvointi, jossa satsataan ongelmien ennaltaehk\u00e4isyyn ja sosiaalisen p\u00e4\u00e4oman vahvistamiseen.\nSitran mukaan t\u00e4m\u00e4 tulevaisuusresilienssin vahvistaminen on ensisijainen tavoite, sill\u00e4 kriisit kietoutuvat\ntoisiinsa, ja jokaisella on vastuu rakentaa reilua, kest\u00e4v\u00e4\u00e4 ja innostavaa tulevaisuutta.\nIII. Ennusteiden Osuvuus (J\u00e4lkeenp\u00e4in Katsoen)\nSitran raportit onnistuivat tunnistamaan useita my\u00f6hemmin kiihtyneit\u00e4 muutoksia.\nOsuva (Kriisiytyneet Ilmi\u00f6t):Ekologisen kriisin eskaloituminen ja sen kiireellisyys vahvistui.\nGeopolitiikan ja konfliktin paluu (esim. Ukrainan sota, teknologiaj\u00e4ttien ylivalta) ja\ninformaatiovaikuttamisen korostus osuivat oikeaan.\nMonimutkainen/Aliarvioitu: Vaikka Ty\u00f6n murros tunnistettiin, seuraus on ollut ennemmin\nkohtaanto-ongelmia ja osaamistarpeiden kehityst\u00e4 kuin ennustettua massiivista ty\u00f6paikkojen\nkatoa.\nMegatrendien Kooste, voiko t\u00e4ss\u00e4 olevia asioita yhdistell\u00e4 ja tuottaa supermegatrendej\u00e4\nKyll\u00e4, Sitran megatrendien pohjalta voi ehdottomasti yhdistelem\u00e4ll\u00e4 tuottaa niin kutsuttuja\nsupermegatrendej\u00e4 (tai metatrendej\u00e4) , jotka kuvaavat useampia teemoja l\u00e4pileikkaavia, syvempi\u00e4\nmuutosvoimia. Raportit itsess\u00e4\u00e4n tunnistavat t\u00e4m\u00e4n tarpeen, sill\u00e4 ne korostavat megatrendien v\u00e4lisi\u00e4\nkytk\u00f6ksi\u00e4 ja j\u00e4nnitteit\u00e4.\nSupermegatrendit syntyv\u00e4t, kun tarkastellaan, miten kaksi tai useampi megatrendi t\u00f6rm\u00e4\u00e4v\u00e4t ja luovat\nuudenlaisen, laajemman muutoksen tilan.\nSitran Megatrendeist\u00e4 Johdetut Supermegatrendit\nSitran viiden p\u00e4\u00e4megatrendin (Luonto, Ihmiset, Valta, Teknologia, Talous)  perusteella voidaan tunnistaa\nkolme keskeist\u00e4 supermegatrendi\u00e4, jotka kuvaavat evoluutiota 2017\u20132023:\n1. Ekologinen Resilienssikriisi (Luonto + Talous + Ihmiset) \ud83d\udea8\nT\u00e4m\u00e4 supermegatrendi syntyy ekologisen kriisin (Luonnon kantokyky murenee) ja taloudellisen sek\u00e4\nsosiaalisen vakauden (Talouden perusta rakoilee, Hyvinvoinnin haasteet kasvavat)  v\u00e4lisest\u00e4 suorasta\nkytk\u00f6ksest\u00e4.\nYdin: Yhteiskunnan on pakko siirty\u00e4 korjaavaan ja uusintavaan talouteen, koska \u00e4\u00e4ris\u00e4\u00e4olojen\nlis\u00e4\u00e4ntyminen ja luonnon romahdus murentavat talouden edellytyksi\u00e4. Samalla ep\u00e4varmuus\nekologisesta tulevaisuudesta pahentaa mielenterveysongelmia.\nSitran Suunta: Pakollinen Ekologinen j\u00e4lleenrakennus, jossa kest\u00e4v\u00e4t el\u00e4m\u00e4ntavat n\u00e4hd\u00e4\u00e4n\nedellytyksen\u00e4 kokonaisvaltaiselle hyvinvoinnille.\n2. Geoteknologinen Valtaistelu (Valta + Teknologia) \u2694\nT\u00e4m\u00e4 supermegatrendi kuvaa geopoliittisen konfliktin ja teknologian hallinnan tiukkaa kietoutumista\ntoisiinsa, joka oli n\u00e4ht\u00e4viss\u00e4 jo Data on valtaa -teemassa (2017) ja Verkostomainen valta voimistuu -\nteemassa (2020).\nYdin:Demokratian kamppailu koveneeja Kilpailu digivallasta kiihtyy ovat samaa ilmi\u00f6t\u00e4.\nGeopoliittinen valtataistelu kytkeytyy suoraan digimaailman pelis\u00e4\u00e4nt\u00f6ihin, kriittisten resurssien\nriitt\u00e4vyyteen ja teknologiaj\u00e4ttien ylivaltaan. Teknologia (ja data) on noussut keskeiseksi\ngeopoliittisen vallank\u00e4yt\u00f6n instrumentiksi.\nSitran Suunta: Tavoitteena on luoda Reilu digimaailma ja vahvistaa demokratiaa. T\u00e4m\u00e4 edellytt\u00e4\u00e4\nkansalaisten Digitaalista sivistyst\u00e4 ja datatalouden pelis\u00e4\u00e4nt\u00f6j\u00e4.\n3. Ep\u00e4varmuuden Sosiaalinen Polarisointi (Ihmiset + Valta + Talous) \ud83c\udf2a\nT\u00e4m\u00e4 supermegatrendi kuvaa, kuinka kriisien aiheuttama ep\u00e4varmuus ja eriarvoisuus (Talouden perusta\nrakoilee, Hyvinvoinnin haasteet kasvavat) ruokkivat poliittista polarisaatiota (Demokratian kamppailu\nkovenee).\nYdin:Globaali eriarvoisuus kasvaa, ja mielenterveysongelmat lis\u00e4\u00e4ntyv\u00e4t ep\u00e4varmuuden keskell\u00e4.\nT\u00e4m\u00e4 luo maaper\u00e4n populismin nousulle ja h\u00e4mmennyksen lietsomiselle, mik\u00e4 rapauttaa\nluottamusta instituutioihin.\nSitran Suunta: Vaaditaan Ylisukupolvisuuttaja Kokonaisvaltaista hyvinvointia torjumaan\neriarvoisuutta ja lis\u00e4\u00e4m\u00e4\u00e4n sosiaalista p\u00e4\u00e4omaa (luottamusta).\n\ntee kokonaisuudesta raportti, miss\u00e4 Supermegatrendit ovat p\u00e4\u00e4osassaII. Sitran N\u00e4kemys Suunnasta Eteenp\u00e4in Yhdistelyn Valossa\nSitran n\u00e4kemys tulevaisuuden suunnasta (ei toivetila) on Tulevaisuusresilienssinjatkuva vahvistaminen\nkriisien keskell\u00e4, sill\u00e4 paluuta vanhaan normaaliin ei ole. Suunta eteenp\u00e4in edellytt\u00e4\u00e4 samanaikaista\nsopeutumista ja uudistumista.\nSitran mukaan tavoitteena on k\u00e4\u00e4nt\u00e4\u00e4 Ekologisen Kriisin, Geopolitiikan ja Taloudellisen Ep\u00e4varmuuden\nasettamat haasteet mahdollisuuksiksi:\nEkologinen Toiminta: Vain panostamalla Ekologiseen j\u00e4lleenrakennukseenja uudistamalla taloutta\nkorjaavaksi ja uusintavaksi voidaan taata maapallon kantokyvyn rajojen sis\u00e4ll\u00e4 pysyminen ja\nturvata hyvinvoinnin edellytykset.\nValtaistaminen:Demokratiaa on vahvistettava lis\u00e4\u00e4m\u00e4ll\u00e4 osallisuutta ja\nvaikutusmahdollisuuksia (esim. kansalaisraadit) ja luomalla Reilu digimaailma datan hallintaan.\nYhteenveto: Kaikki t\u00e4m\u00e4 edellytt\u00e4\u00e4 tulevaisuusajattelua ja muutoskyky\u00e4, jotta voidaan tarttua\nvalinnan paikkoihin ja rakentaa parempaa tulevaisuutta.\nKriittinen Analyysi Sitran Megatrendien Evoluutiosta (2017  2023)\nSupermegatrendit Postnormaalissa Ajassa\nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit 2017, 2020, 2023\nTiivistelm\u00e4\nSitran megatrendien evoluutio vuosien 2017 ja 2023 v\u00e4lill\u00e4 osoittaa dramaattisen siirtym\u00e4n\npotentiaaleista ja kehityskuluista kohti kriisien kasautumista ja systeemisi\u00e4 murtumia.\nSupermegatrendit syntyv\u00e4t, kun n\u00e4m\u00e4 yksitt\u00e4iset megatrendit (Luonto, Valta, Teknologia, Talous, Ihmiset)\nkietoutuvat toisiinsa ja synnytt\u00e4v\u00e4t laajoja, toisistaan riippuvaisia konfliktitiloja, jotka vaativat\nsamanaikaista sopeutumista ja uudistumista. Sitran n\u00e4kemyksen mukaan paluuta vanhaan normaaliin\nei ole.\nI. Supermegatrendit: Systeemiset Muutosvoimat\nKolme keskeist\u00e4 supermegatrendi\u00e4 kuvaavat muutosta, jossa geopoliittiset, ekologiset ja sosiaaliset kriisit\nruokkivat toisiaan:\n1. Ekologinen Resilienssikriisi (Luonto + Talous + Ihmiset) \ud83d\udea8\nT\u00e4m\u00e4 supermegatrendi kuvaa ymp\u00e4rist\u00f6n ja ihmisen hyvinvoinnin v\u00e4litt\u00f6m\u00e4n ja peruuttamattoman\nkytk\u00f6ksen. Evoluutio on edennyt Ymm\u00e4rryksen kasvusta (2017) siihen, ett\u00e4 Luonnon kantokyky\nmurenee (2023) ja Talouden perusta rakoilee.\nYdin: Talouden vakauden edellytykset murenevat, kun \u00e4\u00e4ris\u00e4\u00e4ilmi\u00f6t ja luonnon palveluiden\nromahdus aiheuttavat mittavia kustannuksia. T\u00e4m\u00e4 ekologinen ep\u00e4varmuus pahentaa my\u00f6s\nsosiaalisia haasteita, kuten mielenterveysongelmien lis\u00e4\u00e4ntymist\u00e4.\nSitran Suunta: Tulevaisuus edellytt\u00e4\u00e4 Ekologista j\u00e4lleenrakennusta, jossa luovutaan kasvu-\nuskosta ja siirryt\u00e4\u00e4n Korjaavaan ja uusintavaan talouteen, joka tuottaa positiivisia vaikutuksia\n(k\u00e4denj\u00e4lki) haittojen sijaan.\n\u2192\nkirjoita t\u00e4m\u00e4 kaupallisen liiketoiminnan johtoryhm\u00e4lle ja kirjoita siihen hiukan kaupallisia\nvaikutuksia mukaan2. Geoteknologinen Valtaistelu (Valta + Teknologia) \u2694\nGeopoliittisen ja teknologisen kehityksen suunta on muuttunut nousevien trendien (2017: Data on valtaa,\nVerkon joukkovoima) kuvailusta suoraan valtataisteluun (2023).\nYdin:Demokratian kamppailu koveneejohtuen geopoliittisista j\u00e4nnitteist\u00e4 ja s\u00e4\u00e4nt\u00f6pohjaisen\nmaailmanj\u00e4rjestyksen horjumisesta. T\u00e4m\u00e4 taistelu kytkeytyy suoraan Kilpailuun digivallasta\nkiihtyy, miss\u00e4 teknologiaj\u00e4tit hallitsevat dataa ja informaatiovaikuttaminen rapauttaa luottamusta.\nSitran Suunta: Suunnan on oltava Demokratian vahvistaminenja Reilu digimaailma. T\u00e4m\u00e4\ntarkoittaa kansalaisten Digitaalisen sivistyksen parantamista ja datan hallinnan pelis\u00e4\u00e4nt\u00f6jen\nluomista, jotta teknologiaa voidaan hy\u00f6dynt\u00e4\u00e4 vastuullisesti.\n3. Ep\u00e4varmuuden Sosiaalinen Polarisointi (Ihmiset + Valta + Talous) \ud83c\udf2a\nT\u00e4m\u00e4 supermegatrendi kuvaa, kuinka toisiinsa kytkeytyv\u00e4t kriisit (ekologiset, taloudelliset, geopoliittiset)\nruokkivat sosiaalista ep\u00e4varmuutta ja jakautumista.\nYdin:Talouden perustan rakoilu ja globaalin eriarvoisuuden kasvuluovat kasvualustan\npoliittiselle polarisaatiolle ja ep\u00e4luottamukselle (Demokratian kamppailu kovenee). T\u00e4m\u00e4\nep\u00e4varmuuden kasvu n\u00e4kyy suoraan Hyvinvoinnin haasteissa, erityisesti mielenterveysongelmien\nlis\u00e4\u00e4ntymisen\u00e4 nuorilla.\nSitran Suunta: Tavoitteena on Kokonaisvaltainen hyvinvointi, joka saavutetaan lis\u00e4\u00e4m\u00e4ll\u00e4\nosallisuuttaja vahvistamalla sosiaalista p\u00e4\u00e4omaa (luottamusta). Yhteiskunnan on tuettava ihmisi\u00e4\nreiluun siirtym\u00e4\u00e4n.\nIII. Ennusteiden Osuvuus ja Tulevaisuuden Suunta\nSitran n\u00e4kemys suunnasta eteenp\u00e4in ei ole toivetila, vaan vaatimus samanaikaiselle sopeutumiselle ja\nuudistumiselle. Suunta on transformatiivinen ja poikkeaa vanhasta normaalista.\nOsuvat Ennusteet: Sitra onnistui tunnistamaan Ekologisen kriisin eskaloitumisen (Luonnon\nkantokyky murenee) ja Geopoliittisen konfliktin paluun (Demokratian kamppailu kovenee). My\u00f6s\nteknologiaj\u00e4ttien vallan kasvu ja informaatiovaikuttaminen osoittautuivat eritt\u00e4in osuviksi.\nTulevaisuuden Suunta (Ei Toivetila): Kriisit kietoutuvat toisiinsa, ja Sitran n\u00e4kemyksen mukaan on\npakko tarttua valinnan paikkoihin. Tulevaisuus edellytt\u00e4\u00e4 tulevaisuusresilienssin rakentamista:\nEkologista toimintaa (j\u00e4lleenrakennus) on teht\u00e4v\u00e4 samanaikaisesti talouden uudistamisen\n(korjaava ja uusintava) kanssa.\nDemokratiaa on vahvistettava vastauksena geopoliittisiin ja teknologisiin uhkiin.\nVain t\u00e4m\u00e4 yhdistetty sopeutumisen ja uudistumisen polku tarjoaa suunnan kohti reilua, kest\u00e4v\u00e4\u00e4 ja\ninnostavaa tulevaisuutta.\nKriittinen Analyysi Sitran Megatrendien Evoluutiosta (2017  2023)\nSupermegatrendit Postnormaalissa Ajassa: Kaupalliset Vaikutukset\nKohderyhm\u00e4: Kaupallinen Johtoryhm\u00e4 P\u00e4iv\u00e4m\u00e4\u00e4r\u00e4: 27. lokakuuta 2025 Viite: Sitran Megatrendiraportit\n2017, 2020, 2023\n\u2192\nJohtop\u00e4\u00e4t\u00f6s: Evoluutio Konfliktiin\nSitran megatrendien kehitys vuosien 2017 ja 2023 v\u00e4lill\u00e4 osoittaa fundamentaalisen siirtym\u00e4n\npotentiaaleista ja kehityskuluista (2017) kohti geopoliittisesti latautuneita kriisej\u00e4 ja systeemisi\u00e4\nmurtumia (2023). N\u00e4m\u00e4 yksitt\u00e4iset megatrendit eiv\u00e4t toimi erill\u00e4\u00e4n, vaan kietoutuvat toisiinsa kolmeksi\nkeskeiseksi Supermegatrendiksi, jotka sanelevat tulevaisuuden markkinaolosuhteet. Sitran n\u00e4kemys on,\nett\u00e4 paluuta vanhaan normaaliin ei ole, ja menesty\u00e4kseen yritysten on panostettava\ntulevaisuusresilienssiin.\nI. Supermegatrendit ja Liiketoimintavaikutukset\nTalousj\u00e4rjestelm\u00e4n vakauteen vaikuttavat kolme p\u00e4\u00e4asiallista, toisiaan vahvistavaa supermegatrendi\u00e4:\n1. Ekologinen Resilienssikriisi (Luonto + Talous + Ihmiset) \ud83d\udea8\nT\u00e4m\u00e4 supermegatrendi syntyy siit\u00e4, ett\u00e4 Luonnon kantokyky murenee, mik\u00e4 ajaa suoraan siihen, ett\u00e4\nTalouden perusta rakoilee. T\u00e4m\u00e4 on evoluutio 2017 trendist\u00e4 Ymm\u00e4rrys maapallon kantokyvyst\u00e4 kasvaa.\nKaupalliset Vaikutukset Strategiset Toimenpiteet\nKustannus- ja Toimitusketjuh\u00e4iri\u00f6t: \u00c4\u00e4rimm\u00e4iset\ns\u00e4\u00e4olot ja luonnonvarojen niukkuus nostavat raaka-\naineiden hintoja ja aiheuttavat ennakoimattomia katkoja\nglobaaleihin toimitusketjuihin.Sopeutuminen & Kiertotalous: Investoinnit\nkiertotalouden ratkaisuihin ja omaan uusiutuvaan\nenergiantuotantoon. Toimitusketjun lyhent\u00e4minen ja\nl\u00e4pin\u00e4kyvyys v\u00e4hent\u00e4v\u00e4t riskej\u00e4.\nS\u00e4\u00e4ntelypaine: CSRD-direktiivin ja EU-taksonomian\nkaltaiset s\u00e4\u00e4d\u00f6kset tekev\u00e4t kest\u00e4vyydest\u00e4 pakollista\n(compliance) ja rajoittavat ei-kest\u00e4v\u00e4\u00e4 rahoitusta.Kest\u00e4v\u00e4 Liiketoiminta:Decarbonization Roadmap\npakollinen kilpailuvaltti. Vain kest\u00e4v\u00e4t liiketoimintamallit\nsaavat tulevaisuudessa p\u00e4\u00e4omaa.\n2. Geoteknologinen Valtaistelu (Valta + Teknologia) \u2694\nT\u00e4m\u00e4 supermegatrendi kuvaa Demokratian kamppailun koventumista kytkeytyneen\u00e4 suoraan\nKilpailuun digivallasta kiihtyy. Se on siirtym\u00e4 vuoden 2017 Datan vallan potentiaalista geopoliittiseen\nkonfliktiin.\nKaupalliset Vaikutukset Strategiset Toimenpiteet\nMarkkinoiden Fragmentaatio: Teknologiasodat (esim.\nYhdysvallat vs. Kiina) ja data-autonomian vaatimukset\n(esim. EU:n tietosuojas\u00e4\u00e4d\u00f6kset) jakavat markkinoita ja\nvaikeuttavat globaalia skaalausta.Teknologia-autonomia ja Turvallisuus: Panostus\nkyberturvallisuuteen ja strategiseen\nriippumattomuuteen kriittisiss\u00e4 teknologioissa. Vahva\npanostus GDPR/AI Act -vaatimustenmukaisuuteen.\nLuottamuskriisi: Informaatiovaikuttaminen ja\nluottamuksen rapautuminen vaikuttavat br\u00e4ndin\narvoon. Eettisesti kyseenalaiset AI-ratkaisut\naiheuttavat maineriskin.Reilu Digimaailma: Kehitet\u00e4\u00e4n ja k\u00e4ytet\u00e4\u00e4n teknologiaa\neettisesti ja l\u00e4pin\u00e4kyv\u00e4sti. Reilun datatalouden\nperiaatteet (Sitran suunta) tarjoavat uuden kilpailuedun.\n3. Ep\u00e4varmuuden Sosiaalinen Polarisointi (Ihmiset + Valta + Talous) \ud83c\udf2a\nT\u00e4m\u00e4 supermegatrendi kuvaa, miten kriisit ja Talouden perustan rakoilu ruokkivat Hyvinvoinnin\nhaasteita ja sosiaalista polarisaatiota, mik\u00e4 vaikuttaa suoraan ty\u00f6voiman saatavuuteen.content_copy\ncontent_copy\nKaupalliset Vaikutukset Strategiset Toimenpiteet\nTy\u00f6voimapula ja Tuottavuus: Hyvinvoinnin haasteet\n(erityisesti mielenterveysongelmien kasvu nuorilla) ja\nglobaali ep\u00e4varmuus v\u00e4hent\u00e4v\u00e4t ty\u00f6voiman saatavuutta ja\nheikent\u00e4v\u00e4t ty\u00f6ntekij\u00f6iden tuottavuutta.Ty\u00f6ntekij\u00e4p\u00e4\u00e4oman Vahvistaminen:\nEnnaltaehk\u00e4isev\u00e4t investoinnit kokonaisvaltaiseen\nhyvinvointiin ja mielenterveyteen ovat kriittisi\u00e4\nrekrytoinnissa ja pitovoimassa.\nKysynn\u00e4n Volatiliteetti: Kuluttajien ostovoiman\nheikkeneminen ja luottamuksen puute kasvattavat kysynn\u00e4n\nep\u00e4varmuutta ja vaativat joustavampia liiketoimintamalleja.Arvojen Vahvistaminen: Selke\u00e4 Yritysvastuu\n(Purpose) erottaa polarisoituneessa markkinassa.\nKeskityt\u00e4\u00e4n resilienssiin ja joustavaan\nhinnoitteluun ep\u00e4varman kysynn\u00e4n hallitsemiseksi.\nII. Sitran Strateginen Suunta: Tulevaisuusresilienssi\nSitran n\u00e4kemys suunnasta eteenp\u00e4in kiteytyy tulevaisuusresilienssin rakentamiseen \u2013 kykyyn selviyty\u00e4\njatkuvista kriiseist\u00e4 ja samalla uudistua. Johtoryhm\u00e4lle t\u00e4m\u00e4 tarkoittaa:\n1. Ekologian Integroiminen Talouteen: Luonnon kantokyvyn rajat eiv\u00e4t ole vain rajoite, vaan uuden\ntaloudellisen kasvun perusta. Korjaavaan ja uusintavaan talouteen siirtyminen on ainoa tapa taata\npitk\u00e4n aikav\u00e4lin vakaus.\n2. Valinnan Paikkoihin Tarttuminen: Kriisien keskell\u00e4 on teht\u00e4v\u00e4 tietoisia valintoja ja n\u00e4ht\u00e4v\u00e4\nteknologinen murros (esim. AI) v\u00e4lineen\u00e4 reilun digimaailman luomiseen, ei vain kustannuss\u00e4\u00e4st\u00f6n\u00e4.\n3. Ylisukupolvisuuden Edist\u00e4minen: Panostamalla kokonaisvaltaiseen hyvinvointiin ja ratkaisemalla\nsosiaalisia haasteita turvataan tulevaisuuden ty\u00f6voima ja markkinat.\nJohtop\u00e4\u00e4t\u00f6s: Muutos 2017:n potentiaalista 2023:n kriisiin on peruuttamaton. Yrityksemme menestys\nriippuu kyvyst\u00e4mme integroida n\u00e4m\u00e4 kolme supermegatrendi\u00e4 strategiseen p\u00e4\u00e4t\u00f6ksentekoon ja n\u00e4hd\u00e4\nkest\u00e4vyys ja autonomia uusina kilpailutekij\u00f6in\u00e4.content_copy", "product_text": " \nKriittinen\n \nAnalyysi\n \nSitran\n \nMegatrendien\n \nEvoluutiosta\n \n(2017\n \n-\n \n2023)\n \n \nSupermegatrendit\n \nPostnormaalissa\n \nAjassa:\n \nKaupalliset\n \nVaikutukset\n \nKohderyhm\u00e4:\n \nKaupallinen\n \nJohtoryhm\u00e4\n \nP\u00e4iv\u00e4m\u00e4\u00e4r\u00e4:\n \n27.\n \nlokakuuta\n \n2025\n \nViite:\n \nSitran\n \nMegatrendiraportit\n \n2017,\n \n2020,\n \n2023\n \n \nEvoluutio\n \nKonfliktiin\n \n \nSitran\n \nmegatrendien\n \nkehitys\n \nvuosien\n \n2017\n \nja\n \n2023\n \nv\u00e4lill\u00e4\n \nosoittaa\n \nfundamentaalisen\n \nsiirtym\u00e4n\n \npotentiaaleista\n \nja\n \nkehityskuluista\n \n(2017)\n \nkohti\n \ngeopoliittisesti\n \nlatautuneita\n \nkriisej\u00e4\n \nja\n \nsysteemisi\u00e4\n \nmurtumia\n \n(2023)\n.\n \nN\u00e4m\u00e4\n \nyksitt\u00e4iset\n \nmegatrendit\n \neiv\u00e4t\n \ntoimi\n \nerill\u00e4\u00e4n,\n \nvaan\n \nkietoutuvat\n \ntoisiinsa\n \nkolmeksi\n \nkeskeiseksi\n \nSupermegatrendiksi\n,\n \njotka\n \nsanelevat\n \ntulevaisuuden\n \nmarkkinaolosuhteet.\n \nSitran\n \nn\u00e4kemys\n \non,\n \nett\u00e4\n \npaluuta\n \nvanhaan\n \nnormaaliin\n \nei\n \nole,\n \nja\n \nmenesty\u00e4kseen\n \nyritysten\n \non\n \npanostettava\n \ntulevaisuusresilienssiin\n.\n \n \nSupermegatrendit\n \nja\n \nLiiketoimintavaikutukset\n \nTalousj\u00e4rjestelm\u00e4n\n \nvakauteen\n \nvaikuttavat\n \nkolme\n \np\u00e4\u00e4asiallista,\n \ntoisiaan\n \nvahvistavaa\n \nsupermegatrendi\u00e4:\n \n1.\n \nEkologinen\n \nResilienssikriisi\n \nT\u00e4m\u00e4\n \nsyntyy\n \nsiit\u00e4,\n \nett\u00e4\n \nLuonnon\n \nkantokyky\n \nmurenee\n,\n \nmik\u00e4\n \najaa\n \nsuoraan\n \nsiihen,\n \nett\u00e4\n \nTalouden\n \nperusta\n \nrakoilee\n.\n \nT\u00e4m\u00e4\n \non\n \nevoluutio\n \n2017\n \ntrendist\u00e4\n \nYmm\u00e4rrys\n \nmaapallon\n \nkantokyvyst\u00e4\n \nkasvaa\n.\n \nKaupalliset\n \nVaikutukset\n \nStrategiset\n \nToimenpiteet\n \nKustannus-\n \nja\n \nToimitusketjuh\u00e4iri\u00f6t:\n \n\u00c4\u00e4rimm\u00e4iset\n \ns\u00e4\u00e4olot\n \nja\n \nluonnonvarojen\n \nniukkuus\n \nnostavat\n \nraaka-aineiden\n \nhintoja\n \nja\n \naiheuttavat\n \nennakoimattomia\n \nkatkoja\n \nSopeutuminen\n \n&\n \nKiertotalous:\n \nInvestoinnit\n \nkiertotalouden\n \nratkaisuihin\n \nja\n \nomaan\n \nuusiutuvaan\n \nenergiantuotantoon\n.\n \nToimitusketjun\n \nglobaaleihin\n \ntoimitusketjuihin.\n \nlyhent\u00e4minen\n \nja\n \nl\u00e4pin\u00e4kyvyys\n \nv\u00e4hent\u00e4v\u00e4t\n \nriskej\u00e4.\n \nS\u00e4\u00e4ntelypaine:\n \nCSRD-direktiivin\n \nja\n \nEU-taksonomian\n \nkaltaiset\n \ns\u00e4\u00e4d\u00f6kset\n \ntekev\u00e4t\n \nkest\u00e4vyydest\u00e4\n \npakollista\n \n(compliance)\n \nja\n \nrajoittavat\n \nei-kest\u00e4v\u00e4\u00e4\n \nrahoitusta.\n \nKest\u00e4v\u00e4\n \nLiiketoiminta:\n \nDecarbonization\n \nRoadmap\n \npakollinen\n \nkilpailuvaltti.\n \nVain\n \nkest\u00e4v\u00e4t\n \nliiketoimintamallit\n \nsaavat\n \ntulevaisuudessa\n \np\u00e4\u00e4omaa.\n \nGeoteknologinen\n \nValtaistelu\n \nT\u00e4m\u00e4\n \nsupermegatrendi\n \nkuvaa\n \nDemokratian\n \nkamppailun\n \nkoventumista\n \nkytkeytyneen\u00e4\n \nsuoraan\n \nKilpailuun\n \ndigivallasta\n \nkiihtyy\n.\n \nSe\n \non\n \nsiirtym\u00e4\n \nvuoden\n \n2017\n \nDatan\n \nvallan\n \npotentiaalista\n \ngeopoliittiseen\n \nkonfliktiin.\n \nKaupalliset\n \nVaikutukset\n \nStrategiset\n \nToimenpiteet\n \nMarkkinoiden\n \nFragmentaatio:\n \nTeknologiasodat\n \n(esim.\n \nYhdysvallat\n \nvs.\n \nKiina)\n \nja\n \ndata-autonomian\n \nvaatimukset\n \n(esim.\n \nEU:n\n \ntietosuojas\u00e4\u00e4d\u00f6kset)\n \njakavat\n \nmarkkinoita\n \nja\n \nvaikeuttavat\n \nglobaalia\n \nskaalausta.\n \nTeknologia-autonomia\n \nja\n \nTurvallisuus:\n \nPanostus\n \nkyberturvallisuuteen\n \nja\n \nstrategiseen\n \nriippumattomuuteen\n \nkriittisiss\u00e4\n \nteknologioissa.\n \nEuroopassa\n \nvahva\n \npanostus\n \ns\u00e4\u00e4nt\u00f6jen\n \nnoudattamiseen,\n \navoimuuteen\n \nja\n \ntietosuojaan.\n \nLuottamuskriisi:\n \nInformaatiovaikuttaminen\n \nja\n \nluottamuksen\n \nrapautuminen\n \nvaikuttavat\n \nbr\u00e4ndin\n \narvoon.\n \nEettisesti\n \nkyseenalaiset\n \nAI-ratkaisut\n \naiheuttavat\n \nmaineriskin.\n \nReilu\n \nDigimaailma:\n \nKehitet\u00e4\u00e4n\n \nja\n \nk\u00e4ytet\u00e4\u00e4n\n \nteknologiaa\n \neettisesti\n \nja\n \nl\u00e4pin\u00e4kyv\u00e4sti\n.\n \nReilun\n \ndatatalouden\n \nperiaatteet\n \ntarjoavat\n \nuuden\n \nkilpailuedun.\n \nEp\u00e4varmuuden\n \nSosiaalinen\n \nPolarisointi\n \nT\u00e4m\u00e4\n \nsupermegatrendi\n \nkuvaa,\n \nmiten\n \nkriisit\n \nja\n \nTalouden\n \nperustan\n \nrakoilu\n \nruokkivat\n \nHyvinvoinnin\n \nhaasteita\n \nja\n \nsosiaalista\n \npolarisaatiota,\n \nmik\u00e4\n \nvaikuttaa\n \nsuoraan\n \nty\u00f6voiman\n \nsaatavuuteen.\n \nKaupalliset\n \nVaikutukset\n \nStrategiset\n \nToimenpiteet\n \nTy\u00f6voimapula\n \nja\n \nTuottavuus:\n \nHyvinvoinnin\n \nhaasteet\n \n(erityisesti\n \nmielenterveysongelmien\n \nkasvu\n \nnuorilla)\n \nja\n \nglobaali\n \nep\u00e4varmuus\n \nv\u00e4hent\u00e4v\u00e4t\n \nty\u00f6voiman\n \nsaatavuutta\n \nja\n \nheikent\u00e4v\u00e4t\n \nty\u00f6ntekij\u00f6iden\n \nTy\u00f6ntekij\u00e4p\u00e4\u00e4oman\n \nVahvistaminen:\n \nEnnaltaehk\u00e4isev\u00e4t\n \ninvestoinnit\n \nkokonaisvaltaiseen\n \nhyvinvointiin\n \nja\n \nmielenterveyteen\n \novat\n \nkriittisi\u00e4\n \ntuottavuutta.\n \nrekrytoinnissa\n \nja\n \npitovoimassa.\n \nKysynn\u00e4n\n \nVolatiliteetti:\n \nKuluttajien\n \nostovoiman\n \nheikkeneminen\n \nja\n \nluottamuksen\n \npuute\n \nkasvattavat\n \nkysynn\u00e4n\n \nep\u00e4varmuutta\n \nja\n \nvaativat\n \njoustavampia\n \nliiketoimintamalleja.\n \nArvojen\n \nVahvistaminen:\n \nSelke\u00e4\n \nYritysvastuu\n \n(Purpose)\n \nerottaa\n \npolarisoituneessa\n \nmarkkinassa.\n \nKeskityt\u00e4\u00e4n\n \nresilienssiin\n \nja\n \njoustavaan\n \nhinnoitteluun\n \nep\u00e4varman\n \nkysynn\u00e4n\n \nhallitsemiseksi.\n \n \nSitran\n \nStrateginen\n \nSuunta:\n \nTulevaisuusresilienssi\n \nSitran\n \nn\u00e4kemys\n \nsuunnasta\n \neteenp\u00e4in\n \nkiteytyy\n \ntulevaisuusresilienssin\n \nrakentamiseen\n \n\u2013\n \nkykyyn\n \nselviyty\u00e4\n \njatkuvista\n \nkriiseist\u00e4\n \nja\n \nsamalla\n \nuudistua.\n \nJohtoryhm\u00e4lle\n \nt\u00e4m\u00e4\n \ntarkoittaa:\n \n1.\n \nEkologian\n \nIntegroiminen\n \nTalouteen:\n \nLuonnon\n \nkantokyvyn\n \nrajat\n \neiv\u00e4t\n \nole\n \nvain\n \nrajoite\n,\n \nvaan\n \nuuden\n \ntaloudellisen\n \nkasvun\n \nperusta\n.\n \nKorjaavaan\n \nja\n \nuusintavaan\n \ntalouteen\n \nsiirtyminen\n \non\n \nainoa\n \ntapa\n \ntaata\n \npitk\u00e4n\n \naikav\u00e4lin\n \nvakaus.\n \n2.\n \nValinnan\n \nPaikkoihin\n \nTarttuminen:\n \nKriisien\n \nkeskell\u00e4\n \non\n \nteht\u00e4v\u00e4\n \ntietoisia\n \nvalintoja\n \nja\n \nn\u00e4ht\u00e4v\u00e4\n \nteknologinen\n \nmurros\n \n(esim.\n \nAI)\n \nv\u00e4lineen\u00e4\n \nreilun\n \ndigimaailman\n \nluomiseen,\n \nei\n \nvain\n \nkustannuss\u00e4\u00e4st\u00f6n\u00e4.\n \n3.\n \nYlisukupolvisuuden\n \nEdist\u00e4minen:\n \nPanostamalla\n \nkokonaisvaltaiseen\n \nhyvinvointiin\n \nja\n \nratkaisemalla\n \nsosiaalisia\n \nhaasteita\n \nturvataan\n \ntulevaisuuden\n \nty\u00f6voima\n \nja\n \nmarkkinat.\n \nJohtop\u00e4\u00e4t\u00f6s:\n \nMuutos\n \n2017:n\n \npotentiaalista\n \n2023:n\n \nkriisiin\n \non\n \nperuuttamaton.\n \nYrityksemme\n \nmenestys\n \nriippuu\n \nkyvyst\u00e4mme\n \nintegroida\n \nn\u00e4m\u00e4\n \nkolme\n \nsupermegatrendi\u00e4\n \nstrategiseen\n \np\u00e4\u00e4t\u00f6ksentekoon\n \nja\n \nn\u00e4hd\u00e4\n \nkest\u00e4vyys\n \nja\n \nautonomia\n \nuusina\n \nkilpailutekij\u00f6in\u00e4.\n ", "reflection_text": "Reflektiodokumentin j\u00e4sentely (Reflektiodokumentti.pdf)  \nSuunnittelu: Miten aloitit ja miksi?  \nAloitin kyselem\u00e4\u00e4n yleisesti, mit\u00e4 ovat megatrendit. Annoin rajoituksia sek\u00e4 roolin  liiketoiminnalle \nkoska kyse oli johtoryhm \u00e4n teht\u00e4v\u00e4st\u00e4 . Esimerkkej\u00e4 en an tanut . Ennakoin, ett\u00e4 alkuun en saa hyv\u00e4\u00e4 \ntulosta.  \nProsessin ohjaaminen: Miten reagoit ja sopeuduit?  \nPyysin supermegat rendej\u00e4  \u2013 t\u00e4m\u00e4 oli iso oivallus . Teko\u00e4lyn alkuper\u00e4inen vastau s oli liian laaja , joten sit\u00e4 oli \npakko supistaa ja  tuottaa yl\u00e4tason n\u00e4kemys. Mietin erilaisia sanoja ja termej\u00e4,  mutta supermegatrendit tuli \nensimm\u00e4isen\u00e4 mielee ni.  \nHuomasin my\u00f6s , ett\u00e4 l\u00e4ht\u00f6tilanteessaa oli vi rhe, koska yksi raportti oli annettu kahteen  kertaan mutta \nteht\u00e4v\u00e4n vaatima a viimeist\u00e4 raportti a ei oll ut annettu  \nLopputuloksen arviointi: Mit\u00e4 opit ja mik\u00e4 oli oma panoksesi?  \nLopp utuloksessa muuttelin yksityiskohtia ja otin mielest\u00e4ni asioita pois, jot ka eiv\u00e4t kuuluneet \nloppuraporttiin ja muutin my\u00f6s tulosta.  Korjasin ta ulukosta Eurooppaa n liit tyv\u00e4n asian , koska n\u00e4in \nalkupe\u00e4isen tar peettomana.  \n "}, "frozen_context": {"compiled_prompts": {}, "injected_theory": {}, "generated_schemas": {"step_input_processing": {"properties": {"acknowledged_instruction": {"default": "yes", "description": "Acknowledge completion of the instruction.", "title": "Acknowledged Instruction", "type": "string"}}, "title": "Step_step_input_processing_Response", "type": "object"}, "step_guard": {"properties": {"block_taskguard": {"description": "TASK_GUARD: ROLE: GUARD (Hygiene & Ethics Audit)\nTASKS: Oversee inputs and outputs for ethical tensions, security issues, and biases.\n\nOUTPUT REQUIREMENT:\nThe response must be JSON conforming to the `GuardOutput` schema.\nMANDATE: Output your response EXACTLY according to the JSON schema:\n{{SCHEMA_EXAMPLE}}", "title": "Block Taskguard", "type": "integer"}, "block_taskguard_justification": {"description": "Detailed reasoning for the assigned score for 'TASK_GUARD'. Must explicitly adhere to the active STRICTNESS CALIBRATION.", "title": "Block Taskguard Justification", "type": "string"}, "block_taskguard_cited_source_id": {"anyOf": [{"const": "OWASP Foundation (2025). OWASP Top 10 for Large Language Model Applications. (System Threat Modeling).", "type": "string"}, {"type": "null"}], "default": null, "description": "Jos perustelut viittaavat johonkin ohjeistettuun teoriaan, PALAUTA T\u00c4SM\u00c4LLEEN T\u00c4M\u00c4 merkkijono: 'OWASP Foundation (2025). OWASP Top 10 for Large Language Model Applications. (System Threat Modeling).'. Muuten palauta null.", "title": "Block Taskguard Cited Source Id"}, "block_taskguard_cited_text_quote": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "JOS valitsit l\u00e4hteen yll\u00e4, liit\u00e4 t\u00e4h\u00e4n tarkka, SUORA ja SANATARKKA lainaus teoriasta/l\u00e4hteest\u00e4, joka tukee perusteluasi. Teko\u00e4lyn luoma oma teksti on t\u00e4ss\u00e4 kielletty. Jos l\u00e4hdett\u00e4 ei ole, palauta null.", "title": "Block Taskguard Cited Text Quote"}}, "required": ["block_taskguard", "block_taskguard_justification"], "title": "Step_step_guard_Response", "type": "object"}, "step_analyst": {"properties": {"acknowledged_instruction": {"default": "yes", "description": "Acknowledge completion of the instruction.", "title": "Acknowledged Instruction", "type": "string"}}, "title": "Step_step_analyst_Response", "type": "object"}, "step_profiler": {"properties": {"matrix_kahneman": {"description": "Kahnemanin Ajattelumallit: Arvioi ajattelun hitautta tai nopeutta (System 1 vs System 2).", "title": "Matrix Kahneman", "type": "number"}, "matrix_kahneman_justification": {"description": "Detailed reasoning for the assigned score for 'Kahnemanin Ajattelumallit'. Must explicitly adhere to the active STRICTNESS CALIBRATION.", "title": "Matrix Kahneman Justification", "type": "string"}, "matrix_kahneman_cited_source_id": {"anyOf": [{"const": "Kahneman, Daniel 2011.", "type": "string"}, {"type": "null"}], "default": null, "description": "Jos perustel