null, "is_active": true}}}, "2": {"id": "cfg_mcpGateways01", "slug": "mcp_gateways", "type": "mcp_gateways", "tools": [{"tool_id": "mcp_tavily_search", "name": {"default_locale": "en", "translations": {"en": "Tavily AI Search", "fi": "Tavily AI -haku"}}, "description": "Search the internet for factual information using Tavily AI.", "input_schema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}]}}, "workflows": {"1": {"id": "wf_d653170e174847559e08af42b938d826", "slug": "kokonaisvaltainen_auditointi", "name": {"default_locale": "fi", "translations": {"fi": "Kokonaisvaltainen Auditointi", "en": "Holistic Audit"}}, "description": {"default_locale": "fi", "translations": {"fi": "Kattava 12-vaiheinen auditointiketju, joka analysoi datan monipuolisesti ja tuottaa syv\u00e4llisen arvioinnin.", "en": "Comprehensive 12-step audit chain that analyzes data from multiple perspectives to produce an in-depth evaluation."}}, "status": "active", "version": 1, "is_public": true, "organization_id": null, "ui_schema": {}, "output_profiles": {"prf_4308b1aedaa541499b99338d9ef8e9e6": {"name": {"default_locale": "fi", "translations": {"fi": "Laajennetut Nykytiedot", "en": "Extended Insights"}}, "layouts": [{"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Toulminin Argumentaatiomalli", "en": "Toulmin Argumentation Model"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi argumentin laatua Toulminin mallin mukaisesti.", "en": "Evaluates the quality of an argument using the Toulmin model."}}, "steps": [], "target_blocks": ["blk_371c7724eeba40218409b5a3697ac1d3"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Bloomin Taksonomia", "en": "Bloom's Taxonomy"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi kognitiivista syvyytt\u00e4 Bloomin taksonomian perusteella.", "en": "Evaluates cognitive depth using Bloom's Taxonomy."}}, "steps": [], "target_blocks": ["blk_a0405e121dbf44bfa8ee80566f8d0c2a"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Kahnemanin Kaksoisprosessiteoria", "en": "Kahneman's Dual Process Theory"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi ajattelun hitautta tai nopeutta (System 1 vs System 2).", "en": "Evaluates the speed and depth of cognitive processing using System 1/System 2."}}, "steps": [], "target_blocks": ["blk_9adcb55b7ba44baeaf8921cb2fb935dc"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Performatiivisuus ja Goodhartin Laki", "en": "Performativity & Goodhart's Law"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi mittarin ja tavoitteen v\u00e4\u00e4ristym\u00e4\u00e4.", "en": "Evaluates whether the user acts as a driver or a passenger in the interaction."}}, "steps": [], "target_blocks": ["blk_b5ec25bb352e4dc09de386f0da991a08"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Sy\u00f6tteiden Prosessointi", "en": "Input Processing"}}, "description": {"default_locale": "fi", "translations": {"fi": "Teht\u00e4v\u00e4si on k\u00e4sitell\u00e4 raakatiedot ja sy\u00f6tteet (Input Processing). Poista kohina, j\u00e4senn\u00e4 olennaiset v\u00e4itteet ja valmistele data selke\u00e4\u00e4n, analysoitavaan formaattiin seuraavia vaiheita varten.", "en": "Evaluates how thoroughly the user analyzes provided inputs."}}, "steps": [], "target_blocks": ["blk_cf081a3325f44dc49bbe06d600f268fc"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Arkistointistandardien Auditointi", "en": "Archival Compliance Audit"}}, "description": {"default_locale": "fi", "translations": {"fi": "Teht\u00e4v\u00e4si on peilata teko\u00e4lyn toimintaa organisaation aikaisempiin (Precedent) linjauksiin ja ohjeisiin.", "en": "Evaluates compliance with organizational standards and precedent."}}, "steps": [], "target_blocks": ["blk_d0e240184e0a40759d37138a250bd0aa"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Kausaalisuuden Analyysi", "en": "Causal Analyst"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Kausaalinen Analyytikko (Causal Analyst). Teht\u00e4v\u00e4si on tunnistaa syy-seuraussuhteet, rakentaa kontrafaktuaalisia (mit\u00e4 jos) skenaarioita ja arvioida v\u00e4itteiden uskottavuutta.", "en": "Evaluates causal direction and guidance quality."}}, "steps": [], "target_blocks": ["blk_bf8a99a1b3514f6c93aff42a4cc52213"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Falsifioinnin Auditointi", "en": "Falsification Audit"}}, "description": {"default_locale": "fi", "translations": {"fi": "Laske 'Critical Distance Score' (1-4) aineiston perusteella.", "en": "Evaluates active testing and falsification of AI assumptions."}}, "steps": [], "target_blocks": ["blk_1e33ce78623943af9d5ce39ce6620478"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Ylituomari", "en": "Supreme Adjudicator"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet Tuomari (Judge). Teht\u00e4v\u00e4si on arvioida aiemmin tuotettu todistusaineisto ja analyysit kokonaisuutena. Anna lopullinen, perusteltu ja puolueeton tuomio.", "en": "Synthesizes multi-agent evaluations into a final verdict."}}, "steps": [], "target_blocks": ["blk_598f9d9fab3143e1b57ae999fc5d375d"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "XAI-Raportoija", "en": "XAI Synthesis Reporter"}}, "description": {"default_locale": "fi", "translations": {"fi": "Olet selitett\u00e4v\u00e4n teko\u00e4lyn raportoija (XAI Reporter). Teht\u00e4v\u00e4si on koota kaikkien aiempien analyysivaiheiden l\u00f6yd\u00f6kset yhdeksi selke\u00e4ksi, l\u00e4pin\u00e4kyv\u00e4ksi ja tiiviiksi synteesiksi, joka nostaa esiin t\u00e4rkeimm\u00e4t huomiot ja vinoumat.", "en": "Evaluates the transparency and clarity of the decision-making report."}}, "steps": [], "target_blocks": ["blk_3c3b6a9b67bf41e88ed4b59524d6c6f3"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Turvallisuus- ja Etiikkasuodatin", "en": "Security & Ethics Guardrail"}}, "description": {"default_locale": "fi", "translations": {"fi": "Valvo sy\u00f6tteit\u00e4 (Input) ja tulosteita (Output) eettisten j\u00e4nnitteiden, tietoturvan ja asenteellisuuksien varalta", "en": "Evaluates adherence to security and input guardrails."}}, "steps": [], "target_blocks": ["blk_8b12be64227c4abd83e2f409b5c3ce28"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Kausaalinen ja Abduktiivinen Integriteetti", "en": "Causal & Abductive Integrity"}}, "description": {"default_locale": "fi", "translations": {"fi": "Abduktiivinen P\u00e4\u00e4ttely (Pearl): Onko k\u00e4ytt\u00e4j\u00e4n v\u00e4itt\u00e4m\u00e4 ohjaustarina todellinen strateginen valinta vai j\u00e4lkik\u00e4teen keksitty (Post-Hoc) rationalisointi?", "en": "Evaluates abductive reasoning patterns in the data."}}, "steps": [], "target_blocks": ["blk_a8e356b276f04ddeb7cc3a0eec58daf6"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Selitett\u00e4vyys ja L\u00e4pin\u00e4kyvyys", "en": "Explainability & Transparency"}}, "description": {"default_locale": "fi", "translations": {"fi": "Arvioi tuomion ymm\u00e4rrett\u00e4vyytt\u00e4 ja l\u00e4pin\u00e4kyvyytt\u00e4.", "en": "Evaluates the comprehensibility and transparency of the verdict."}}, "steps": [], "target_blocks": ["blk_2878d1c8b5494180b1a5231466e2e0a9"], "show_text": true}, {"preset_view": "text_only", "title": {"default_locale": "fi", "translations": {"fi": "Episteeminen N\u00f6yryys", "en": "Epistemic Humility"}}, "description": {"default_locale": "fi", "translations": {"fi": "Matriisi: Tekstin omien rajoitteiden ja riskien tunnistus.", "en": "Matrix: Recognition of the text's own limitations and risks."}}, "steps": [], "target_blocks": ["blk_635d07ae441d41e6a274911854ef8283"], "show_text": true}]}}, "default_profile_id": "default", "expected_inputs": [{"input_key": "product_text", "label": {"default_locale": "fi", "translations": {"fi": "Lopputuote (Analyysin P\u00e4\u00e4kohde)", "en": "Product (Main Audit Target)"}}, "required": false, "is_chat_history": false, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "T\u00e4h\u00e4n liitet\u00e4\u00e4n auditoitavan prosessin varsinainen tuotos, esim. PDF-dokumentti.", "en": "Attach the actual output of the audited process (e.g. PDF)."}}, "ai_description": "SOURCE EVIDENCE DIRECTIVE: This artifact represents the final target output of the audited process. It must be evaluated strictly on its own merits without assuming any external context or hidden intentions. Treat this as the definitive end-result of the cognitive process.", "questionnaire_definition": []}, {"input_key": "chat_log", "label": {"default_locale": "fi", "translations": {"fi": "Keskusteluhistoria", "en": "Chat Log"}}, "required": true, "is_chat_history": true, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 keskusteluhistoria ihmisen ja teko\u00e4lyn v\u00e4lill\u00e4.", "en": "Attach chat log between human and AI."}}, "ai_description": "PROCESS EVIDENCE DIRECTIVE: This artifact contains the chronological dialogue unspooled between the human operator and the AI system leading up to the final product. You must analyze this strictly for developmental trajectory, cognitive dependencies, prompt compliance, and the balance of intellectual labor. Do not treat this as the final product itself, but rather the scaffolding that built it.", "questionnaire_definition": []}, {"input_key": "reflection_text", "label": {"default_locale": "fi", "translations": {"fi": "Reflektiodokumentti", "en": "Reflection"}}, "required": false, "is_chat_history": false, "input_modes": ["questionnaire"], "description": {"default_locale": "fi", "translations": {"fi": "Vastaa lyhyesti reflektiokysymyksiin.", "en": "Answer reflection questions briefly."}}, "ai_description": "META-COGNITIVE EVIDENCE DIRECTIVE: This artifact contains the human operator's post-hoc reflection on the interaction. Analyze this to establish the operator's self-awareness, critical distance, and theoretical grounding regarding the process. Evaluate if the reflection aligns transparently with the actual events logged in the chat history.", "questionnaire_definition": [{"question_id": "ref1", "question": {"default_locale": "fi", "translations": {"fi": "Mik\u00e4 oli mielest\u00e4si onnistuneinta t\u00e4ss\u00e4 vuorovaikutuksessa?", "en": "What do you think was the most successful part of this interaction?"}}, "type": "text"}, {"question_id": "ref2", "question": {"default_locale": "fi", "translations": {"fi": "Mit\u00e4 tekisit toisin ensi kerralla?", "en": "What would you do differently next time?"}}, "type": "text"}]}], "steps": [{"id": "steprule_f15853d2584e4096aeb60f11a3e6ea7c1", "task_blueprint": "step_f15853d2584e4096aeb60f11a3e6ea7c", "depends_on": [], "input_mappings": {"inputs": "$inputs"}, "allowed_mcp_tools": [], "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "steprule_02dd32906f4145bea6f6bf0a807d60111", "task_blueprint": "step_02dd32906f4145bea6f6bf0a807d6011", "depends_on": ["steprule_f15853d2584e4096aeb60f11a3e6ea7c1"], "input_mappings": {"inputs": "$inputs"}, "allowed_mcp_tools": [], "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "steprule_factcheck1234ab", "task_blueprint": "step_factchecker1234abcd", "depends_on": ["steprule_f15853d2584e4096aeb60f11