ule4": 50, "block_rule5": 50, "block_rule6": 50, "block_oprule1": 50, "block_oprule2": 50, "block_oprule3": 50, "block_principle1": 50, "block_requirement1": 50, "block_heuristic1": 50, "block_heuristic2": 50, "block_heuristic3": 50, "block_protocol4": 50, "block_instructionbiblicalgrounding": 50, "block_instructionnohallucination": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "block_taskoverseer": 50}}}, "step_archivist": {"matrix_archivist": 3.0, "matrix_archivist_justification": "The AI's action, as observed across the product text, chat log, and reflection text, is merely a repetitive echo of the input. There is no evidence of the AI applying any structured steering models, checking against organizational precedents, or ensuring compliance with specific guidelines. While not critically misaligned or random, it also does not demonstrate any best practices or active steering. It follows a basic process of repetition without utilizing any advanced AI steering mechanisms, thus aligning with a 'Neutral' score.", "matrix_archivist_cited_source_id": null, "matrix_archivist_cited_text_quote": null, "block_taskarchivist": 3.0, "block_taskarchivist_justification": "The user's input across all provided sources is identical and highly repetitive, stating 'T\u00e4m\u00e4 on t\u00e4rke\u00e4 hanke. Hanke on eritt\u00e4in t\u00e4rke\u00e4. Tuotokset ovat t\u00e4rkeit\u00e4 hankkeelle.' (This is an important project. The project is very important. The outputs are important for the project.) This input does not contain any specific 'action' or 'decision-making' that can be meaningfully audited against previous precedents or organizational standards. Without any substantive content or context, it is impossible to determine alignment or misalignment with best practices or established guidelines. Therefore, the evaluation defaults to a neutral stance, as there is no evidence of either good or bad practices in the user's interaction.", "block_taskarchivist_cited_source_id": null, "block_taskarchivist_cited_text_quote": null, "matrix_archivist_scaled": 7.6, "matrix_archivist_normalized": 60.0, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_archivist", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:52:58.534222+00:00", "unix_time": 1773510778, "v2_engine": true}, "_audit_signature": "step_archivist:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510778", "_step_metadata": {"micro_strictness_levels": {"block_globalcontext": 50, "block_headermandates": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule5": 50, "block_instructionnohallucination": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "matrix_archivist": 50, "block_taskarchivist": 50}}}, "step_falsifier": {"matrix_falsifier": 1.0, "matrix_falsifier_justification": "The user's interaction is limited to a single input, which is a repetitive block of text. There is no dialogue, no AI response, and consequently, no opportunity for the user to challenge, correct, or falsify any information. The user did not accept an AI answer (Sycophancy), request aesthetic changes, or challenge logic. The interaction is completely non-reactive and demonstrates a total absence of critical engagement. This lack of any attempt to test or question the AI model places the behavior at the very bottom of the scale. It represents the baseline of interaction, which is even more passive than a 'Yes-man' who at least reacts to an AI output. Therefore, the score is the lowest possible.", "matrix_falsifier_cited_source_id": null, "matrix_falsifier_cited_text_quote": null, "matrix_falsifier_scaled": 5.5, "matrix_falsifier_normalized": 25.0, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_falsifier", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:52:58.329490+00:00", "unix_time": 1773510778, "v2_engine": true}, "_audit_signature": "step_falsifier:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510778", "_step_metadata": {"micro_strictness_levels": {"block_rule4": 50, "block_protocol1": 50, "block_globalcontext": 50, "block_headermandates": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule5": 50, "block_instructionbiblicalgrounding": 50, "block_instructionnohallucination": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "matrix_falsifier": 50, "block_taskfalsifier": 50}}}, "step_profiler": {"matrix_kahneman": 1.0, "matrix_kahneman_justification": "The user's input across all provided sources is exclusively composed of the same few sentences repeated ad nauseam. The text asserts the project's importance without providing any reasoning, evidence, or analysis. This performance is a clear demonstration of System 1 thinking, which is characterized by automatic, intuitive, and effortless cognitive processes. There is a complete absence of the deliberate, analytical, and logical effort that defines System 2. The user is not engaging in any form of systematic thought, questioning of assumptions, or consideration of alternatives. Instead, the output is a low-effort, repetitive assertion, which is the hallmark of fast, unconscious intuition. The thinking process is entirely on autopilot, showing no signs of transitioning towards slower, more deliberate analysis.", "matrix_kahneman_cited_source_id": null, "matrix_kahneman_cited_text_quote": null, "matrix_kahneman_scaled": 6.0, "matrix_kahneman_normalized": 33.33333333333333, "profiler_metrics": {"word_count": 579, "sentence_count": 135, "avg_sentence_length": 4.29, "lexical_diversity": 0.06, "capitalization_ratio": 0.07, "control_ratio": 1.0, "say_do_gap": 0.0, "automation_bias": 0.0, "illusion_of_competence": 0.0, "imperative_command_count": 0}, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_profiler", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:52:58.457765+00:00", "unix_time": 1773510778, "v2_engine": true}, "_audit_signature": "step_profiler:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510778", "_step_metadata": {"micro_strictness_levels": {"block_globalcontext": 50, "block_headermandates": 50, "block_mandate2": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule5": 50, "block_heuristic2": 50, "block_instructionbiblicalgrounding": 50, "block_instructionnohallucination": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_heuristic1": 50, "block_instruction_strictness": 50, "matrix_kahneman": 50, "block_taskprofiler": 50}}}, "step_logician": {"matrix_toulmin": 1.0, "matrix_toulmin_justification": "The analysis of the provided text through the lens of Toulmin's model reveals a complete absence of a structured argument. The text presents a claim, 'This is an important project' ('T\u00e4m\u00e4 on t\u00e4rke\u00e4 hanke'), and repeats it incessantly. However, it offers no data, evidence, or grounds to support this claim. The statement 'The outputs are important for the project' is another unsubstantiated claim, not data. Without any data, a warrant (the logical bridge) cannot exist. The argument is nothing more than a bare, repeated assertion, which corresponds to the lowest score on the scale, as the claim is entirely without grounds.", "matrix_toulmin_cited_source_id": null, "matrix_toulmin_cited_text_quote": null, "matrix_bloom": 1.0, "matrix_bloom_justification": "The cognitive level demonstrated in the text aligns perfectly with the 'Remembering' stage of Bloom's Taxonomy. The user is simply recalling and repeating a series of phrases verbatim. There is no evidence of 'Understanding,' as the concepts are not explained or rephrased in a meaningful way. The performance is a clear example of rote memorization, where information is reproduced without any implication of deeper comprehension or the ability to apply, analyze, or evaluate it. The entire input is a loop of the same information, which is the hallmark of the most basic cognitive level.", "matrix_bloom_cited_source_id": null, "matrix_bloom_cited_text_quote": null, "matrix_toulmin_scaled": 5.2, "matrix_toulmin_normalized": 20.0, "matrix_bloom_scaled": 5.0, "matrix_bloom_normalized": 16.666666666666664, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_logician", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:52:58.168615+00:00", "unix_time": 1773510778, "v2_engine": true}, "_audit_signature": "step_logician:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510778", "_step_metadata": {"micro_strictness_levels": {"block_globalcontext": 50, "block_headermandates": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule3": 50, "block_instructionbiblicalgrounding": 50, "block_instructionnohallucination": 50, "block_instructioncitationobligation": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "matrix_toulmin": 50, "matrix_bloom": 50, "block_tasklogician": 50, "block_instructionstrictscale": 50}}}, "step_causal_analyst": {"matrix_causal_analyst": 5.0, "matrix_causal_analyst_justification": "The relationship between the user's prompt and the final output is one of direct and indisputable cause and effect. The `product_text` is a verbatim, character-for-character copy of the text provided by the user in the `chat_log`. The AI's role was reduced to that of a copy machine. Therefore, the quality and content of the work are entirely and exclusively a direct result of the provided data, not the AI's skills or any other intervening factor. This represents a perfect causal link.", "matrix_causal_analyst_cited_source_id": null, "matrix_causal_analyst_cited_text_quote": null, "matrix_causal_abductive": 3.0, "matrix_causal_abductive_justification": "The user's guidance was a genuine, pre-active instruction. The `chat_log` serves as undeniable proof that the user provided the exact text they wanted as the output *before* the AI executed the task. There is no room for post-hoc rationalization, as the user's intent was simply to have their provided text become the output. This is a clear case of a user visioning and guiding the solution prior to execution.", "matrix_causal_abductive_cited_source_id": null, "matrix_causal_abductive_cited_text_quote": null, "block_taskcausal": "{\n  \"reasoning_trace\": \"The primary task is to evaluate the causal link between the user's input and the AI's output. The evidence is clear: the 'product_text' is an exact replica of the 'chat_log'. This indicates a direct, deterministic causal relationship. A counterfactual test confirms this: if the input text were different, the output text would be different in the exact same way. The analysis is therefore straightforward and the JSON output is structured to reflect this direct causality.\",\n  \"causal_analysis\": {\n    \"claim\": \"The user's prompt is the sole and direct cause of the final generated output.\",\n    \"evidence\": \"The content of the 'product_text' file is identical to the content of the 'chat_log' file.\",\n    \"causal_relationship_strength\": \"Deterministic. The output is a direct and unaltered copy of the input.\",\n    \"counterfactual_test\": {\n      \"scenario\": \"What if the user had provided a different text in the chat_log, such as 'This is a test.'?\",\n      \"predicted_outcome\": \"The 'product_text' would contain 'This is a test.' and nothing else.\",\n      \"simulation_result\": \"The counterfactual scenario holds true. Altering the cause (the input text) would directly and predictably alter the effect (the output text), confirming a perfect causal link.\",\n      \"matrix_causal_analyst_score\": 5.0,\n      \"matrix_causal_abductive_score\": 3.0\n    }\n  }\n}", "block_taskcausal_justification": "The instruction requires the creation of a JSON object that performs a causal analysis on the provided inputs. I have analyzed the relationship between the `chat_log` (cause) and `product_text` (effect), identified it as a direct copy, and constructed the counterfactual test as required. The resulting JSON string adheres to the described structure, containing a `reasoning_trace` and a nested `causal_analysis` object, fulfilling the task's mandate.", "block_taskcausal_cited_source_id": null, "block_taskcausal_cited_text_quote": null, "matrix_causal_analyst_scaled": 10.0, "matrix_causal_analyst_normalized": 100.0, "matrix_causal_abductive_scaled": 10.0, "matrix_causal_abductive_normalized": 100.0, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_causal_analyst", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:53:08.317488+00:00", "unix_time": 1773510788, "v2_engine": true}, "_audit_signature": "step_causal_analyst:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510788", "_step_metadata": {"micro_strictness_levels": {"block_heuristic2": 50, "block_heuristic1": 50, "block_globalcontext": 50, "block_headermandates": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule5": 50, "block_instructionbiblicalgrounding": 50, "block_instructionnohallucination": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "matrix_causal_analyst": 50, "matrix_causal_abductive": 50, "block_taskcausal": 50}}}, "step_performativity_detector": {"matrix_goodhart": 1.0, "matrix_goodhart_justification": "The user's performance is evaluated at the lowest possible level because the interaction lacks any form of critical engagement. The user provided identical, highly repetitive, and semantically empty text across all available input fields. The evaluation matrix for performativity assesses the user's critical reaction to an AI's analysis, particularly their ability to recognize when a metric or target becomes distorted.\n\nIn this scenario, there was no AI analysis for the user to react to. The user's own input is a form of performative behavior where the act of filling the text fields appears to be the sole target, rather than providing meaningful content for analysis. This demonstrates a complete failure to engage with the task's underlying purpose. This absolute lack of critical thought is functionally equivalent to the \"Blind Faith\" (Score 1) category, as it represents a state where even the most obvious logical flaws and vacuity\u2014in this case, within the user's own provided material\u2014are not considered or addressed. The user's action is purely mechanical and shows no awareness of the relationship between a measure and a goal.", "matrix_goodhart_cited_source_id": null, "matrix_goodhart_cited_text_quote": null, "matrix_goodhart_scaled": 5.2, "matrix_goodhart_normalized": 20.0, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_performativity_detector", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:53:10.619287+00:00", "unix_time": 1773510790, "v2_engine": true}, "_audit_signature": "step_performativity_detector:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510790", "_step_metadata": {"micro_strictness_levels": {"block_globalcontext": 50, "block_headermandates": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule5": 50, "block_instructionbiblicalgrounding": 50, "block_instructionnohallucination": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "matrix_goodhart": 50, "block_taskperformativity": 50}}}, "step_judge": {"matrix_judge": 1.0, "matrix_judge_justification": "[PASSIVITY PENALTY x1.00] The user's performance is evaluated as the lowest possible score based on a comprehensive review of the evidence. The input provided across all sources (`product_text`, `chat_log`, `reflection_text`) consists solely of a repetitive, low-information string with no instructions, questions, or tasks for the AI. The analysis from previous steps confirms this: the cognitive engagement is at the lowest level of Bloom's Taxonomy ('Remembering') and Kahneman's System 1 thinking. The Toulmin analysis shows a complete lack of argumentation (claim without grounds), and the Falsifier score is minimal because there was no AI output to challenge or interact with.\n\nAccording to the evaluation matrix, the user's role is 'Passenger (Rejected)'. This is justified because there was a total absence of guidance. The user did not use RFI, did not monitor any instruction compliance (as none were given), and did not engage in any form of quality assurance. The interaction is not even 'weak guidance'; it is a complete lack of guidance, representing the most passive form of user input possible. The user simply provided static, meaningless data without directing the AI in any way. Therefore, the performance is rejected for failing to meet the most basic criteria of interaction and guidance.", "matrix_judge_cited_source_id": null, "matrix_judge_cited_text_quote": null, "scoring_result": {"total_score": 59.33333333333333, "final_score": 59.33333333333333, "penalties_applied": [], "aggregation_status": "V2 Commensurate Average of 5 matrices"}, "integrity_audit": {"valid_citations": 0, "invalid_citations": ["System 1 operates automatically and quickly, with little or no effort and no sense of voluntary control."], "integrity_score": 0.0}, "matrix_judge_scaled": 5.2, "matrix_judge_normalized": 20.0, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_judge", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:53:39.005872+00:00", "unix_time": 1773510819, "v2_engine": true}, "_audit_signature": "step_judge:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510819", "_step_metadata": {"micro_strictness_levels": {"block_oprule4": 50, "block_oprule3": 50, "block_globalcontext": 50, "block_headermandates": 50, "block_mandate2": 50, "block_mandate3": 50, "block_mandate5": 50, "block_principle1": 50, "block_requirement1": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_instruction_strictness": 50, "matrix_judge": 50, "block_taskjudge": 50, "block_instructionstrictscale": 50}}}, "step_xai_reporter": {"matrix_xai_reporter": 3.0, "matrix_xai_reporter_justification": "The synthesis of all prior analyses reveals a complete consensus. The Profiler identified purely System 1 thinking (Kahneman score 1.0), the Logician found a complete absence of argumentation and only the 'Remembering' cognitive level (Toulmin & Bloom scores 1.0), and the Falsifier noted a total lack of critical engagement (score 1.0). The Judge confirmed a \"total absence of guidance\" (score 1.0). The Causal Analyst's high scores (5.0 and 3.0) perfectly explain these low scores by establishing the user's input as the direct and sole cause of the output. There are no contradictions; all agents unanimously support the same outcome of a minimal, passive user interaction. This represents complete certainty in the analysis.", "matrix_xai_reporter_cited_source_id": null, "matrix_xai_reporter_cited_text_quote": null, "matrix_taskxai_clarity": 5.0, "matrix_taskxai_clarity_justification": "The task of producing an explainable and transparent report is achieved with maximum confidence. The findings from all preceding analytical steps are entirely consistent and unambiguous. Every agent, from the Profiler to the Logician and Falsifier, provided evidence pointing to a minimal, low-effort user interaction. The Causal Analyst's report reinforces this by establishing a deterministic link between the user's input and the final output. With no conflicting data or interpretative ambiguities to resolve, the synthesis is a direct and clear summary of unanimous evidence. This allows for a report that is perfectly transparent, explaining exactly how the verdict was reached by tracing the consistent findings through each stage of the evaluation.", "matrix_taskxai_clarity_cited_source_id": null, "matrix_taskxai_clarity_cited_text_quote": null, "matrix_xai_reporter_scaled": 3.0, "matrix_xai_reporter_normalized": 100.0, "matrix_taskxai_clarity_scaled": 5.0, "matrix_taskxai_clarity_normalized": 100.0, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_xai_reporter", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:53:55.082615+00:00", "unix_time": 1773510835, "v2_engine": true}, "_audit_signature": "step_xai_reporter:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510835", "_step_metadata": {"micro_strictness_levels": {"block_globalcontext": 50, "block_headermandates": 50, "block_mandate2": 50, "block_mandate3": 50, "block_principle1": 50, "block_requirement1": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "matrix_xai_reporter": 50, "matrix_taskxai_clarity": 50}}}, "step_coach": {"block_taskcoach": "{\n  \"performance_summary\": \"Your interaction was evaluated as entirely passive. You provided a repetitive, low-information text without any specific instructions, questions, or goals. This resulted in the AI's role being reduced to simply copying your input, reflecting the lowest possible levels of cognitive engagement and interactive guidance.\",\n  \"areas_for_improvement\": [\n    {\n      \"area\": \"Cognitive Engagement (Bloom's & Kahneman's Frameworks)\",\n      \"observation\": \"The analysis concluded that your input operated at the 'Remembering' level of Bloom's Taxonomy (rote repetition) and was a clear example of automatic 'System 1' thinking. There was a complete absence of deeper understanding, application, or analysis.\",\n      \"suggestion\": \"To achieve a more meaningful outcome, structure your prompts to elicit higher-order thinking. For example, ask the AI to 'Explain this concept in simple terms' (Understanding), 'Use this data to create a project plan' (Applying), or 'Compare the pros and cons of this approach' (Analyzing).\"\n    },\n    {\n      \"area\": \"Logical Argumentation (Toulmin's Model)\",\n      \"observation\": \"Your input consisted of a repeated claim ('This is an important project') without any supporting data or evidence. A robust interaction requires logical structure.\",\n      \"suggestion\": \"Strengthen your prompts by providing grounds for your claims. Instead of just stating importance, explain *why*. For example: 'This project is important [Claim] because it is projected to increase user engagement by 30% [Data].' This allows the AI to work with a logical foundation.\"\n    },\n    {\n      \"area\": \"Critical Interaction (Falsifier Principle)\",\n      \"observation\": \"The interaction was a one-way data dump. There was no dialogue, which meant there was no opportunity to challenge, refine, or correct the AI's output. This represents a complete lack of critical engagement.\",\n      \"suggestion\": \"Treat the AI as an interactive partner. After its first response, provide feedback. Ask it to elaborate, correct its mistakes, or consider an alternative perspective. This iterative process of testing and refining is crucial for achieving high-quality results.\"\n    }\n  ],\n  \"next_step_recommendation\": \"In your next session, define a clear task for the AI. Instead of just providing text, instruct the AI to *do* something with it, such as summarizing it, extracting key information, rewriting it for a different audience, or identifying potential risks based on the content. This shift from providing static data to assigning a dynamic task is the first step toward a more powerful and productive collaboration.\"\n}", "block_taskcoach_justification": "The coaching feedback is directly derived from the unanimous conclusions of the preceding analytical steps. The user's performance was scored at the absolute minimum across all evaluated matrices: Bloom (1.0 for 'Remembering'), Kahneman (1.0 for 'System 1'), Toulmin (1.0 for 'Claim without Grounds'), Falsifier (1.0 for 'Non-reactive'), and Judge (1.0 for 'Passenger (Rejected)'). The causal analysis confirmed the output was a verbatim copy of the input. Therefore, the coaching is designed to be fundamentally remedial. It addresses these specific, identified failures by providing concrete, actionable advice on how to move beyond passive data entry towards active, critical, and goal-oriented interaction with the AI, thus fulfilling the coach's mandate to guide the user towards deeper solutions.", "block_taskcoach_cited_source_id": null, "block_taskcoach_cited_text_quote": null, "step_metadata": {"execution_id": "5da625e0-4549-4a1c-8263-89c3d03ca3c2", "workflow_id": "workflow_courtroom_20_full_audit", "step_id": "step_coach", "initiator_id": "system", "timestamp_isot": "2026-03-14T17:53:55.017854+00:00", "unix_time": 1773510835, "v2_engine": true}, "_audit_signature": "step_coach:5da625e0-4549-4a1c-8263-89c3d03ca3c2:1773510835", "_step_metadata": {"micro_strictness_levels": {"block_globalcontext": 50, "block_headermandates": 50, "block_mandate2": 50, "block_mandate3": 50, "block_mandate5": 50, "block_headerrules": 50, "block_rule1": 50, "block_rule2": 50, "block_rule3": 50, "block_rule4": 50, "block_rule5": 50, "block_rule6": 50, "block_oprule1": 50, "block_oprule2": 50, "block_oprule3": 50, "block_principle1": 50, "block_requirement1": 50, "block_heuristic1": 50, "block_heuristic2": 50, "block_heuristic3": 50, "block_instructionlanguage_dynamic": 50, "block_headerinstructions": 50, "block_taskcoach": 50, "block_instructionstrictscale": 50, "block_i