story": false, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 lopputuote (esim. PDF muodossa).", "en": "Attach Product (e.g. as PDF)."}}, "ai_description": {"default_locale": "fi", "translations": {"fi": "T\u00e4m\u00e4 on lopputuotteen dokumentaatio.", "en": "This is the final product documentation."}}, "questionnaire_definition": []}, {"input_key": "chat_log", "label": {"default_locale": "fi", "translations": {"fi": "Keskusteluhistoria", "en": "Chat Log"}}, "required": true, "is_chat_history": true, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 keskusteluhistoria ihmisen ja teko\u00e4lyn v\u00e4lill\u00e4.", "en": "Attach chat log between human and AI."}}, "ai_description": {"default_locale": "fi", "translations": {"fi": "T\u00e4m\u00e4 on j\u00e4sennetty loki k\u00e4ytt\u00e4j\u00e4n ja teko\u00e4lyn v\u00e4lisest\u00e4 dialogista.", "en": "This is the parsed log of the dialogue between user and AI."}}, "questionnaire_definition": []}, {"input_key": "reflection_text", "label": {"default_locale": "fi", "translations": {"fi": "Reflektiodokumentti", "en": "Reflection"}}, "required": false, "is_chat_history": false, "input_modes": ["questionnaire"], "description": {"default_locale": "fi", "translations": {"fi": "Vastaa lyhyesti reflektiokysymyksiin.", "en": "Answer reflection questions briefly."}}, "ai_description": {"default_locale": "fi", "translations": {"fi": "T\u00e4m\u00e4 on k\u00e4ytt\u00e4j\u00e4n vapaamuotoinen reflektio.", "en": "This is the user's free-form reflection."}}, "questionnaire_definition": [{"question_id": "ref1", "question": {"default_locale": "fi", "translations": {"fi": "Mik\u00e4 oli mielest\u00e4si onnistuneinta t\u00e4ss\u00e4 vuorovaikutuksessa?", "en": "What do you think was the most successful part of this interaction?"}}, "type": "text"}, {"question_id": "ref2", "question": {"default_locale": "fi", "translations": {"fi": "Mit\u00e4 tekisit toisin ensi kerralla?", "en": "What would you do differently next time?"}}, "type": "text"}]}], "steps": [{"id": "step_input_processing", "task_blueprint": "step_input_processing", "depends_on": [], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_guard", "task_blueprint": "step_guard", "depends_on": ["step_input_processing"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_analyst", "task_blueprint": "step_analyst", "depends_on": ["step_guard"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_profiler", "task_blueprint": "step_profiler", "depends_on": ["step_guard"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "precise"}, {"id": "step_logician", "task_blueprint": "step_logician", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "strict"}, {"id": "step_falsifier", "task_blueprint": "step_falsifier", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "strict"}, {"id": "step_causal_analyst", "task_blueprint": "step_causal_analyst", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "deep"}, {"id": "step_performativity_detector", "task_blueprint": "step_performativity_detector", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "precise"}, {"id": "step_overseer", "task_blueprint": "step_overseer", "depends_on": ["step_analyst"], "input_mappings": {"step_analyst": "$step_analyst", "inputs": "$inputs"}, "model_strategy": "strict"}, {"id": "step_archivist", "task_blueprint": "step_archivist", "depends_on": ["step_guard"], "input_mappings": {"inputs": "$inputs"}, "model_strategy": "fast"}, {"id": "step_judge", "task_blueprint": "step_judge", "d