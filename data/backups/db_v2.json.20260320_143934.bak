{"system_config": {"1": {"id": "syscfg_658b86111cb44e658c2d0c868141b841", "slug": "config_model_registry", "type": "model_registry", "models": {"deep": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.5, "top_p": null, "tpm_limit": 30000, "rpm_limit": 2, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "GEMINI_JSON", "is_active": true}, "fast": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.1, "top_p": null, "tpm_limit": 100000, "rpm_limit": 15, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "GEMINI_JSON", "is_active": true}, "search": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.0, "top_p": null, "tpm_limit": 100000, "rpm_limit": 15, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "GEMINI_JSON", "is_active": true}, "precise": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.3, "top_p": null, "tpm_limit": 30000, "rpm_limit": 2, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "GEMINI_JSON", "is_active": true}, "strict": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.1, "top_p": null, "tpm_limit": 30000, "rpm_limit": 2, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "GEMINI_JSON", "is_active": true}, "SearchHook": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.0, "top_p": null, "tpm_limit": 100000, "rpm_limit": 15, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "GEMINI_JSON", "is_active": true}}}}, "workflows": {"1": {"id": "wf_d653170e174847559e08af42b938d826", "slug": "kokonaisvaltainen_auditointi", "name": {"default_locale": "