itointi", "en": "Falsification Audit"}}}], "validation_rules": {"max": 4.0}}, "blk_15baac89cc9445ec9e9bccac2680688d": {"field_id": "blk_15baac89cc9445ec9e9bccac2680688d", "component_type": "hidden", "options": [{"label": {"default_locale": "fi", "translations": {"fi": "Teht\u00e4vien Falsifioija", "en": "Task Falsifier"}}}], "validation_rules": {"max": 6.0}}, "blk_bf8a99a1b3514f6c93aff42a4cc52213": {"field_id": "blk_bf8a99a1b3514f6c93aff42a4cc52213", "component_type": "slider", "options": [{"label": {"default_locale": "fi", "translations": {"fi": "Kausaalisuuden Analyysi", "en": "Causal Analyst"}}}], "validation_rules": {"max": 5.0}}, "blk_a8e356b276f04ddeb7cc3a0eec58daf6": {"field_id": "blk_a8e356b276f04ddeb7cc3a0eec58daf6", "component_type": "slider", "options": [{"label": {"default_locale": "fi", "translations": {"fi": "Kausaalinen ja Abduktiivinen Integriteetti", "en": "Causal & Abductive Integrity"}}}], "validation_rules": {"max": 3.0}}, "blk_da0f1a42f08f4fb6bd23177302444f60": {"field_id": "blk_da0f1a42f08f4fb6bd23177302444f60", "component_type": "hidden", "options": [{"label": {"default_locale": "fi", "translations": {"fi": "Kausaalivaikutusten Todentaminen", "en": "Causal Impact Verification"}}}], "validation_rules": {"max": 6.0}}, "blk_b5ec25bb352e4dc09de386f0da991a08": {"field_id": "blk_b5ec25bb352e4dc09de386f0da991a08", "component_type": "slider", "options": [{"label": {"default_locale": "fi", "translations": {"fi": "Performatiivisuus ja Goodhartin Laki", "en": "Performativity & Goodhart's Law"}}}], "validation_rules": {"max": 5.0}}, "blk_03e4b136739f41a48ed06aab823b8b8f": {"field_id": "blk_03e4b136739f41a48ed06aab823b8b8f", "component_type": "hidden", "options": [{"label": {"default_locale": "fi", "translations": {"fi": "Performatiivisuuden Auditointi", "en": "Task Performativity Audit"}}}], "validation_rules": {"max": 6.0}}, "blk_4c19f32f1dc14672bd2951c8bb70dcc4": {"field_id": "blk_4c19f32f1dc14672bd2951c8bb70dcc4", "component_type": "hidden", "options":