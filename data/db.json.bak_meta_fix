                            "semanttinen_tarkistussumma": "f080e59f129ff2476f4fd599b8e7979bd39c93f6275110a7e1d53d3295b575b4",
                            "role_classification": "Passenger",
                            "input_quality_score": 0.4,
                            "improvement_suggestions": [
                                "Määrittele tarkemmin, mitä 'parempi versio' tarkoittaa. Haluatko esimerkiksi lisää myyvyyttä, virallisemman sävyn, lyhyemmän tekstin, kohdennuksen tiettyyn yleisöön tai tiettyjen etujen korostamista?",
                                "Anna esimerkkejä toivomastasi tyylistä tai sävystä, jos sinulla on mielessä tietty malli.",
