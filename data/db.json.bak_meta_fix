        "464": {
            "id": "35b51da6-8fd8-4e0d-8a74-0b8036d222c6",
            "type": "claim",
            "term": "McHugh 2012...",
            "definition": "Agenda jakautuu kahteen vaiheeseen: Ulkoisen validiteetin testaus (arvioijien välinen luotettavuus IRR): On välittömästi käynnistettävä vertaileva pilottitutkimus (n=50), joka mittaa Kognitiivisen Kvoorumin arvioitsijareliabiliteetin (IRR) suhteessa ihmisasiantuntijoihin käyttämällä Cohenin Kappa -kerrointa ja Intra-Class Correlation (ICC) -mittaria.",
            "source_file": "Holistinen Mestaruus.docx",
