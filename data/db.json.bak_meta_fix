                            "hypotheses": [
                                {
                                    "id": "HYP-1",
                                    "claim_text": "Käyttäjä aktiivisesti tarkensi analyysin laajuutta ja sävyä, ohjaten sen pois yleisestä kuvauksesta kohti realistista ja ei-toiveajatteluun perustuvaa näkemystä.",
                                    "evidence_found": true,
