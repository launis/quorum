                            {
                                "id": "1a5e634d-0810-466f-9666-e0817d366cd4",
                                "type": "claim",
                                "term": "Agrawal ym. 2022...",
                                "definition": "Kun tekoälyn kyky tuottaa ennusteita ja sisältöä yleistyy ja on laajasti saatavilla, ihmisen arvonluonnin ytimeen nousevat arviointi- ja harkintakyky sekä näiden taitojen hyödyntäminen päätöksentekojärjestelmien strategisessa uudelleensuunnittelussa.",
