          throwsA(
            isA<AppException>()
                .having((e) => e.errorCode, 'errorCode', 'RESOURCE_IN_USE')
                .having((e) => e.status, 'status', 400),
          ),
        );

        // Verify client was called
        verify(() => mockClient.deletePromptBlock(id)).called(1);
      },
    );
  });
}
