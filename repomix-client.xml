                        label: val,
                      );
                    });
                  },
                ),
              ] else if (_editableI18nText != null) ...[
                I18nTextField(
                  label: 'Item Content',
                  initialData: _editableI18nText!,
                  onChanged: (val) {
                    setState(() {
                      _editableI18nText = val;
                    });
                  },
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }
}
