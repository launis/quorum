                children: [
                  Text(
                    '$agent ($version)',
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                      color: Theme.of(context).colorScheme.onSurfaceVariant,
                    ),
                  ),
                  Text(
                    timestamp,
                    style: TextStyle(
