    if (key == null) return "N/A";
    final l10n = AppLocalizations.of(context)!;
    switch (key) {
      // Security
      case 'SEC_THREAT_DETECTED':
        return l10n.secThreatDetected;
      case 'SEC_THREAT_NONE':
        return l10n.secThreatNone;
      case 'SEC_ANONYMIZED':
