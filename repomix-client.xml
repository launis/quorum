                        ),
                        onPressed: isMockLoading.value
                            ? null
                            : () => mockLogin(
                                'usr_b2d6e4487afc4e69', // VIEWER
                              ),
                        child: const Text('Mock Login (Viewer)'),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}
