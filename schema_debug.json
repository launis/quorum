{
  "model_name": "workflow_definition",
  "schema_def": {
    "$defs": {
      "ComponentScoringRule": {
        "description": "Defines how a specific component contributes to a score.",
        "properties": {
          "component_id": {
            "description": "ID of the component being scored",
            "title": "Component Id",
            "type": "string",
            "x-ui-label": "Component ID"
          },
          "weight": {
            "default": 1.0,
            "description": "Weight multiplier for this component",
            "title": "Weight",
            "type": "number",
            "x-ui-label": "Weight"
          },
          "metric_key": {
            "description": "Key of the metric to extract (e.g., 'compliance_score')",
            "title": "Metric Key",
            "type": "string",
            "x-ui-label": "Metric Key"
          }
        },
        "required": [
          "component_id",
          "metric_key"
        ],
        "title": "ComponentScoringRule",
        "type": "object"
      },
      "ScoringLogic": {
        "description": "Named collection of scoring rules.",
        "properties": {
          "label": {
            "description": "Display label for this scoring logic",
            "title": "Label",
            "type": "string",
            "x-ui-label": "Label"
          },
          "rules": {
            "description": "List of rules defining the score",
            "items": {
              "$ref": "#/$defs/ComponentScoringRule"
            },
            "title": "Rules",
            "type": "array",
            "x-ui-label": "Rules"
          }
        },
        "required": [
          "label"
        ],
        "title": "ScoringLogic",
        "type": "object"
      },
      "WorkflowStep": {
        "description": "Represents a single step in a workflow execution.\n\nThis model defines the task to be executed and how data maps\nfrom the workflow state into the task's input schema.",
        "properties": {
          "id": {
            "description": "Unique step identifier, e.g., 'safety_check'",
            "title": "Id",
            "type": "string",
            "x-ui-label": "ID"
          },
          "name": {
            "description": "Human-readable name of the step",
            "title": "Name",
            "type": "string",
            "x-ui-label": "Step Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional description of the step's purpose",
            "title": "Description",
            "x-ui-label": "Description"
          },
          "task_key": {
            "description": "Registry Task Name (matches @register_task name)",
            "title": "Task Key",
            "type": "string",
            "x-ui-label": "Task Key"
          },
          "inputs": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Maps task inputs to state values. Example: {'text': '$inputs.history_text'}",
            "title": "Inputs",
            "type": "object",
            "x-ui-label": "Inputs"
          },
          "config": {
            "additionalProperties": true,
            "description": "Optional static config for the task",
            "title": "Config",
            "type": "object",
            "x-ui-label": "Configuration"
          },
          "hoist_keys": {
            "description": "Defines which keys from the task's result should be promoted to the top-level execution state",
            "items": {
              "type": "string"
            },
            "title": "Hoist Keys",
            "type": "array",
            "x-ui-label": "Hoist Keys"
          },
          "metadata": {
            "additionalProperties": true,
            "description": "Arbitrary metadata for the step (e.g., 'agent_class')",
            "title": "Metadata",
            "type": "object",
            "x-ui-label": "Metadata"
          }
        },
        "required": [
          "id",
          "name",
          "task_key"
        ],
        "title": "WorkflowStep",
        "type": "object"
      }
    },
    "description": "Defines the structure of a workflow stored in the DB.\n\nA workflow is an ordered sequence of steps that process data\ntransformation through registered tasks.",
    "properties": {
      "id": {
        "description": "Unique Workflow ID, e.g., 'comprehensive_audit_v1'",
        "title": "Id",
        "type": "string"
      },
      "name": {
        "default": "Untitled Workflow",
        "description": "Human-readable name for the workflow",
        "minLength": 3,
        "title": "Name",
        "type": "string",
        "x-ui-label": "Workflow Name",
        "x-ui-widget": "text"
      },
      "steps": {
        "description": "Ordered list of Step Definitions",
        "items": {
          "$ref": "#/$defs/WorkflowStep"
        },
        "title": "Steps",
        "type": "array",
        "x-ui-group": "Steps",
        "x-ui-widget": "reorderable-list"
      },
      "description": {
        "description": "Human-readable description of what this workflow does",
        "title": "Description",
        "type": "string",
        "x-ui-label": "Description",
        "x-ui-widget": "textarea"
      },
      "status": {
        "default": "draft",
        "description": "Workflow lifecycle status",
        "enum": [
          "draft",
          "active",
          "deprecated",
          "archived"
        ],
        "title": "Status",
        "type": "string",
        "x-ui-label": "Status",
        "x-ui-widget": "select"
      },
      "version": {
        "default": 1,
        "description": "Numeric version",
        "title": "Version",
        "type": "integer"
      },
      "is_public": {
        "default": false,
        "description": "If checked, visible to all tenants (System Only)",
        "title": "Is Public",
        "type": "boolean",
        "x-ui-label": "Publicly Available"
      },
      "organization_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Organization ID this workflow belongs to (or 'system')",
        "title": "Organization Id",
        "x-ui-label": "Organization ID"
      },
      "scoring_logic": {
        "description": "Defined scoring methods for this workflow",
        "items": {
          "$ref": "#/$defs/ScoringLogic"
        },
        "title": "Scoring Logic",
        "type": "array",
        "x-ui-group": "Scoring Logic",
        "x-ui-label": "Scoring Logic"
      },
      "ui_schema": {
        "additionalProperties": true,
        "description": "JSON Schema for the dynamic input form",
        "title": "Ui Schema",
        "type": "object",
        "x-ui-label": "UI Schema"
      }
    },
    "required": [
      "id",
      "description"
    ],
    "title": "WorkflowDefinition",
    "type": "object"
  }
}