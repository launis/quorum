# Local Seed Secrets Template (Copy to .env.secrets.local and populate with real local credentials)
# WARNING: Never commit real credentials to .env.secrets.example or version control.
# Running `uv run python backend_v2/seed/run_seed.py local` encrypts these values into PostgreSQL 19 `tenant_secrets`
# under the Root System Organization (org_0195f3a0000070008000000000000001) and provisions the ROOT user in Firebase Auth.

SECRET_AI_STUDIO_API_KEY=""
SECRET_VERTEX_AI_SA_JSON=""
SECRET_OPENAI_API_KEY=""
SECRET_ANTHROPIC_API_KEY=""
SECRET_TAVILY_API_KEY=""
SECRET_LOGFIRE_TOKEN=""
SECRET_LOGFIRE_READ_TOKEN=""
SECRET_ROOT_USER_EMAIL=""
SECRET_ROOT_USER_PASSWORD=""
