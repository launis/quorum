      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "Analyst"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Olet Analyytikko (Analyst). Tehtäväsi on käsitellä tietoa puolueettomasti, etsiä syy-seuraussuhteita ja muodostaa selkeä, jäsennelty katsaus käsiteltävästä materiaalista."
        }
      },
      "category_id": "agent_role",
      "type": "instruction",
      "allow_decimals": false,
      "strictness_level": 50,
      "require_justification": false,
      "theory_grounding": null,
