    {
      "id": "workflow_courtroom_20_full_audit",
      "slug": "workflow_courtroom_20_full_audit",
      "name": {
        "default_locale": "fi",
        "translations": {
          "fi": "Courtroom 2.0 (Full Audit)"
        }
      },
      "description": {
