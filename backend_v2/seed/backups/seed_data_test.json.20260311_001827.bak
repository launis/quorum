      "columns": null
    },
    {
      "id": "matrix_coach",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "Coach"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Olet Valmentaja (Coach). Tehtäväsi on antaa rakentavaa palautetta, tukea kognitiivista kehitystä ja ohjata käyttäjää tai toista agenttia kohti parempia ja syvällisempiä ratkaisuja."
        }
      },
      "category_id": "agent_role",
      "type": "instruction",
      "allow_decimals": false,
