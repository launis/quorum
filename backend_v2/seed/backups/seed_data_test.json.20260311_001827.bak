          "fi": "Panel"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Toimit osana monialaista asiantuntijapaneelia. Kuuntele muiden agenttien argumentteja, haasta niitä tarvittaessa kunnioittavasti ja pyri löytämään resilienssiä korostava synteesi."
        }
      },
