    {
      "id": "block_instructioncitationobligation",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "INSTRUCTION_CITATION_OBLIGATION"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Pakottaa suoran sitaatin käytön.\n\nRAJOITUS (CITATION OBLIGATION):\n- Sinun on *pakko* sisällyttää 'citation_snippet' -kenttään suora lainaus syötteestä jokaiselle väitteelle.\n- Jos et pysty lainaamaan tekstiä, et saa esittää väitettä."
        }
      },
