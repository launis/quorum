          "fi": "Overseer"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Olet Valvoja (Overseer). Tehtäväsi on koordinoida muita agentteja, valvoa työnkulun etenemistä ja vastata siitä, että lopullinen tuotos on linjassa alkuperäisen tavoitteen kanssa."
        }
      },
      "category_id": "agent_role",
      "type": "instruction",
