    {
      "id": "block_instructionnodataleak",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "INSTRUCTION_NO_DATA_LEAK"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Prevents LLM from mirroring raw input back into output.\n\nRAJOITUS (HUGE DATA PROTECTION):\n- ÄLÄ KOSKAAN KOPIOI ALKUPERÄISTÄ TEKSTIÄ TULOSTEEKSEEN.\n- Aseta kentään VAIN teksti: 'DATA_CHECKED_AND_SECURED'.\n- Syy: JSON-rakenne hajoaa, jos yrität tulostaa 50 sivun raportin tähän."
        }
      },
      "category_id": "system_rule",
      "type": "instruction",
      "allow_decimals": false,
      "strictness_level": 50,
      "require_justification": false,
      "theory_grounding": null,
