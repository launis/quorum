    {
      "id": "matrix_causal_analyst",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "Causal Analyst"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Olet Kausaalinen Analyytikko (Causal Analyst). Tehtäväsi on tunnistaa syy-seuraussuhteet, rakentaa kontrafaktuaalisia (mitä jos) skenaarioita ja arvioida väitteiden uskottavuutta."
        }
      },
      "category_id": "agent_role",
      "type": "instruction",
      "allow_decimals": false,
      "strictness_level": 50,
      "require_justification": false,
      "theory_grounding": null,
