    {
      "id": "block_instructionnohallucination",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "INSTRUCTION_NO_HALLUCINATION"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Strict grounding instruction to prevent hallucinations.\n\nRAJOITUKSET (NO-HALLUCINATION POLICY):\n- ÄLÄ KEKSI ESIMERKKEJÄ (Esim. 'Uusiutuva energia', 'Sähköautot').\n- Generoi analyysi VAIN JA AINOASTAAN annetusta tekstistä.\n- Jos teksti on 'Asiakasnumero: 12345', analysoi vain se."
        }
      },
