          "fi": "Falsifier"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Laske 'Critical Distance Score' (1-4) aineiston perusteella."
        }
      },
      "category_id": "scientific_theory",
      "type": "int",
      "allow_decimals": false,
      "strictness_level": 50,
      "require_justification": false,
      "scales": [
        {
          "score": 1,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Myötäilyvinouma (Sycophancy)",
              "en": "Sycophancy Bias"
            }
          },
          "claims": [
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Käyttäjä on 'Jees-mies'. Hyväksyi tekoälyn ensimmäisen vastauksen sokeasti.",
                "en": "User is a 'Yes-man'. Blindly accepted the AI's first answer."
              }
            },
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Ei yhtäkään korjausliikettä tai vastalauseen ('Ei, vaan...') esittämistä.",
                "en": "Not a single corrective move or objection ('No, instead...') presented."
              }
            }
          ]
        },
        {
          "score": 2,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Kosmeettinen Korjaaja (Aesthetic)",
              "en": "Aesthetic Corrector"
            }
          },
          "claims": [
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Käyttäjä pyysi muutoksia, mutta ne olivat vain pintapuolisia (esim. lyhennys tai sävy).",
                "en": "User requested changes, but they were only superficial (e.g. shortening or tone)."
              }
            },
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Sisältöä ja alkuperäistä logiikkaa ei haastettu.",
                "en": "Content and initial logic were not challenged."
              }
            }
          ]
        },
        {
          "score": 3,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Substanssin Haastaja (Substantive)",
              "en": "Substantive Challenger"
            }
          },
          "claims": [
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Käyttäjä etsi aktiivisesti loogisia virheitä tai pyysi tekoälyä perustelemaan jonkin tietyn väitteen.",
                "en": "User actively looked for logical errors or asked the AI to justify a specific claim."
              }
            },
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Popperilainen iteraatiosilmukka (kumoamisyritys) löytyi aineistosta.",
                "en": "Popperian iteration loop (attempted refutation) found in the material."
              }
            }
          ]
        },
        {
          "score": 4,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Armoton Falsifioija (Popperian)",
              "en": "Ruthless Falsifier"
            }
          },
          "claims": [
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Käyttäjä yritti koko painollaan rikkoa tekoälyn mallin syöttämällä vasta-argumentteja ja haastamalla oletuksia.",
                "en": "User tried with full force to break the AI's model by feeding counter-arguments and challenging assumptions."
              }
            },
            {
              "default_locale": "fi",
              "translations": {
                "fi": "Tieteellisen tiedonhankinnan mestariluokka.",
                "en": "Masterclass in scientific knowledge acquisition."
              }
            }
          ]
        }
      ],
      "theory_grounding": {
        "citation_reference": "Popper, K. (1963). Conjectures and Refutations: The Growth of Scientific Knowledge. (Falsification principle & Anti-Sycophancy).",
        "source_url": "https://plato.stanford.edu/entries/popper/"
      },
      "rows": [
