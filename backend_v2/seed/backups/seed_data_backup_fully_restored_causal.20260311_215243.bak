              "en": "Attach chat log between human and AI."
            }
          },
          "ai_description": {
            "default_locale": "fi",
            "translations": {
              "fi": "Tämä on jäsennetty loki käyttäjän ja tekoälyn välisestä dialogista.",
              "en": "This is the parsed log of the dialogue between user and AI."
            }
          },
          "questionnaire_definition": []
        },
        {
