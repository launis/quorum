              "en": "Answer reflection questions briefly."
            }
          },
          "ai_description": {
            "default_locale": "fi",
            "translations": {
              "fi": "Tämä on käyttäjän vapaamuotoinen reflektio.",
              "en": "This is the user's free-form reflection."
            }
          },
          "questionnaire_definition": [
            {
              "question_id": "ref1",
              "question": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Mikä oli mielestäsi onnistuneinta tässä vuorovaikutuksessa?",
                  "en": "What do you think was the most successful part of this interaction?"
                }
              },
              "type": "text"
            },
            {
              "question_id": "ref2",
              "question": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Mitä tekisit toisin ensi kerralla?",
                  "en": "What would you do differently next time?"
                }
              },
              "type": "text"
            }
          ]
        }
      ],
