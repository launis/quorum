        "translations": {
          "fi": "HEURISTIC_3"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Occamin partaveitsi. Heuristiikka 3 (Occamin partaveitsi): MÄÄRÄYS: Yksinkertaisin selitys on todennäköisin."
        }
      },
      "category_id": "system_rule",
      "type": "instruction",
