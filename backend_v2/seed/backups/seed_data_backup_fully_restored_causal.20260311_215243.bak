    {
      "id": "block_instructionstrictscale",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "INSTRUCTION_STRICT_SCALE"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Pakottaa noudattamaan matriisin asteikkoa (Fail Fast). TÄRKEÄÄ: Kaikkien pisteiden ON oltava määritellyn asteikon (Scale) sisällä. Sinun on noudatettava asteikon rajoja ehdottomasti. Pisteet alle asteikon minimin tai yli maksimin ovat kiellettyjä."
        }
