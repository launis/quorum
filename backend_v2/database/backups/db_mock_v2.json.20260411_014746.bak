arsing_mode": "GEMINI_JSON", "caching_strategy": null, "is_active": true}, "SearchHook": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.0, "top_p": 0.1, "top_k": 1, "tpm_limit": 4000000, "rpm_limit": 5, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "GEMINI_JSON", "caching_strategy": null, "is_active": true}}}, "2": {"id": "sys_8172bda70c8641c5", "slug": "mcp_gateways", "type": "mcp_gateways", "tools": [{"tool_id": "mcp_tavily_search", "name": {"default_locale": "en", "translations": {"en": "Tavily AI Search", "fi": "Tavily AI -haku"}}, "description": "Search the internet for factual information using Tavily AI.", "input_schema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}]}}, "workflows": {"1": {"id": "wf_9d68c573802341db", "slug": "kokonaisvaltainen_auditointi", "name": {"default_locale": "fi", "translations": {"fi": "Kokonaisvaltainen Auditointi", "en": "Holistic Audit"}}, "description": {"default_locale": "fi", "translations": {"fi": "Kattava 12-vaiheinen auditointiketju, joka analysoi datan monipuolisesti ja tuottaa syv\u00e4llisen arvioinnin.", "en": "Comprehensive 12-step audit chain that analyzes data from multiple perspectives to produce an in-depth evaluation."}}, "status": "active", "version": 1, "is_public": true, "organization_id": null, "ui_schema": {}, "output_profiles": {}, "default_profile_id": "prf_5d6e7f8091a2b3c4", "expected_inputs": [{"input_key": "product_text", "label": {"default_locale": "fi", "translations": {"fi": "Lopputuote (Analyysin P\u00e4\u00e4kohde)", "en": "Product (Main Audit Target)"}}, "required": false, "is_chat_history": false, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "T\u00e4h\u00e4n liitet\u00e4\u00e4n auditoitavan prosessin varsinainen tuotos, esim. PDF-dokumentti.", "en": "Attach the actual output of the audited process (e.g. PDF)."}}, "ai_description": "SOURCE EVIDENCE DIRECTIVE: This artifact represents the final target output of the audited process. It must be evaluated strictly on its own merits without assuming any external context or hidden intentions. Treat this as the definitive end-result of the cognitive process.", "questionnaire_definition": []}, {"input_key": "chat_log", "label": {"default_locale": "fi", "translations": {"fi": "Keskusteluhistoria", "en": "Chat Log"}}, "required": true, "is_chat_history": true, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 keskusteluhistoria ihmisen ja teko\u00e4lyn v\u00e4lill\u00e4.", "en": "Attach chat log between human and AI."}}, "ai_description": "PROCESS EVIDENCE DIRECTIVE: This artifact contains the chronological dialogue unspooled between the human operator and the AI system leading up to the final product. You must analyze this strictly for developmental trajectory, cognitive dependencies, prompt compliance, and the balance of intellectual labor. Do not treat this as the final product itself, but rather the scaffolding that built it.", "questionnaire_definition": []}, {"input_key": "reflection_text", "label": {"default_locale": "fi", "translations": {"fi": "Reflektiodokumentti", "en": "Reflection"}}, "required": false, "is_chat_history": false, "input_modes": ["questionnaire"], "description": {"default_locale": "fi", "translations": {"fi": "Vastaa lyhyesti reflektiokysymyksiin.", "en": "Answer reflection questions briefly."}}, "ai_description": "META-COGNITIVE EVIDENCE DIRECTIVE: This artifact contains the human operator's post-hoc reflection on the interaction. Analyze this to establish the operator's self-awareness, critical distance, and theoretical grounding regarding the process. Evaluate if the reflection aligns transparently with the actual events logged in the chat history.", "questionnaire_definition": [{"question_id": "ref1", "question": {"default_locale": "fi", "translations": {"fi": "Mik\u00e4 oli mielest\u00e4si onnistuneinta t\u00e4ss\u00e4 vuorovaikutuksessa?", "en": "What do you think was the most successful part of this interaction?"}}, "type": "text"}, {"question_id": "ref2", "question": {"default_locale": "fi", "translations": {"fi": "Mit\u00e4 tekisit toisin ensi kerralla?", "en": "What would you do differently next time?"}}, "type": "text"}]}], "steps": [{"id": "sr_f0a26d17cc9b48a7", "task_blueprint": "sp_db849f9790984585", "depends_on": [], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_0f7947ec7007498c", "task_blueprint": "sp_ddb7cf7c8a0245d4", "depends_on": ["sr_f0a26d17cc9b48a7"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_02b7cc1e7c2a4a62", "task_blueprint": "sp_76eedbc020274f66", "depends_on": ["sr_f0a26d17cc9b48a7", "sr_0f7947ec7007498c"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_5a8ae009eee44fe2", "task_blueprint": "sp_b5c751d1cbe24735", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_99ca8c82a5aa48cd", "task_blueprint": "sp_6a45d484ad5b497c", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_87f408aeee64462f", "task_blueprint": "sp_8daee218c6b14f02", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_d56fb84fbe13463a", "task_blueprint": "sp_6f40b964895c426b", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_4d2272d8b4864847", "task_blueprint": "sp_bd0b3054fe664960", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_1d7e6d26b02b457b", "task_blueprint": "sp_7f9649114d2344dc", "depends_on": ["sr_02b7cc1e7c2a4a62