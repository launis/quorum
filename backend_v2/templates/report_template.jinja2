<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Execution Report</title>
    <style>
        @page {
            size: A4;
            margin: 1.5cm;
            @bottom-center {
                content: "Page " counter(page) " of " counter(pages);
                font-family: 'Inter', sans-serif;
                font-size: 9px;
                color: #888;
            }
        }
        body {
            font-family: 'Inter', sans-serif;
            color: #2c3e50;
            line-height: 1.4;
            font-size: 11px;
            background-color: #fff;
        }
        h1, h2, h3, h4 { color: #2c3e50; margin-top: 0; }
        h1 { font-size: 22px; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; text-align: center; color: #1a237e; }
        h2 { font-size: 16px; border-bottom: 2px solid #eee; padding-bottom: 8px; margin-top: 15px; margin-bottom: 12px; font-weight: 700; }
        
        .header-card {
            border: 2px solid #4CAF50;
            text-align: center;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 12px;
            background-color: #f8f9fa;
            page-break-inside: avoid;
        }

        .card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            background-color: #fff;
            page-break-inside: avoid;
        }

        .justify-box {
            background-color: #f8fbff;
            border-left: 4px solid #2196F3;
            padding: 14px;
            margin-top: 10px;
            border-radius: 4px;
        }
        .value-box {
            font-size: 24px;
            color: #1E88E5;
            font-weight: bold;
        }
    </style>
</head>
<body>

    {% if report_data %}
        <div class="header-card" style="text-align: left;">
            <h1 style="margin: 0 0 10px 0;">{{ workflow_name }} {% if report_data %}({{ report_data.profile_id }}){% endif %}</h1>
            
            <div style="font-size: 12px; color: #444; margin-bottom: 12px;">
                <strong>Konteksti:</strong> {% if report_data and report_data.org_name %}{{ report_data.org_name }}{% else %}Tuntematon organisaatio{% endif %}<br>
                <strong>Aikaleima:</strong> {% if report_data and report_data.created_at %}{{ report_data.created_at }}{% else %}{{ printed_at }}{% endif %}<br>
                <div style="font-size: 10px; color: #888; margin-top: 4px;">ID: {{ execution_id }} &bull; Tulostettu: {{ printed_at }}</div>
            </div>

            <table style="width: 100%; border-top: 1px solid #ccc; padding-top: 10px;">
                <tr>
                    <td style="width: 50%; vertical-align: top; text-align: left;">
                        <strong style="font-size: 12px;">Kustannukset</strong><br>
                        <span style="font-size: 11px;">API-hinta: {% if report_data and report_data.cost_estimate != None %}${{ "%.4f"|format(report_data.cost_estimate) }}{% else %}-{% endif %}</span>
                    </td>
                    <td style="width: 50%; vertical-align: top; text-align: left;">
                        <strong style="font-size: 12px;">Kognitiivinen työ (Tokens)</strong><br>
                        <span style="font-size: 11px;">
                            Prompt: {% if report_data and report_data.prompt_tokens != None %}{{ report_data.prompt_tokens }}{% else %}-{% endif %}<br>
                            Completion: {% if report_data and report_data.completion_tokens != None %}{{ report_data.completion_tokens }}{% else %}-{% endif %}<br>
                            Reasoning: {% if report_data and report_data.reasoning_tokens != None %}{{ report_data.reasoning_tokens }}{% else %}-{% endif %}
                        </span>
                    </td>
                </tr>
            </table>
        </div>

        {% for layout in report_data.layouts %}
            {% if report_data.layouts|length > 1 %}
                <h2 style="margin-top: 20px; color: #004D40;">Layout Block ({{ layout.preset_view }})</h2>
            {% else %}
                <h2>Axes Evaluation</h2>
            {% endif %}
            
            {% for axis in layout.axes %}
                <div class="card">
                    <h3 style="margin-bottom: 5px; color: #1976D2;">{{ axis.name }}</h3>
                    {% if axis.description %}
                        <div style="font-size: 12px; color: #666; font-style: italic; margin-bottom: 8px;">{{ axis.description }}</div>
                    {% endif %}
                    <div class="value-box">Score: {{ "%.1f"|format(axis.score) }}</div>
                    {% if axis.justification %}
                        <div class="justify-box">
                            <strong style="color: #1565C0; font-size: 11px; text-transform: uppercase;">Justification / Evaluation Notes:</strong><br>
                            <div style="font-size: 13px; line-height: 1.6; color: #333; margin-top: 4px;">{{ axis.justification | md | safe }}</div>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        {% endfor %}

        {% if report_data.synthesis %}
        <div class="card" style="border-top: 3px solid #9C27B0;">
            <h2 style="color: #9C27B0;">Synthesis</h2>
            <div style="font-size: 13px; line-height: 1.6; color: #333;">{{ report_data.synthesis | md | safe }}</div>
        </div>
        {% endif %}
        
    {% else %}
        <div class="card" style="border-left: 4px solid #F44336; background-color: #ffebee;">
            <h2 style="color: #c62828;">V2 ARCHITECTURE VIOLATION</h2>
            <p style="font-size: 12px; color: #b71c1c;">
                <strong>FAIL-FAST MANDATE:</strong> This execution lacks explicit ReportDataDTO mapping securely populated from backend APIs.
            </p>
        </div>
    {% endif %}

</body>
</html>
