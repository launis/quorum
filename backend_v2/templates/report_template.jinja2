<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ l10n.report_title }}</title>
    <style>
        @page {
            size: A4;
            margin: 1.5cm;
            @bottom-right {
                content: counter(page) " / " counter(pages);
                font-family: 'Inter', sans-serif;
                font-size: 9px;
                color: #888;
            }
        }
        body {
            font-family: 'Inter', sans-serif;
            color: #2c3e50;
            line-height: 1.4;
            font-size: 11px;
            background-color: #fff;
        }
        h1, h2, h3, h4 { color: #2c3e50; margin-top: 0; }
        h1 { font-size: 22px; margin-bottom: 20px; font-weight: bold; }
        h2 { font-size: 18px; margin-bottom: 15px; font-weight: bold; }
        
        .header-card {
            border: 2px solid #4CAF50;
            text-align: center;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 12px;
            background-color: #f8f9fa;
            page-break-inside: avoid;
        }

        .card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            background-color: #fff;
            page-break-inside: avoid;
        }

        .justify-box {
            background-color: #f8fbff;
            border-left: 4px solid #2196F3;
            padding: 14px;
            margin-top: 10px;
            border-radius: 4px;
        }
        .value-box {
            font-size: 24px;
            color: #1E88E5;
            font-weight: bold;
        }
        .atom-card {
            padding: 10px;
            margin-top: 4px;
            font-size: 12px;
            page-break-inside: avoid;
        }

        .matrix-summary-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            text-align: left;
            background-color: #fff;
            border: 1px solid #e0e0e0;
            table-layout: fixed;
            word-wrap: break-word;
        }

        .matrix-summary-table th,
        .matrix-summary-table td {
            word-wrap: break-word;
            overflow-wrap: break-word;
            white-space: normal;
        }
    </style>
</head>
<body>

    {% macro render_sdui_blocks(blocks, level=0, charts=none) %}
        {% for block in blocks %}
            {% if block.title is defined and block.title and block.block_type not in ['metadata', 'accordion'] %}
                <h2 style="color: #1a237e; margin-top: 0; margin-bottom: 10px;">
                    {% if block.title is string %}
                        {{ block.title }}
                    {% elif block.title is mapping %}
                        {{ block.title[lang_code] if lang_code in block.title else block.title['en'] }}
                    {% else %}
                        {{ block.title.resolve(lang_code) }}
                    {% endif %}
                </h2>
            {% endif %}
            
            {% if block.block_type is defined and block.block_type == 'paragraph' %}
                <div style="margin-top: 0; margin-bottom: 10px; font-size: 13px; line-height: 1.6; color: #333;">
                    {{ block.text | md | safe if block.text is defined else '' }}
                    {% if block.citations is defined and block.citations %}{% for cit in block.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                </div>
            {% elif block.block_type is defined and block.block_type == 'bullet_list' %}
                <ul style="margin-top: 0; margin-bottom: 10px; padding-left: 20px;">
                    {% for item in (block.items if block.items is defined else []) %}
                        <li style="margin-bottom: 4px;">
                            {{ item.text | md | safe if item.text is defined else '' }}
                            {% if item.citations is defined and item.citations %}{% for cit in item.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% elif block.block_type is defined and block.block_type == 'accordion' %}
                {% set border_color = '#1E88E5' %}
                {% set bg_color = '#E3F2FD' %}
                {% set title_icon = 'ℹ️' %}
                
                {% if block.severity == 'success' %}
                    {% set border_color = '#2E7D32' %}
                    {% set bg_color = '#E8F5E9' %}
                {% elif block.severity == 'warning' %}
                    {% set border_color = '#F57C00' %}
                    {% set bg_color = '#FFF3E0' %}
                {% elif block.severity == 'error' %}
                    {% set border_color = '#C62828' %}
                    {% set bg_color = '#FFEBEE' %}
                {% endif %}
                
                {% if block.icon_name == 'lightbulb' %}{% set title_icon = '💡' %}{% endif %}
                {% if block.icon_name == 'balance' %}{% set title_icon = '⚖️' %}{% endif %}
                {% if block.icon_name == 'build' %}{% set title_icon = '🛠️' %}{% endif %}
                {% if block.icon_name == 'warning' %}{% set title_icon = '⚠️' %}{% endif %}
                {% if block.icon_name == 'error' %}{% set title_icon = '❌' %}{% endif %}

                <div class="sdui-accordion" style="border: 1px solid {{ border_color }}; background-color: {{ bg_color }}; border-radius: 8px; margin-bottom: 20px; overflow: hidden;">
                    <div style="padding: 12px 16px; font-weight: bold; font-size: 14px; color: {{ border_color }}; border-bottom: 1px solid rgba(0,0,0,0.05);">
                        {{ title_icon }} {{ block.title }} <span style="float: right;">▼</span>
                    </div>

                    <div style="background-color: white; padding: 16px;">
                        {{ render_sdui_blocks(block.children) }}
                    </div>
                </div>
            {% elif block.block_type is defined and block.block_type == 'alert_box' %}
                {% set border_color = '#1E88E5' if (block.severity is defined and block.severity == 'info') else '#F57C00' %}
                {% set bg_color = '#E3F2FD' if (block.severity is defined and block.severity == 'info') else '#FFF3E0' %}
                <div class="alert alert-{{ block.severity if block.severity is defined else 'warning' }}" style="border-left: 4px solid {{ border_color }}; background-color: {{ bg_color }}; padding: 12px; margin-bottom: 15px; border-radius: 6px; font-size: 13px; line-height: 1.6; color: #333;">
                    {{ block.text | md | safe if block.text is defined else '' }}
                    {% if block.citations is defined and block.citations %}{% for cit in block.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                </div>
            {% elif block.block_type is defined and block.block_type == 'hero_insight' %}
                <h3 style="color: #1E88E5; font-size: 18px; margin-top: 15px; margin-bottom: 15px;">
                    {{ block.text | md | safe if block.text is defined else '' }}
                    {% if block.citations is defined and block.citations %}{% for cit in block.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                </h3>
            {% elif block.block_type is defined and block.block_type == 'markdown' %}
                <div style="margin-bottom: 15px; font-size: 13px; line-height: 1.6; color: #333;">
                    {{ block.text | md | safe if block.text is defined else '' }}
                </div>
            {% elif block.block_type is defined and block.block_type == 'quote_card' %}
                <div style="margin-bottom: 15px; border-left: 3px solid #9E9E9E; padding-left: 10px; font-style: italic; color: #616161;">
                    {{ block.quote if block.quote is defined else '' }}
                    {% if block.source_aliases is defined and block.source_aliases %}
                        <div style="font-size: 11px; margin-top: 5px; font-weight: bold;">- {{ block.source_aliases | join(', ') }}</div>
                    {% endif %}
                </div>
            {% elif block.block_type is defined and block.block_type == 'warning_card' %}
                <div style="margin-bottom: 15px; border-left: 4px solid #D32F2F; background-color: #FFEBEE; padding: 12px; border-radius: 6px;">
                    <strong style="color: #D32F2F;">{{ l10n.warning_label }}:</strong> {{ block.message if block.message is defined else '' }}
                    {% if block.quote_text is defined and block.quote_text %}
                        <div style="margin-top: 5px; font-style: italic; color: #D32F2F; font-size: 11px;">"{{ block.quote_text }}"</div>
                    {% endif %}
                </div>
            {% elif block.block_type is defined and block.block_type == 'n_a_card' %}
                <div style="margin-bottom: 15px; border-left: 4px solid #9E9E9E; background-color: #F5F5F5; padding: 12px; border-radius: 6px;">
                    <strong style="color: #757575;">{{ l10n.na_not_evaluated_label }}:</strong> {{ block.message if block.message is defined else '' }}
                </div>
            {% elif block.block_type is defined and block.block_type == 'grid' %}
                <div style="margin-bottom: 15px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
                        {% for item in (block.items if block.items is defined else []) %}
                            <tr><td style="border: 1px solid #E0E0E0; padding: 4px;">{{ render_sdui_blocks([item], level=level+1) }}</td></tr>
                        {% endfor %}
                    </table>
                </div>
            {% elif block.block_type is defined and block.block_type == 'metadata' %}
                <div class="header-card" style="text-align: left;">
                    <h1 style="margin: 0 0 10px 0;">{{ block.title }}</h1>
                    
                    {% if block.badges %}
                    <div style="margin-bottom: 15px; text-align: center;">
                        {% for badge in block.badges %}
                        <span style="background-color: #E8EAF6; border: 1px solid #C5CAE9; border-radius: 4px; padding: 4px 8px; font-size: 11px; display: inline-block; margin-right: 8px; font-weight: bold; color: #283593;">
                            {{ badge }}
                        </span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    
                    {% if block.metadata_lines %}
                    <div style="font-size: 12px; color: #444; margin-bottom: 12px;">
                        {% for line in block.metadata_lines %}
                            <div style="margin-bottom: 4px;">{{ line | md | safe }}</div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {% if block.costs or block.tokens %}
                    <table style="width: 100%; border-top: 1px solid #ccc; padding-top: 10px;">
                        <tr>
                            {% if block.costs %}
                            <td style="width: 50%; vertical-align: top; text-align: left;">
                                <strong style="font-size: 12px;">{{ l10n.sduiMetadataCosts }}</strong><br>
                                <span style="font-size: 11px;">{{ block.costs }}</span>
                            </td>
                            {% endif %}
                            {% if block.tokens %}
                            <td style="width: 50%; vertical-align: top; text-align: left;">
                                <strong style="font-size: 12px;">{{ l10n.sduiMetadataTokens }}</strong><br>
                                <span style="font-size: 11px;">
                                    {% for key, val in block.tokens.items() %}
                                        {{ key }}: {{ val }}<br>
                                    {% endfor %}
                                </span>
                            </td>
                            {% endif %}
                        </tr>
                    </table>
                    {% endif %}
                </div>

                {% if block.custom_preface_md %}
                <div class="card" style="border-left: 4px solid #42a5f5; padding: 20px; margin-bottom: 20px; background-color: #fff;">
                    <div style="font-size: 13px; line-height: 1.6; color: #333;">{{ block.custom_preface_md | md | safe }}</div>
                </div>
                {% endif %}
            {% elif block.block_type is defined and block.block_type == 'score_card' %}
                <div style="background-color: #e6e0f8; border: 1px solid #d1c4e9; border-radius: 8px; padding: 15px 20px; margin-bottom: 25px; margin-top: 20px; page-break-inside: avoid;">
                    <table style="width: 100%; border: none; margin: 0; padding: 0;">
                        <tr>
                            <td style="text-align: left; vertical-align: middle;">
                                <strong style="color: #1a1a1a; font-size: 18px;">{{ l10n.scorecard_global_average }}</strong>
                            </td>
                            <td style="text-align: right; vertical-align: middle;">
                                <span style="font-size: 24px; font-weight: 800; color: #1a1a1a;">
                                    {% if block.global_score != None %}{{ "%.2f"|format(block.global_score) }}{% else %}N/A{% endif %}/100
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            {% elif block.block_type is defined and block.block_type == 'audit_trail' %}
                {% if report_data and report_data.mcp_tool_audit %}
                <div class="card" style="border-top: 3px solid #009688;">
                    <h2 style="color: #00796b;">{{ l10n.systemAuditTrailLabel }}</h2>
                    {% for audit in report_data.mcp_tool_audit %}
                    <div style="background-color: #f7f9f9; border: 1px solid #e0e0e0; border-radius: 6px; padding: 12px; margin-bottom: 15px;">
                        <div style="font-size: 13px; font-weight: bold; color: #333; margin-bottom: 6px;">
                            <span style="font-size: 11px; float: right; font-weight: normal; color: #888; background-color: #eee; padding: 2px 6px; border-radius: 10px;">{{ l10n.pdfAuditDuration }} {{ audit.duration_ms }}ms</span>
                            <span style="font-family: monospace; font-size: 10px; background-color: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; border-radius: 4px; padding: 2px 6px; margin-right: 6px;">{{ audit.tool_id }}</span>
                            🔍 {{ l10n.pdfAuditQuery }} "{{ audit.query }}"
                        </div>
                        <div style="font-size: 12px; color: #555; margin-bottom: 10px; line-height: 1.5; clear: both;">
                            {{ audit.response_summary | md | safe }}
                        </div>
                        {% if audit.impacted_axis_names %}
                        <div style="font-size: 11px; font-weight: bold; color: #2E7D32; margin-bottom: 10px; padding: 6px; background-color: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 4px; clear: both;">
                            🎯 {{ l10n.pdfAuditImpactedAxes }}
                            <span style="font-weight: normal; color: #1b5e20;">{{ audit.impacted_axis_names | join(', ') }}</span>
                        </div>
                        {% endif %}
                        {% if audit.source_urls %}
                        <div style="font-size: 11px; font-weight: bold; color: #009688; margin-bottom: 4px;">{{ l10n.pdfAuditSources }}</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; clear: both;">
                            {% for url in audit.source_urls %}
                            <div style="background-color: #e3f2fd; border: 1px solid #bbdefb; color: #1976D2; padding: 4px 8px; border-radius: 4px; font-size: 10px; text-decoration: none; word-break: break-all; display: inline-block;">
                                🔗 {{ url }}
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            {% elif block.block_type is defined and (block.block_type == '3d_matrix' or block.block_type == '2d_compare') %}
                {% if level == 0 and charts and loop.index0 in charts %}
                <div style="text-align: center; margin: 20px 0;">
                    <img src="data:image/png;base64,{{ charts[loop.index0] }}" style="max-width: 100%; height: auto; border: 1px solid #eee; border-radius: 8px;" />
                </div>
                {% endif %}
            {% elif block.block_type is defined and block.block_type == '1d_metrics' %}
                {% if block.axes is defined %}
                {% for axis in block.axes %}
                    <div class="card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <h3 style="margin: 0; color: #1a1a1a; font-size: 16px;">{{ axis.name }}</h3>
                            {% if axis.score_display_label %}
                            <div style="display: flex; align-items: center; gap: 8px;">
                                {% if axis.contextual_override %}
                                <span style="color: #f57c00; font-size: 12px; font-weight: 500;">⚠️ {{ l10n.evidence_rejected }}</span>
                                {% endif %}
                                <div style="background-color: #e3f2fd; color: #1976D2; padding: 4px 12px; border-radius: 12px; font-weight: bold; font-size: 14px;">
                                    {{ axis.score_display_label }}
                                </div>
                            </div>
                            {% endif %}
                        </div>
                        
                        {% if axis.description %}
                            <div style="font-size: 12px; color: #666; font-style: italic; margin-bottom: 8px;">{{ axis.description }}</div>
                        {% endif %}

                        {% if axis.row_explanation %}
                            <div style="margin-top: 8px; margin-bottom: 8px;">
                                <div style="font-size: 11px; font-weight: bold; color: #1976D2; margin-bottom: 2px;">{{ l10n.xai_ext_justification }}</div>
                                <div style="font-size: 12px; color: #444; font-style: italic; line-height: 1.4;">{{ axis.row_explanation }}</div>
                            </div>
                        {% endif %}
                        
                        {% if axis.ui_plot_ratio != None %}
                            <div style="margin: 12px 0 8px 0; background-color: #eee; border-radius: 6px; height: 12px; width: 100%; overflow: hidden;">
                                <div style="background: linear-gradient(90deg, rgba(33,150,243,0.6) 0%, rgba(33,150,243,1) 100%); height: 100%; width: {{ axis.ui_plot_ratio * 100 }}%; border-radius: 6px;"></div>
                            </div>
                        {% endif %}
                        
                        {% if axis.inner_sdui_blocks %}
                            <div style="margin-top: 15px;">
                                {{ render_sdui_blocks(axis.inner_sdui_blocks, level=level+1) }}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
                {% endif %}
            {% elif block.block_type is defined and block.block_type == 'matrix_summary' %}
                {% set visible_cols = block.matrix_visible_columns if block.matrix_visible_columns else [] %}
                {% set col_labels = block.matrix_column_labels if block.matrix_column_labels is defined and block.matrix_column_labels else {} %}
                {% if visible_cols and block.axes %}
                <div style="page-break-before: always; margin-top: 30px;">
                    <table class="matrix-summary-table">
                        <thead>
                            <tr style="background-color: #f5f5f5; border-bottom: 2px solid #ccc;">
                                {% if 'label' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700; width: 22%;">{{ (col_labels['label'].resolve(lang_code) if col_labels and 'label' in col_labels else l10n.matrix_col_label) }}</th>{% endif %}
                                {% if 'context_target' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700; width: 12%;">{{ (col_labels['context_target'].resolve(lang_code) if col_labels and 'context_target' in col_labels else l10n.matrix_col_context_target) }}</th>{% endif %}
                                {% if 'distribution' in visible_cols or 'atomic_breakdown' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700; width: 14%;">{{ (col_labels['atomic_breakdown'].resolve(lang_code) if col_labels and 'atomic_breakdown' in col_labels else (col_labels['distribution'].resolve(lang_code) if col_labels and 'distribution' in col_labels else l10n.matrix_col_distribution)) }}</th>{% endif %}
                                {% if 'row_explanation' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700; width: 20%;">{{ (col_labels['row_explanation'].resolve(lang_code) if col_labels and 'row_explanation' in col_labels else l10n.matrix_col_row_explanation) }}</th>{% endif %}
                                {% if 'criteria' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700; width: 18%;">{{ (col_labels['criteria'].resolve(lang_code) if col_labels and 'criteria' in col_labels else l10n.matrix_col_criteria) }}</th>{% endif %}
                                {% if 'quotes' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700; width: 14%;">{{ (col_labels['quotes'].resolve(lang_code) if col_labels and 'quotes' in col_labels else l10n.matrix_col_quotes) }}</th>{% endif %}
                                {% if 'source' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700;">{{ (col_labels['source'].resolve(lang_code) if col_labels and 'source' in col_labels else l10n.matrix_col_source) }}</th>{% endif %}
                                {% if 'normalized_score' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700;">{{ (col_labels['normalized_score'].resolve(lang_code) if col_labels and 'normalized_score' in col_labels else l10n.matrix_col_normalized_score) }}</th>{% endif %}
                                {% if 'score' in visible_cols %}<th style="padding: 12px 10px; color: #333; font-weight: 700;">{{ (col_labels['score'].resolve(lang_code) if col_labels and 'score' in col_labels else l10n.matrix_col_score) }}</th>{% endif %}
                            </tr>
                        </thead>
                        <tbody>
                        {% for axis in block.axes %}
                            <tr style="border-bottom: 1px solid #eee;">
                                {% if 'label' in visible_cols %}
                                <td style="padding: 10px; vertical-align: top;">
                                    <div style="font-weight: 600; color: #2c3e50; margin-bottom: 4px;">{{ axis.name }}{% if axis.is_evaluative %} *{% endif %}{% if axis.allow_contextual_override %} **{% endif %}</div>
                                    {% if axis.context_target_label %}
                                    <div style="margin-top: 2px; margin-bottom: 4px;">
                                        <span style="background: #f0f0f0; border-radius: 3px; font-size: 9px; padding: 1px 4px; display: inline-block; color: #555; font-weight: 600;">{{ axis.context_target_label.resolve(lang_code) }}</span>
                                    </div>
                                    {% elif axis.context_target %}
                                    <div style="margin-top: 2px; margin-bottom: 4px;">
                                        <span style="background: #f0f0f0; border-radius: 3px; font-size: 9px; padding: 1px 4px; display: inline-block; color: #555; font-weight: 600;">{{ axis.context_target }}</span>
                                    </div>
                                    {% endif %}
                                    {% if axis.description %}
                                    <div style="font-size: 10px; color: #666; font-weight: normal; line-height: 1.3;">{{ axis.description }}</div>
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'context_target' in visible_cols %}
                                <td style="padding: 10px; color: #444; font-size: 10px; vertical-align: top; font-weight: 600;">
                                    {% if axis.context_target_label %}
                                        {{ axis.context_target_label.resolve(lang_code) }}
                                    {% elif axis.context_target %}
                                        {{ axis.context_target }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'distribution' in visible_cols or 'atomic_breakdown' in visible_cols %}
                                <td style="padding: 10px; color: #555; vertical-align: top;">
                                    {% set lvl = axis.level_breakdown or {} %}
                                    {% set lvl_names = axis.level_names or {} %}
                                    {% if lvl %}
                                        <div style="margin: 0; font-size: 10px; line-height: 1.3;">
                                        {% for key, val in lvl.items() | sort(reverse=True, attribute='0') %}
                                            {% set hit_str = val if val is string else (val.hits ~ '/' ~ val.total) %}
                                            {% set name = lvl_names[key] if key in lvl_names else ('T' ~ key) %}
                                            {% set numLvl = (key | float | int) if '.' in key else (key | int) %}
                                            <div style="margin-bottom: 2px;">{{ numLvl }} - {{ name }}: {{ hit_str }}</div>
                                        {% endfor %}
                                        </div>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'row_explanation' in visible_cols %}
                                <td style="padding: 10px; color: #444; font-style: italic; font-size: 10px; vertical-align: top;">
                                    {{ axis.row_explanation }}
                                </td>
                                {% endif %}
                                {% if 'criteria' in visible_cols %}
                                <td style="padding: 10px; vertical-align: top; font-size: 10px;">
                                    {% set evaluated_atoms = axis.evaluated_atoms or [] %}
                                    {% if evaluated_atoms %}
                                        {% set grouped_atoms = evaluated_atoms | group_atoms_by_level %}
                                        {% for lvl, atoms in grouped_atoms.items() | sort(reverse=True, attribute='0') %}
                                            {% set lvl_name = axis.level_names[lvl|string] if axis.level_names and (lvl|string) in axis.level_names else '' %}
                                            <div style="font-weight: bold; margin-bottom: 4px; font-size: 11px;">{{ lvl }} - {{ lvl_name }}</div>
                                            {% set has_rendered = false %}
                                            {% for atom in atoms %}
                                                {% set status = (atom.status or '') | lower %}
                                                {% if status not in ['skipped', 'none', 'dlq'] and 'chunk processing failed' not in (atom.semantic_reasoning or '')|lower %}
                                                    <div style="margin-bottom: 4px; font-weight: {{ 'bold' if status in ['pass', 'contested'] else 'normal' }}; color: #333;">
                                                        - {{ atom.chart_display_label }}
                                                    </div>
                                                    {% set has_rendered = true %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if not has_rendered %}
                                                <div style="color: #999; font-style: italic; margin-bottom: 4px;">- N/A</div>
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        <div style="color: #999; font-style: italic;">- N/A</div>
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'quotes' in visible_cols %}
                                <td style="padding: 10px; vertical-align: top; font-size: 10px;">
                                    {% set evaluated_atoms = axis.evaluated_atoms or [] %}
                                    {% set ns = namespace(has_any_quote=false) %}
                                    {% for atom in evaluated_atoms %}
                                        {% if atom.exact_quotes %}
                                            {% set ns.has_any_quote = true %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if ns.has_any_quote %}
                                        {% set grouped_atoms = evaluated_atoms | group_atoms_by_level %}
                                        {% for lvl, atoms in grouped_atoms.items() | sort(reverse=True, attribute='0') %}
                                            {% set ns_lvl = namespace(has_lvl_quote=false) %}
                                            {% for atom in atoms %}
                                                {% if atom.exact_quotes %}
                                                    {% set ns_lvl.has_lvl_quote = true %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if ns_lvl.has_lvl_quote %}
                                                {% set lvl_name = axis.level_names[lvl|string] if axis.level_names and (lvl|string) in axis.level_names else '' %}
                                                <div style="font-weight: bold; margin-bottom: 4px; font-size: 11px;">{{ lvl }} - {{ lvl_name }}</div>
                                                {% for atom in atoms %}
                                                    {% set status = (atom.status or '') | lower %}
                                                    {% if status not in ['skipped', 'none', 'dlq'] and 'chunk processing failed' not in (atom.semantic_reasoning or '')|lower %}
                                                        {% if atom.exact_quotes %}
                                                            {% for quote in atom.exact_quotes %}
                                                                <div style="margin-bottom: 6px; color: #555;">
                                                                    {% if quote.verified_source_ids %}
                                                                        <span style="background-color: #e3f2fd; border: 1px solid #bbdefb; padding: 1px 4px; border-radius: 2px; font-size: 8px; font-weight: bold; color: #1565c0; margin-right: 4px;">{{ quote.verified_source_ids | join(', ') }}</span>
                                                                    {% endif %}
                                                                    "{{ quote.quote }}"
                                                                </div>
                                                            {% endfor %}
                                                        {% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        <div style="color: #666; font-style: italic;">-</div>
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'source' in visible_cols %}
                                <td style="padding: 10px; vertical-align: top; font-size: 10px;">
                                    {% if axis.cited_source_title or axis.cited_source_url %}
                                        <div style="margin-bottom: 4px;">
                                            {% if axis.cited_source_url %}
                                                <a href="{{ axis.cited_source_url }}" target="_blank" style="color: #1565C0; text-decoration: underline; font-weight: 500;">
                                                    {{ axis.cited_source_title if axis.cited_source_title else axis.cited_source_url }}
                                                </a>
                                            {% else %}
                                                <span style="color: #333; font-weight: 500;">{{ axis.cited_source_title }}</span>
                                            {% endif %}
                                        </div>
                                    {% elif axis.cited_web_citation %}
                                        <div style="margin-bottom: 4px;">
                                            <a href="{{ axis.cited_web_citation }}" target="_blank" style="color: #1565C0; text-decoration: underline; font-weight: 500;">
                                                {{ axis.cited_web_citation }}
                                            </a>
                                        </div>
                                    {% elif axis.clustered_row_sources %}
                                        {% for src in axis.clustered_row_sources %}
                                            <div style="margin-bottom: 4px;">
                                                <span style="font-weight: 600; color: #333;">{{ src.step_name }}:</span> {{ src.query }}
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <span style="color: #999; font-style: italic;">-</span>
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'normalized_score' in visible_cols %}
                                <td style="padding: 10px; vertical-align: top; white-space: nowrap;">
                                    {% if axis.ui_plot_ratio != None %}
                                        <div style="background-color: #e8f5e9; border: 1px solid #c8e6c9; color: #2e7d32; font-weight: bold; padding: 4px 8px; border-radius: 4px; display: inline-block; font-size: 11px;">
                                            {{ "%.1f"|format(axis.ui_plot_ratio * 100) }} %
                                        </div>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                {% endif %}
                                {% if 'score' in visible_cols %}
                                <td style="padding: 10px; vertical-align: top; white-space: nowrap;">
                                    {% if axis.score_display_label and axis.score_display_label != '-' %}
                                        <div style="background-color: #e3f2fd; border: 1px solid #bbdefb; color: #1565c0; font-weight: bold; padding: 4px 8px; border-radius: 4px; display: inline-block; font-size: 11px;">
                                            {{ axis.score_display_label }}
                                        </div>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    {% set ns = namespace(has_evaluative=false, has_override=false) %}
                    {% for axis in block.axes %}
                        {% if axis.is_evaluative %}{% set ns.has_evaluative = true %}{% endif %}
                        {% if axis.allow_contextual_override %}{% set ns.has_override = true %}{% endif %}
                    {% endfor %}
                    {% if ns.has_evaluative or ns.has_override %}
                    <div style="font-size: 11px; color: #666; margin-top: 8px; font-style: italic;">
                        {% if ns.has_evaluative %}<div>{{ l10n.matrixEvaluativeAsteriskLegend }}</div>{% endif %}
                        {% if ns.has_override %}<div>{{ l10n.matrixOverrideAsteriskLegend }}</div>{% endif %}
                    </div>
                    {% endif %}
                </div>
                {% endif %}
            {% else %}
                {{ raise_unrecognized_sdui_block(block.block_type) }}
            {% endif %}
        {% endfor %}
    {% endmacro %}

    {% if report_data and report_data.inner_sdui_blocks %}
        {{ render_sdui_blocks(report_data.inner_sdui_blocks, level=0, charts=charts) }}
    {% else %}
        <div class="card" style="border-left: 4px solid #F44336; background-color: #ffebee;">
            <h2 style="color: #c62828;">V2 ARCHITECTURE VIOLATION</h2>
            <p style="font-size: 12px; color: #b71c1c;">
                <strong>FAIL-FAST MANDATE:</strong> This execution lacks explicit ReportDataDTO mapping securely populated from backend APIs, or the inner_sdui_blocks array is missing.
            </p>
        </div>
    {% endif %}

</body>
</html>
