<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Execution Report</title>
    <style>
        @page {
            size: A4;
            margin: 1.5cm;
            @bottom-center {
                content: "Page " counter(page) " of " counter(pages);
                font-family: 'Inter', sans-serif;
                font-size: 9px;
                color: #888;
            }
        }
        body {
            font-family: 'Inter', sans-serif;
            color: #2c3e50;
            line-height: 1.4;
            font-size: 11px;
            background-color: #fff;
        }
        h1, h2, h3, h4 { color: #2c3e50; margin-top: 0; }
        h1 { font-size: 22px; margin-bottom: 20px; font-weight: bold; }
        h2 { font-size: 18px; margin-bottom: 15px; font-weight: bold; }
        
        .header-card {
            border: 2px solid #4CAF50;
            text-align: center;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 12px;
            background-color: #f8f9fa;
            page-break-inside: avoid;
        }

        .card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            background-color: #fff;
            page-break-inside: avoid;
        }

        .justify-box {
            background-color: #f8fbff;
            border-left: 4px solid #2196F3;
            padding: 14px;
            margin-top: 10px;
            border-radius: 4px;
        }
        .value-box {
            font-size: 24px;
            color: #1E88E5;
            font-weight: bold;
        }
        .atom-card {
            padding: 10px;
            margin-top: 4px;
            font-size: 12px;
            page-break-inside: avoid;
        }
        .intent-success {
            background-color: #e8f5e9;
            border-left: 3px solid #4CAF50;
            color: #2e7d32;
        }
        .intent-warning {
            background-color: #fff3e0;
            border-left: 3px solid #FF9800;
            color: #ef6c00;
        }
        .intent-critical_override {
            background-color: #ffebee;
            border-left: 3px solid #F44336;
            color: #c62828;
        }
        .intent-info {
            background-color: #e3f2fd;
            border-left: 3px solid #2196F3;
            color: #1565c0;
        }
        .intent-default {
            background-color: #f5f5f5;
            border-left: 3px solid #ccc;
            color: #555;
        }
    </style>
</head>
<body>

    {% macro render_sdui_blocks(blocks) %}
        {% for block in blocks %}
            {% if block.block_type == 'paragraph' %}
                <div style="margin-top: 0; margin-bottom: 10px; font-size: 13px; line-height: 1.6; color: #333;">
                    {{ block.text | md | safe }}
                    {% if block.citations %}{% for cit in block.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                </div>
            {% elif block.block_type == 'bullet_list' %}
                <ul style="margin-top: 0; margin-bottom: 10px; padding-left: 20px;">
                    {% for item in block.get('items', []) %}
                        <li style="margin-bottom: 4px;">
                            {{ item.text | md | safe }}
                            {% if item.citations %}{% for cit in item.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% elif block.block_type == 'alert_box' %}
                {% set border_color = '#1E88E5' if block.severity == 'info' else '#F57C00' %}
                {% set bg_color = '#E3F2FD' if block.severity == 'info' else '#FFF3E0' %}
                <div class="alert alert-{{ block.severity }}" style="border-left: 4px solid {{ border_color }}; background-color: {{ bg_color }}; padding: 12px; margin-bottom: 15px; border-radius: 6px; font-size: 13px; line-height: 1.6; color: #333;">
                    {{ block.text | md | safe }}
                    {% if block.citations %}{% for cit in block.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                </div>
            {% elif block.block_type == 'hero_insight' %}
                <h3 style="color: #1E88E5; font-size: 18px; margin-top: 15px; margin-bottom: 15px;">
                    {{ block.text | md | safe }}
                    {% if block.citations %}{% for cit in block.citations %}<sup style="color: #1976D2; font-weight: bold;">[{{ cit }}]</sup>{% endfor %}{% endif %}
                </h3>
            {% elif block.block_type == 'markdown' %}
                <div style="margin-bottom: 15px; font-size: 13px; line-height: 1.6; color: #333;">
                    {{ block.text | md | safe }}
                </div>
            {% elif block.block_type == 'quote_card' %}
                <div style="margin-bottom: 15px; border-left: 3px solid #9E9E9E; padding-left: 10px; font-style: italic; color: #616161;">
                    {{ block.quote }}
                    {% if block.source_aliases %}
                        <div style="font-size: 11px; margin-top: 5px; font-weight: bold;">- {{ block.source_aliases | join(', ') }}</div>
                    {% endif %}
                </div>
            {% elif block.block_type == 'warning_card' %}
                <div style="margin-bottom: 15px; border-left: 4px solid #D32F2F; background-color: #FFEBEE; padding: 12px; border-radius: 6px;">
                    <strong style="color: #D32F2F;">Warning:</strong> {{ block.message }}
                    {% if block.quote_text %}
                        <div style="margin-top: 5px; font-style: italic; color: #D32F2F; font-size: 11px;">"{{ block.quote_text }}"</div>
                    {% endif %}
                </div>
            {% elif block.block_type == 'n_a_card' %}
                <div style="margin-bottom: 15px; border-left: 4px solid #9E9E9E; background-color: #F5F5F5; padding: 12px; border-radius: 6px;">
                    <strong style="color: #757575;">N/A (Ei arvioitu):</strong> {{ block.message }}
                </div>
            {% elif block.block_type == 'grid' %}
                <div style="margin-bottom: 15px;">
                    <!-- Grid representation -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
                        {% for item in block.items %}
                            <tr><td style="border: 1px solid #E0E0E0; padding: 4px;">{{ item }}</td></tr>
                        {% endfor %}
                    </table>
                </div>
            {% endif %}
        {% endfor %}
    {% endmacro %}

    {% if report_data %}
        {% set show_user = not report_data.visible_metadata or 'user' in report_data.visible_metadata %}
        {% set show_date = not report_data.visible_metadata or 'date' in report_data.visible_metadata %}
        {% set show_cost = not report_data.visible_metadata or 'cost' in report_data.visible_metadata %}
        {% set show_tokens = not report_data.visible_metadata or 'tokens' in report_data.visible_metadata %}
        {% set show_engine = not report_data.visible_metadata or 'scoring_engine' in report_data.visible_metadata %}
        {% set show_strictness = not report_data.visible_metadata or 'strictness' in report_data.visible_metadata %}

        <div class="header-card" style="text-align: left;">
            <h1 style="margin: 0 0 10px 0;">{{ workflow_name }}</h1>
            {% if report_data and ((show_engine and report_data.scoring_strategy) or (show_strictness and report_data.strictness_level != None)) %}
            <div style="margin-bottom: 15px; text-align: center;">
                {% if show_engine and report_data.scoring_strategy %}
                {% set strategy_map = {
                    'waterfall': l10n.strategyKoearvostelu,
                    'dampening': l10n.strategySyvaarvostelu,
                    'average': l10n.strategyLineaarinenKeskiarvo,
                    'weighted_average': l10n.strategyPainotettuKeskiarvo
                } %}
                <span style="background-color: #E8EAF6; border: 1px solid #C5CAE9; border-radius: 4px; padding: 4px 8px; font-size: 11px; display: inline-block; margin-right: 8px; font-weight: bold; color: #283593;">
                    🧮 Scoring Engine: {{ strategy_map.get(report_data.scoring_strategy, report_data.scoring_strategy) }}
                </span>
                {% endif %}
                
                {% if show_strictness and report_data.strictness_level != None %}
                {% set strictness_map = {
                    0: l10n.strictnessFullFlex,
                    15: l10n.strictnessLenient,
                    50: l10n.strictnessBalanced,
                    85: l10n.strictnessStrict,
                    100: l10n.strictnessAbsolute
                } %}
                <span style="background-color: #E8EAF6; border: 1px solid #C5CAE9; border-radius: 4px; padding: 4px 8px; font-size: 11px; display: inline-block; font-weight: bold; color: #283593;">
                    ⚖️ {{ l10n.strictnessSelectorTitle | default('Arvioinnin tiukkuus') }}: {{ strictness_map.get(report_data.strictness_level, report_data.strictness_level) }}
                </span>
                {% endif %}
            </div>
            {% endif %}
            
            <div style="font-size: 12px; color: #444; margin-bottom: 12px;">
                {% set default_meta = ['date', 'organization', 'user'] %}
                {% set metadata_list = report_data.visible_metadata if report_data and report_data.visible_metadata else default_meta %}
                
                {% for metaKey in metadata_list %}
                    {% if metaKey == 'user' %}
                        <strong>Käyttäjä:</strong> {% if report_data and report_data.user_name %}{{ report_data.user_name }}{% else %}Tuntematon{% endif %}<br>
                    {% elif metaKey == 'organization' %}
                        <strong>Organisaatio:</strong> {% if report_data and report_data.org_name %}{{ report_data.org_name }}{% else %}Tuntematon{% endif %}<br>
                    {% elif metaKey == 'date' %}
                        <strong>Aikaleima:</strong> {% if report_data and report_data.local_time_str %}{{ report_data.local_time_str }}{% else %}{{ printed_at }}{% endif %}<br>
                        <div style="font-size: 10px; color: #888; margin-top: 4px; margin-bottom: 4px;">ID: {{ execution_id }}</div>
                    {% endif %}
                {% endfor %}
            </div>

            {% if show_cost or show_tokens %}
            <table style="width: 100%; border-top: 1px solid #ccc; padding-top: 10px;">
                <tr>
                    {% if show_cost %}
                    <td style="width: 50%; vertical-align: top; text-align: left;">
                        <strong style="font-size: 12px;">Kustannukset</strong><br>
                        <span style="font-size: 11px;">API-hinta: {% if report_data and report_data.cost_estimate != None %}${{ "%.4f"|format(report_data.cost_estimate) }}{% else %}-{% endif %}</span>
                    </td>
                    {% endif %}
                    {% if show_tokens %}
                    <td style="width: 50%; vertical-align: top; text-align: left;">
                        <strong style="font-size: 12px;">Kognitiivinen työ (Tokens)</strong><br>
                        <span style="font-size: 11px;">
                            Prompt: {% if report_data and report_data.prompt_tokens != None %}{{ report_data.prompt_tokens }}{% else %}-{% endif %}<br>
                            Completion: {% if report_data and report_data.completion_tokens != None %}{{ report_data.completion_tokens }}{% else %}-{% endif %}<br>
                            Reasoning: {% if report_data and report_data.reasoning_tokens != None %}{{ report_data.reasoning_tokens }}{% else %}-{% endif %}
                        </span>
                    </td>
                    {% endif %}
                </tr>
            </table>
            {% endif %}
        </div>

        {% if report_data and report_data.custom_preface_md %}
        <div class="card" style="border-left: 4px solid #42a5f5; padding: 20px; margin-bottom: 20px; background-color: #fff;">
            <div style="font-size: 13px; line-height: 1.6; color: #333;">{{ report_data.custom_preface_md | md | safe }}</div>
        </div>
        {% endif %}



        {% if report_data and report_data.content_blocks %}
        <div class="card" style="border-left: 4px solid #1E88E5; padding: 20px; margin-bottom: 0px; page-break-after: avoid;">
            <h2 style="color: #1a237e; margin-top: 0;">Yhteenveto</h2>
            <div style="font-size: 13px; line-height: 1.6; color: #333;">
                {{ render_sdui_blocks(report_data.content_blocks) }}
            </div>
        </div>
        {% endif %}

        {% if report_data and report_data.global_score != None %}
        <div style="background-color: #e6e0f8; border: 1px solid #d1c4e9; border-radius: 0 0 8px 8px; padding: 15px 20px; margin-bottom: 25px; margin-top: 0px; page-break-inside: avoid; page-break-before: avoid;">
            <table style="width: 100%; border: none; margin: 0; padding: 0;">
                <tr>
                    <td style="text-align: left; vertical-align: middle;">
                        <strong style="color: #1a1a1a; font-size: 18px;">Kokonaiskeskiarvo</strong>
                    </td>
                    <td style="text-align: right; vertical-align: middle;">
                        <span style="font-size: 24px; font-weight: 800; color: #1a1a1a;">{{ "%.2f"|format(report_data.global_score) }}/100</span>
                    </td>
                </tr>
            </table>
        </div>
        {% endif %}

        {% for layout in report_data.layouts %}
            {% set layout_title_label = layout.title.get('fi', layout.title.get('en', 'Arviointi')) if layout.title else ('Automaattinen' if layout.preset_view == 'default' else layout.preset_view) %}
            <h2 style="margin-top: 20px; color: #004D40; border-bottom: 2px solid #4CAF50; padding-bottom: 5px;">{{ layout_title_label }}</h2>
            
            {% if layout.description %}
                {% set layout_desc_label = layout.description.get('fi', layout.description.get('en', '')) %}
                {% if layout_desc_label %}
                    <div style="font-size: 12px; color: #555; margin-bottom: 15px; font-style: italic;">{{ layout_desc_label }}</div>
                {% endif %}
            {% endif %}

            {% if layout.synthesis_blocks %}
            <div class="justify-box" style="margin-bottom: 20px; border-left: 4px solid #4CAF50; background-color: #F1F8E9;">
                <div style="font-size: 12px; color: #333; line-height: 1.5;">
                    {{ render_sdui_blocks(layout.synthesis_blocks) }}
                </div>
            </div>
            {% endif %}

            {% if charts and loop.index0 in charts %}
                <div style="text-align: center; margin: 20px 0;">
                    <img src="data:image/png;base64,{{ charts[loop.index0] }}" style="max-width: 100%; height: auto; border: 1px solid #eee; border-radius: 8px;" />
                </div>
            {% endif %}
            
            {% set has_graph = layout.preset_view in ['matrix3d', '3d_matrix', 'compare2d', '2d_compare', '3d_complex', 'complex3d'] %}
            {% set hide_axes = layout.preset_view == 'text_only' or (has_graph and layout.text_delivery_mode == 'none') %}
            
            {% if not hide_axes %}
                {% for axis in layout.axes %}
                    <div class="card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <h3 style="margin: 0; color: #1a1a1a; font-size: 16px;">{{ axis.name }}</h3>
                        {% if axis.score != None %}
                        <div style="display: flex; align-items: center; gap: 8px;">
                            {% if axis.contextual_override %}
                            <span style="color: #f57c00; font-size: 12px; font-weight: 500;">⚠️ {{ l10n.get('evidence_rejected', 'Arvosanan perusteet kumottu asiantuntijan toimesta') }}</span>
                            {% endif %}
                            <div style="background-color: #e3f2fd; color: #1976D2; padding: 4px 12px; border-radius: 12px; font-weight: bold; font-size: 14px;">
                                {{ "%.1f"|format(axis.score) }} {% if axis.scale_max > axis.scale_min %}/ {{ "%.1f"|format(axis.scale_max) }}{% endif %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                    
                    {% if axis.description %}
                        <div style="font-size: 12px; color: #666; font-style: italic; margin-bottom: 8px;">{{ axis.description }}</div>
                    {% endif %}
                    
                    {% if layout.preset_view == 'metrics1d' and axis.ui_plot_ratio != None %}
                        <div style="margin: 12px 0 8px 0; background-color: #eee; border-radius: 6px; height: 12px; width: 100%; overflow: hidden;">
                            <div style="background: linear-gradient(90deg, rgba(33,150,243,0.6) 0%, rgba(33,150,243,1) 100%); height: 100%; width: {{ axis.ui_plot_ratio * 100 }}%; border-radius: 6px;"></div>
                        </div>
                    {% endif %}
                    
                    {% if layout.text_delivery_mode != 'none' %}
                        {% if axis.row_explanation %}
                            <div style="font-size: 13px; line-height: 1.5; color: #333; margin-top: 8px;">
                                {{ axis.row_explanation | md | safe }}
                            </div>
                        {% endif %}

                        {% if axis.evaluated_atoms %}
                            {% set grouped_atoms = axis.evaluated_atoms | group_atoms_by_level %}
                            {% for level, atoms in grouped_atoms.items() %}
                                <div style="margin-top: 10px;">
                                    <strong style="font-size: 11px; color: #444;">{{ atoms[0].level_name }}</strong>
                                    {% for atom in atoms %}
                                        <div class="atom-card intent-{{ atom.visual_intent | default('default') }}">
                                            <div style="font-weight: bold; margin-bottom: 4px; color: #333;">{{ atom.chart_display_label }}</div>
                                            {% if atom.status == 'Skipped' %}
                                                <div style="color: #888; font-style: italic;">Arviointi ohitettu (Skipped)</div>
                                            {% else %}
                                                {% if atom.exact_quotes %}
                                                    {% for quote_dto in atom.exact_quotes %}
                                                        <div style="font-style: italic; margin-bottom: 4px;">
                                                            "{{ quote_dto.quote }}"
                                                            {% if quote_dto.verified_source_ids %}
                                                                <br><span style="font-size: 10px; color: #1976D2; font-weight: bold;">(Lähde: {{ quote_dto.verified_source_ids | join(', ') }})</span>
                                                            {% endif %}
                                                        </div>
                                                    {% endfor %}
                                                {% else %}
                                                    <div style="font-style: italic; color: #888;">{{ atom.semantic_reasoning }}</div>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endfor %}
                        {% endif %}

                        {% if axis.cited_source_id %}
                            <div style="margin-top: 8px; font-size: 10px; color: #607d8b; font-weight: bold;">
                                ⚖️ Viitekehys: {{ axis.cited_source_id }}
                            </div>
                        {% endif %}

                        {% if report_data and report_data.grouped_extensions and 'confidence' in report_data.grouped_extensions and axis.confidence is not none %}
                            <div style="margin-top: 8px; font-size: 11px; color: #3f51b5; font-weight: bold;">
                                🎯 {{ l10n.get('reportConfidenceTitle', 'Tekoälyn varmuus: {value}%').replace('{value}', (axis.confidence * 100) | int | string) }}
                            </div>
                        {% endif %}

                        {% if layout.text_delivery_mode == 'full' %}
                            {% if axis.evidence_type %}
                                <div style="margin-top: 8px; font-size: 11px;">
                                    {% if axis.evidence_type == 'EXPLICIT_QUOTE' %}
                                    <span style="background-color: #e8f5e9; border: 1px solid #c8e6c9; color: #2e7d32; padding: 2px 6px; border-radius: 4px;">✅ Explicit Quote</span>
                                    {% elif axis.evidence_type == 'IMPLIED_INTENT' %}
                                    <span style="background-color: #fff3e0; border: 1px solid #ffe0b2; color: #ef6c00; padding: 2px 6px; border-radius: 4px;">⚠️ Implied Intent</span>
                                    {% else %}
                                    <span style="background-color: #e3f2fd; border: 1px solid #bbdefb; color: #1565c0; padding: 2px 6px; border-radius: 4px;">{{ axis.evidence_type }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </div>
            {% endfor %}
            {% endif %}
        {% endfor %}

        {% if report_data.grouped_extensions %}
            {% set ext_title_map = {
                'citation': 'VIITTEET',
                'justification': 'PERUSTELUT',
                'falsification': '⚖️ VASTA-ARGUMENTTI',
                'theory_link': '📚 TEOREETTINEN YHTEYS',
                'risk_flag': '⚠️ VAKAVA RISKI HAVAITTU',
                'coaching': '💡 ARJEN VINKKI',
                'missing_context': '🔍 PUUTTUVA KONTEKSTI',
                'remediation_steps': '🛠️ KORJAAVAT TOIMENPITEET',
                'emotional_sentiment': '🎭 EMOTIONAALINEN SÄVY',
                'confidence': 'LUOTETTAVUUS JA VARMUUS',
                'variance_validation': l10n.get('xaiVarianceValidationTitle', '🤖 VARIAATIO (KOGNITIIVINEN VS. MEKAANINEN)')
            } %}

            {% for ext_key, ext_items in report_data.grouped_extensions.items() %}
                {% if ext_items and ext_items | length > 0 %}
                    {% set card_border = '#d1c4e9' %}
                    {% set card_bg = '#ede7f6' %}
                    {% set header_text = '#4527a0' %}
                    
                    {% if ext_key in ['falsification', 'risk_flag'] %}
                        {% set card_border = '#ef9a9a' %}
                        {% set card_bg = '#ffebee' %}
                        {% set header_text = '#c62828' %}
                    {% elif ext_key in ['coaching', 'remediation_steps'] %}
                        {% set card_border = '#a5d6a7' %}
                        {% set card_bg = '#e8f5e9' %}
                        {% set header_text = '#2e7d32' %}
                    {% elif ext_key in ['justification', 'theory_link'] %}
                        {% set card_border = '#90caf9' %}
                        {% set card_bg = '#e3f2fd' %}
                        {% set header_text = '#1565c0' %}
                    {% elif ext_key == 'missing_context' %}
                        {% set card_border = '#ffcc80' %}
                        {% set card_bg = '#fff3e0' %}
                        {% set header_text = '#ef6c00' %}
                    {% elif ext_key == 'variance_validation' %}
                        {% set card_border = '#c5cae9' %}
                        {% set card_bg = '#e8eaf6' %}
                        {% set header_text = '#1a237e' %}
                    {% endif %}

                    <div class="card" style="border: 2px solid {{ card_border }}; background-color: {{ card_bg }}; border-radius: 8px; margin-bottom: 16px; padding: 0; overflow: hidden; page-break-inside: avoid;">
                        <div style="background-color: transparent; padding: 12px 16px; border-bottom: 1px solid {{ card_border }}; display: flex; align-items: center; justify-content: space-between;">
                            <h2 style="color: {{ header_text }}; margin: 0; font-size: 15px; font-weight: 600;">
                                <span style="margin-right: 8px;">🧩</span>
                                {{ ext_title_map.get(ext_key, ext_key | upper | replace('_', ' ')) }}
                            </h2>
                            <span style="color: {{ header_text }}; font-size: 12px;">▼</span>
                        </div>
                        <div style="padding: 16px; margin-top: 0; background-color: {{ card_bg }};">
                        {% if ext_key == 'variance_validation' %}
                            {% for item in ext_items %}
                                {% set score = item.get('variance_score') | float %}
                                {% set verdict = item.get('alignment_verdict') %}
                                {% set mech_ref = item.get('mechanical_metric_ref') %}
                                {% set cog_ref = item.get('cognitive_metric_ref') %}
                                
                                {% set verdict_label = verdict %}
                                {% if verdict == 'ALIGNED' %}
                                    {% set verdict_label = l10n.get('xaiVerdictAligned', '✅ Aligned') %}
                                    {% set verdict_color = '#2e7d32' %}
                                {% elif verdict == 'MISALIGNED_SYCOPHANCY' %}
                                    {% set verdict_label = l10n.get('xaiVerdictSycophancy', '❌ Sycophancy') %}
                                    {% set verdict_color = '#d32f2f' %}
                                {% elif verdict == 'MISALIGNED' %}
                                    {% set verdict_label = l10n.get('xaiVerdictMisaligned', '⚠️ Misaligned') %}
                                    {% set verdict_color = '#e65100' %}
                                {% endif %}
                                
                                <div style="margin-bottom: 16px; page-break-inside: avoid;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                        <span style="font-size: 13px; font-weight: bold; color: {{ verdict_color }};">{{ verdict_label }}</span>
                                        <span style="font-size: 10px; color: #666; font-style: italic;">
                                            {{ l10n.get('xaiVarianceInfoText', 'Tämä mittari paljastaa, onko tekoälyn oma arvio suorituksestaan (kognitiivinen) ristiriidassa kylmien faktojen (mekaaninen skannaus) kanssa.') }}
                                        </span>
                                    </div>
                                    
                                    {% set percentage = ((score / 2.0) * 100) | float %}
                                    {% set marker_percentage = [0, [100, percentage]|min]|max %}
                                    
                                    <div style="position: relative; margin: 24px 0 16px 0; padding-top: 10px; height: 35px; width: 100%;">
                                        <!-- The progress bar segments -->
                                        <div style="display: flex; height: 16px; border-radius: 8px; overflow: hidden; border: 1px solid #ccc; width: 100%; position: absolute; top: 12px; left: 0;">
                                            <div style="width: 25%; background-color: #E8F5E9; text-align: center; color: #1B5E20; font-size: 8px; line-height: 16px; font-weight: bold; border-right: 1px dashed #c8e6c9;">{{ l10n.get('xaiVarianceBarAligned', 'Aligned') }} (0.0-0.5)</div>
                                            <div style="width: 25%; background-color: #FFF3E0; text-align: center; color: #E65100; font-size: 8px; line-height: 16px; font-weight: bold; border-right: 1px dashed #ffe0b2;">{{ l10n.get('xaiVarianceBarMild', 'Mild') }} (0.5-1.0)</div>
                                            <div style="width: 50%; background-color: #FFEBEE; text-align: center; color: #C62828; font-size: 8px; line-height: 16px; font-weight: bold;">{{ l10n.get('xaiVarianceBarSevere', 'Severe') }} (1.0-2.0)</div>
                                        </div>
                                        
                                        <!-- Float marker triangle pointing down -->
                                        <div style="position: absolute; left: calc({{ marker_percentage }}% - 6px); top: 0px; width: 12px; height: 12px; z-index: 10;">
                                            <div style="width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 8px solid #1a237e;"></div>
                                        </div>
                                        
                                        <!-- Score text floated below -->
                                        <div style="position: absolute; left: calc({{ marker_percentage }}% - 15px); top: 28px; width: 30px; text-align: center; font-size: 9px; font-weight: bold; color: #1a237e; z-index: 10;">
                                            {{ "%.2f"|format(score) }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            {% for item in ext_items %}
                                {% if item is mapping %}
                                    {% set content = item.get('content') %}
                                    {% set display_content = content %}
                                    {% if not content and item.get('axis_name') %}
                                        {% set ns_inner = namespace(key='') %}
                                        {% for k in item.keys() if k not in ['axis_name', '_score', 'color_theme', 'icon_name'] %}
                                            {% if loop.first %}{% set ns_inner.key = k %}{% endif %}
                                        {% endfor %}
                                        {% if ns_inner.key %}
                                            {% set display_content = item.get('axis_name') ~ ':\n' ~ item.get(ns_inner.key) %}
                                        {% endif %}
                                    {% endif %}
                                    {% set c_theme = item.get('color_theme', 'info') %}
                                    {% set bg_color = '#e3f2fd' %}
                                    {% set fg_color = '#1976d2' %}
                                    
                                    {% if c_theme == 'danger' %}
                                        {% set bg_color = '#ffebee' %}
                                        {% set fg_color = '#d32f2f' %}
                                    {% elif c_theme == 'warning' %}
                                        {% set bg_color = '#fff3e0' %}
                                        {% set fg_color = '#e65100' %}
                                    {% elif c_theme == 'success' %}
                                        {% set bg_color = '#e8f5e9' %}
                                        {% set fg_color = '#1b5e20' %}
                                    {% endif %}
                                    
                                    <div style="margin-bottom: 8px;">
                                        <div style="background-color: {{ bg_color }}; border-left: 4px solid {{ fg_color }}; padding: 12px; border-radius: 8px; font-size: 13px; line-height: 1.5; color: #212121;">
                                            {{ display_content | default('') | md | safe }}
                                        </div>
                                    </div>
                                {% else %}
                                    <div style="margin-bottom: 8px; font-size: 13px; color: #333; padding-left: 10px;">{{ item }}</div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}

        <!-- Yhteenveto / Matrix Summary Table -->
        {% set visible_cols = report_data.matrix_visible_columns if report_data.matrix_visible_columns else ['label', 'score', 'distribution', 'row_explanation'] %}
        {% if visible_cols %}
        <div style="page-break-before: always; margin-top: 30px;">

            {% set default_summary_title = l10n.scorecard_matrix_summary | default('Yhteenveto / Matrix Summary') %}
            {% set first_layout = report_data.layouts[0] if report_data and report_data.layouts else none %}
            {% set summary_title = (first_layout.title.get(lang_code, first_layout.title.get('en', default_summary_title))) if first_layout and first_layout.title else default_summary_title %}
            <h2 style="color: #1a237e; text-transform: uppercase; border-bottom: 2px solid #1a237e; padding-bottom: 8px; margin-bottom: 20px;">{{ summary_title }}</h2>
            <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: left; background-color: #fff; border: 1px solid #e0e0e0;">
                <thead>
                    <tr style="background-color: #f5f5f5; border-bottom: 2px solid #ccc;">
                        {% if 'label' in visible_cols %}<th style="padding: 12px 10px; width: 25%; color: #333; font-weight: 700;">{{ l10n.lblLogicMatrix | default('Matriisi') }}</th>{% endif %}
                        {% if 'distribution' in visible_cols or 'atomic_breakdown' in visible_cols %}<th style="padding: 12px 10px; width: 20%; color: #333; font-weight: 700;">{{ l10n.atomicBreakdownTitle | default('Jakauma') }}</th>{% endif %}
                        {% if 'row_explanation' in visible_cols %}<th style="padding: 12px 10px; width: 20%; color: #333; font-weight: 700;">{{ l10n.rowExplanationTitle | default('Selite') }}</th>{% endif %}
                        {% if 'quotes' in visible_cols %}<th style="padding: 12px 10px; width: 25%; color: #333; font-weight: 700;">Lainaukset (quotes)</th>{% endif %}
                        {% if 'normalized_score' in visible_cols %}<th style="padding: 12px 10px; width: 10%; color: #333; font-weight: 700;">{{ l10n.normalizedScore | default('Skaalattu') }}</th>{% endif %}
                        {% if 'score' in visible_cols %}<th style="padding: 12px 10px; width: 10%; color: #333; font-weight: 700;">{{ l10n.score | default('Pisteet') }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                {% set all_matrices = (report_data.evaluative_matrices | default([], true)) + (report_data.informational_matrices | default([], true)) %}
                {% for axis in all_matrices %}
                    <tr style="border-bottom: 1px solid #eee;">
                        {% if 'label' in visible_cols %}
                        <td style="padding: 10px; vertical-align: top;">
                            <div style="font-weight: 600; color: #2c3e50; margin-bottom: 4px;">{{ axis.name }}{% if axis.is_evaluative %} *{% endif %}</div>
                            {% if axis.description %}
                            <div style="font-size: 10px; color: #666; font-weight: normal; line-height: 1.3;">{{ axis.description }}</div>
                            {% endif %}
                        </td>
                        {% endif %}
                        {% if 'distribution' in visible_cols or 'atomic_breakdown' in visible_cols %}
                        <td style="padding: 10px; color: #555; vertical-align: top;">
                            {% set lvl = axis.level_breakdown or {} %}
                            {% set lvl_names = axis.level_names or {} %}
                            {% if lvl %}
                                <div style="margin: 0; font-size: 10px; line-height: 1.3;">
                                {% for key, val in lvl.items() | sort(reverse=True, attribute='0') %}
                                    {% set hit_str = val if val is string else (val.get('hits', val.get('true_atoms', 0)) ~ '/' ~ val.get('total', val.get('total_atoms', 0))) %}
                                    {% set name = lvl_names.get(key, 'T' ~ key) %}
                                    {% set numLvl = (key | float | int) if '.' in key else (key | int) %}
                                    <div style="margin-bottom: 2px;">{{ numLvl }} - {{ name }}: {{ hit_str }}</div>
                                {% endfor %}
                                </div>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        {% endif %}
                        {% if 'row_explanation' in visible_cols %}
                        <td style="padding: 10px; color: #444; font-style: italic; font-size: 10px; vertical-align: top;">
                            {{ axis.row_explanation }}
                        </td>
                        {% endif %}
                        {% if 'quotes' in visible_cols %}
                        <td style="padding: 10px; vertical-align: top; font-size: 10px;">
                            {% set evaluated_atoms = axis.evaluated_atoms or [] %}
                            {% if evaluated_atoms %}
                                {% set grouped_atoms = {} %}
                                {% for atom in evaluated_atoms %}
                                    {% set lvl = atom.level | string %}
                                    {% if lvl not in grouped_atoms %}
                                        {% set _ = grouped_atoms.update({lvl: []}) %}
                                    {% endif %}
                                    {% set _ = grouped_atoms[lvl].append(atom) %}
                                {% endfor %}
                                
                                {% for lvl, atoms in grouped_atoms.items() | sort(reverse=True, attribute='0') %}
                                    {% set lvl_name = (axis.level_names or {}).get(lvl, 'T' ~ lvl) %}
                                    <div style="font-weight: bold; margin-bottom: 4px; font-size: 11px;">{{ lvl }} - {{ lvl_name }}</div>
                                    {% set has_rendered = false %}
                                    {% for atom in atoms %}
                                        {% set status = (atom.status or '') | lower %}
                                        {% if status not in ['skipped', 'none', 'dlq'] and 'chunk processing failed' not in (atom.semantic_reasoning or '')|lower %}
                                            <div style="margin-bottom: 8px;">
                                                <div style="font-weight: {{ 'bold' if status in ['pass', 'contested'] else 'normal' }}; color: #333;">
                                                    - {{ atom.chart_display_label }}
                                                </div>
                                                {% for quote in atom.exact_quotes %}
                                                    <div style="margin-top: 2px; color: #555;">
                                                        {% if quote.display_name %}
                                                            <span style="background-color: #e3f2fd; border: 1px solid #bbdefb; padding: 1px 4px; border-radius: 2px; font-size: 8px; font-weight: bold; color: #1565c0; margin-right: 4px;">{{ quote.display_name | upper }}</span>
                                                        {% endif %}
                                                        {{ quote.quote_text }}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            {% set has_rendered = true %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if not has_rendered %}
                                        <div style="color: #999; font-style: italic; margin-bottom: 8px;">- N/A</div>
                                    {% endif %}
                                {% endfor %}
                            {% else %}
                                <div style="color: #999; font-style: italic;">- N/A</div>
                            {% endif %}
                        </td>
                        {% endif %}
                        {% if 'normalized_score' in visible_cols %}
                        <td style="padding: 10px; font-weight: bold; color: #2E7D32; vertical-align: top;">
                            {% if axis.ui_plot_ratio != None %}
                                <div style="background-color: #e8f5e9; border: 1px solid #c8e6c9; padding: 4px 8px; border-radius: 4px; display: inline-block;">
                                    {{ "%.1f"|format(axis.ui_plot_ratio * 100) }}%
                                </div>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        {% endif %}
                        {% if 'score' in visible_cols %}
                        <td style="padding: 10px; font-weight: bold; color: #1565C0; vertical-align: top;">
                            {% if axis.score != None %}
                                {{ "%.1f"|format(axis.score) }} {% if axis.scale_max != None and axis.scale_max > (axis.scale_min or 0) %}/ {{ "%.1f"|format(axis.scale_max) }}{% endif %}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if report_data.evaluative_matrices %}
            <div style="font-size: 11px; color: #666; margin-top: 8px; font-style: italic;">
                {{ l10n.matrixEvaluativeAsteriskLegend }}
            </div>
            {% endif %}

        </div>
        {% endif %}

        {% if report_data.mcp_tool_audit %}
        <div class="card" style="border-top: 3px solid #009688;">
            <h2 style="color: #00796b;">{{ l10n.systemAuditTrailLabel | default('Järjestelmän Faktantarkistusloki') }}</h2>
            {% for audit in report_data.mcp_tool_audit %}
            <div style="background-color: #f7f9f9; border: 1px solid #e0e0e0; border-radius: 6px; padding: 12px; margin-bottom: 15px;">
                <div style="font-size: 13px; font-weight: bold; color: #333; margin-bottom: 6px;">
                    <span style="font-size: 11px; float: right; font-weight: normal; color: #888; background-color: #eee; padding: 2px 6px; border-radius: 10px;">{{ l10n.pdfAuditDuration | default('Kesto:') }} {{ audit.duration_ms }}ms</span>
                    <span style="font-family: monospace; font-size: 10px; background-color: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; border-radius: 4px; padding: 2px 6px; margin-right: 6px;">{{ audit.tool_id }}</span>
                    🔍 {{ l10n.pdfAuditQuery | default('Hakukysely:') }} "{{ audit.query }}"
                </div>
                <div style="font-size: 12px; color: #555; margin-bottom: 10px; line-height: 1.5; clear: both;">
                    {{ audit.response_summary | md | safe }}
                </div>
                {% if audit.impacted_axis_names %}
                <div style="font-size: 11px; font-weight: bold; color: #2E7D32; margin-bottom: 10px; padding: 6px; background-color: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 4px; clear: both;">
                    🎯 {{ l10n.pdfAuditImpactedAxes | default('Tätä tietoa käytettiin seuraavien osioiden arvioinnissa:') }}
                    <span style="font-weight: normal; color: #1b5e20;">{{ audit.impacted_axis_names | join(', ') }}</span>
                </div>
                {% endif %}
                {% if audit.source_urls %}
                <div style="font-size: 11px; font-weight: bold; color: #009688; margin-bottom: 4px;">{{ l10n.pdfAuditSources | default('Lähteet') }}</div>
                <div style="display: flex; flex-wrap: wrap; gap: 6px; clear: both;">
                    {% for url in audit.source_urls %}
                    <div style="background-color: #e3f2fd; border: 1px solid #bbdefb; color: #1976D2; padding: 4px 8px; border-radius: 4px; font-size: 10px; text-decoration: none; word-break: break-all; display: inline-block;">
                        🔗 {{ url }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if report_data.penalties_applied %}
        <div style="margin-top: 40px; padding: 15px; background-color: #ffebee; border: 1px solid #ffcdd2; border-radius: 6px;">
            <div style="font-size: 13px; font-weight: bold; color: #c62828; margin-bottom: 8px;">{{ l10n.reportPenaltiesApplied | default('Rangaistukset (Sovelletut vääristymät)') }}</div>
            <ul style="margin: 0; padding-left: 20px; font-size: 11px; color: #b71c1c;">
                {% for penalty in report_data.penalties_applied %}
                <li>
                    {% if penalty.startswith('PENALTY_SECURITY:') %}
                        {% set pct = penalty.split(':')[1] %}
                        {{ l10n.penaltySecurity | default('Security Threat Detected (-{percentage}%)') | replace('{percentage}', pct) }}
                    {% elif penalty.startswith('PENALTY_POST_HOC:') %}
                        {% set pct = penalty.split(':')[1] %}
                        {{ l10n.penaltyPostHoc | default('Post-Hoc Rationalization Detected (-{percentage}%)') | replace('{percentage}', pct) }}
                    {% elif penalty.startswith('PENALTY_SLOP:') %}
                        {% set phrases = penalty.split(':', 1)[1] %}
                        {{ l10n.penaltySlop | default('-5% Slop Penalty (AI Jargon): detected {phrases}') | replace('{phrases}', phrases) }}
                    {% else %}
                        {# Zero-Compromise check: crash/fail-fast on legacy formats by invoking undefined #}
                        {{ ZERO_COMPROMISE_CRASH_LEGACY_PENALTY_FORMAT_DETECTION }}
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        
    {% else %}
        <div class="card" style="border-left: 4px solid #F44336; background-color: #ffebee;">
            <h2 style="color: #c62828;">V2 ARCHITECTURE VIOLATION</h2>
            <p style="font-size: 12px; color: #b71c1c;">
                <strong>FAIL-FAST MANDATE:</strong> This execution lacks explicit ReportDataDTO mapping securely populated from backend APIs.
            </p>
        </div>
    {% endif %}

</body>
</html>
