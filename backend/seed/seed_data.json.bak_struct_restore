        "51": {
            "id": "c4312caa-0285-4d7c-9990-a3ea6d4e40fe",
            "type": "concept",
            "term": "4.3 Kehityspolku: Kaksitasoisen Arkkitehtuurin Rakentaminen",
            "definition": "Kehityspolku on kolmivaiheinen. Se etenee reliabiliteetin maksimoinnista (Järjestelmä 2) kohti tehokkuuden optimointia (Järjestelmä 1).",
