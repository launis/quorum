                            "2": "Heikko synteesi. Yhdistelee asioita mekaanisesti. Ei uusia oivalluksia tai käsitteitä.",
                            "3": "Vahva synteesi. Tekoäly on tuottanut uudenlaisen kokonaisuuden käyttäjän ohjauksessa. Selkeä lisäarvo.",
                            "4": "Transformatiivinen. 'Supermegatrendi'-tason oivallus. Lopputulos on enemmän kuin osiensa summa ja aidosti uutta tietoa."
                        },
                        "id": "synteesi",
                        "instruction": "Luoako käyttäjä uutta tietoa tekoälyn avulla vai vain kierrättääkö vanhaa?",
                        "label": "Uuden Tiedon Luominen (Synteesi)"
                    },
                    {
                        "anchors": {
                            "1": "Sokea: Sokea luottamus. Kopioi hallusinaatiot suoraan lopputuotteeseen.",
                            "2": "Hyväksyvä: Kehuu tekoälyä ('Hyvä!') vaikka vastauksessa olisi puutteita. Korjaukset vain tyylillisiä.",
                            "3": "Korjaava: Huomaa selkeät virheet ja pyytää korjausta.",
                            "4": "Adversariaalinen: Testaa rajoja ('Etsi virheet'). Spottaa faktavirheet ja pakottaa korjaamaan lähteisiin viitaten."
                        },
                        "id": "falsification",
                        "instruction": "Miten käyttäjä reagoi virheisiin ja haastaako hän tekoälyä?",
                        "label": "Kriittinen Iteraatio (Falsification)"
                    }
