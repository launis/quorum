                {
                    "citation": "Zou, Wei; Geng, Runpeng; Wang, Binghui & Jia, Jinyuan. 2024: PoisonedRAG: Knowledge Corruption Attacks to Retrieval-Augmented Generation of Large Language Models. arXiv preprint arXiv:2402.07867. DOI: 10.48550/arXiv.2402.07867.",
                    "link": "https://doi.org/10.48550/arXiv.2402.07867",
