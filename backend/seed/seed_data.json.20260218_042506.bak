        },
        {
            "id": "c7eedb8b-901f-40fc-884a-7b7c86cf7bce",
            "type": "claim",
            "term": "Strathern 1997...",
            "definition": "On suoritettava koe, jossa testataan ”Epäilyttävä Täydellisyys” -heuristiikan kykyä erottaa aidot suoritukset optimoiduista.",
            "source_file": "Holistinen Mestaruus.docx",
            "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29",
            "ingested_at": "2026-02-17T03:38:32.851399",
            "metadata": {
                "citation_keys": [],
                "citation_text": "Strathern 1997",
                "full_reference": "Strathern, Marilyn 1997. 'Improving ratings': audit in the British university system. European Review, 5(3), s. 305–321. Saatavilla: https://doi.org/10.1002/(SICI)1234-981X(199707)5:3<305::AID-EURO184>3.0.CO;2-4.",
