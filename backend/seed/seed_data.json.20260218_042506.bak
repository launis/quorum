        {
            "id": "matrix_standard_v1",
            "name": "Kognitiivinen Quorum Unified Matrix",
            "description": "Yhdistetty matriisi: Agency (Prosessi), Synteesi (Lopputulos), Falsification (Laatu).",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "evaluation_matrix",
            "content": {
                "criteria": [
                    {
                        "anchors": {
                            "1": "Matkustaja (Tilaa): Passiivinen tilaaja. 'Tee essee aiheesta X'. Hyväksyy ensimmäisen version. Ulkoistaa ajattelun.",
                            "2": "Kartanlukija (Korjaa): Reaktiivinen toiminta. Epämääräinen aloitus, korjaa vasta jälkikäteen ('Ei noin, vaan näin').",
                            "3": "Kuski (Ohjaa): Käyttäjä tietää mitä haluaa ja asettaa reunaehdot. Korjaa suuntaa aktiivisesti, jos tekoäly poikkeaa.",
                            "4": "Arkkitehti (Suunnittelee): Käyttäjä on purkanut ongelman osiin (Decomposition) ENNEN ensimmäistä promptia. Prosessi on suunniteltu ketju."
                        },
                        "id": "agency",
                        "instruction": "Onko käyttäjällä suunnitelma vai reagoiko hän vain?",
                        "label": "Strateginen Ohjaus (Agency)"
                    },
                    {
                        "anchors": {
                            "1": "Ei uutta tietoa. Lopputuote on vain tiivistelmä tai kopio lähdemateriaalista ilman omaa panosta.",
                            "2": "Heikko synteesi. Yhdistelee asioita mekaanisesti. Ei uusia oivalluksia tai käsitteitä.",
                            "3": "Vahva synteesi. Tekoäly on tuottanut uudenlaisen kokonaisuuden käyttäjän ohjauksessa. Selkeä lisäarvo.",
                            "4": "Transformatiivinen. 'Supermegatrendi'-tason oivallus. Lopputulos on enemmän kuin osiensa summa ja aidosti uutta tietoa."
                        },
                        "id": "synteesi",
                        "instruction": "Luoako käyttäjä uutta tietoa tekoälyn avulla vai vain kierrättääkö vanhaa?",
                        "label": "Uuden Tiedon Luominen (Synteesi)"
                    },
                    {
                        "anchors": {
                            "1": "Sokea: Sokea luottamus. Kopioi hallusinaatiot suoraan lopputuotteeseen.",
                            "2": "Hyväksyvä: Kehuu tekoälyä ('Hyvä!') vaikka vastauksessa olisi puutteita. Korjaukset vain tyylillisiä.",
                            "3": "Korjaava: Huomaa selkeät virheet ja pyytää korjausta.",
                            "4": "Adversariaalinen: Testaa rajoja ('Etsi virheet'). Spottaa faktavirheet ja pakottaa korjaamaan lähteisiin viitaten."
                        },
                        "id": "falsification",
                        "instruction": "Miten käyttäjä reagoi virheisiin ja haastaako hän tekoälyä?",
                        "label": "Kriittinen Iteraatio (Falsification)"
                    }
                ],
                "description": "Yhdistetty matriisi: Agency (Prosessi), Synteesi (Lopputulos), Falsification (Laatu).",
                "name": "Kognitiivinen Quorum Unified Matrix",
                "role_description": "Toimit Järjestelmän Tuomarina. Arvioi sekä prosessia että lopputulosta.",
                "scale": {
                    "max": 100,
                    "min": 1
                }
            }
        },
        {
