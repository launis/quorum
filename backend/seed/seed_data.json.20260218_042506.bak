        {
            "id": "METHOD_3",
            "name": null,
            "description": "Sokraattinen auditointi.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "method",
            "content": "Menetelmä 3 (Kysymykset): Generoi kysymyksiä, jotka paljastavat käyttäjän tietämättömyyden."
        },
        {
            "id": "INSTRUCTION_TOULMIN",
            "name": null,
            "description": "Argumentaatiomalli.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "instruction",
            "content": "KÄSKE: Jäsennä Toulmin-mallilla (Väite, Peruste, Oikeutus). Perusta analyysi VAIN annettuun aineistoon (step_analyst). ÄLÄ keksi omia esimerkejä. Jos todisteita ei ole, hylkää väite."
        },
        {
            "id": "INSTRUCTION_BLOOM",
            "name": null,
            "description": "Kognitiivinen mittari.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "instruction",
            "content": "KÄSKE: Arvioi Bloomin tasolla. Vaadi 'Analyysiä' tai korkeampaa."
        },
        {
            "id": "INSTRUCTION_ANON",
            "name": null,
            "description": "Tietosuoja.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "instruction",
            "content": "TARKISTA: Etsi tekstistä PII-dataa (Nimet, Email). JOS JA VAIN JOS löydät AITOA PII-dataa syötteestä, poista se. ÄLÄ KOSKAAN keksi esimerkkejä tyhjästä (esim. 'Matti Meikäläinen'). Jos dataa ei löydy, kirjaa 'Ei havaittu' ja jatka."
        },
        {
            "id": "INSTRUCTION_RAG_OPT",
            "name": null,
            "description": "RAG-optimointi.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "instruction",
            "content": "KÄSKE: Optimoi konteksti 'Lost in the Middle' -ilmiötä vastaan."
        },
        {
            "id": "PRINCIPLE_1",
            "name": null,
            "description": "Popperilainen tieteenfilosofia.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "principle",
            "content": "Periaate 1: MÄÄRÄYS: Tieteellinen totuus selvitetään yrittämällä kumota väite. Jos väite ei kestä kritiikkiä, se on väärä."
        },
        {
            "id": "REQUIREMENT_1",
            "name": null,
            "description": "Mallien diversiteetti.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "requirement",
            "content": "Vaatimus 1: MÄÄRÄYS: Kriittiset vaiheet (Falsifiointi) on ajettava eri parametreilla kuin luovat vaiheet."
        },
        {
            "id": "INSTRUCTION_COACH_CITATION",
            "name": null,
            "description": "Tiukat ohjeet lähdeluettelon luomiseen (Vain DB).",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "instruction",
            "content": "CRITICAL: Do NOT populate the 'lahdeluettelo' field manually. The system will generate it programmatically based on your inline citations.\n\nYOUR TASK is to use inline citations explicitly in your text (e.g., '(Toulmin 2003)', '(Kahneman 2011)').\nEnsure you refer to the provided EXTERNAL SOURCES.\nLeave 'lahdeluettelo' as an empty list []."
        },
        {
            "id": "HEURISTIC_1",
            "name": null,
            "description": "Syy-seuraus -analyysi.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "heuristic",
            "content": "Heuristiikka 1 (Temporaalinen): MÄÄRÄYS: Tarkista aikajana. Tuliko oivallus ENNEN tuloksen paranemista (Syy) vai vasta sen jälkeen (Rationalisointi)?"
        },
        {
            "id": "HEURISTIC_2",
            "name": null,
            "description": "Lisäarvon mittaus.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "heuristic",
            "content": "Heuristiikka 2 (Kontrafaktuaalinen): MÄÄRÄYS: Kysy 'Jos käyttäjä ei olisi tehnyt mitään, olisiko tekoäly ratkaissut tämän silti?'. Jos kyllä -> Matkustaja."
        },
        {
            "id": "HEURISTIC_3",
            "name": null,
            "description": "Occamin partaveitsi.",
            "citation": null,
            "citation_full": null,
            "module": null,
            "component_class": null,
            "class_name": null,
            "registered_at": null,
            "type": "heuristic",
            "content": "Heuristiikka 3 (Occamin partaveitsi): MÄÄRÄYS: Yksinkertaisin selitys on todennäköisin."
        },
