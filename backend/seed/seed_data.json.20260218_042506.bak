            "job_id": "f99b2fd9-6c79-4559-a3d5-6587f6652a29",
            "ingested_at": "2026-02-17T03:38:32.824884",
            "metadata": {
                "citation_keys": [],
                "citation_text": "Cullen 2020",
                "full_reference": "Cullen, Michael J. 2020. Faking in high-stakes selection: A call to integrate empirical research and applied practice. International Journal of Selection and Assessment, 28(3), s. 223–226. Saatavilla: https://doi.org/10.1111/ijsa.12289.",
