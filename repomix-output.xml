      "name": {
        "default_locale": "fi",
        "translations": {
          "fi": "Kokonaisvaltainen Auditointi",
          "en": "Holistic Audit"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Kattava 12-vaiheinen auditointiketju, joka analysoi datan monipuolisesti ja tuottaa syvällisen arvioinnin.",
          "en": "Comprehensive 12-step audit chain that analyzes data from multiple perspectives to produce an in-depth evaluation."
        }
      },
      "expected_inputs": [
        {
          "input_key": "product_text",
          "label": {
            "default_locale": "fi",
            "translations": {
              "fi": "Lopputuote (Analyysin Pääkohde)",
              "en": "Product (Main Audit Target)"
            }
          },
          "required": false,
          "is_chat_history": false,
          "input_modes": [
            "file",
            "paste"
          ],
          "description": {
            "default_locale": "fi",
            "translations": {
              "fi": "Tähän liitetään auditoitavan prosessin varsinainen tuotos, esim. PDF-dokumentti.",
              "en": "Attach the actual output of the audited process (e.g. PDF)."
            }
          },
          "ai_description": "SOURCE EVIDENCE DIRECTIVE: This artifact represents the final target output of the audited process. It must be evaluated strictly on its own merits without assuming any external context or hidden intentions. Treat this as the definitive end-result of the cognitive process.",
          "questionnaire_definition": []
        },
        {
          "input_key": "chat_log",
          "label": {
            "default_locale": "fi",
            "translations": {
              "fi": "Keskusteluhistoria",
              "en": "Chat Log"
            }
          },
          "required": true,
          "is_chat_history": true,
          "input_modes": [
            "file",
            "paste"
          ],
          "description": {
            "default_locale": "fi",
            "translations": {
              "fi": "Liitä keskusteluhistoria ihmisen ja tekoälyn välillä.",
              "en": "Attach chat log between human and AI."
            }
          },
          "ai_description": "PROCESS EVIDENCE DIRECTIVE: This artifact contains the chronological dialogue unspooled between the human operator and the AI system leading up to the final product. You must analyze this strictly for developmental trajectory, cognitive dependencies, prompt compliance, and the balance of intellectual labor. Do not treat this as the final product itself, but rather the scaffolding that built it.",
          "questionnaire_definition": []
        },
        {
          "input_key": "reflection_text",
          "label": {
            "default_locale": "fi",
            "translations": {
              "fi": "Reflektiodokumentti",
              "en": "Reflection"
            }
          },
          "required": false,
          "is_chat_history": false,
          "input_modes": [
            "questionnaire"
          ],
          "description": {
            "default_locale": "fi",
            "translations": {
              "fi": "Vastaa lyhyesti reflektiokysymyksiin.",
              "en": "Answer reflection questions briefly."
            }
          },
          "ai_description": "META-COGNITIVE EVIDENCE DIRECTIVE: This artifact contains the human operator's post-hoc reflection on the interaction. Analyze this to establish the operator's self-awareness, critical distance, and theoretical grounding regarding the process. Evaluate if the reflection aligns transparently with the actual events logged in the chat history.",
          "questionnaire_definition": [
            {
              "question_id": "ref1",
              "question": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Mikä oli mielestäsi onnistuneinta tässä vuorovaikutuksessa?",
                  "en": "What do you think was the most successful part of this interaction?"
                }
              },
              "type": "text"
            },
            {
              "question_id": "ref2",
              "question": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Mitä tekisit toisin ensi kerralla?",
                  "en": "What would you do differently next time?"
                }
              },
              "type": "text"
            }
          ]
        }
      ],
