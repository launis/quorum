                                  ?.copyWith(
                                    fontSize: 14,
                                    fontWeight: highlight
                                        ? FontWeight.bold
                                        : FontWeight.w600,
                                    color: highlight
                                        ? Colors.deepPurple[700]
                                        : Theme.of(
                                            context,
                                          ).colorScheme.onSurfaceVariant,
                                  ),
                              overflow: TextOverflow.ellipsis,
                            ),
                          ],
                        ),
                      ),
                    );
                  }).toList(),
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}
