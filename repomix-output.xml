                    input_tokens=int(usage_data["prompt_tokens"]),
                    output_tokens=int(usage_data["completion_tokens"]),
                    cost_usd=usage_data["total_cost"],
                )
            except Exception as e:
                logger.warning("[MockProvider] Usage Tracking Failed: %s", e)

        return LLMResponse(
