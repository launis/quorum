                "translations": {
                  "fi": "Ylituomari",
                  "en": "Supreme Adjudicator"
                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Olet Tuomari (Judge). Tehtäväsi on arvioida aiemmin tuotettu todistusaineisto ja analyysit kokonaisuutena. Anna lopullinen, perusteltu ja puolueeton tuomio.",
                  "en": "Synthesizes multi-agent evaluations into a final verdict."
                }
              },
              "show_text": true,
              "target_blocks": [
                "blk_ff72c2d79edb4ebf"
              ],
              "steps": []
            },
            {
              "preset_view": "text_only",
              "title": {
                "default_locale": "fi",
                "translations": {
                  "fi": "XAI-Raportoija",
                  "en": "XAI Synthesis Reporter"
                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Olet selitettävän tekoälyn raportoija (XAI Reporter). Tehtäväsi on koota kaikkien aiempien analyysivaiheiden löydökset yhdeksi selkeäksi, läpinäkyväksi ja tiiviiksi synteesiksi, joka nostaa esiin tärkeimmät huomiot ja vinoumat.",
                  "en": "Evaluates the transparency and clarity of the decision-making report."
