def test_out_of_order_step_reference_rejected() -> None:
    # step_1 depends on step_2 for variables but doesn't declare the edge
    steps = [
        StepRule(
            id="step_11111111",
            task_blueprint="a",
            depends_on=[],
            input_mappings={"val": "$steps.step_22222222.result"}
        ),
        StepRule(
            id="step_22222222",
            task_blueprint="b",
