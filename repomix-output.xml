                "translations": {
                  "fi": "Performatiivisuus ja Goodhartin Laki",
                  "en": "Performativity & Goodhart's Law"
                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Arvioi mittarin ja tavoitteen vääristymää.",
                  "en": "Evaluates whether the user acts as a driver or a passenger in the interaction."
