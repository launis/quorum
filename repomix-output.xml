                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Valvo syötteitä (Input) ja tulosteita (Output) eettisten jännitteiden, tietoturvan ja asenteellisuuksien varalta",
                  "en": "Evaluates adherence to security and input guardrails."
                }
              },
              "show_text": true,
              "target_blocks": [
                "blk_80732a33fe1947ee"
              ],
              "steps": []
            },
            {
              "preset_view": "text_only",
              "title": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Kausaalinen ja Abduktiivinen Integriteetti",
