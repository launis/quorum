              ],
              "steps": []
            },
            {
              "preset_view": "text_only",
              "title": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Falsifioinnin Auditointi",
                  "en": "Falsification Audit"
                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
