                <div class="gauge-container" style="margin-bottom: 8px;">
                    <div class="gauge-header">
                        <span class="label" style="color: #E65100;">{{ 'FIDELITY_SCORE_LABEL' | translate }}</span>
                        <span class="value" style="color: #EF6C00;">{{ d.fidelity_audit.fidelity_score_display }} / 3.0</span>
                    </div>
                    <div class="gauge-track" style="background: #FFE0B2;">
                        <div class="gauge-bar" style="--percent: {{ d.fidelity_audit.fidelity_percent_display }}; background-color: #FF9800;"></div>
                    </div>
                    <div class="gauge-labels" style="display: flex; justify-content: space-between;">
                         <span>{{ 'WEAK_LABEL' | translate }}</span>
                         <span>{{ 'STRONG_LABEL' | translate }}</span>
                    </div>
                </div>
                {% endif %}

                <div style="display: flex; justify-content: space-between; margin-bottom: 4px; align-items: center;">
                    <span style="font-weight: 700; font-size: 11px; color: #E65100;">
                         {{ d.fidelity_audit.fidelity_label }}
                    </span>
                    <div>
                        <span style="font-size: 10px; margin-right: 4px;">{{ 'POST_HOC_LABEL' | translate }}?</span>
                        {% if d.fidelity_audit.post_hoc_rationalization_suspected %}
                            <span class="chip red">{{ 'DETECTED_LABEL' | translate }}</span>
                        {% else %}
                            <span class="chip green">{{ 'CLEAN_LABEL' | translate }}</span>
                        {% endif %}
                    </div>
                </div>
                <div style="font-size: 10px; color: #BF360C; margin-top: 4px;">{{ d.fidelity_audit.reasoning }}</div>
            </div>
            {% endif %}

            {# Stress Findings #}
            {% if d.findings %}
            <div class="label" style="margin-bottom: 5px;">{{ 'STRESS_FINDINGS_LABEL' | translate }}</div>
            {% for f in d.findings %}
            {# Hoisted Logic: Color class and Text class are pre-calculated #}
            <div style="margin-bottom: 8px; padding-left: 8px; border-left: 3px solid;" class="{{ f.color_class }}">
                <div style="font-weight: 600; font-size: 11px; color: #263238;">{{ f.question }}</div>
                <div style="font-size: 10px; margin-top: 2px;">
                    Result: <span style="font-weight: 700;" class="{{ f.text_class }}">{{ f.result_label | translate }}</span>
                </div>
                <div style="font-size: 10px; color: #546E7A; font-style: italic;">{{ f.observation }}</div>
            </div>
            {% endfor %}
            {% endif %}
        </div>

        {# --- 3. CAUSAL ANALYSIS (Teal/Cyan) --- #}
        {% elif section.id == 'causal-analysis' %}
        <div class="card" style="border-left: 4px solid #00BCD4;">
            <h2 style="color: #00838F;">{{ section.label }}</h2>
            {% set d = section.value %}

            {# Abductive Reasoning Box #}
            {# Falsifier / Stress Test SDUI #}
            {% if d %}
            <div class="box-teal" style="border-color: #80DEEA; background: #E0F7FA;">
                {# Bloom Score Gauge #}
                {% if d.bloom_percent_display is not none and d.bloom_percent_display|string|trim != '' %}
                <div class="gauge-container">
                    <div class="gauge-header">
                        <span class="label" style="color: #00796B;">{{ 'BLOOM_TAXONOMY_LABEL' | translate }}</span>
                        <span class="value" style="color: #00796B;">{{ d.bloom_score }} / 6.0</span>
                    </div>
                    <div class="gauge-track" style="background: #B2DFDB;">
                        <div class="gauge-bar" style="--percent: {{ d.bloom_percent_display }}; background-color: #009688;"></div>
                    </div>
                </div>
                {% endif %}
                {# Abductive Logic Gauge #}
                {% if d.abductive_percent is not none %}
                <div class="gauge-container">
                    <div class="gauge-header">
                        <span class="label" style="color: #006064;">{{ 'ABDUCTIVE_STRENGTH_LABEL' | translate }}</span>
                        <span class="value" style="color: #00838F;">{{ d.abductive_score_display }} / 3.0</span>
                    </div>
                    <div class="gauge-track" style="background: #B2EBF2;">
                        <div class="gauge-bar" style="--percent: {{ d.abductive_percent_display }}; background-color: #00BCD4;"></div>
                    </div>
                    <div class="gauge-labels" style="display: flex; justify-content: space-between;">
                        <span>{{ 'LOW_CAPACITY' | translate }}</span>
                        <span>{{ 'STRONG_LABEL' | translate }}</span>
                    </div>
                </div>
                {% endif %}
                
                {% if d.abductive_conclusion %}
                <div style="font-size: 11px; margin-top: 5px; color: #006064;">
                    <strong>{{ 'CONCLUSION_LABEL' | translate }}:</strong> {{ d.abductive_conclusion | translate }}
                </div>
                {% endif %}
            </div>

            {# Counterfactual Test (Comparison) #}
            <div style="margin-top: 15px;">
                <div class="label" style="margin-bottom: 5px;">{{ 'COUNTERFACTUAL_LABEL' | translate }}</div>
                <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                        <div style="flex: 1; padding: 8px; background: #F5F5F5; border-radius: 4px;">
                            <div style="font-size: 9px; font-weight: 700; text-align: center; color: #616161;">{{ 'ACTUAL_LABEL' | translate }}</div>
                            <div style="font-size: 10px; text-align: center; color: #212121;">{{ d.counterfactual_actual }}</div>
                        </div>
                        <div style="display: flex; align-items: center; color: #00BCD4; font-size: 14px;">➔</div>
                        <div style="flex: 1; padding: 8px; background: #E0F7FA; border-radius: 4px; border: 1px solid #B2EBF2;">
                            <div style="font-size: 9px; font-weight: 700; text-align: center; color: #006064;">{{ 'SIMULATED_LABEL' | translate }}</div>
                            <div style="font-size: 10px; text-align: center; color: #006064;">{{ d.counterfactual_simulated }}</div>
                        </div>
                </div>
                
                {# Plausibility #}
                {% if d.plausibility_percent is not none %}
                <div class="gauge-container">
                    <div class="gauge-header">
                        <span class="label">{{ 'PLAUSIBILITY_LABEL' | translate }}</span>
                        <span class="value">{{ d.plausibility_score_display }} / 3.0</span>
                    </div>
                    <div class="gauge-track">
                            <div class="gauge-bar" style="--percent: {{ d.plausibility_percent_display }}; background-color: #00ACC1;"></div>
                    </div>
                </div>
                {% endif %}
            </div>
            {% endif %}
        </div>

        {# --- 4. PERFORMATIVITY CHECK (Purple) --- #}
        {% elif section.id == 'performativity-check' %}
        <div class="card" style="border-left: 4px solid #9C27B0;">
            <h2 style="color: #6A1B9A;">{{ section.label }}</h2>
            {% set d = section.value %}

            {% if d %}
            <div class="box-purple">
                 {% if d.authenticity_percent is not none %}
                 <div class="gauge-container">
                    <div class="gauge-header">
                        <span class="label" style="color: #4A148C;">{{ 'AUTHENTICITY_SCORE_LABEL' | translate }}</span>
                        <span class="value" style="color: #7B1FA2;">{{ d.authenticity_score_display }} / 3.0</span>
                    </div>
                    <div class="gauge-track" style="background: #E1BEE7;">
                        <div class="gauge-bar" style="--percent: {{ d.authenticity_percent_display }}; background-color: #9C27B0;"></div>
                    </div>
                    <div class="gauge-labels" style="display: flex; justify-content: space-between;">
                        <span>{{ 'PERFORMATIVE_LABEL' | translate }}</span>
                        <span>{{ 'AUTHENTIC_LABEL' | translate }}</span>
                    </div>
                </div>
                {% endif %}
                <div style="text-align: center; font-weight: 700; font-size: 12px; color: #4A148C; margin-top: 5px;">
                    {{ d.authenticity_assessment }}
                </div>
            </div>
            
            {% if d.heuristics %}
            <div class="label" style="margin-bottom: 5px;">{{ 'HEURISTICS_LABEL' | translate }}</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                {% for h in d.heuristics %}
                    <span class="chip {{ h.color }}">{{ h.icon }} {{ h.name }}</span>
                {% endfor %}
            </div>
            {% endif %}
            {% endif %}
        </div>

        {# --- 5. FACTS & ETHICS (Blue) --- #}
        {% elif section.id == 'fact-check-grid' %}
        <div class="card" style="border-left: 4px solid #2196F3;">
            <h2 style="color: #0D47A1;">{{ section.label }}</h2>
            {% set d = section.value %}

            {% if d %}
            <div class="label" style="margin-bottom: 5px;">{{ 'VERIFIED_FACTS_LABEL' | translate }}</div>
            {% for f in d.fact_checks %}
            <div class="timeline-item">
                <div style="margin-right: 8px;">
                    <span class="chip {{ f.color }}">{{ f.label }}</span>
                </div>
                <div>
                     <div style="font-weight: 600;">{{ f.claim }}</div>
                     <div style="color: #666; font-size: 9px;">{{ 'SOURCE_LABEL' | translate }}: {{ f.source }}</div>
                </div>
            </div>
            {% endfor %}

            <div class="label" style="margin-top: 12px; margin-bottom: 5px;">{{ 'ETHICAL_ISSUES_LABEL' | translate }}</div>
            {% for e in d.ethical_issues %}
            <div class="box-orange" style="margin-bottom: 4px; padding: 6px;">
                <div style="display: flex; justify-content: space-between;">
                    <span style="font-weight: 700; color: #E65100;">{{ e.issue }}</span>
                    <span class="chip {{ e.color }}">{{ e.label }}</span>
                </div>
                <div style="font-size: 10px;">{{ e.description }}</div>
            </div>
            {% endfor %}
            {% endif %}
        </div>

            {# --- 5b. SECURITY CHECK & KEY-VALUE GRIDS --- #}
            {% elif section.id == 'security-grid' or section.id == 'usage-stats' or section.type == 'USAGE_STATS' %}
            <div class="card" style="border-left: 4px solid #607D8B;">
                <h2 style="color: #455A64;">{{ section.label }}</h2>
                {% set d = section.value %}

                {% if section.id == 'security-grid' and d and d.get('security_display') %}
                    {% set sec = d.get('security_display') %}
                    {# Hoisted SDUI Display #}
                    <div style="display: flex; gap: 10px; margin-bottom: 12px;">
                        {# Threat Chip #}
                         <div class="chip {{ sec.threat_color }}">
                            {{ sec.threat_label }}
                         </div>
    
                         {# Risk Chip #}
                         <div class="chip {{ sec.risk_color }}">
                            {{ sec.risk_label }}
                         </div>
    
                         {# Anonymized Chip #}
                         <div class="chip {{ sec.anonymized_color }}">
                            {{ sec.anonymized_label }}
                         </div>
                    </div>
    
                    {# Findings #}
                    {% if sec.findings %}
                        <div class="label">{{ sec.findings_label }}</div>
                        <ul style="margin-top: 4px; padding-left: 15px; margin-bottom: 0;">
                            {% for f in sec.findings %}
                            <li style="font-size: 10px; color: #333;">{{ f }}</li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div style="font-size: 10px; color: #777; font-style: italic;">{{ sec.no_findings_label }}</div>
                    {% endif %}
                {% else %}
                    {# Custom Layout for Usage Stats to match UI - Dynamic for Translations #}
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 4px;">
                        {% for item in section.value.get('items', []) %}
                        {% set bg_color = '#F8F9FA' if loop.index <= 2 else '#FFF' %}
                        {% set border_style = 'border: 1px solid #EEEEEE;' if loop.index <= 2 else '' %}
                        {% set is_high = item.get('highlight') %}
                        {% set text_color = '#512DA8' if is_high else '#212121' %}
                        {% set font_weight = '700' if is_high else '600' %}
                        {% set grid_bg_style = "background: " ~ bg_color ~ "; padding: 8px; border-radius: 6px; " ~ border_style %}
                        {% set grid_text_style = "font-size: 10px; font-weight: " ~ font_weight ~ "; color: " ~ text_color ~ "; margin-top: 2px;" %}
                        <!-- Inline style string generated by Jinja -->
                        <div {{ 'style' }}="{{ grid_bg_style }}">
                            <div style="font-size: 8px; color: #757575; font-weight: 700; text-transform: uppercase;">{{ item.get('label') }}</div>
                            <div {{ 'style' }}="{{ grid_text_style }}">{{ item.get('value') }}</div>
                        </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        {# --- 5c. DATA TABLE (Analyst/Generic) --- #}
        {% elif section.id == 'hypotheses-table' %}
        <div class="card" style="border-left: 4px solid #3F51B5;">
            <h2 style="color: #283593;">{{ section.label }}</h2>
            <table>
                <thead>
                    <tr>
                        {% for col in section.value.columns %}
                        <th>{{ col.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in section.value.rows %}
                    <tr>
                        {% for col in section.value.columns %}
                        <td>{{ row[col.key] }}</td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# --- 5d. EVIDENCE LIST --- #}
        {% elif section.id == 'analyst-evidence' %}
        <div class="card" style="border-left: 4px solid #009688;">
            <h2 style="color: #00796B;">{{ section.label }}</h2>
            {% for ev in section.value.get('items', []) %}
            <div style="margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #eee;">
                <div style="font-size: 9px; color: #666; font-weight: 600; margin-bottom: 2px;">
                    {{ ev.type | upper }} | Lähde: {{ ev.source }}
                </div>
                <div style="font-size: 11px; color: #333;">
                    {{ ev.content }}
                </div>
            </div>
            {% endfor %}
            <div style="font-size: 9px; color: #999; text-align: right; margin-top: 4px;">
                Yhteensä löydöksiä: {{ section.value.get('total_count', 0) }}
            </div>
        </div>

        {# --- 6. PROFILER ANALYSIS (Pink) --- #}
        {% elif section.id == 'profiler-analysis' %}
        <div class="card" style="border-left: 4px solid #E91E63;">
            <h2 style="color: #880E4F;">{{ section.label }}</h2>
            {% set d = section.value %}

            {# Control Ratio Gauge #}
            {# Support Multiple Key Paths for pass-through #}
            {# --- TEXT METRICS GRID (Strict SDUI) --- #}
            {% if d %}
                {# Control Ratio #}
                {% if d.control_ratio_percent is not none %}
                <div class="box-pink">
                    <div class="gauge-container">
                        <div class="gauge-header">
                            <span class="label" style="color: #880E4F;">{{ 'CONTROL_RATIO_LABEL' | translate }}</span>
                            <span class="value" style="color: #C2185B;">{{ d.control_ratio_display }} {{ d.control_label }}</span>
                        </div>
                        <div class="gauge-track" style="background: #F8BBD0;">
                            {% if d.control_ratio_display is defined %}
                            <div class="gauge-bar" style="--percent: {{ d.control_ratio_display }}; background-color: #E91E63;"></div>
                            {% endif %}
                        </div>
                        <div class="gauge-labels">
                            <span>{{ 'PASSENGER_LABEL' | translate }}</span>
                            <span>{{ 'DRIVER_LABEL' | translate }}</span>
                        </div>
                    </div>
                </div>
                {% endif %}

            <div class="grid-container" style="margin-bottom: 12px; grid-template-columns: repeat(4, 1fr);">
                <div class="grid-item">
                    <div class="label">{{ 'WORD_COUNT_LABEL' | translate }}</div>
                    <div class="value">{{ d.word_count_display }}</div>
                </div>
                <div class="grid-item">
                     <div class="label">{{ 'AVG_SENTENCE_LABEL' | translate }}</div>
                     <div class="value">{{ d.avg_sentence_length_display }}</div>
                </div>
                <div class="grid-item">
                     <div class="label">{{ 'LEXICAL_DIVERSITY_LABEL' | translate }}</div>
                     <div class="value">{{ d.lexical_diversity_display }}</div>
                </div>
                <div class="grid-item">
                     <div class="label">{{ 'CAPITALS_RATIO_LABEL' | translate }}</div>
                     <div class="value">{{ d.capitalization_ratio_display }}</div>
                </div>
            </div>
            
             <div class="grid-container" style="margin-bottom: 12px; grid-template-columns: repeat(2, 1fr);">
                 <div class="grid-item">
                     <div class="label">{{ 'AUTOMATION_BIAS_LABEL' | translate }}</div>
                     <div class="value">
                        {% if d.automation_bias_color == '#4CAF50' %}
                            <span style="color: #4CAF50;">{{ d.automation_bias_label | translate }}</span>
                        {% elif d.automation_bias_color == '#F44336' %}
                            <span style="color: #F44336;">{{ d.automation_bias_label | translate }}</span>
                        {% else %}
                            <span style="color: #000000;">{{ d.automation_bias_label | translate }}</span>
                        {% endif %}
                     </div>
                 </div>
                 <div class="grid-item">
                     <div class="label">{{ 'SAY_DO_GAP_LABEL' | translate }}</div>
                      <div class="value">
                        {% if d.say_do_gap_color == '#4CAF50' %}
                            <span style="color: #4CAF50;">{{ d.say_do_gap_label | translate }}</span>
                        {% elif d.say_do_gap_color == '#F44336' %}
                            <span style="color: #F44336;">{{ d.say_do_gap_label | translate }}</span>
                        {% else %}
                            <span style="color: #000000;">{{ d.say_do_gap_label | translate }}</span>
                        {% endif %}
                     </div>
                 </div>
            </div>
            {% endif %}

            <div class="grid-container" style="margin-bottom: 12px;">
                 <div class="grid-item">
                     <div class="label">{{ 'PSYCHOLOGICAL_PROFILE_LABEL' | translate }}</div>
                     <div class="value" style="font-size: 11px; font-weight: 400;">{{ d.psychological_profile }}</div>
                 </div>
                 <div class="grid-item">
                     <div class="label">{{ 'INTENT_LABEL' | translate }}</div>
                     <div class="value" style="font-size: 11px; font-weight: 400;">{{ d.intent_analysis }}</div>
                 </div>
            </div>
        </div>

        {# --- 7. ARCHIVIST CHECK (Brown) --- #}
        {% elif section.id == 'archivist-check' %}
        <div class="card" style="border-left: 4px solid #795548;">
            <h2 style="color: #3E2723;">{{ section.label }}</h2>
            {% set d = section.value %}
             <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                 <div>
                     <div class="label">{{ 'COMPLIANCE_SCORE_LABEL' | translate }}</div>
                     {# Domain model says 1.0 - 5.0 #}
                     {% if d.compliance_score is not none %}
                     <div style="font-size: 24px; font-weight: 700; color: #5D4037;">{{ d.compliance_score }} / 5.0</div>
                     {% else %}
                     <div style="font-size: 24px; font-weight: 700; color: #5D4037;">{{ 'N/A' | translate }}</div>
                     {% endif %}
                 </div>
                 <div style="flex: 1; margin-left: 15px; font-size: 11px; color: #4E342E; font-style: italic;">
                     {{ d.compliance_analysis | translate }}
                 </div>
             </div>
             
             <div class="label">{{ 'RECOMMENDATIONS_LABEL' | translate }}</div>
             <ul>
                 {% if d.recommendations %}
                 {% for rec in d.recommendations %}
                 <li style="font-size: 10px; margin-bottom: 2px;">{{ rec }}</li>
                 {% endfor %}
                 {% else %}
                 <li style="font-size: 10px; margin-bottom: 2px; color: #999;">{{ 'NO_RECOMMENDATIONS_LABEL' | translate }}</li>
                 {% endif %}
             </ul>
        </div>

        {# --- 8. DRIVER PROFILE (Interaction) --- #}
        {% elif section.id == 'interaction-grid' %}
        <div class="card" style="border-left: 4px solid #2196F3;">
            <h2 style="color: #1565C0;">{{ section.label }}</h2>
            {% set d = section.value %}
            
            <div style="margin: 20px 0; position: relative;">
                <!-- Gray track line -->
                <div style="position: absolute; top: 12px; left: 10%; right: 10%; height: 4px; background-color: #E0E0E0; z-index: 1;"></div>
                
                <div style="display: flex; justify-content: space-between; position: relative; z-index: 2;">
                    {% set roles = [
                        ('ROLE_PASSENGER', 'ROLE_PASSENGER'),
                        ('ROLE_NAVIGATOR', 'ROLE_NAVIGATOR'), 
                        ('ROLE_DRIVER', 'ROLE_DRIVER'), 
                        ('ROLE_ARCHITECT', 'ROLE_ARCHITECT')
                    ] %}
                    
                    {% for role_val, role_label in roles %}
                    {% set active = (d.role_classification == role_val) %}
                    {% set role_bg = '#2196F3' if active else '#E0E0E0' %}
                    {% set role_border = '#1565C0' if active else '#BDBDBD' %}
                    {% set role_text = '#1565C0' if active else '#757575' %}
                    {% set role_weight = 'bold' if active else 'normal' %}
                    {% set role_icon_style = "width: 24px; height: 24px; background-color: " ~ role_bg ~ "; border-radius: 50%; margin: 0 auto 8px auto; border: 3px solid #FFF; box-shadow: 0 0 0 1px " ~ role_border ~ ";" %}
                    {% set role_font_style = "font-size: 10px; font-weight: " ~ role_weight ~ "; color: " ~ role_text ~ ";" %}
                    
                    <!-- Dynamic inline bindings with Jinja -->
                    <div style="text-align: center; width: 25%;">
                        <div {{ 'style' }}="{{ role_icon_style }}"></div>
                        <div {{ 'style' }}="{{ role_font_style }}">
                            {{ role_label | translate }}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="grid-container" style="margin-top: 15px;">
                 <div class="grid-item">
                     <div class="label">{{ 'CONTROL_RATIO_LABEL' | translate }}</div>
                     <div class="value" style="font-size: 14px; color: #1565C0;">
                        {{ d.input_control_ratio_display | default('N/A') }}
                     </div>
                 </div>
                 <div class="grid-item">
                     <div class="label">Suoria käskyjä (Imperative)</div>
                     <div class="value">{{ d.imperative_command_count }}</div>
                 </div>
            </div>

            {% if d.strategy %}
            <div class="label" style="margin-top: 10px;">{{ 'STRATEGIES_LABEL' | translate }}</div>
            <div class="strategy-box">{{ d.strategy }}</div>
            {% endif %}
        </div>

        {# --- OTHER: TIMELINE --- #}
        {% elif section.id == 'unified-timeline' %}
        <div class="card" style="border-left: 4px solid #9E9E9E;">
            <h2>{{ section.label }}</h2>
            {% for event in section.value.get('events', []) %}
            <div class="timeline-item">
                <div class="timestamp">{{ event.timestamp[11:19] if event.timestamp|length > 18 else event.timestamp }}</div>
                <div class="content">
                    <div class="actor">{{ event.actor }}</div>
                    <div>{{ event.message }}</div>
                </div>
            </div>
            {% endfor %}
        </div>

        {# --- SCORE CARD --- #}
        {% elif section.type == 'CARD' %}
        <div class="card" style="padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <h2 style="color: #039BE5; border-bottom: none; margin-top: 0; padding-bottom: 0;">{{ section.label }}</h2>
                <div style="background-color: #D1C4E9; border-radius: 50%; min-width: 48px; height: 48px; padding: 4px; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 2px solid #512DA8;">
                    <div style="font-size: 15px; font-weight: 700; color: #000; text-align: center; margin-top: 4px;">
                        {% set ts = section.value.get('total_score_display', '0') %}
                        {% if ts is not none and ts|string|trim != '' %}
                            {{ ts }}
                        {% else %}
                            0
                        {% endif %}
                    </div>
                    <div style="font-size: 6px; color: #555; text-align: center; line-height: 1;">
                        (Asteikko:<br/>{{ section.value.get('max_score', '100') }})
                    </div>
                </div>
            </div>
            
            {% if section.value.get('chart_image') %}
            <div style="text-align: center; margin-top: -15px; margin-bottom: 20px;">
                <img src="{{ section.value.get('chart_image') }}" style="max-width: 100%; max-height: 220px; object-fit: contain;" alt="Radar Chart"/>
            </div>
            {% endif %}

            <h3 style="margin-top: 10px; margin-bottom: 10px; font-size: 11px; color: #333; font-weight: 700;">Tarkempi erittely</h3>
            <div style="display: flex; flex-direction: column; gap: 8px;">
            {% for dim in section.value.get('dimensions', []) %}
                <div style="background-color: #FAFAFA; border: 1px solid #E0E0E0; border-radius: 6px; padding: 12px; display: flex; align-items: flex-start; gap: 15px;">
                    <div style="background-color: #E1BEE7; border-radius: 50%; width: 34px; height: 34px; min-width: 34px; display: flex; justify-content: center; align-items: center; margin-top: 2px;">
                        <span style="font-size: 13px; font-weight: 700; color: #311B92;">
                            {% set ds = dim.get('score_display', '0') %}
                            {% if ds is not none and ds|string|trim != '' %}
                                {{ ds }}
                            {% else %}
                                0
                            {% endif %}
                        </span>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 10px; font-weight: 700; color: #212121; margin-bottom: 4px;">{{ dim.get('dimension_label') or dim.get('label') }}</div>
                        <div style="font-size: 10px; color: #616161; line-height: 1.4;">{{ dim.get('reasoning') }}</div>
                    </div>
                </div>
            {% endfor %}
            </div>
        </div>

        {# --- CRITICAL FINDINGS --- #}
        {% elif section.id == 'critical-findings' %}
        <div class="card" style="border-left: 4px solid #F44336; background-color: #FFEBEE;">
            <h2 style="color: #C62828;">{{ section.label }}</h2>
            <ul style="padding-left: 20px; color: #B71C1C;">
                {% for finding in section.value.get('findings', []) %}
                <li style="margin-bottom: 5px; font-weight: 600;">{{ finding }}</li>
                {% endfor %}
            </ul>
        </div>

        {# --- CONTEXT / KNOWLEDGE BASE --- #}
        {% elif section.id == 'context-display' %}
        <div class="card" style="border-left: 4px solid #8D6E63;">
            <h2 style="color: #4E342E;">{{ section.label }}</h2>
            {% for item in section.value.get('items', []) %}
            <div style="margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #D7CCC8;">
                <div style="font-size: 9px; color: #795548; font-weight: 600; margin-bottom: 2px;">
                    Lähde: {{ item.source }}
                </div>
                <div style="font-size: 11px; color: #3E2723;">
                    {{ item.content }}
                </div>
            </div>
            {% endfor %}
        </div>

        {# --- XAI SUMMARY --- #}
        {% elif section.id == 'xai-summary' %}
        <div class="card" style="border-left: 4px solid #673AB7; background-color: #EDE7F6;">
            <h2 style="color: #4527A0;">{{ section.label }}</h2>
            <div style="font-family: inherit; font-size: 11px; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; color: #311B92;">{{ section.value.get('content', '') }}</div>
        </div>

        {# --- COACH FEEDBACK BLOCK --- #}
        {% elif section.id == 'coach-markdown' %}
        <div class="card" style="background: linear-gradient(135deg, #E8F5E9, #E0F2F1); border: 2px solid #A5D6A7; padding: 20px;">
            <div style="display: flex; align-items: center; margin-bottom: 15px;">
                <div style="background-color: #43A047; border-radius: 50%; width: 24px; height: 24px; display: inline-flex; justify-content: center; align-items: center; color: white; margin-right: 12px; font-weight: bold; font-family: sans-serif; font-size: 14px;">🧠</div>
                <h2 style="color: #1B5E20; margin: 0; border: none; padding: 0;">{{ section.label if section.label else 'Ohjaajan Palaute' }}</h2>
            </div>
            <div style="background-color: #FFFFFF; border: 1px solid #C8E6C9; border-radius: 8px; padding: 16px; font-family: inherit; font-size: 11px; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; color: #1B5E20;">{{ section.value.get('content', '') }}</div>
        </div>

        {# --- MARKDOWN BLOCK (GENERIC) --- #}
        {% elif section.type == 'MARKDOWN_BLOCK' %}
        <div class="card">
            <h2>{{ section.label }}</h2>
            <div style="font-family: inherit; font-size: 11px; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; max-width: 100%;">{{ section.value.get('content', '') }}</div>
        </div>

        {# --- GENERIC FALLBACK --- #}
        {% else %}
        {% if section.id != 'context-items' %}
        <div class="card">
            <h2>{{ section.label }}</h2>
            <pre style="font-size: 9px; overflow: hidden;">{{ section.value | tojson(indent=2) }}</pre>
        </div>
        {% endif %}
        {% endif %}
        
    </div>
    {% endfor %}

</body>
</html>
</file>

