              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: NULL HYPOTHESIS APPLIED. Catastrophic failure. The output makes absolute, unqualified assertions without any acknowledgment of limitations. Presents probabilistic information as incontrovertible fact."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Rajoitteita tai epävarmuuksia ei ole tunnistettu.",
                  "en": "Limitations or uncertainties have not been identified."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The text completely ignores its own cognitive boundaries, acting as a blind, unreflective generator. Zero evidence of self-correction."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Vaihtoehtoiset näkökulmat sivuutetaan täysin.",
                  "en": "Alternative perspectives are completely ignored."
                }
              },
              "ai_description": "ENFORCEMENT RULE: SEVERE HUBRIS PENALTY. Falsify immediately if the text asserts a singular narrative while aggressively ignoring established alternative views or contradictory data."
            }
          ],
          "ai_label": "UNACCEPTABLE HUBRIS"
        },
        {
          "score": 2,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Heikko",
              "en": "Weak"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Teksti käyttää performatiivista epävarmuutta.",
                  "en": "The text uses performative uncertainty."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The output exhibits superficial hedging ('it may be that...', 'some might say...') while still aggressively implying certainty."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Kritiikille jätetään vain marginaalinen sija.",
