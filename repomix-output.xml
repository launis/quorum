<file path="backend_v2/templates/report_template.jinja2">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Execution Report</title>
    <style>
        @page {
            size: A4;
            margin: 1.5cm;
            @bottom-center {
                content: "Page " counter(page) " of " counter(pages);
                font-family: 'Inter', sans-serif;
                font-size: 9px;
                color: #888;
            }
        }
        body {
            font-family: 'Inter', sans-serif;
            color: #2c3e50;
            line-height: 1.4;
            font-size: 11px;
            background-color: #fff;
        }
        h1, h2, h3, h4 { color: #2c3e50; margin-top: 0; }
        h1 { font-size: 22px; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; text-align: center; color: #1a237e; }
        h2 { font-size: 16px; border-bottom: 2px solid #eee; padding-bottom: 8px; margin-top: 15px; margin-bottom: 12px; font-weight: 700; }
        
        .header-card {
            border: 2px solid #4CAF50;
            text-align: center;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 12px;
            background-color: #f8f9fa;
            page-break-inside: avoid;
        }

        .card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            background-color: #fff;
            page-break-inside: avoid;
        }

        .justify-box {
            background-color: #f8fbff;
            border-left: 4px solid #2196F3;
            padding: 14px;
            margin-top: 10px;
            border-radius: 4px;
        }
        .value-box {
            font-size: 24px;
            color: #1E88E5;
            font-weight: bold;
        }
    </style>
</head>
<body>

    {% if report_data %}
        <div class="header-card" style="text-align: left;">
            <h1 style="margin: 0 0 10px 0;">{{ workflow_name }} {% if report_data %}({{ report_data.profile_id }}){% endif %}</h1>
            
            <div style="font-size: 12px; color: #444; margin-bottom: 12px;">
                <strong>Konteksti:</strong> {% if report_data and report_data.org_name %}{{ report_data.org_name }}{% else %}Tuntematon organisaatio{% endif %}<br>
                <strong>Aikaleima:</strong> {% if report_data and report_data.created_at %}{{ report_data.created_at }}{% else %}{{ printed_at }}{% endif %}<br>
                <div style="font-size: 10px; color: #888; margin-top: 4px;">ID: {{ execution_id }} &bull; Tulostettu: {{ printed_at }}</div>
            </div>

            <table style="width: 100%; border-top: 1px solid #ccc; padding-top: 10px;">
                <tr>
                    <td style="width: 50%; vertical-align: top; text-align: left;">
                        <strong style="font-size: 12px;">Kustannukset</strong><br>
                        <span style="font-size: 11px;">API-hinta: {% if report_data and report_data.cost_estimate != None %}${{ "%.4f"|format(report_data.cost_estimate) }}{% else %}-{% endif %}</span>
                    </td>
                    <td style="width: 50%; vertical-align: top; text-align: left;">
                        <strong style="font-size: 12px;">Kognitiivinen työ (Tokens)</strong><br>
                        <span style="font-size: 11px;">
                            Prompt: {% if report_data and report_data.prompt_tokens != None %}{{ report_data.prompt_tokens }}{% else %}-{% endif %}<br>
                            Completion: {% if report_data and report_data.completion_tokens != None %}{{ report_data.completion_tokens }}{% else %}-{% endif %}<br>
                            Reasoning: {% if report_data and report_data.reasoning_tokens != None %}{{ report_data.reasoning_tokens }}{% else %}-{% endif %}
                        </span>
                    </td>
                </tr>
            </table>
        </div>

        {% if report_data and report_data.global_score != None %}
            <div style="background-color: #E8F5E9; border: 2px solid #4CAF50; border-radius: 8px; padding: 15px; margin-bottom: 20px; text-align: center; page-break-inside: avoid;">
                <strong style="color: #2E7D32; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Kokonaispisteet</strong><br>
                <div style="margin-top: 5px;">
                    <span style="font-size: 36px; font-weight: 800; color: #1B5E20;">{{ "%.1f"|format(report_data.global_score) }}</span>
                    <span style="font-size: 18px; color: #4CAF50; font-weight: 600;">/ 100</span>
                </div>
            </div>
        {% endif %}

        {% set ns = namespace(seen_quotes=[]) %}
        {% for layout in report_data.layouts %}
            {% set layout_title_label = layout.title.get('fi', layout.title.get('en', 'Arviointi')) if layout.title else ('Automaattinen' if layout.preset_view == 'default' else layout.preset_view) %}
            <h2 style="margin-top: 20px; color: #004D40; border-bottom: 2px solid #4CAF50; padding-bottom: 5px;">{{ layout_title_label }}</h2>
            
            {% if layout.description %}
                {% set layout_desc_label = layout.description.get('fi', layout.description.get('en', '')) %}
                {% if layout_desc_label %}
                    <div style="font-size: 12px; color: #555; margin-bottom: 15px; font-style: italic;">{{ layout_desc_label }}</div>
                {% endif %}
            {% endif %}

            {% if charts and loop.index0 in charts %}
                <div style="text-align: center; margin: 20px 0;">
                    <img src="data:image/png;base64,{{ charts[loop.index0] }}" style="max-width: 100%; height: auto; border: 1px solid #eee; border-radius: 8px;" />
                </div>
            {% endif %}
            
            {% for axis in layout.axes %}
                <div class="card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                        <h3 style="margin: 0; color: #1a1a1a; font-size: 16px;">{{ axis.name }}</h3>
                        {% if axis.score != None %}
                        <div style="background-color: #e3f2fd; color: #1976D2; padding: 4px 12px; border-radius: 12px; font-weight: bold; font-size: 14px;">
                            {{ "%.1f"|format(axis.score) }} {% if axis.scale_max > axis.scale_min %}/ {{ "%.1f"|format(axis.scale_max) }}{% endif %}
                        </div>
                        {% endif %}
                    </div>
                    
                    {% if axis.description %}
                        <div style="font-size: 12px; color: #666; font-style: italic; margin-bottom: 8px;">{{ axis.description }}</div>
                    {% endif %}
                    
                    {% if axis.justification and layout.show_text %}
                        <div style="font-size: 13px; line-height: 1.5; color: #333; margin-top: 8px;">
                            {{ axis.justification | md | safe }}
                        </div>

                        {% if axis.confidence %}
                            <div style="font-size: 12px; font-weight: bold; color: #1976D2; margin-top: 8px;">
                                Tekoälyn varmuus: {{ axis.confidence }}%
                            </div>
                        {% endif %}

                        {% if axis.emotional_sentiment %}
                            <div style="font-size: 12px; color: #e91e63; font-style: italic; margin-top: 6px;">
                                ⚡ Emotionaalinen Sävy: {{ axis.emotional_sentiment }}
                            </div>
                        {% endif %}

                        {% if axis.theory_link %}
                            <div style="font-size: 12px; color: #1976d2; margin-top: 6px;">
                                📚 Teoreettinen Yhteys: {{ axis.theory_link }}
                            </div>
                        {% endif %}

                        {% if axis.risk_flag %}
                            <div style="background-color: #ffebee; border: 1px solid #ffcdd2; padding: 6px 10px; margin-top: 8px; border-radius: 4px; display: inline-block;">
                                <strong style="color: #d32f2f; font-size: 11px;">⚠️ Vakava Riski Havaittu</strong>
                            </div>
                        {% endif %}

                        {% if axis.coaching %}
                            <div style="background-color: #fff8e1; border-left: 4px solid #ffb300; padding: 10px; margin-top: 10px;">
                                <strong style="color: #f57f17; font-size: 11px;">💡 Arjen Vinkki:</strong><br>
                                <div style="font-size: 12px; color: #333; margin-top: 4px;">{{ axis.coaching | md | safe }}</div>
                            </div>
                        {% endif %}

                        {% if axis.falsification %}
                            <div style="background-color: #f3e5f5; border-left: 4px solid #ab47bc; padding: 10px; margin-top: 10px;">
                                <strong style="color: #7b1fa2; font-size: 11px;">⚖️ Vasta-argumentti:</strong><br>
                                <div style="font-size: 12px; color: #333; font-style: italic; margin-top: 4px;">{{ axis.falsification | md | safe }}</div>
                            </div>
                        {% endif %}

                        {% if axis.missing_context %}
                            <div style="background-color: #f5f5f5; border-left: 4px solid #9e9e9e; padding: 10px; margin-top: 10px;">
                                <strong style="color: #616161; font-size: 11px;">🔍 Puuttuva Konteksti:</strong><br>
                                <div style="font-size: 12px; color: #333; margin-top: 4px;">{{ axis.missing_context | md | safe }}</div>
                            </div>
                        {% endif %}

                        {% if axis.remediation_steps %}
                            <div style="background-color: #e0f2f1; border-left: 4px solid #009688; padding: 10px; margin-top: 10px;">
                                <strong style="color: #00796b; font-size: 11px;">🛠️ Korjaavat Toimenpiteet:</strong>
                                <ul style="margin: 4px 0 0 0; padding-left: 20px; font-size: 12px; color: #333;">
                                {% for step in axis.remediation_steps %}
                                    <li style="margin-bottom: 2px;">{{ step }}</li>
                                {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if axis.cited_text_quote %}
                            {% set norm_quote = axis.cited_text_quote|lower|trim %}
                            {% if norm_quote not in ns.seen_quotes %}
                                <div style="background-color: #f5f5f5; border-left: 3px solid #ccc; padding: 10px; margin-top: 10px; font-style: italic; font-size: 12px; color: #555; page-break-inside: avoid;">
                                    💬 <em>Ote alkuperäisestä tekstistä:</em><br>
                                    <div style="margin-top: 4px;">{{ axis.cited_text_quote | md | safe }}</div>
                                </div>
                                {% set _ = ns.seen_quotes.append(norm_quote) %}
                            {% endif %}
                        {% endif %}

                        {% if axis.cited_source_id %}
                            <div style="margin-top: 8px; font-size: 10px; color: #607d8b; font-weight: bold;">
                                ⚖️ Viitekehys: {{ axis.cited_source_id }}
                            </div>
                        {% endif %}

                        {% if axis.cited_web_citation %}
                            <div style="background-color: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 6px; padding: 8px 12px; margin-top: 8px; display: inline-block;">
                                <span style="color: #4CAF50; font-weight: 500; font-size: 10px;">✅ Tarkistettu Googlen lähteistä:</span><br>
                                <span style="color: #4CAF50; font-size: 10px;">{{ axis.cited_web_citation }}</span>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            {% endfor %}
        {% endfor %}

        {% if report_data.synthesis %}
        <div class="card" style="border-top: 3px solid #9C27B0;">
            <h2 style="color: #9C27B0;">Synthesis</h2>
            <div style="font-size: 13px; line-height: 1.6; color: #333;">{{ report_data.synthesis | md | safe }}</div>
        </div>
        {% endif %}

        {% if report_data.mcp_tool_audit %}
        <div class="card" style="border-top: 3px solid #009688;">
            <h2 style="color: #00796b;">Tekoälyn Asiantuntijalähteet (Faktantarkistus)</h2>
            {% for audit in report_data.mcp_tool_audit %}
            <div style="background-color: #f7f9f9; border: 1px solid #e0e0e0; border-radius: 6px; padding: 12px; margin-bottom: 15px;">
                <div style="font-size: 13px; font-weight: bold; color: #333; margin-bottom: 6px;">
                    <span style="font-size: 11px; float: right; font-weight: normal; color: #888; background-color: #eee; padding: 2px 6px; border-radius: 10px;">Kesto: {{ audit.duration_ms }}ms</span>
                    <span style="font-family: monospace; font-size: 10px; background-color: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; border-radius: 4px; padding: 2px 6px; margin-right: 6px;">{{ audit.tool_id }}</span>
                    🔍 Hakukysely: "{{ audit.query }}"
                </div>
                <div style="font-size: 12px; color: #555; margin-bottom: 10px; line-height: 1.5; clear: both;">
                    {{ audit.response_summary | md | safe }}
                </div>
                {% if audit.source_urls %}
                <div style="font-size: 11px; font-weight: bold; color: #009688; margin-bottom: 4px;">Lähteet</div>
                <div style="display: flex; flex-wrap: wrap; gap: 6px; clear: both;">
                    {% for url in audit.source_urls %}
                    <div style="background-color: #e3f2fd; border: 1px solid #bbdefb; color: #1976D2; padding: 4px 8px; border-radius: 4px; font-size: 10px; text-decoration: none; word-break: break-all; display: inline-block;">
                        🔗 {{ url }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        
    {% else %}
        <div class="card" style="border-left: 4px solid #F44336; background-color: #ffebee;">
            <h2 style="color: #c62828;">V2 ARCHITECTURE VIOLATION</h2>
            <p style="font-size: 12px; color: #b71c1c;">
                <strong>FAIL-FAST MANDATE:</strong> This execution lacks explicit ReportDataDTO mapping securely populated from backend APIs.
            </p>
        </div>
    {% endif %}

</body>
</html>
</file>

