                "translations": {
                  "fi": "Syötteiden Prosessointi",
                  "en": "Input Processing"
                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Tehtäväsi on käsitellä raakatiedot ja syötteet (Input Processing). Poista kohina, jäsennä olennaiset väitteet ja valmistele data selkeään, analysoitavaan formaattiin seuraavia vaiheita varten.",
                  "en": "Evaluates how thoroughly the user analyzes provided inputs."
                }
              },
              "show_text": true,
              "target_blocks": [
                "blk_599645bd5baf44e2"
              ],
              "steps": []
            },
            {
              "preset_view": "text_only",
              "title": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Arkistointistandardien Auditointi",
                  "en": "Archival Compliance Audit"
                }
              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Tehtäväsi on peilata tekoälyn toimintaa organisaation aikaisempiin (Precedent) linjauksiin ja ohjeisiin.",
                  "en": "Evaluates compliance with organizational standards and precedent."
                }
              },
              "show_text": true,
              "target_blocks": [
