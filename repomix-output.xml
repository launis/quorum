            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Itsereflektio puuttuu.",
                  "en": "Self-reflection is missing."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: It critically lacks proactive self-reflection. It fails to explicitly articulate its own limitations, forcing the user to infer them."
