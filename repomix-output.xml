  "prompt_blocks": [
    {
      "id": "blk_440a5fef9331451b",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "Toulminin Argumentaatiomalli",
          "en": "Toulmin Argumentation Model"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Arvioi argumentin laatua ja sen rakenteellisia osia Toulminin mallin mukaisesti.",
          "en": "Evaluates the quality and structural components of an argument using the Toulmin model."
        }
      },
      "category_id": "matrix",
      "type": "float",
      "allow_decimals": true,
      "theory_grounding": {
        "source_url": "https://doi.org/10.1017/CBO9780511802034",
        "citation_reference": "Toulmin, Stephen E. 2003. The uses of argument."
      },
      "scales": [
        {
          "score": 1,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Heikko",
              "en": "Weak"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Väite on vailla perusteita.",
                  "en": "The claim is completely unfounded."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: NULL HYPOTHESIS APPLIED. Assume the claim is hallucinated or unsubstantiated. ENFORCEMENT RULE: Assign this score immediately if the core claim lacks explicit foundation."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Data puuttuu.",
                  "en": "Data is missing."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: Active falsification triggered. The author asserts a position but fails to provide any explicit empirical or textual Data."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Oikeutus (warrant) puuttuu.",
                  "en": "Warrant is missing."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The logical bridge (Warrant) is entirely absent. Apply this when the text relies purely on declaratory statements without underlying structural support."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Esittää olettamuksia absoluuttisina faktoina.",
                  "en": "Presents assumptions as absolute facts."
                }
              },
              "ai_description": "ENFORCEMENT RULE: SEVERE HUBRIS PENALTY. Falsify the text if it presents subjective views, probabilities, or AI-hallucinated assumptions as absolute 100% facts without any evidence or source criticism."
            }
          ],
          "ai_label": "CATASTROPHIC FAILURE - TRIGGER PASSIVITY PENALTY AND HUBRIS PENALTY"
        },
        {
          "score": 2,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Välttävä",
              "en": "Poor"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Väitteen tueksi esitetty data on irrelevanttia.",
                  "en": "The data provided to support the claim is irrelevant."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: Explicit Data is presented, but upon adversarial scrutiny, it is factually disconnected or completely disjointed from the original Claim."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Väitteen tueksi esitetty data on riittämätöntä.",
                  "en": "The data provided to support the claim is insufficient."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: Data exists but is objectively too weak or narrow to bear the weight of the Claim. Do not give the benefit of the doubt."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Looginen silta (warrant) on irrallinen datasta.",
                  "en": "The logical bridge (warrant) is disconnected from the data."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: A Warrant is vaguely stated, but it fails to logically map the specific Data to the Claim. ENFORCEMENT RULE: Drop to this score if the logical bridge is broken."
            }
          ],
          "ai_label": "FUNDAMENTALLY FLAWED - DISCONNECTED LOGIC"
        },
        {
          "score": 3,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Kohtalainen",
              "en": "Fair"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Oikeutus (warrant) on hatara.",
                  "en": "The warrant is flimsy."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The argument presents a Claim and Data, but the Warrant is implicit, weak, or fallacious. The connection is tenuous and fails under strict adversarial scrutiny."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Vastaväitteitä (rebuttal) ei ole huomioitu.",
                  "en": "Rebuttals have not been considered."
                }
              },
              "ai_description": "ENFORCEMENT RULE: ONE-SIDED ARGUMENT DETECTED. The author presents an argument without acknowledging obvious limitations, alternative models, or counter-viewpoints. Penalize intellectual laziness; this completely blocks progression to upper scales."
            }
          ],
          "ai_label": "STRUCTURALLY DEFICIENT - LACKS REBUTTALS"
        },
        {
          "score": 4,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Hyvä",
              "en": "Good"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Looginen silta (warrant) on kestävä.",
                  "en": "The logical bridge (warrant) is robust."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The Warrant is explicitly articulated and forms a valid, robust logical bridge capable of withstanding basic adversarial checks."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Looginen silta kytkee datan eksplisiittisesti väitteeseen.",
                  "en": "The logical bridge connects the data explicitly to the claim."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The connection is not left to the reader's interpretation. It is actively and clearly mapped out by the author."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Taustaoletuksia ja poikkeuksia on käsitelty.",
                  "en": "Underlying assumptions and exceptions have been discussed."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The author demonstrates epistemological awareness by explicitly stating the boundary conditions and exceptions of their argument."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Epävarmuudet on tunnistettu avoimesti.",
                  "en": "Uncertainties are acknowledged openly."
                }
              },
              "ai_description": "ENFORCEMENT RULE: EPISTEMOLOGICAL HUMILITY. You must verify that the author points out the probabilistic nature of the data. If probabilistic data is presented as absolute 100% truth, downgrade immediately."
            }
          ],
          "ai_label": "LOGICALLY SOUND - REQUIRES EPISTEMOLOGICAL HUMILITY"
        },
        {
          "score": 5,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Erinomainen",
              "en": "Excellent"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Väite on vahvasti perusteltu asiantuntijadatalla.",
                  "en": "The claim is strongly justified with expert data."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: ABSOLUTE ZERO-TRUST. Flawless execution is merely the baseline here. The data must be irrefutable, highly relevant, and expertly integrated."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Oikeutus (warrant) on aukoton.",
                  "en": "The warrant is watertight."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The explicit logical bridge seamlessly maps the Data to the Claim without any logical leaps or fallacies, surviving maximum adversarial scrutiny."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Argumentti on ankkuroitu ekspliittisesti ulkoisiin asiantuntijalähteisiin.",
                  "en": "The argument is explicitly anchored to external expert sources."
                }
              },
              "ai_description": "ENFORCEMENT RULE: MANDATORY SOURCE ANCHORING. A perfect logical structure without demonstrable anchoring in cited external literature or concrete expert references is inherently suspicious. Missing this nullifies the highest score."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Mahdolliset vastaväitteet on kumottu asiantuntevasti.",
                  "en": "Potential counterarguments have been expertly refuted."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The author acts as their own prosecutor, actively anticipating, articulating, and expertly dismantling opposing views and rebuttals."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Päätöksentekoprosessi ja kognitiivinen kitka on dokumentoitu.",
                  "en": "The decision-making process and cognitive friction are documented."
                }
              },
              "ai_description": "ENFORCEMENT RULE: SYSTEM 2 REQUIREMENT. The text MUST explicitly articulate 'how' and 'why' the conclusion was reached. It must show the slow, deliberate work of reasoning. Mere correct synthesis without documented cognitive friction fails this condition."
            }
          ],
          "ai_label": "THEORETICALLY PERFECT - EXPLICIT COGNITIVE FRICTION AND ANCHORING REQUIRED"
        }
      ],
      "rows": [
        {
          "label": {
            "default_locale": "fi",
            "translations": {
              "fi": "Argumentaation laatu",
              "en": "Quality of Argumentation"
            }
          },
          "ai_description": "CRITICAL MANDATE: THE DEFAULT SCORE IS 1. You are strictly forbidden from granting a score higher than 1 unless you can extract direct, irrefutable, and explicit textual quotes that satisfy every single condition of the higher tiers. Passive or implicit logic results in an automatic score of 1."
        }
      ],
      "scale_min": 1,
      "scale_max": 5,
      "ai_description": "ROLE: ANTAGONISTIC PROSECUTOR (ZERO-TRUST). TASK: Your primary objective is to falsify and demolish the provided argument using the Toulmin Model. NULL HYPOTHESIS: Assume the argument is intellectually lazy, hallucinated, or a product of automated generation without true human System 2 reasoning. You must actively search for logical contradictions, missing warrants, and unaddressed rebuttals. Do NOT give the benefit of the doubt. If the explicit logical bridge (Warrant) is not articulated clearly in the text, the argument fails.",
      "slug": "matrix_toulmin",
      "output_extensions": [
        "citation",
        "justification",
        "falsification",
        "theory_link"
      ]
    },
    {
      "id": "blk_f921c7c0989b47e8",
      "label": {
        "default_locale": "fi",
        "translations": {
