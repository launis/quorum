    container_name: quorum-backend
    ports:
      - "8000:8000"
    environment:
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      # Production Configuration (Vertex AI + Firestore)
      - USE_MOCK_LLM=false
      - USE_MOCK_DB=false
      - STORAGE_BACKEND=FIRESTORE
      - STORAGE_BUCKET_NAME=cognitive-quorum.firebasestorage.app
      - USE_VERTEX_LLM=true
      - VERTEX_LOCATION=europe-north1
      - GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
      - GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
      # Allow local override via .env if needed, but defaults above are safer for container logic
    env_file:
      - .env
    volumes:
      - ./backend:/app/backend
      - ./data:/app/data
      - ./service-account.json:/app/service-account.json
    networks:
      - quorum-net

  worker:
    build: ./backend
    container_name: quorum-worker
    command: python -m backend.run_worker
    environment:
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - USE_MOCK_LLM=false
      - USE_MOCK_DB=false
      - STORAGE_BACKEND=FIRESTORE
      - STORAGE_BUCKET_NAME=cognitive-quorum.appspot.com
      - USE_VERTEX_LLM=true
      - VERTEX_LOCATION=europe-north1
      - VERTEX_LOCATION=europe-north1
      - GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
    env_file:
      - .env
    volumes:
      - ./backend:/app/backend
      - ./data:/app/data
      - ./service-account.json:/app/service-account.json
    depends_on:
      - redis
      - backend
    networks:
      - quorum-net

  redis:
    image: redis:alpine
    ports:
      - "6379:6379"
    networks:
      - quorum-net

  frontend:
    build: ./client_app
    container_name: quorum-frontend
    ports:
      - "8080:80"
    depends_on:
      - backend
    networks:
      - quorum-net

networks:
  quorum-net:
    driver: bridge
</file>

