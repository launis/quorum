              },
              "description": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Arvioi ajattelun hitautta tai nopeutta (System 1 vs System 2).",
                  "en": "Evaluates the speed and depth of cognitive processing using System 1/System 2."
