      "category_id": "matrix",
      "type": "float",
      "allow_decimals": true,
      "theory_grounding": {
        "source_url": "https://www.jstor.org/stable/j.ctt1v2xv4",
        "citation_reference": "Anderson, Lorin W. & Krathwohl, David R. (toim.) 2001."
      },
      "scales": [
        {
          "score": 1,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Muistaminen",
              "en": "Remembering"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Teksti ainoastaan toistaa annettua tietoa.",
                  "en": "The text merely repeats given information."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: NULL HYPOTHESIS APPLIED. The response consists solely of regurgitated, unanalyzed data or verbatim text. There is zero evidence of comprehension. ENFORCEMENT RULE: Assign this score immediately if the output is purely mechanical retrieval."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Ymmärrystä ei ole eksplisiittisesti osoitettu.",
                  "en": "Understanding is not explicitly demonstrated."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: Active falsification triggered. The text lacks any contextual framing or interpretation that would prove the author understands what they are saying."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Tieto esitetään absoluuttisena faktana ilman lähdekritiikkiä.",
                  "en": "Information is presented as absolute fact without source criticism."
                }
              },
              "ai_description": "ENFORCEMENT RULE: SEVERE HUBRIS PENALTY. Falsify the text if it presents regurgitated statements, AI hallucinations, or basic assumptions as absolute 100% facts without any epistemological humility or critical reflection."
            }
          ],
          "ai_label": "CATASTROPHIC FAILURE - TRIGGER PASSIVITY PENALTY AND HUBRIS PENALTY"
        },
        {
          "score": 2,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Ymmärtäminen",
              "en": "Understanding"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Tieto on muotoiltu uudelleen omin sanoin.",
                  "en": "Information is rephrased in own words."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The response demonstrates a rudimentary ability to paraphrase. It is a surface-level interpretation without deeper insight."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Käsitteiden väliset syvemmät yhteydet puuttuvat.",
                  "en": "Deeper connections between concepts are missing."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The explanation is shallow. ENFORCEMENT RULE: Do not offer unearned benefit of the doubt. If the author summarizes without connecting the concepts to a broader framework, cap the score here."
            }
          ],
          "ai_label": "DEFICIENT - SUPERFICIAL REWRITE"
        },
        {
          "score": 3,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Soveltaminen",
              "en": "Applying"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Tietoa sovelletaan uuteen, konkreettiseen tilanteeseen.",
                  "en": "Information is applied to a new, concrete situation."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The response correctly applies a known rule or abstract concept to a specific scenario. However, the application is strictly procedural."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Soveltaminen on mekaanista.",
                  "en": "The application is mechanistic."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The user executes a known process without questioning or optimizing it. There is no adaptability or critical judgment present."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Vaihtoehtoisia lähestymistapoja ei ole käsitelty.",
                  "en": "Alternative approaches have not been considered."
                }
              },
              "ai_description": "ENFORCEMENT RULE: ONE-SIDED EXECUTION DETECTED. The author uses a tool or model blindly without acknowledging its limitations or alternative models. Penalize intellectual laziness; this completely blocks progression to upper scales."
            }
          ],
          "ai_label": "MECHANISTIC APPLICATION - REQUIRES REBUTTALS FOR ADVANCEMENT"
        },
        {
          "score": 4,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Analysointi",
              "en": "Analyzing"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Kokonaisuus on purettu rakenteellisiin osiin.",
                  "en": "The whole has been broken down into structural parts."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The response successfully deconstructs information into its constituent components."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Osien väliset piilevät suhteet on paljastettu.",
                  "en": "Underlying relationships between parts have been revealed."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The text identifies underlying structures, patterns, or causal relationships, distinguishing between facts and inferences."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Analyysin taustaoletuksia ei kyseenalaisteta riittävästi.",
                  "en": "The underlying assumptions of the analysis are not sufficiently questioned."
                }
              },
              "ai_description": "ENFORCEMENT RULE: LACK OF EPISTEMOLOGICAL HUMILITY. Even though the structure is analyzed, the author still operates within a rigid framework without questioning the foundational axioms of the data provided. Downgrade or lock at this tier if absolute certainty is assumed."
            }
          ],
          "ai_label": "STRUCTURAL ANALYSIS - LACKS EPISTEMOLOGICAL HUMILITY"
        },
        {
          "score": 5,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Arviointi",
              "en": "Evaluating"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Teksti esittää loogisesti perustellun arvoasetelman teorioiden välillä.",
                  "en": "The text presents a logically justified value judgment between theories."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The response moves beyond analysis to make defensible judgments based on logical criteria."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Arviointi nojaa ekspliittisiin sisäisiin ja ulkoisiin kriteereihin.",
                  "en": "The evaluation relies on explicit internal and external criteria."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The critique of validity, quality, or utility must be explicitly tethered to stated standards, not just subjective opinion."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Vastaväitteet ja rajoitteet on käsitelty asiantuntevasti.",
                  "en": "Counterarguments and limitations have been expertly addressed."
                }
              },
              "ai_description": "ENFORCEMENT RULE: The author must act as their own prosecutor, actively anticipating and dismantling opposing views. If the evaluation is one-sided, it fails this tier."
            }
          ],
          "ai_label": "CRITICAL EVALUATION - COGNITIVE FRICTION DEMANDED"
        },
        {
          "score": 6,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Luominen",
              "en": "Creating"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Teksti syntetisoi uuden ja alkuperäisen rakenteen tai hypoteesin.",
                  "en": "The text synthesizes a new and original structure or hypothesis."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: THEORETICAL PERFECTION. The response synthesizes disparate elements into a completely novel, coherent, and logically sound framework. It represents a genuine act of intellectual creation."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Päätöksentekoprosessi ja kognitiivinen kitka on dokumentoitu.",
                  "en": "The decision-making process and cognitive friction are documented."
                }
              },
              "ai_description": "ENFORCEMENT RULE: SYSTEM 2 REQUIREMENT. The text MUST explicitly articulate 'how' and 'why' the novel conclusion was reached. It must show the slow, deliberate work of reasoning. Mere correct synthesis without explicitly documented cognitive friction fails this condition."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Uusi synteesi on ankkuroitu ekspliittisesti asiantuntijalähteisiin.",
                  "en": "The new synthesis is explicitly anchored to expert sources."
                }
              },
              "ai_description": "ENFORCEMENT RULE: MANDATORY SOURCE ANCHORING. ABSOLUTE ZERO-TRUST. A perfect intellectual structure without demonstrable anchoring in cited external literature or concrete expert references is inherently suspicious and must be penalized."
            }
          ],
          "ai_label": "NOVEL SYNTHESIS - EXPLICIT COGNITIVE FRICTION AND ANCHORING REQUIRED"
        }
      ],
      "rows": [
        {
          "label": {
            "default_locale": "fi",
            "translations": {
              "fi": "Kognitiivinen syvyys",
              "en": "Cognitive Depth"
            }
          },
          "ai_description": "CRITICAL MANDATE: THE DEFAULT SCORE IS 1. You are strictly forbidden from granting a score higher than 1 unless you can extract direct, irrefutable, and explicit textual quotes that satisfy every single condition of the higher tiers. Passive or implicit logic results in an automatic score of 1."
        }
      ],
      "scale_min": 1,
      "scale_max": 6,
      "ai_description": "ROLE: ANTAGONISTIC PROSECUTOR (ZERO-TRUST). TASK: Evaluate the response's cognitive depth and intellectual complexity using Bloom's Taxonomy. NULL HYPOTHESIS: Assume the text relies on mere rote memorization, lazy aggregation, or AI-generated hallucination without true System 2 comprehension. Actively search for passive regurgitation, lack of critical friction, and unacknowledged alternative models. Do NOT give the benefit of the doubt. Falsify immediately if the required cognitive operation is not explicitly demonstrated and sourced in the text.",
      "slug": "matrix_bloom",
      "output_extensions": [
        "citation",
        "justification",
        "coaching",
        "theory_link"
      ]
    },
    {
      "id": "blk_109dab5b6b3f403a",
      "label": {
        "default_locale": "fi",
        "translations": {
          "fi": "Kahnemanin Kaksoisprosessiteoria",
          "en": "Kahneman's Dual Process Theory"
        }
      },
      "description": {
        "default_locale": "fi",
        "translations": {
          "fi": "Arvioi ajattelun hitautta tai nopeutta (System 1 vs System 2).",
          "en": "Evaluates the speed and depth of cognitive processing using System 1/System 2."
        }
      },
      "category_id": "matrix",
      "type": "float",
      "allow_decimals": true,
      "theory_grounding": {
        "source_url": "https://us.macmillan.com/books/9780374533557",
        "citation_reference": "Kahneman, Daniel 2011."
      },
      "scales": [
        {
          "score": 1,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Systeemi 1 (Nopea)",
              "en": "System 1 (Fast)"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Teksti perustuu intuitioon.",
                  "en": "The text relies on intuition."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: NULL HYPOTHESIS APPLIED. Assume the response is a product of pure, unexamined System 1 thinking. The output is instantaneous, automatic, and lacks analytical depth. ENFORCEMENT RULE: Falsify immediately if there is zero evidence of self-correction."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Teksti hyödyntää heuristiikkaa.",
                  "en": "The text utilizes heuristics."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The reasoning heavily relies on mental shortcuts and associative memory rather than logical deduction. Look for 'What You See Is All There Is' (WYSIATI) fallacies."
            },
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Tekstissä esiintyy kognitiivisia vinoumia.",
                  "en": "The text exhibits cognitive biases."
