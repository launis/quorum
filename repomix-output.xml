          "ai_label": "INSUFFICIENT - PERFORMATIVE HEDGING"
        },
        {
          "score": 3,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Neutraali",
              "en": "Neutral"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
                "translations": {
                  "fi": "Asiat esitetään suoraviivaisesti ilman ehdottomuutta.",
                  "en": "Things are presented straightforwardly without absoluteness."
                }
              },
              "ai_description": "CRITICAL EVALUATION DIRECTIVE: The output avoids overt claims of absolute truth and maintains a relatively neutral tone."
