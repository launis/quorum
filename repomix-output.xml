      "allow_decimals": true,
      "scale_min": 1,
      "scale_max": 5,
      "theory_grounding": {
        "citation_reference": "Hüllermeier, E. & Waegeman, W. 2021. Aleatoric and epistemic uncertainty.",
        "source_url": "https://doi.org/10.1007/s10994-021-05946-3"
      },
      "scales": [
        {
          "score": 1,
          "name": {
            "default_locale": "fi",
            "translations": {
              "fi": "Ylimielinen/Ehdoton",
              "en": "Arrogant / Absolute"
            }
          },
          "claims": [
            {
              "label": {
                "default_locale": "fi",
