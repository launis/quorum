{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/settings": {
      "get": {
        "tags": [
          "Global Settings"
        ],
        "summary": "Get Settings",
        "description": "Retrieves the current global system connection settings.",
        "operationId": "get_settings_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSettings"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Global Settings"
        ],
        "summary": "Update Settings",
        "description": "Updates global system settings.\n\nRequires ROOT.",
        "operationId": "update_settings_settings_patch",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSettings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SystemSettings": {
        "properties": {
          "maintenance_mode": {
            "type": "boolean",
            "title": "Maintenance Mode",
            "description": "If True, only ROOT can login/act.",
            "default": false
          },
          "allow_signups": {
            "type": "boolean",
            "title": "Allow Signups",
            "description": "If True, new users can register.",
            "default": true
          },
          "global_banner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Banner",
            "description": "Message displayed to all users."
          },
          "default_model_strategy": {
            "type": "string",
            "title": "Default Model Strategy",
            "description": "Default LLM strategy for new agents.",
            "default": "fast"
          },
          "enable_beta_features": {
            "type": "boolean",
            "title": "Enable Beta Features",
            "description": "Toggle experimental features.",
            "default": false
          }
        },
        "type": "object",
        "title": "SystemSettings",
        "description": "Global System Configuration.\n\nPersisted as a singleton in the 'system_settings' table.",
        "example": {
          "allow_signups": true,
          "default_model_strategy": "fast",
          "global_banner": "Scheduled maintenance at 02:00 UTC",
          "maintenance_mode": false
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}