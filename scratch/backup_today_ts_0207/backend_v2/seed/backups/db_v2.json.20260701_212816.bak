{"system_config": {"1": {"id": "sys_e26807f3bfa3454d", "slug": "config_model_registry", "type": "model_registry", "models": {"deep": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.0, "top_p": 0.0, "top_k": 1, "tpm_limit": 4000000, "rpm_limit": 5, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": true, "api_key": null, "parsing_mode": "STRUCTURED_JSON", "caching_strategy": "prompt_caching", "additional_params": {"vertex_location": "${VERTEX_LOCATION}"}, "is_active": true}, "synthesis": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.4, "top_p": 0.9, "top_k": 40, "tpm_limit": 4000000, "rpm_limit": 5, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "STRUCTURED_JSON", "caching_strategy": "prompt_caching", "additional_params": {"vertex_location": "${VERTEX_LOCATION}"}, "is_active": true}, "fast": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-flash", "temperature": 0.0, "top_p": 0.0, "top_k": 1, "tpm_limit": 4000000, "rpm_limit": 100, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "STRUCTURED_JSON", "caching_strategy": "prompt_caching", "additional_params": {"vertex_location": "${VERTEX_LOCATION}"}, "is_active": true}, "strict": {"provider": "google", "model_name": "vertex_ai/gemini-2.5-pro", "temperature": 0.0, "top_p": 0.0, "top_k": 1, "tpm_limit": 4000000, "rpm_limit": 5, "max_tokens": 65536, "allowed_tools": [], "supports_grounding": false, "api_key": null, "parsing_mode": "STRUCTURED_JSON", "caching_strategy": "prompt_caching", "additional_params": {"vertex_location": "${VERTEX_LOCATION}"}, "is_active": true}}}, "2": {"id": "sys_8172bda70c8641c5", "slug": "mcp_gateways", "type": "mcp_gateways", "tools": [{"tool_id": "mcp_tavily_search", "name": {"default_locale": "en", "translations": {"en": "Tavily AI Search", "fi": "Tavily AI -haku"}}, "description": "Search the internet for factual information using Tavily AI.", "input_schema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}]}, "3": {"id": "sys_e0b2a3c4d5e6f7a8", "slug": "config_performative_lexicons", "type": "performative_lexicons", "lexicon_configs": {"en": {"language_code": "en", "language_name": "English", "fuzz_threshold": 90.0, "words": ["delve into", "tapestry", "comprehensive overview", "rich history", "testament to", "underscore the importance", "pivotal role", "landscape of", "realm of", "foster a sense of", "game changer", "cutting edge", "revolutionary", "dive deep", "in conclusion", "it is important to note", "vast array", "myriad of", "unleash the power", "embark on a journey", "beacon of", "multifaceted", "gobeliini"]}, "fi": {"language_code": "fi", "language_name": "Finnish", "fuzz_threshold": 90.0, "words": ["syventy\u00e4", "kattava katsaus", "rikas historia", "osoitus siit\u00e4", "korostaa merkityst\u00e4", "keskeinen rooli", "merkitt\u00e4v\u00e4 rooli", "maisema", "kentt\u00e4", "luoda tunnetta", "mullistava", "huippuluokan", "vallankumouksellinen", "sukeltaa syv\u00e4lle", "yhteenvetona", "on t\u00e4rke\u00e4\u00e4 huomata", "voidaan todeta", "laaja kirjo", "lukuisia", "vapauttaa voima", "l\u00e4hte\u00e4 matkalle", "majakka", "dynaaminen", "innovatiivinen", "saumaton", "synergia", "kokonaisvaltainen", "merkitt\u00e4v\u00e4sti", "avainasemassa", "tulevaisuuden n\u00e4kym\u00e4t", "digitaalinen aikakausi", "virstanpylv\u00e4s", "paradigm", "ekosysteemi", "k\u00e4rkihanke", "strateginen", "optimoitu", "resonoimaan", "navigoida", "monitahoinen", "kukoistaa", "kudottu", "el\u00e4v\u00e4 kudos", "el\u00e4v\u00e4 osoitus", "gobeliini", "n\u00e4ytt\u00e4m\u00f6"]}}}}, "workflows": {"1": {"id": "wf_0000000000000000", "slug": "system_default", "name": {"default_locale": "en", "translations": {"en": "System Default Workflow", "fi": "J\u00e4rjestelm\u00e4n Oletusty\u00f6nkulku"}}, "description": {"default_locale": "en", "translations": {"en": "Built-in fallback workflow for global system profiles.", "fi": "Sis\u00e4\u00e4nrakennettu varaty\u00f6nkulku globaaleille j\u00e4rjestelm\u00e4profiileille."}}, "status": "published", "version": 1, "is_public": false, "organization_id": null, "ui_schema": {}, "output_profiles": {}, "default_profile_id": "prf_4050cb0e1f4245e2b44e42153d9cc962", "default_strictness_level": 50, "default_scoring_strategy": "AVERAGE", "enable_contextual_overrides": false, "enable_semantic_smoothing": false, "enable_eager_anonymization": false, "system_audit_trail": false, "expected_inputs": [], "steps": []}, "2": {"id": "wf_9d68c573802341db", "slug": "kokonaisvaltainen_auditointi", "name": {"default_locale": "fi", "translations": {"fi": "Kokonaisvaltainen Auditointi", "en": "Holistic Audit"}}, "description": {"default_locale": "fi", "translations": {"fi": "Kattava 12-vaiheinen auditointiketju, joka analysoi datan monipuolisesti ja tuottaa syv\u00e4llisen arvioinnin.", "en": "Comprehensive 12-step audit chain that analyzes data from multiple perspectives to produce an in-depth evaluation."}}, "status": "active", "version": 1, "is_public": true, "organization_id": null, "ui_schema": {}, "output_profiles": {"prf_5d6e7f8091a2b3c4": {"name": {"default_locale": "fi", "translations": {"en": "Holistic Audit", "fi": "Kokonaisvaltainen Auditointi"}}, "description": {"default_locale": "fi", "translations": {"en": "End-to-end transparent evaluation.", "fi": "Koko datan l\u00e4p\u00e4isev\u00e4 t\u00e4ydellinen auditointiraportti."}}, "custom_preface": null, "language": null, "formatting_directives": [], "tone_instruction": {"default_locale": "en", "translations": {"fi": "K\u00e4yt\u00e4 asiallista, neutraalia ja analyyttist\u00e4 s\u00e4vy\u00e4.", "en": "Use professional, neutral, and analytical tone."}}, "visible_metadata": ["date", "organization"], "visible_block_extensions": ["falsification", "coaching", "remediation_steps", "emotional_sentiment"], "visible_workflow_extensions": ["variance_validation"], "max_extension_items": 2, "display_scale": "original", "synthesis": {"system_prompt": "## Role\\nSenior Executive Coach\\n\\n## Objective\\nProduce a clear, coherent, and highly concrete executive summary of the entire evaluation. You possess the complete context of the workflow, including multiple configured XAI output perspectives.\\nYour goal is to synthesize these diverse findings into a strictly structured, unified narrative. Do not just summarize the text; actively map the combined effects of the XAI findings.\\n\\n## Rules\\n- SCORE-DRIVEN TONE AND STRUCTURE (CRITICAL): You must dynamically adjust your tone AND the content of your paragraphs based on the mathematical 'normalized_score' (0-100) found in the source data: (1) 0 - 39: Zero praise. (2) 40 - 69: Firm and clinical. (3) 70 - 89: Constructive coaching. (4) 90 - 100: Highly validating and visionary.\\n- CROSS-EXAMINE FINDINGS: Never list findings separately. Always weave them together. Show the causal link between different flaws.\\n- CONSTRUCTIVE CRITICISM: Speak truthfully. Highlight logical gaps without sugarcoating, but do so as a mentor assessing a candidate.\\n- NO ACADEMIC JARGON: Translate complex theory into punchy, plain business language.\\n- TECHNICAL GATES: NEVER mention internal system IDs, node names, file names, or numeric scores.\\n- EVIDENCE MANDATE (CRITICAL): You MUST anchor every major analytical claim to reality by providing at least 1-2 direct quotes (\\\"...\\\") extracted directly from the user's comments. Without direct quotes, your synthesis is invalid.", "model_strategy": "synthesis", "length_constraint": 2000, "preamble_text": {"default_locale": "fi", "translations": {"en": "Global Executive Summary", "fi": "Globaali Johdon Yhteenveto"}}, "historical_context_mode": "SLIDING_WINDOW_3", "enable_pii_masking": false, "allowed_exports": ["pdf", "docx", "raw_json"], "omit_empty_sections": false, "allowed_mcp_tools": [], "matrix_visible_columns": ["label", "score", "distribution", "row_explanation", "quotes"], "tone_instruction": null}, "include_diagnostic_scorecard": false, "strictness_level": null, "scoring_strategy": null, "layouts": [{"preset_view": "3d_matrix", "title": {"default_locale": "fi", "translations": {"en": "Intellectual Self-Defense Radar: 3D Cognitive Analysis", "fi": "\u00c4lyllisen Itsepuolustuksen Tutka: 3D-Kognitioanalyysi"}}, "description": {"default_locale": "fi", "translations": {"en": "Evaluation of input data sanitization.", "fi": "Datan todennettavuus ja looginen rakenne."}}, "steps": [], "target_blocks": ["blk_440a5fef9331451b", "blk_53f32679aa514fcb", "blk_109dab5b6b3f403a"], "text_delivery_mode": "none", "synthesis": {"system_prompt": "You are an objective analytical reporting engine. Synthesize the provided execution data into a professional summary. Do not re-evaluate the raw claims or perform independent logical deduction. Output clear, concise, and highly readable text. CRITICAL: When evaluations data contains exact_quote fields, you MUST weave these real user quotes into your narrative to ground every claim in concrete evidence. NEVER use academic framework names (Kahneman, Toulmin, Pearl, Goodhart, Popper) \u2014 translate all theoretical findings into plain business language about the user's actual content.", "model_strategy": "synthesis", "length_constraint": 300, "preamble_text": {"default_locale": "fi", "translations": {"en": "Argument structure, decision-making quality, and performance bias detection", "fi": "Argumentoinnin rakenne, p\u00e4\u00e4t\u00f6ksenteon laatu ja suoritusharhan tunnistaminen"}}, "historical_context_mode": "DISABLED", "enable_pii_masking": false, "allowed_exports": ["pdf"], "omit_empty_sections": false, "allowed_mcp_tools": [], "matrix_visible_columns": ["label", "score", "distribution", "row_explanation", "quotes"], "tone_instruction": null}, "synthesis_blocks": null, "strictness_level": null, "scoring_strategy": null}, {"preset_view": "3d_matrix", "title": {"default_locale": "en", "translations": {"en": "Reality Radar: Idea Robustness and Cognitive Blindness", "fi": "Reaalimaailman Tutka: Idean Kest\u00e4vyys ja Kognitiivinen Sokeus"}}, "description": {"default_locale": "fi", "translations": {"en": "Analysis of True Causality, Falsifiability, and Epistemic Humility.", "fi": "Datan aito syy-seuraussuhde, v\u00e4itteen falsifioitavuus sek\u00e4 arvioijan episteeminen n\u00f6yryys."}}, "steps": [], "target_blocks": ["blk_c5804a9143c34cb1", "blk_b476f89fb732448c", "blk_22e3598e06414409"], "text_delivery_mode": "none", "synthesis": {"system_prompt": "You are an objective analytical reporting engine. Synthesize the provided execution data into a professional summary. Do not re-evaluate the raw claims or perform independent logical deduction. Output clear, concise, and highly readable text. CRITICAL: When evaluations data contains exact_quote fields, you MUST weave these real user quotes into your narrative to ground every claim in concrete evidence. NEVER use academic framework names (Kahneman, Toulmin, Pearl, Goodhart, Popper) \u2014 translate all theoretical findings into plain business language about the user's actual content.", "model_strategy": "synthesis", "length_constraint": 200, "preamble_text": {"default_locale": "en", "translations": {"en": "Causal reasoning depth, claim testability, and awareness of knowledge limits", "fi": "Syy-seuraussuhteiden syvyys, v\u00e4itteiden testattavuus ja tiedon rajojen tunnistaminen"}}, "historical_context_mode": "DISABLED", "enable_pii_masking": false, "allowed_exports": ["pdf", "raw_json"], "omit_empty_sections": true, "allowed_mcp_tools": [], "matrix_visible_columns": ["label", "score", "distribution", "row_explanation", "quotes"], "tone_instruction": null}, "synthesis_blocks": null, "strictness_level": null, "scoring_strategy": null}, {"preset_view": "3d_matrix", "title": {"default_locale": "en", "translations": {"fi": "Illuusionpaljastin: Analyysin L\u00e4pin\u00e4kyvyyden ja Vastuullisuuden Testi", "en": "The Illusion Detector: Test of Analytical Transparency and Accountability"}}, "description": {"default_locale": "fi", "translations": {"en": "Measurement of Unfounded Assumptions, Internal Contradictions, and Post-Hoc Rationalization.", "fi": "Kryptisten oletusten, sis\u00e4isen ristiriitaisuuden ja j\u00e4lkik\u00e4teisen selittelyn riskimitta."}}, "steps": [], "target_blocks": ["blk_6b8c766185294f7e", "blk_f6e286f050c94d60", "blk_22e3598e06414409"], "text_delivery_mode": "none", "synthesis": {"system_prompt": "You are an objective analytical reporting engine. Synthesize the provided execution data into a professional summary. Do not re-evaluate the raw claims or perform independent logical deduction. Output clear, concise, and highly readable text. CRITICAL: When evaluations data contains exact_quote fields, you MUST weave these real user quotes into your narrative to ground every claim in concrete evidence. NEVER use academic framework names (Kahneman, Toulmin, Pearl, Goodhart, Popper) \u2014 translate all theoretical findings into plain business language about the user's actual content.", "model_strategy": "synthesis", "length_constraint": 200, "preamble_text": {"default_locale": "en", "translations": {"en": "Data Anchoring, Internal Logic, and Post-Hoc Rationalization", "fi": "Datan ankkurointi, sis\u00e4inen logiikka ja j\u00e4lkik\u00e4teinen selittely"}}, "historical_context_mode": "DISABLED", "enable_pii_masking": false, "allowed_exports": ["pdf", "raw_json"], "omit_empty_sections": true, "allowed_mcp_tools": [], "matrix_visible_columns": ["label", "score", "distribution", "row_explanation", "quotes"], "tone_instruction": null}, "synthesis_blocks": null, "strictness_level": null, "scoring_strategy": null}]}}, "default_profile_id": "prf_5d6e7f8091a2b3c4", "default_strictness_level": 50, "default_scoring_strategy": "AVERAGE", "enable_contextual_overrides": true, "enable_semantic_smoothing": false, "enable_eager_anonymization": false, "system_audit_trail": true, "expected_inputs": [{"input_key": "product_text", "label": {"default_locale": "fi", "translations": {"fi": "Lopputuote (Analyysin P\u00e4\u00e4kohde)", "en": "Product (Main Audit Target)"}}, "required": false, "is_chat_history": false, "scan_for_performative_patterns": false, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "T\u00e4h\u00e4n liitet\u00e4\u00e4n auditoitavan prosessin varsinainen tuotos, esim. PDF-dokumentti.", "en": "Attach the actual output of the audited process (e.g. PDF)."}}, "ai_description": "SOURCE EVIDENCE DIRECTIVE: This artifact represents the final target output of the audited process. It must be evaluated strictly on its own merits without assuming any external context or hidden intentions. Treat this as the definitive end-result of the cognitive process.", "questionnaire_definition": []}, {"input_key": "chat_log", "label": {"default_locale": "fi", "translations": {"fi": "Keskusteluhistoria", "en": "Chat Log"}}, "required": true, "is_chat_history": true, "scan_for_performative_patterns": false, "input_modes": ["file", "paste"], "description": {"default_locale": "fi", "translations": {"fi": "Liit\u00e4 keskusteluhistoria ihmisen ja teko\u00e4lyn v\u00e4lill\u00e4.", "en": "Attach chat log between human and AI."}}, "ai_description": "--- AI INSTRUCTION FOR THIS SOURCE (chat_log) ---\nPROCESS EVIDENCE DIRECTIVE: This artifact contains the chronological dialogue unspooled between the human operator and the AI system leading up to the final product. You must analyze this strictly for developmental trajectory, cognitive dependencies, prompt compliance, and the balance of intellectual labor. Do not treat this as the final product itself, but rather the scaffolding that built it.\n\nMANDATE_HUMAN_EVALUATION: You must evaluate ONLY the human user's cognitive level, steering skills, and domain expertise. \n\nEXTRACTION_RULE: You MUST extract 'exact_quote' evidence STRICTLY from lines starting with \"user:\". \n\nCONTEXT_RULE: Text starting with \"ai:\" is strictly background context. NEVER use the AI's output, intelligence, or reasoning as evidence of the human's competence.", "questionnaire_definition": []}, {"input_key": "reflection_text", "label": {"default_locale": "fi", "translations": {"fi": "Reflektiodokumentti", "en": "Reflection"}}, "required": false, "is_chat_history": false, "scan_for_performative_patterns": false, "input_modes": ["questionnaire"], "description": {"default_locale": "fi", "translations": {"fi": "Vastaa lyhyesti reflektiokysymyksiin.", "en": "Answer reflection questions briefly."}}, "ai_description": "META-COGNITIVE EVIDENCE DIRECTIVE: This artifact contains the human operator's post-hoc reflection on the interaction. Analyze this to establish the operator's self-awareness, critical distance, and theoretical grounding regarding the process. Evaluate if the reflection aligns transparently with the actual events logged in the chat history.", "questionnaire_definition": [{"question_id": "ref1", "question": {"default_locale": "fi", "translations": {"fi": "Mik\u00e4 oli mielest\u00e4si onnistuneinta t\u00e4ss\u00e4 vuorovaikutuksessa?", "en": "What do you think was the most successful part of this interaction?"}}, "type": "text"}, {"question_id": "ref2", "question": {"default_locale": "fi", "translations": {"fi": "Mit\u00e4 tekisit toisin ensi kerralla?", "en": "What would you do differently next time?"}}, "type": "text"}]}], "steps": [{"id": "sr_f0a26d17cc9b48a7", "task_blueprint": "sp_db849f9790984585", "depends_on": [], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_0f7947ec7007498c", "task_blueprint": "sp_ddb7cf7c8a0245d4", "depends_on": ["sr_f0a26d17cc9b48a7"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_02b7cc1e7c2a4a62", "task_blueprint": "sp_76eedbc020274f66", "depends_on": ["sr_f0a26d17cc9b48a7", "sr_0f7947ec7007498c"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_5a8ae009eee44fe2", "task_blueprint": "sp_b5c751d1cbe24735", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_99ca8c82a5aa48cd", "task_blueprint": "sp_6a45d484ad5b497c", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_87f408aeee64462f", "task_blueprint": "sp_8daee218c6b14f02", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_d56fb84fbe13463a", "task_blueprint": "sp_6f40b964895c426b", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_4d2272d8b4864847", "task_blueprint": "sp_bd0b3054fe664960", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_1d7e6d26b02b457b", "task_blueprint": "sp_7f9649114d2344dc", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_b4c328df1c4141c6", "task_blueprint": "sp_dfc365994fa944b2", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_566e3209a60444d3", "task_blueprint": "sp_f22db9f1dde048b7", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_ba028623acab447a", "task_blueprint": "sp_48974af1fc584407", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs", "context": "$steps.sr_02b7cc1e7c2a4a62"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_0228db320e8f41bb", "task_blueprint": "sp_25664f44773a4354", "depends_on": ["sr_02b7cc1e7c2a4a62"], "input_mappings": {"inputs": "$inputs"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_5f3dd7712a7f4bb3", "task_blueprint": "sp_192910b5f5a34c79", "depends_on": ["sr_5a8ae009eee44fe2", "sr_99ca8c82a5aa48cd", "sr_87f408aeee64462f", "sr_d56fb84fbe13463a", "sr_4d2272d8b4864847", "sr_1d7e6d26b02b457b", "sr_b4c328df1c4141c6", "sr_566e3209a60444d3", "sr_ba028623acab447a", "sr_0228db320e8f41bb"], "input_mappings": {"context": "$steps"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_2fa56dc36614469a", "task_blueprint": "sp_d245365e4a274b9e", "depends_on": ["sr_5f3dd7712a7f4bb3"], "input_mappings": {"results": "$steps.sr_5f3dd7712a7f4bb3"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_752e1e125eb3413b", "task_blueprint": "sp_8ffee13639e64e34", "depends_on": ["sr_2fa56dc36614469a"], "input_mappings": {"steps": "$steps"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_f959d76af98c4d20", "task_blueprint": "sp_9c6a85edc29347b9", "depends_on": ["sr_752e1e125eb3413b"], "input_mappings": {"distilled_inputs": "$steps.sr_752e1e125eb3413b.distilled_inputs", "historical_context": "$steps.sr_752e1e125eb3413b.historical_context", "output_profile_id": "$steps.sr_752e1e125eb3413b.output_profile_id", "language": "$steps.sr_752e1e125eb3413b.language"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}, {"id": "sr_875ebc1441ee406c", "task_blueprint": "sp_fb1b8e908bf24c1f", "depends_on": ["sr_752e1e125eb3413b"], "input_mappings": {"matrices_to_explain": "$steps.sr_752e1e125eb3413b.matrices_to_explain", "language": "$steps.sr_752e1e125eb3413b.language"}, "ui_pos_x": 0.0, "ui_pos_y": 0.0}]}}}